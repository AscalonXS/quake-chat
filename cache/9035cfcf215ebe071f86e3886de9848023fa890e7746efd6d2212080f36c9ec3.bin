    <!-- HowTo Schema - First Aid for Electrical Injury -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": "How to Help Someone Who Has Been Electrocuted",
      "description": "Step-by-step first aid instructions for helping a victim of electrical injury while ensuring your own safety.",
      "image": "https://imedic.health/images/electrical-injury-first-aid.jpg",
      "estimatedCost": {
        "@type": "MonetaryAmount",
        "currency": "USD",
        "value": "0"
      },
      "totalTime": "PT5M",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Ensure your safety first",
          "text": "Do not touch the person if they are still in contact with the electrical source. You could be electrocuted too. Assess the situation from a safe distance.",
          "url": "https://imedic.health/en/first-aid/emergency-advice/electrical-injury#first-aid"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Disconnect the power source",
          "text": "Turn off the electricity at the circuit breaker, fuse box, or unplug the device. If outdoors near power lines, stay at least 20 feet away and call emergency services.",
          "url": "https://imedic.health/en/first-aid/emergency-advice/electrical-injury#first-aid"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Separate person from source if power cannot be cut",
          "text": "Use a non-conducting object (dry wood, plastic, rubber) to push the person away from the electrical source. Never use anything wet or metallic.",
          "url": "https://imedic.health/en/first-aid/emergency-advice/electrical-injury#first-aid"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Call emergency services",
          "text": "Call your local emergency number immediately. Describe the electrical injury and the person's condition.",
          "url": "https://imedic.health/en/first-aid/emergency-advice/electrical-injury#when-to-seek-care"
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Check breathing and pulse",
          "text": "Once the person is safely away from the electrical source, check if they are breathing and have a pulse. If not breathing or no pulse, begin CPR immediately.",
          "url": "https://imedic.health/en/first-aid/emergency-advice/electrical-injury#first-aid"
        },
        {
          "@type": "HowToStep",
          "position": 6,
          "name": "Treat for shock and burns",
          "text": "Keep the person lying down. Cover any burns loosely with a sterile bandage. Do not apply ice or water to electrical burns. Keep the person warm while waiting for emergency services.",
          "url": "https://imedic.health/en/first-aid/emergency-advice/electrical-injury#first-aid"
        }
      ]
    }
    </script>

