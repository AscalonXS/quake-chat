<style id="wp-custom-css">.navbar .hamburger span{width:18px;height:2px;background-color:#191a22}.navbar .hamburger{gap:3px}.course-single-text ol{list-style:decimal!important}.faq-courses-slider .slick-track{display:flex;align-items:stretch}.faq-courses-slider .slick-slide{margin:10px;border-style:solid;border-width:0px 0px 1px 0px;border-color:#AACD67;box-shadow:5px 0px 51px 0px rgba(16.999999999999996, 85.00000000000009, 126, 0.11);transition:background 0.3s, border 0.3s, border-radius 0.3s, box-shadow 0.3s;padding:10px 15px 30px 15px;background:#fff;border-radius:8px;height:auto}.faq-courses-slider .slick-prev:before,.faq-courses-slider .slick-next:before{display:none}.faq-courses-slider .slick-next{background:url(/wp-content/uploads/2025/04/Arrow-white.png)no-repeat center #11557e;padding:5px 7px;border-radius:50px}.faq-courses-slider .slick-prev{background:url(/wp-content/uploads/2025/04/Arrow-white-prev.png)no-repeat center #11557e;padding:5px 7px;border-radius:50px}.faq-courses-slider .slick-prev:hover{background:url(/wp-content/uploads/2025/04/Arrow-white-prev.png)no-repeat center #9dc843}.faq-courses-slider .slick-next:hover{background:url(/wp-content/uploads/2025/04/Arrow-white.png)no-repeat center #9dc843}.faq-courses-slider ul{min-height:180px}.swiper .post{box-shadow:0px 5px 51px 0px rgba(17, 85, 126, 0.11)!important}.single-post table ul{padding:0 0 0 10px}.elementor-posts-container .elementor-post__thumbnail img{position:absolute}body{font-family:'Inter',"Inter Fallback",sans-serif!important}a{color:#b51d1a}#site-header,#site-footer{display:none}.site-branding{display:none!important}.site-navigation{max-width:1100px!important;margin:0 auto}.header-mini-links a{color:#000;vertical-align:middle}.header-mini-links a:hover{color:#b51d1a}.header-mini-links img{vertical-align:middle}.last-mod-date .elementor-icon-list-icon{display:block!important}.last-mod-date .elementor-icon-list-text{font-weight:500}.last-mod-date ul li{background-color:#fff;padding:5px