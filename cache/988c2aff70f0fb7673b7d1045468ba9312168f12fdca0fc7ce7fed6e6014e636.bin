.single-post .receive-cpr-certification-box{padding: 20px;background: #083651;}
.single-post .need-cpraed-certification-box a.btn-primary{font-size: 12px;padding: 8px 15px;}
.single-post .need-cpraed-certification-box h4{font-size: 14px;line-height: 24px;}
.single-post .need-cpraed-certification-box h5{font-size: 12px;line-height: 22px;}
}
@media (max-width:992px) {
.receive-cpr-certification-box{padding: 34px 38px 43px 310px;}
.receive-cpr-certification-box h5{font-size: 10px;line-height: 24px;}
.success-courses-box ul{font-size: 14px;}
.success-courses-box p.h4{font-size: 22px;line-height: 32px;}
}
@media (max-width:768px) {
.single-post .receive-cpr-certification-box h5 {font-size: 14px;line-height: 22px;max-width: 175px;}
.single-post .receive-cpr-certification-box {padding: 16px;}
.single-post .receive-cpr-certification-box a.btn-primary {font-size: 12px; padding: 8px 12px;}
.single-post .need-cpraed-certification-box { padding: 16px;}
.single-post .need-cpraed-certification-box h5 {font-size: 14px; line-height: 22px; max-width: 175px; }
.single-post .need-cpraed-certification-box h4 {font-size: 20px;line-height: 25px;}
.single-post .need-cpraed-certification-box a.btn-primary {position: absolute;}
.need-cpraed-certification-box{background:#F6F9FD; padding:16px; overflow:hidden;}
.get-certification-minutes-box,.receive-cpr-certification-box{background:#083651; padding:16px; overflow:hidden;}
.need-cpraed-certification-box h4,.get-certification-minutes-box p.h4,.receive-cpr-certification-box h4,.receive-cpr-certification-box p.h4{font-size: 20px;line-height: 25px;margin: 0 0 16px;}
.get-certification-minutes-box p.h4,.receive-cpr-certification-box h4,.receive-cpr-certification-box p.h4{margin: 0 0 7px;}
.need-cpraed-certification-box h5,.get-certification-minutes-box p.h5,.receive-cpr-certification-box h5,.receive-cpr-certification-box p.h5{font-size: 14px;line-height: 18px;max-width: 200px;}
.need-cpraed-certification-box a.btn-primary,.get-certification-minutes-box a.btn-primary,.receive-cpr-certification-box a.btn-primary{font-size: 12px;line-height: 16px;padding: 8px 12px;position: absolute;right: 16px;bottom: 20px;}
.need-cpraed-certification-box:after,.get-certification-minutes-box:after{top: -8px;left: -45px;}
.need-cpraed-certification-box:before,.get-certification-minutes-box:before{bottom: -8px;right: -45px;}
.success-courses-box{padding:16px;}
.success-courses-box .d-flex{display: block;}
.success-courses-box p.h4{font-size: 18px;line-height: 22px;}
.success-courses-box ul{font-size: 12px;line-height: 15px;}
.success-courses-box li{min-height: 24px;}
.success-courses-box .bluebox p.h4{font-size: 20px;line-height: 25px;}
.success-courses-box .bluebox .price{font-size: 16px;line-height: 20px;}
.success-courses-box .bluebox .oldprice{font-size: 14px;line-height: 24px;}
.totalreviews{font-size: 14px;line-height: 24px;}
.reviewstext{font-size: 10px;line-height: 12px;}
.success-courses-box a.btn-primary{width: 100%;text-align: center;}
.success-courses-box .totalreviewsbox,.success-courses-box .stars{display:inline-block;}
.success-courses-box .bluebox .price-box{margin-bottom: 8px;line-height: 20px;}
}
