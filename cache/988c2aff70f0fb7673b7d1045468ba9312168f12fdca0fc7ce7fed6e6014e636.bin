/* Banners With Shorcode css Start*/
/*Banner1 css*/
.need-cpraed-certification-box{background: url(/wp-content/uploads/2024/07/Dots-icon.png) no-repeat #F6F9FD;padding: 24px 124px;border-radius: 8px;box-shadow: 0 0 16px 0 rgba(0, 0, 0, 0.16);position: relative;background-position: 26px 85%;}
.need-cpraed-certification-box:after{content:""; position:absolute; top:0; left:0; background:url(/wp-content/uploads/2024/07/Plus-icon-gray-top.png)no-repeat; width:106px; height:60px;}
.need-cpraed-certification-box:before{content:""; position:absolute; bottom:0; right:0; background:url(/wp-content/uploads/2024/07/Plus-icon-gray-bottom.png)no-repeat; width:106px; height:60px;}
.need-cpraed-certification-box .d-flex{display:flex; align-items:center; justify-content:space-between;}
.need-cpraed-certification-box h4{font-size:30px; font-weight:700; line-height:42px; color:#11557E; padding:0; margin:0 0 8px;}
.need-cpraed-certification-box h5{font-size:22px; font-weight:400; line-height:32px; color:#191A22; padding:0; margin:0;}
.need-cpraed-certification-box a.btn-primary{font-size:16px; color:#fff; line-height:24px; font-weight:700; padding:12px 24px; background:#B51D1A; border-radius:4px;display: block;width: max-content;}
.need-cpraed-certification-box a.btn-primary:hover{background:#000;}
.single-post .need-cpraed-certification-box{padding: 35px 10px 25px;background-position: 26px 95%;}
.single-post .need-cpraed-certification-box h4{font-size: 20px;line-height: 30px; margin:0;}
.single-post .need-cpraed-certification-box h5{font-size: 15px;line-height: 25px;}
.single-post .need-cpraed-certification-box a.btn-primary{position: relative;}
/*Banner2 css*/
.get-certification-minutes-box{background: #083651;padding: 24px 128px;border-radius: 8px;position: relative;}
.get-certification-minutes-box:after{content:""; position:absolute; top:0; left:12px; background:url(/wp-content/uploads/2024/07/Plus-icon-blue-top.png)no-repeat; width:104px; height:60px;}
.get-certification-minutes-box:before{content:""; position:absolute; bottom:0; right:12px; background:url(/wp-content/uploads/2024/07/Plus-icon-blue-bottom.png)no-repeat; width:104px; height:60px;}
.get-certification-minutes-box .d-flex{display:flex; align-items:center; justify-content:space-between;}
.get-certification-minutes-box p.h4{font-size:36px; font-weight:700; line-height:45px; color:#F6F9FD; padding:0; margin:0 0 8px;}
.get-certification-minutes-box p.h5{font-size:20px; font-weight:400; line-height:28px; color:#F6F9FD; padding:0; margin:0;}
.get-certification-minutes-box a.btn-primary{font-size:16px; color:#fff; line-height:24px; font-weight:700; padding:12px 24px; background:#B51D1A; border-radius:4px;display: block;width: max-content; position:relative;}
.get-certification-minutes-box a.btn-primary:hover{background:#000;}
.single-post .get-certification-minutes-box{padding: 24px; margin-bottom:15px;}
.single-post .get-certification-minutes-box p.h4{font-size: 28px;line-height: 38px;}
/*Banner3 css*/
.receive-cpr-certification-box{background:url(/wp-content/uploads/2024/07/Receive-certification-img.png)no-repeat #083651;padding: 34px 38px 43px 337px;border-radius: 8px;position: relative;background-position:top left;}
.receive-cpr-certification-box .d-flex{ display:flex; align-items:center; justify-content:space-between;}
.receive-cpr-certification-box h4,.receive-cpr-certification-box p.h4{font-size:32px; font-weight:700; line-height:42px; color:#F6F9FD; padding:0; margin:0 0 12px;}
.receive-cpr-certification-box h5,.receive-cpr-certification-box p.h5{font-size:20px; font-weight:400; line-height:24px; color:#F6F9FD; padding:0; margin:0;}
.receive-cpr-certification-box a.btn-primary{font-size:16px; color:#fff; line-height:24px; font-weight:700; padding:12px 24px; background:#B51D1A; border-radius:4px;display: block;width: max-content;}
.receive-cpr-certification-box a.btn-primary:hover{background:#000;}
/*Banner4 css*/
.success-courses-box{background: #F6F9FD;padding: 12px 12px 12px 28px;border-radius: 8px;box-shadow: 0 0 16px 0 rgba(0, 0, 0, 0.16);position: relative;}
.success-courses-box .d-flex{ display:flex; align-items:center; justify-content:space-between;}
.success-courses-box p.h4{ font-size:30px; font-weight:700; line-height:42px; color:#11557E; padding:0; margin:0 0 8px;}
.success-courses-box ul{padding:0; margin:0; font-size:18px; line-height:28px; color:#191A22;}
.success-courses-box li{list-style:none; width:49%; display:inline-block; margin-bottom:8px; padding-left:36px;    background: url(/wp-content/uploads/2024/07/Tick-mark.png) no-repeat;}
.success-courses-box .bluebox{background:#083651; padding:14px 16px; border-radius:4px;}
.success-courses-box .bluebox p.h4{font-size:28px; font-weight:700; line-height:36px; color:#fff; padding:0; margin:0;}
.success-courses-box .bluebox .price{font-size:24px; font-weight:700; color:#F5FBFF;vertical-align: middle;}
.success-courses-box .bluebox .oldprice{font-size:16px; font-weight:500; line-height:32px; color:#ccc;text-decoration: line-through;}
.success-courses-box .bluebox .price-box{margin-bottom:12px; line-height:28px;}
.success-courses-box .bluebox .stars img{vertical-align:middle;}
.success-courses-box .totalreviewsbox{margin-bottom:8px;}
.totalreviews{font-size:14px; color:#fff; font-weight:700; line-height:18px; margin-right:8px;}
.reviewstext{font-size:14px; color:#fff; font-weight:400; line-height:18px;}
.success-courses-box a.btn-primary{font-size:14px; color:#fff; line-height:20px; font-weight:700; padding:10px 70px; background:#B51D1A; border-radius:4px;display: block;width: max-content;}
.success-courses-box a.btn-primary:hover{background:#000;}
.single-post .success-courses-box{padding: 12px;}
.single-post .success-courses-box p.h4{font-size: 19px;line-height: 29px;}
.single-post .success-courses-box li{font-size:11px;}
.single-post .success-courses-box .bluebox p.h4{font-size: 20px; line-height: 30px;}
.single-post .success-courses-box .bluebox .price{font-size: 20px;}
.single-post .success-courses-box a.btn-primary{padding: 10px 60px;}
.single-post .receive-cpr-certification-box{padding: 20px 10px 20px 255px;background-size: 255px;}
.single-post .receive-cpr-certification-box h4,.single-post .receive-cpr-certification-box p.h4{font-size: 20px;line-height: 30px;margin: 0 0 8px;}
.single-post .receive-cpr-certification-box h5,.single-post .receive-cpr-certification-box p.h5{font-size: 12px;line-height: 22px;}
.single-post .receive-cpr-certification-box a.btn-primary{font-size: 14px;padding: 8px 18px;}
@media (max-width:1200px) {
.single-post .success-courses-box a.btn-primary {padding: 10px 42px;}
.single-post .receive-cpr-certification-box{padding: 20px 10px 20px 200px;background-size: 200px;}
.single-post .receive-cpr-certification-box h4,.single-post .receive-cpr-certification-box p.h4{font-size: 17px;line-height: 27px;}
.single-post .receive-cpr-certification-box h5,.single-post .receive-cpr-certification-box p.h5{font-size: 11px;line-height: 22px;}
}
