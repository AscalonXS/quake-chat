	<style id="header-bar-critical">
	.ahca-wrap, .ahca-wrap *{
    box-sizing:border-box;
    margin:0;
    padding:0;
    font-family: "Inter","Inter Fallback",Sans-serif;
  }
  .ahca-wrap{ position:relative; width:100%; max-width:1140px; margin:0 auto;}

  /* ================= TOP UTILITY BAR ================= */
  .ahca-header{
    height:var(--top-h);
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:24px;
    padding:18px 0px;
    background:#ffffff;
    border-bottom:1px solid var(--border);
    width:100%;
  }

  .ahca-logo{ display:flex; align-items:center; gap:12px; text-decoration:none; height:56px; }
  .ahca-logo svg{ width:56px; height:56px; flex:0 0 56px; display:block; }
  .ahca-logo-text{ display:flex; flex-direction:column; justify-content:center; line-height:1.05; white-space:nowrap; }
  .ahca-logo-text .brand{ font-size:22px; font-weight:800; color:var(--navy); letter-spacing:.2px; }
  .ahca-logo-text .sub{ font-size:15px; font-weight:700; color:var(--teal); margin-top:1px; }
  .ahca-logo-text .tagline{ font-size:11px; font-weight:700; font-style:italic; color:var(--red); margin-top:3px; }

  .ahca-nav{ display:flex; align-items:center; gap:36px; flex:0 0 auto; }

  .aca-language-switcher{
    display:flex; align-items:center; height:36px; min-width:90px;
    padding:0px; border:1px solid var(--border); border-radius:18px;
    background:#fff; position:relative; font-size:14px;
  }
.aca-language-switcher .wpml-ls-legacy-dropdown-click {margin-right: 0; }
  .aca-language-switcher ul,
  .aca-language-switcher .wpml-ls-legacy-list-horizontal,
  .aca-language-switcher .wpml-ls-legacy-dropdown{
    display:flex; align-items:center; list-style:none; height:100%; border:none; padding:0; background:transparent;
  }
  .aca-language-switcher a{ display:flex; align-items:center; gap:6px; color:var(--navy); text-decoration:none; font-weight:500; white-space:nowrap; }
  .aca-language-switcher img{ width:16px; height:16px; flex:0 0 16px; display:block; }

  .ahca-link{ display:flex; align-items:center; gap:8px; height:36px; text-decoration:none; color:#000; font-size: 16px; font-weight: 400; line-height: 19px; white-space:nowrap; }
  .ahca-link svg{ flex:0 0 auto; display:block; }
  .ahca-link.customer-login{font-size: 16px; font-weight: 400; line-height: 19px; color:#000;}
  .ahca-link.customer-login svg{ width:18px; height:18px; }
  .ahca-link.group-login svg{ width:22px; height:16px; }

  .ahca-phone{display:flex; align-items:center; gap:8px; color:#000; font-size: 16px; font-weight: 400; line-height: 19px; text-decoration:none; white-space:nowrap; }
  .ahca-phone svg{ width:18px; height:18px; flex:0 0 18px; }

  /* Mobile-only controls, hidden on desktop up front (no load-time swap) */
  .ahca-burger{
    display:none!important;
    width:40px; height:40px; flex:0 0 40px;
    border:1px solid var(--border); border-radius:8px; background:#fff;
    align-items:center; justify-content:center; cursor:pointer;
  }
  .ahca-burger svg{ width:20px; height:20px; display:block; }
  .ahca-burger .icon-close{ display:none; }
  .ahca-burger[aria-expanded="true"] .icon-burger{ display:none; }
  .ahca-burger[aria-expanded="true"] .icon-close{ display:block; }

  /* ================= MAIN NAV (desktop) ================= */
  .ahca-mainnav{
    height:var(--nav-h);
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding: 14px 0px;
    background:#fff;
    border-bottom:1px solid var(--border);
    width:100%;
	border-top:1px solid #00000011 !important;
  }
  .ahca-menu{ display:flex; align-items:center; gap:23px; height:100%; list-style:none; }
  .ahca-menu > li{ height:100%; display:flex; align-items:center; position:relative; }
  .ahca-menu > li > a,
  .ahca-menu > li > button{
    display:flex; align-items:center; gap:6px; height:100%;
    background:none; border:none; cursor:pointer;
    font-size:15px; font-weight:600; color:var(--navy); text-decoration:none; font-family:inherit;
  }
  .ahca-menu > li.is-active > a,
  .ahca-menu > li.is-active > button{ color:var(--red); }
  .ahca-menu .chev{ width:9px; height:6px; flex:0 0 9px; transition:transform .15s ease; }
  .ahca-menu > li[aria-expanded="true"] .chev{ transform:rotate(180deg); }

  .ahca-register{
    display:inline-flex; align-items:center; justify-content:center;
    height:38px; padding:0 22px; border-radius:19px;
    background:var(--red); color:#fff; font-size:14px; font-weight:700;
    text-decoration:none; white-space:nowrap; flex:0 0 auto;
  }

  /* Mega dropdown: absolutely positioned overlay — opening/closing this
     never changes document height, so it cannot trigger CLS. */
  .ahca-megamenu{
    position:absolute;
    top:100%; left:0;
    min-width:560px;
    background:#fff;
    border:1px solid var(--border);
    border-top:3px solid var(--teal);
    box-shadow:0 12px 24px rgba(20,40,60,.12);
    padding:18px 24px;
    display:none;
    grid-template-columns:1fr 1fr;
    column-gap:32px;
    z-index:40;
  }
  .ahca-menu > li[aria-expanded="true"] .ahca-megamenu{ display:grid; }
  .ahca-megamenu a{
    display:flex; align-items:center; justify-content:space-between;
    padding:12px 4px; text-decoration:none; color:var(--navy);
    font-size:14.5px; font-weight:500; border-bottom:1px solid #eef1f4;
  }
  .ahca-megamenu a svg{ width:14px; height:14px; flex:0 0 14px; opacity:.5; }

  /* ================= MOBILE OFF-CANVAS PANEL ================= */
  /* Fixed position overlay: shown/hidden with a class, never part of
     normal document flow, so toggling it cannot shift page content. */
  .ahca-mobilepanel{
    position:fixed;
    inset:0;
    top:var(--top-h);
    background:#fff;
    z-index:50;
    overflow-y:auto;
    transform:translateX(100%);
    transition:transform .2s ease;
    display:none;
  }
  .ahca-mobilepanel.is-open{ transform:translateX(0); }

  .ahca-mlink{
    display:flex; align-items:center; gap:14px;
    padding:16px 20px; border-bottom:1px solid #eef1f4;
    text-decoration:none; color:var(--navy-2); font-size:16px; font-weight:600;
    background:none; border-left:none; border-right:none; border-top:none;
    width:100%; text-align:left; font-family:inherit; cursor:pointer;
  }
  .ahca-mlink svg{ width:20px; height:20px; flex:0 0 20px; color:var(--navy); }
  .ahca-mlink .chev{ width:11px; height:7px; margin-left:auto; flex:0 0 11px; transition:transform .15s ease; }
  .ahca-mlink[aria-expanded="true"] .chev{ transform:rotate(180deg); }

  .ahca-msub{
    display:none;
    list-style:none;
    background:#fafbfc;
  }
  .ahca-mlink[aria-expanded="true"] + .ahca-msub{ display:block; }
  .ahca-msub li a{
    display:block; padding:14px 20px 14px 54px;
    text-decoration:none; color:var(--navy); font-size:14.5px;
    border-bottom:1px solid #eef1f4;
  }

/* Normal header */ .ahca-sticky-header { width: 100%; background: #fff; z-index: 99999; } /* Sticky state - ONLY change positioning */ .ahca-sticky-header.sticky_header { position: fixed; top: 0; left: 0; right: 0; width: 100%; background: #fff; z-index: 99999; } /* Keep the header content exactly the same width */ .ahca-sticky-header .ahca-header, .ahca-sticky-header .navbar-main { width: 100%; max-width: 1140px; margin-left: auto; margin-right: auto; box-sizing: border-box; } /* Keep nav container from changing dimensions */ .ahca-sticky-header .nav-container { width: 100%; max-width: 1140px; margin-left: auto; margin-right: auto; box-sizing: border-box; }

		  /* ================= RESPONSIVE ================= */
@media (max-width: 1200px) {
.ahca-link.customer-login, .ahca-link, .ahca-phone {font-size: 13px !important;}
.ahca-nav {gap: 53px; padding-right: 10px;}
 .ahca-sticky-header .ahca-header, .ahca-sticky-header .navbar-main, .ahca-sticky-header .nav-container { width: 100%; max-width: 100%; } 
}
@media (max-width: 1024px) { .ahca-sticky-header.sticky_header { position: static !important; top: auto; left: auto; right: auto; } .ahca-nav {gap: 20px;}}
@media (min-width: 768px) {

    #header-bar-main {
        height: 66px !important;
        min-height: 66px !important;
        max-height: 66px !important;
        padding: 0 !important;
        margin: 0 !important;
        box-sizing: border-box !important;
        overflow: visible !important;
    }

    #header-bar-main > .elementor-widget-html {
        width: 100% !important;
        height: 66px !important;
        min-height: 66px !important;
        margin: 0 !important;
        padding: 0 !important;
    }

    #header-bar-main .navbar-main,
    #header-bar-main .nav-container,
    #header-bar-main .navbar {
        width: 100%; max-width: 1140px;
        height: 66px;
        min-height: 66px;
        margin: 0 auto;
        padding: 0;
        box-sizing: border-box;
    }

	.header-mini-links .wp-image-16 {width:14px!important; height:17px!important;}
	.header-mini-links .wp-image-17 {width:20px!important; height:17px!important;}
	.header-mini-links .wp-image-15{width:17px!important; height:19px!important;}

}

.leading-provider-v2-sevtion .show-view img {
    width: 70px;
    height: 70px;
	flex: 0 0 70px;
}
  @media (max-width:767px){
    .ahca-header{ padding:0 16px; }
    .ahca-nav{gap:14px; padding-right:30px;}
    .ahca-link, .ahca-phone{ display:none; } /* moved into mobile panel instead */
    .ahca-burger{ display:flex; }
    .ahca-mainnav{ display:none; } /* replaced entirely by the off-canvas panel */
    .ahca-mobilepanel{ display:block;}
	 .ahca-wrap .hamburger { top: -46px; }
	  }
@media (max-width: 767px) {
	 #header-bar-main .navbar-main, .ahca-wrap .navbar-main{height: 0px!important; min-height: 0px!important; max-height: 0px!important;}
    .leading-provider-v2-sevtion .show-view {
        display: none !important;
    }
	.ahca-logo-text .sub, .ahca-logo-text .tagline{ display:none; }
    :root{ --top-h:72px; }
    .ahca-logo svg{ width:44px; height:44px; flex-basis:44px;}
	.ahca-logo img{width:104px!important; height:auto!important;}
}
</style><style id="original-header-tokens">@media (min-width:768px){:root{--top-h:92px;--nav-h:66px}}</style>

	
