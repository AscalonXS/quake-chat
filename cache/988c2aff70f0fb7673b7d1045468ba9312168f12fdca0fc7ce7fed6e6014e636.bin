.banner1{background: #125b91; text-align:center;padding: 26px 30px 0;}
.banner1 .banner-txt,.banner4 .banner-txt{margin: 0 auto;}
.banner1 .banner-txt p{margin-top: 10px; line-height:normal;}
.banner4{padding: 20px 20px 0; }
.banner4 .banner-txt h3{font-size: 20px;}
.banner4 .banner-txt p{font-size: 14px;}
.banner5.banner3 .banner-txt p{font-size: 10px;}
.banner5.banner3 .banner-txt h3{font-size: 13px;color: #0c4b78;}
.bls-services a.elementor-button,.mob-lg-btn a.elementor-button{display:block;}
	.bls-services .old-price{font-size: 14px!important; color: #767676!important;}
.bls-services .sm-red-txt{font-size: 12px;line-height: 16px;}
.virtual-banner-269.bls-banner sup{font-size: 16px;line-height: 24px;}
.webp .main-banner-one.virtual-banner.bls-banner .virtual-banner-right-col .elementor-button {padding: 6px 40px!important; border-radius:4px;} .webp .main-banner-one.virtual-banner.bls-banner .elementor-button{padding-top:6px!important; padding-bottom:6px!important;} .cta-banner-cprfac a {padding: 6px 24px;}
.smmob-txt{font-size:12px!important; font-weight:400!important; vertical-align: text-bottom!important; padding-right: 2px!important;}
.all-course-option1-boxes.testnew .elementor-inner-section{padding: 8px;}
.all-course-option1-boxes.testnew .first-col>.elementor-widget-wrap{padding: 0 6px 0!important; margin-bottom: 16px!important;}	
.all-course-option1-boxes.testnew .offer-txt .elementor-widget-container{margin: 0!important; font-size: 10px; font-weight: 500; line-height: 20px; padding: 2.4px 5px!important;}
.all-course-option1-boxes.testnew h3.elementor-heading-title{margin-bottom: 0;}
.all-course-option1-boxes.testnew .price{line-height: normal!important; margin-bottom: 8px!important;}
.all-course-option1-boxes.testnew .offer-txt.cutting-white:after{bottom: auto; top: -4px; left: 47px;}
.all-course-option1-boxes.testnew .credit-hours-link{text-align: left;}
.all-course-option1-boxes.all-course-option2-boxes.testnew .start-course-btn a{margin-top: 8px;font-size: 12px!important;padding: 8px!important;color: #fff!important;background-color: #B51D1A!important; border: 1px solid #B51D1A!important;}
.all-course-option1-boxes.testnew .view-course-demo-btn a{	margin: 8px auto;}
.all-course-option1-boxes.testnew .title-bot.one-line{min-height: auto;}
.all-course-option1-boxes.testnew .old-price{color: #767676!important;}
.all-course-option2-boxes.testnew span.off-price{color: #9DC843;}
.all-course-option1-boxes.testnew .title-bot{margin-bottom: 8px!important;}
.all-course-option1-boxes.testnew .price .elementor-widget-container{margin-bottom: 0;}
.all-course-option1-boxes.testnew .credit-hours-link a{margin-top: 8px; display:block;}
.brk-new{display:block;}
.all-course-option1-boxes.testnew .credit-hours-link.no-txt{min-height: 24px;}
.abs-first-aid-course .elementor-column-gap-default>.elementor-column>.elementor-element-populated{padding: 0;}
.mob-overviwe-table{display:block;}
.dt-overviwe-table{display:none;}
.abs-first-aid-course .text-left{width: 100%;}
.abs-first-aid-course .col-right{width: 100%;}
.abs-first-aid-course h1, .abs-first-aid-course h2{margin-bottom:8px;}
.table-section,.devider-section{margin-bottom:16px!important;}
.abs-first-aid-course .elementor-widget:not(:last-child){margin-block-end: 0;}
.bls-banner .virtual-banner-right-col{margin-top: 0;}
.mob-banner.bls-new-banner,.mob-banner-bg,.mob-banner.bls-banner{background:url("/wp-content/uploads/2023/11/Bls-mob-banner.jpg") no-repeat!important; background-position:top center!important;background-size: cover!important;}
.reducedhome-banner.mob-banner-bg{background:url("/wp-content/uploads/2023/12/Mob-hero-img-bg.png") no-repeat!important; background-position:top center!important;background-size: cover!important;}
.webp .reducedhome-banner.mob-banner-bg{background:url("/wp-content/uploads/2023/12/Mob-hero-img-bg-1.webp") no-repeat!important; background-position:top center!important;background-size: cover!important;}
.in-person-vid-slider .elementor-swiper-button svg {background:none!important; border:none!important; fill:#9DC843!important;}
.in-person-vid-slider .elementor-swiper-button{top:105%!important}
.in-person-vid-slider .elementor-swiper-button-prev{left:40%!important;}
.in-person-vid-slider .elementor-swiper-button-next{right:40%!important;}
.aioseo-breadcrumb, .aioseo-breadcrumb a{font-size: 12px!important;}
.mob-contnt, .brk{display:block;}
.dt-contnt{display:none;} 
.course-content-container-main h2.elementor-heading-title{font-size: 24px; line-height: 30px;}
.course-content-container-main h3.elementor-heading-title{font-size: 22px; line-height: 28px;}
.course-content-container-main{font-size: 14px; line-height: 20px;}
.elementor-column-gap-wider>.elementor-column.course-content-container-main>.elementor-element-populated{padding: 0!important;}
.dt-hide-plus{display:inline!important;}
.mob-hide-plus{display:none!important;}
.reduce-approval .wpm-search-form form .wpmselectbox, .wpm-search-form form .wpmselectbox{width: 48%; display: inline-block;}
.money-back-sec{background-color:#fff!important;}
.money-back-sec p{color:#000;}
.money-back-sec-img{max-width:230px; max-height:132px; margin: 0 auto;}
.search-approval-br span strong br{display:block;}
.google-slide.reducedhome .reviews-slider .slick-prev:before{display:none;}
.google-slide.reducedhome .reviews-slider .slick-prev{width:24px; height:24px; background:url("/wp-content/uploads/2023/12/Left-arrow.png")no-repeat;}
.google-slide.reducedhome .reviews-slider .slick-next:before{display:none;}
.google-slide.reducedhome .reviews-slider .slick-next{width:24px; height:24px; background:url("/wp-content/uploads/2023/12/Right-arrow.png")no-repeat;}
.reduce-approval.reducedhome .wpm-search-form form input{height: 42px; font-size:14px;}
.reducedhome-hrs-list .elementor-icon-list-text{display: flex;}
.reducedhome-hrs-list .hours-txt{margin-right: 24px;min-width: 110px;}
.healthcare-industries-bg:after,.why-become-bg:after,.why-choose-bg:after{ display:none;}
.faqs-acls.reducedhome .elementor-tab-title{border: 1px solid #D5D8DC!important;}
.faqs-acls.reducedhome .elementor-tab-content{padding: 16px 10px!important; border-right: 1px solid #D5D8DC!important; border-left: 1px solid #D5D8DC!important;}
.post-slider.reducedhome .wb_ps_single_item{height: auto!important;}
.all-course-option1-menu #menu-item-90666 ul.sub-menu{width:auto!important;}
.all-course-option1-menu #menu-item-90666 ul.sub-menu li.menu-item{width: 100% !important;}
.all-course-option1-menu ul.sub-menu li.menu-item:last-child{border-bottom:none!important;}
.all-course-option1-menu.menuv2 ul.sub-menu{display: block;position: relative;top: auto !important;left: auto !important;visibility: visible !important;opacity: 1 !important;height: auto !important;}
.all-course-option1-menu.menuv2 ul.sub-menu a br{display:none;}
.all-course-option1-menu.menuv2 li.menu-item.reg-btn{padding: 8px !important;}
.all-course-option1-menu.menuv2 li.menu-item.reg-btn a.hfe-menu-item{font-size: 14px!important;color: #F6F9FD!important;line-height: 20px;background: #B51D1A!important;border-radius: 4px;display: block;padding: 10px 25px!important;text-align: center;}
.all-course-option1-menu.menuv2 li.menu-item.reg-btn a.hfe-menu-item:hover{background: #000!important;}
.all-course-option1-menu.menuv2 li.menu-item.menu-item-has-children{padding: 25px 20px 0 50px !important;}
