<!-- Pipedrive LeadBooster chat -->
<script>
(function () {

    function getCentralMinutes() {

        const parts = new Intl.DateTimeFormat('en-US', {
            timeZone: 'America/Chicago',
            hour: 'numeric',
            minute: 'numeric',
            hour12: false
        }).formatToParts(new Date());

        let hour = 0;
        let minute = 0;

        parts.forEach(function (part) {

            if (part.type === 'hour') {
                hour = parseInt(part.value, 10);
            }

            if (part.type === 'minute') {
                minute = parseInt(part.value, 10);
            }

        });

        return (hour * 60) + minute;
    }


    function isPipedriveHours() {

        const currentMinutes = getCentralMinutes();

        /*
         * TEST:
         * 2:00 AM - 5:00 PM
         *
         * Change 120 back to 420
         * when testing is complete.
         */

        return (
            currentMinutes >= 420 &&
            currentMinutes < 1020
        );
    }


    function loadPipedrive() {

        // Already loaded
        if (window.__sparkPipedriveLoaded) {
            return;
        }

        window.__sparkPipedriveLoaded = true;


        window.pipedriveLeadboosterConfig = {
            base: 'leadbooster-chat.pipedrive.com',
            companyId: 11076153,
            playbookUuid: '453a7a31-e28e-4bcc-8258-4d2fc58f041c',
            version: 2
        };


        if (!window.LeadBooster) {

            window.LeadBooster = {
                q: [],

                on: function (n, h) {
                    this.q.push({
                        t: 'o',
                        n: n,
                        h: h
                    });
                },

                trigger: function (n) {
                    this.q.push({
                        t: 't',
                        n: n
                    });
                }
            };

        }


        var script = document.createElement('script');

        script.src =
            'https://leadbooster-chat.pipedrive.com/assets/loader.js';

        script.async = true;

        document.head.appendChild(script);
    }


    function updateChat() {

        const pipedriveHours = isPipedriveHours();


        if (pipedriveHours) {

            /*
             * =================================
             * PIPEDRIVE HOURS
             * =================================
             */

            document.documentElement.classList.add('pipedrive-hours');
            document.documentElement.classList.remove('spark-hours');


            // Hide Spark
            const sparkLauncher =
                document.querySelector('.spark-chatbot-launcher');

            const sparkWindow =
                document.querySelector('.spark-chatbot-window');
			
			const sparkchatbotteaser =
                document.querySelector('.spark-chatbot-teaser');
			


            if (sparkLauncher) {
                sparkLauncher.style.setProperty(
                    'display',
                    'none',
                    'important'
                );
            }

            if (sparkWindow) {
                sparkWindow.style.setProperty(
                    'display',
                    'none',
                    'important'
                );
            }
			  if (sparkchatbotteaser) {
                sparkchatbotteaser.style.setProperty(
                    'display',
                    'none',
                    'important'
                );
            }
			


            // Load Pipedrive
            loadPipedrive();


        } else {

            /*
             * =================================
             * SPARK HOURS
             * =================================
             */

            document.documentElement.classList.remove('pipedrive-hours');
            document.documentElement.classList.add('spark-hours');


            // Show Spark
            const sparkLauncher =
                document.querySelector('.spark-chatbot-launcher');

            const sparkWindow =
                document.querySelector('.spark-chatbot-window');
			
			const sparkchatbotteaser =
                document.querySelector('.spark-chatbot-teaser');


            if (sparkLauncher) {
                sparkLauncher.style.removeProperty('display');
            }

            if (sparkWindow) {
                sparkWindow.style.removeProperty('display');
            }
if (sparkchatbotteaser) {
                sparkchatbotteaser.style.removeProperty('display');
            }

            // Hide Pipedrive if it exists
            const pipedrive =
                document.querySelector('#LeadboosterContainer');

            if (pipedrive) {
                pipedrive.style.setProperty(
                    'display',
                    'none',
                    'important'
                );
            }

        }

    }


    /*
     * Run immediately.
     */
    updateChat();


    /*
     * Check every 10 seconds.
     *
     * This means you don't need to refresh
     * the page when testing.
     */
    setInterval(updateChat, 10000);


    /*
     * Spark may be created dynamically by
     * its plugin. Watch for it and apply
     * the correct visibility.
     */
    const observer = new MutationObserver(function () {

        updateChat();

    });


    observer.observe(document.documentElement, {
        childList: true,
        subtree: true
    });


})();
</script>
