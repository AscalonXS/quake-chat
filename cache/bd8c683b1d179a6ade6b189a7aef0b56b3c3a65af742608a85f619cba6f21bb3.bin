/>
<noscript>
<img
src="https://www.verywellhealth.com/thmb/x7HhGW8WZuipNQviKVjbJ9bnLZs=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/GettyImages-912082062-5c021fc446e0fb0001febdff.jpg"
width="2121"
height="1414"
class="img--noscript mntl-image mntl-image universal-image__image"
