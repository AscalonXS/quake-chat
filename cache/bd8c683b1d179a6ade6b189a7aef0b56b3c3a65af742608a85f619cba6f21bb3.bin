<span class="newsletter-signup-vue__header"
v-show="!success">Daily Health Tips to Your Inbox</span>
<p class="newsletter-signup-vue__subheader" v-show="!success"></p>
<div class="newsletter-signup-vue__wrapper">
<label class="newsletter-signup-vue__input-label" for="footer-newsletter_1-0-email" v-show="!success">Email Address</label>
<div class="newsletter-signup-vue__input-wrapper input-group" v-show="!success">
<input type="email"
id="footer-newsletter_1-0-email"
v-model="form.email"
name="email"
placeholder="Enter your email"
class="mntl-newsletter-submit__input mntl-newsletter-submit__button newsletter-signup-vue__input"
required
@keyup="resetError"
aria-label="Enter your email"
/>
<button class="btn newsletter-signup-vue__button" type="submit" :disabled="false">Sign Up</button>
</div>
<span class="newsletter-signup-vue__header newsletter-signup-vue__header--success"
v-show="success"
>You're in!</span>
<p class="success-message" v-show="success">Thank you, {{form.email}}, for signing up.</p>
<p class="error-message" v-show="error">There was an error. Please try again.</p>
</div>
</form>
</newsletter>
</div>
