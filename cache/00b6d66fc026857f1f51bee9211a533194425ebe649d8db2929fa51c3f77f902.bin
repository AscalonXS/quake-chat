":"https://www.healthline.com/health/video/ways-to-manage-afib-symptoms-daily"},{"toolName":"Heart Health","videoID":"hKGE-8jTRCU","articleURL":"https://www.healthline.com/health/atrial-fibrillation/manage-symptoms"},{"toolName":"Heart Health","videoID":"hKGE-8jTRCU","articleURL":"https://www.healthline.com/health/living-with-atrial-fibrillation"},{"toolName":"Heart Health","videoID":"hKGE-8jTRCU","articleURL":"https://www.healthline.com/health/treatment-options-afib"},{"toolName":"Digestive Health","videoID":"fSB3XEsX9GE","articleURL":"https://www.healthline.com/health/video/colonoscopies-explained-dr-sethi-on-your-colon-cancer-screening"},{"toolName":"Digestive Health","videoID":"fSB3XEsX9GE","articleURL":"https://www.healthline.com/health/colonoscopy"},{"toolName":"Digestive Health","videoID":"fSB3XEsX9GE","articleURL":"https://www.healthline.com/health/crohns-disease/crohns-disease-colonoscopy-images"},{"toolName":"Digestive Health","videoID":"fSB3XEsX9GE","articleURL":"https://www.healthline.com/health/cancer/does-a-colonoscopy-check-for-prostate-cancer"},{"toolName":"Psoriasis","videoID":"49gAF_SUmUE","articleURL":"https://www.healthline.com/health/video/the-right-way-to-apply-topical-psoriasis-medication"},{"toolName":"Psoriasis","videoID":"49gAF_SUmUE","articleURL":"https://www.healthline.com/health/psoriasis/over-the-counter-psoriasis-treatment"},{"toolName":"Digestive Health","videoID":"XuIrKuUSdyI","articleURL":"https://www.healthline.com/health/video/the-gut-and-brain-connection-dr-sethi-explains"},{"toolName":"Digestive Health","videoID":"XuIrKuUSdyI","articleURL":"https://www.healthline.com/health/ibs-and-brain-fog"},{"toolName":"Digestive Health","videoID":"XuIrKuUSdyI","articleURL":"https://www.healthline.com/nutrition/gut-microbiome-and-health"},{"toolName":"Digestive Health","videoID":"XuIrKuUSdyI","articleURL":"https://www.healthline.com/health/irritable-bowel-syndrome/serotonin-effects"},{"toolName":"Digestive Health","videoID":"XuIrKuUSdyI","articleURL":"https://www.healthline.com/health/video/whats-the-scientific-link-between-your-gut-and-brain"},{"toolName":"Digestive Health","videoID":"ch2vU-c0r1s","articleURL":"https://www.healthline.com/health/video/the-surprising-truth-about-prebiotics-vs-probiotics"},{"toolName":"Digestive Health","videoID":"ch2vU-c0r1s","articleURL":"https://www.healthline.com/health/prebiotics-vs-probiotics"},{"toolName":"Digestive Health","videoID":"ch2vU-c0r1s","articleURL":"https://www.healthline.com/nutrition/prebiotics-benefits"},{"toolName":"Psoriasis","videoID":"fx7R45wOB-I","articleURL":"https://www.healthline.com/health/video/what-every-psoriasis-patient-needs-to-know-about-flares-and-stress"},{"toolName":"Digestive Health","videoID":"a0S9BIu_aFk","articleURL":"https://www.healthline.com/health/video/what-really-happens-when-you-try-a-colon-cleanse-dr-sethi-answers"},{"toolName":"Heart Health","videoID":"mxaokoa7Nrw","articleURL":"https://www.healthline.com/health/video/what-happens-to-your-body-with-high-blood-pressure"},{"toolName":"Psoriasis","videoID":"fx7R45wOB-I","articleURL":"https://www.healthline.com/health/psoriasis/stress-psoriasis-connection"},{"toolName":"Digestive Health","videoID":"a0S9BIu_aFk","articleURL":"https://www.healthline.com/health/natural-colon-cleanse"},{"toolName":"Digestive Health","videoID":"a0S9BIu_aFk","articleURL":"https://www.healthline.com/nutrition/detox-diets-101"},{"toolName":"Digestive Health","videoID":"F8lJDJ8GyWQ","articleURL":"https://www.healthline.com/nutrition/how-much-sugar-per-day#safe-amounts"},{"toolName":"Digestive Health","videoID":"F8lJDJ8GyWQ","articleURL":"https://www.healthline.com/nutrition/30-days-no-sugar"},{"toolName":"Digestive Health","videoID":"F8lJDJ8GyWQ","articleURL":"https://www.healthline.com/health/food-nutrition/no-sugar-diet"},{"toolName":"Heart Health","videoID":"mxaokoa7Nrw","articleURL":"https://www.healthline.com/health/what-considered-high-blood-pressure"},{"toolName":"Heart Health","videoID":"mxaokoa7Nrw","articleURL":"https://www.healthline.com/health/high-blood-pressure-hypertension/effect-on-body"},{"toolName":"Heart Health","videoID":"mxaokoa7Nrw","articleURL":"https://www.healthline.com/health/high-blood-pressure-hypertension-treatment"},{"toolName":"Heart Health","videoID":"mxaokoa7Nrw","articleURL":"https://www.healthline.com/health/video/what-happens-to-your-body-with-high-blood-pressure"},{"toolName":"Heart Health","videoID":"96yXZ1a5w1A","articleURL":"https://www.healthline.com/health/heart-disease#types-of-heart-disease"},{"toolName":"Heart Health","videoID":"96yXZ1a5w1A","articleURL":"https://www.healthline.com/health/hypertensive-heart-disease"},{"toolName":"Heart Health","videoID":"96yXZ1a5w1A","articleURL":"https://www.healthline.com/health/video/whats-the-real-difference-between-hypertension-and-heart-disease"},{"toolName":"Digestive Health","videoID":"DNTl4czTf8E","articleURL":"https://www.healthline.com/health/video/unlock-the-power-of-fermented-foods-for-optimal-gut-health"},{"toolName":"Digestive Health","videoID":"DNTl4czTf8E","articleURL":"www.healthline.com/nutrition/8-fermented-foods"},{"toolName":"Digestive Health","videoID":"DNTl4czTf8E","articleURL":"www.healthline.com/nutrition/fermentation"},{"toolName":"Digestive Health","videoID":"TIRaCgGNCKI","articleURL":"www.healthline.com/nutrition/ways-to-improve-digestion"},{"toolName":"Digestive Health","videoID":"TIRaCgGNCKI","articleURL":"https://www.healthline.com/nutrition/8-things-that-harm-gut-bacteria"},{"toolName":"Digestive Health","videoID":"TIRaCgGNCKI","articleURL":"www.healthline.com/health/digestive-health/reducing-inflammation-gut-health"},{"toolName":"Digestive Health","videoID":"TIRaCgGNCKI","articleURL":"https://www.healthline.com/health/video/unhealthy-gut-dr-sethi-has-answers"},{"toolName":"Digestive Health","videoID":"gIiZ9Ss8opg","articleURL":"https://www.healthline.com/health/anxiety-diarrhea"},{"toolName":"Digestive Health","videoID":"gIiZ9Ss8opg","articleURL":"https://www.healthline.com/health/nervous-stomach"},{"toolName":"Digestive Health","videoID":"gIiZ9Ss8opg","articleURL":"https://www.healthline.com/health/mental-health/is-anxiety-making-you-poop-heres-how-to-soothe"},{"toolName":"Digestive Health","videoID":"gIiZ9Ss8opg","articleURL":"https://www.healthline.com/health/video/hidden-connection-between-stress-and-your-gut"},{"toolName":"Heart Health","videoID":"hKGE-8jTRCU","articleURL":"https://www.healthline.com/health/video/ways-to-manage-afib-symptoms-daily"},{"toolName":"Heart Health","videoID":"3UCSvMnJZV4","articleURL":"www.healthline.com/health/cholesterol-and-heart-disease"},{"toolName":"Heart Health","videoID":"3UCSvMnJZV4","articleURL":"https://www.healthline.com/health/foods-for-the-heart"},{"toolName":"Heart Health","videoID":"3UCSvMnJZV4","articleURL":"https://www.healthline.com/health/video/how-to-prevent-heart-disease-according-to-a-cardiologist"},{"toolName":"Menopause","videoID":"5ko28l_HTNI","articleURL":"www.healthline.com/nutrition/11-natural-menopause-tips"},{"toolName":"Menopause","videoID":"5ko28l_HTNI","articleURL":"https://www.healthline.com/nutrition/menopause-weight-gain"},{"toolName":"Menopause","videoID":"5ko28l_HTNI","articleURL":"www.healthline.com/health/womens-health/low-estrogen-symptoms"},{"toolName":"Menopause","videoID":"5ko28l_HTNI","articleURL":"https://www.healthline.com/health/video/what-to-know-about-menopause-and-weight-gain"},{"toolName":"Menopause","videoID":"TT_TPyD5i58","articleURL":"https://www.healthline.com/health/video/can-anti-inflammatory-foods-ease-menopause-joint-pain"}]}}}}]},{"id":"what-not-to-do","title":"What not to do","isCollapsable":false,"listicleSection":false,"qaQuestion":false,"header":["What not to do"],"body":[{"tagName":"p","source":"There are also some \u003ca href=\"https://www.mountsinai.org/health-library/injury/unconsciousness-first-aid\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"content-link css-1h9c35y\"\u003ethings to avoid\u003c/a\u003e when administering first aid:"},{"tagName":"ul","source":"\u003cli\u003eDo not put a cushion under an unconscious person’s head, as it may disrupt their breathing.\u003c/li\u003e\u003cli\u003eDo not try to get them to sit up.\u003c/li\u003e\u003cli\u003eDo not splash an unconscious person with water.\u003c/li\u003e\u003cli\u003eDo not slap them.\u003c/li\u003e\u003cli\u003eDo not try to get them to drink water or any other liquid.\u003c/li\u003e\u003cli\u003eDo not try to grab or sweep away anything lodged in the throat that is not visible. This can cause it to become lodged deeper.\u003c/li\u003e\u003cli\u003eDo not leave an unconscious person unattended.\u003c/li\u003e"}]},{"id":"when-to-seek-help","title":"When to seek help","isCollapsable":false,"listicleSection":false,"qaQuestion":false,"header":["When to seek emergency help"],"body":[{"tagName":"p","source":"Contact emergency services immediately if someone is unconscious. If the person is not breathing, begin CPR \u003chl-trusted-source source=\"PubMed Central\" rationale=\"Highly respected database from the National Institutes of Health\"\u003e\u003ca href=\"https://www.ncbi.nlm.nih.gov/books/NBK469741/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"content-link css-1h9c35y\"\u003eonly after\u003c/a\u003e\u003c/hl-trusted-source\u003e calling for help. \u003cbr\u003e\u003cbr\u003eIt is \u003ca href=\"https://ufhealth.org/unconsciousness-first-aid\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"content-link css-1h9c35y\"\u003eespecially important\u003c/a\u003e to seek help before performing CPR if the person:"},{"tagName":"ul","source":"\u003cli\u003ehas lost bladder or bowel control\u003c/li\u003e\u003cli\u003eis having a seizure or fit\u003c/li\u003e\u003cli\u003ehas no pulse\u003c/li\u003e\u003cli\u003ehas \u003ca class=\"content-link css-1h9c35y keywords\" title=\"What is Diabetes?\" href=\"https://www.medicalnewstoday.com/info/diabetes/\"\u003ediabetes\u003c/a\u003e\u003c/li\u003e\u003cli\u003eis pregnant\u003c/li\u003e"},{"tagName":"p","source":"If the person regains consciousness, check for other signs of a serious problem, such as:"},{"tagName":"ul","source":"\u003cli\u003etrouble speaking or seeing\u003c/li\u003e\u003cli\u003ereduced ability to move the arms or legs\u003c/li\u003e\u003cli\u003ean irregular heartbeat\u003c/li\u003e\u003cli\u003echest pain\u003c/li\u003e"},{"tagName":"p","source":"Make sure the emergency medical staff are aware of these issues."}]},{"id":"causes","title":"Causes","isCollapsable":false,"listicleSection":false,"qaQuestion":false,"header":["Causes of unconsciousness"],"body":[{"tagName":"p","source":"Many circumstances can \u003ca href=\"https://ufhealth.org/unconsciousness-first-aid\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"content-link css-1h9c35y\"\u003elead to\u003c/a\u003e unconsciousness, including major traumatic events and injuries. \u003cbr\u003e\u003cbr\u003eSome causes include:"},{"tagName":"ul","source":"\u003cli\u003efalls\u003c/li\u003e\u003cli\u003eserious accidents, such as car crashes\u003c/li\u003e\u003cli\u003every heavy blows to the \u003ca href=\"https://www.medicalnewstoday.com/articles/322225\" class=\"content-link css-1h9c35y\"\u003ehead\u003c/a\u003e or chest\u003c/li\u003e\u003cli\u003esevere blood loss or \u003ca href=\"https://www.medicalnewstoday.com/articles/320322\" class=\"content-link css-1h9c35y\"\u003einternal bleeding\u003c/a\u003e\u003c/li\u003e\u003cli\u003e\u003ca href=\"https://www.medicalnewstoday.com/articles/326349\" class=\"content-link css-1h9c35y\"\u003echoking\u003c/a\u003e\u003c/li\u003e\u003cli\u003e\u003ca href=\"https://www.medicalnewstoday.com/articles/153363\" class=\"content-link css-1h9c35y\"\u003edehydration\u003c/a\u003e\u003c/li\u003e\u003cli\u003e\u003ca href=\"https://www.medicalnewstoday.com/articles/low-blood-sugar-effects-on-body\" class=\"content-link css-1h9c35y\"\u003elow blood sugar\u003c/a\u003e\u003c/li\u003e\u003cli\u003ealcohol or \u003ca class=\"content-link css-1h9c35y keywords\" title=\"Carbon monoxide (CO), the silent killer\" href=\"https://www.medicalnewstoday.com/articles/171876.php\"\u003ecarbon monoxide poisoning\u003c/a\u003e\u003c/li\u003e\u003cli\u003ea drug overdose\u003c/li\u003e"}]},{"id":"stages","title":"Stages","isCollapsable":false,"listicleSection":false,"qaQuestion":false,"header":["Stages of unconsciousness"],"body":[{"tagName":"p","source":"There are \u003ca href=\"https://msktc.org/tbi/factsheets/facts-about-vegetative-and-minimally-conscious-states-after-severe-brain-injury\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"content-link css-1h9c35y\"\u003efive stages\u003c/a\u003e of unconsciousness. "},{"tagName":"ul","source":"\u003cli\u003efull consciousness with some impairment\u003c/li\u003e\u003cli\u003ea minimally conscious state\u003c/li\u003e\u003cli\u003ea confusional state\u003c/li\u003e\u003cli\u003ea vegetative state\u003c/li\u003e\u003cli\u003ea coma\u003c/li\u003e"},{"tagName":"p","source":"People in vegetative states and comas are fully unconscious. People in minimally conscious states may have some level of consciousness that comes and goes. "},{"tagName":"p","source":"People usually enter into vegetative states and comas due to an illness or injury to the brain. People may enter minimally conscious states by fainting or blacking out, and this is usually more temporary."},{"tagName":"p","source":"It is also possible to classify unconsciousness by \u003ca href=\"https://www.firstresponse.org.uk/first-aid-az/3-general/first-aid/113-unconsciousness\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"content-link css-1h9c35y\"\u003ehow long\u003c/a\u003e it lasts and how responsive the person is to their environment. For example, a person may:"},{"tagName":"ul","source":"\u003cli\u003ebe only briefly unconscious after fainting \u003c/li\u003e\u003cli\u003eseem to wake up but be hard to understand\u003c/li\u003e\u003cli\u003enot move or respond for a long time\u003c/li\u003e"}]},{"id":"warning-signs","title":"Warning signs","isCollapsable":false,"listicleSection":false,"qaQuestion":false,"header":["Warning signs of unconsciousness"],"body":[{"tagName":"p","source":"There can be signs that a person is \u003ca href=\"https://ufhealth.org/unconsciousness-first-aid\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"content-link css-1h9c35y\"\u003eabout to become\u003c/a\u003e unconscious, including:"},{"tagName":"ul","source":"\u003cli\u003esuddenly becoming unresponsive\u003c/li\u003e\u003cli\u003ehaving a blank or confused look\u003c/li\u003e\u003cli\u003efeeling lightheaded or \u003ca href=\"https://www.medicalnewstoday.com/articles/325251\" class=\"content-link css-1h9c35y\"\u003edizzy\u003c/a\u003e, or having trouble standing\u003c/li\u003e\u003cli\u003eslurring or mumbling\u003c/li\u003e\u003cli\u003ehaving a slow or rapid heartbeat\u003c/li\u003e\u003cli\u003ebeing unable to speak \u003c/li\u003e\u003cli\u003ehaving \u003ca href=\"https://www.medicalnewstoday.com/articles/324429\" class=\"content-link css-1h9c35y\"\u003edifficulty breathing\u003c/a\u003e\u003c/li\u003e\u003cli\u003ehaving bluish skin\u003c/li\u003e\u003cli\u003elosing bladder or bowel control, which is called \u003ca href=\"https://www.medicalnewstoday.com/articles/165408\" class=\"content-link css-1h9c35y\"\u003eincontinence\u003c/a\u003e\u003c/li\u003e"}]},{"id":"sudden-loss","title":"Sudden loss","isCollapsable":false,"listicleSection":false,"qaQuestion":false,"header":["Sudden loss of consciousness without warning"],"body":[{"tagName":"p","source":"A sudden loss of consciousness without warning can result from \u003ca href=\"https://www.medicalnewstoday.com/articles/182524\" class=\"content-link css-1h9c35y\"\u003efainting\u003c/a\u003e, or syncope. \u003cbr\u003e\u003cbr\u003eNeurally mediated syncope (NMS) is the \u003ca href=\"http://neurologiacroatica.com/hr/pdf/1-2_neuro_2013-1.pdf\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"content-link css-1h9c35y\"\u003emost common\u003c/a\u003e form of fainting. NMS is generally harmless and does not usually require medical treatment."},{"tagName":"p","source":"It happens when the brain does not respond correctly to a trigger, such as seeing blood. NMS can also happen in response to something shocking or unpleasant. This response cuts the flow of oxygen to the brain, and the person passes out."},{"tagName":"p","source":"Some other causes of temporary, sudden unconsciousness include:"},{"tagName":"ul","source":"\u003cli\u003e\u003ca class=\"content-link css-1h9c35y keywords\" title=\"What you should know about dehydration\" href=\"https://www.medicalnewstoday.com/articles/153363.php\"\u003edehydration\u003c/a\u003e\u003c/li\u003e\u003cli\u003elow \u003ca class=\"content-link css-1h9c35y keywords\" title=\"What is a normal blood pressure?\" href=\"https://www.medicalnewstoday.com/articles/270644.php\"\u003eblood pressure\u003c/a\u003e\u003c/li\u003e\u003cli\u003e\u003ca href=\"https://www.medicalnewstoday.com/articles/low-blood-sugar-symptoms\" class=\"content-link css-1h9c35y\"\u003elow blood sugar\u003c/a\u003e\u003c/li\u003e\u003cli\u003eheart problems, such as \u003ca class=\"content-link css-1h9c35y keywords\" title=\"Arrhythmia: Causes, symptoms, types, and treatment\" href=\"https://www.medicalnewstoday.com/articles/8887.php\"\u003earrhythmia\u003c/a\u003e or cardiac syncope\u003c/li\u003e\u003cli\u003e\u003ca href=\"https://www.medicalnewstoday.com/articles/323607\" class=\"content-link css-1h9c35y\"\u003ehyperventilating\u003c/a\u003e, which is very fast breathing\u003c/li\u003e"}]},{"id":"complications","title":"Complications","isCollapsable":false,"listicleSection":false,"qaQuestion":false,"header":["Complications"],"body":[{"tagName":"p","source":"Complications of prolonged unconsciousness can be severe. Lack of oxygen to the brain may result in brain damage, and choking can lead to death if the person does not receive treatment."},{"tagName":"p","source":"Emergency first aid can also cause complications. For instance, CPR \u003ca href=\"http://depts.washington.edu/learncpr/askdoctor.html#What%20if%20I%20crack\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"content-link css-1h9c35y\"\u003ecan cause\u003c/a\u003e fractured ribs."}]},{"id":"prevention","title":"Prevention","isCollapsable":false,"listicleSection":false,"qaQuestion":false,"header":["Prevention"],"body":[{"tagName":"p","source":"To help prevent a loss of consciousness as a result of fainting, doctors \u003ca href=\"https://www.cedars-sinai.org/health-library/diseases-and-conditions/v/vasovagal-syncope.html\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"content-link css-1h9c35y\"\u003ewarn against\u003c/a\u003e spending too much time in hot places. For people feeling lightheaded, nauseous, or overly sweaty, they recommend lying down and elevating the legs. \u003cbr\u003e\u003cbr\u003eGenerally, it can also help to stay hydrated and eat more salt.\u003cbr\u003e\u003cbr\u003eSome people need medication or a pacemaker to prevent a loss of consciousness. Anyone with concerns about this should consult a doctor. "},{"tagName":"p","source":"Preventing a loss of consciousness can also involve getting a diagnosis and treatment for an underlying issue. \u003cbr\u003e\u003cbr\u003eGenerally, having a healthy diet, getting enough exercise, attending screenings and scheduled visits, and receiving prompt medical treatment for any health concerns can help people prevent causes of unconsciousness."}]},{"id":"summary","title":"Summary","isCollapsable":false,"listicleSection":false,"qaQuestion":false,"header":["Summary"],"body":[{"tagName":"p","source":"Administering first aid to an unconscious person can help. It is also crucial that they get professional attention as soon as possible. The best idea is to call emergency services and then proceed with first aid or CPR, if necessary. This may mean fewer complications and a better outlook overall."}]}],"hasAffiliateLinks":false,"affiliates":[],"isDisclaimer":false,"isOwnedAndOperatedPresent":false,"propsFor":{"articleResources":[{"displayLink":"redcross.org/content/dam/redcross/atg/PDFs/Take_a_Class/Adult_Ready_Reference_Card.pdf","link":"https://www.redcross.org/content/dam/redcross/atg/PDFs/Take_a_Class/Adult_Ready_Reference_Card.pdf","title":{"tagName":"span","source":"Adult first aid/CPR/AED ready reference. (n.d.)."}},{"displayLink":"ncbi.nlm.nih.gov/books/NBK469741/","link":"https://www.ncbi.nlm.nih.gov/books/NBK469741/","title":{"tagName":"span","source":"Cardiopulmonary resuscitation (CPR): What you need to know. (2017)."}},{"displayLink":"msktc.org/sites/default/files/TBI-AbtVegMinConscState-508.pdf","link":"https://msktc.org/sites/default/files/TBI-AbtVegMinConscState-508.pdf","title":{"tagName":"span","source":"Facts about the vegetative and minimally conscious states after severe brain injury. (2020)."}},{"displayLink":"depts.washington.edu/learncpr/quickcpr.html","link":"http://depts.washington.edu/learncpr/quickcpr.html","title":{"tagName":"span","source":"Learn CPR. (n.d.).\u0026nbsp;"}},{"displayLink":"redcross.org.uk/first-aid/learn-first-aid/unresponsive-and-breathing","link":"https://www.redcross.org.uk/first-aid/learn-first-aid/unresponsive-and-breathing","title":{"tagName":"span","source":"Learn first aid for someone who is unresponsive and breathing. (n.d.).\u0026nbsp;"}},{"displayLink":"neurologiacroatica.com/hr/pdf/1-2_neuro_2013-1.pdf","link":"http://neurologiacroatica.com/hr/pdf/1-2_neuro_2013-1.pdf","title":{"tagName":"span","source":"Ljilja, A., \u003cem\u003eet al. \u003c/em\u003e(2013). Neurally mediated syncope."}},{"displayLink":"ufhealth.org/","link":"https://ufhealth.org/","title":{"tagName":"span","source":"Unconsciousness \u0026mdash; first aid. (2019)."}},{"displayLink":"mountsinai.org/health-library/injury/unconsciousness-first-aid","link":"https://www.mountsinai.org/health-library/injury/unconsciousness-first-aid","title":{"tagName":"span","source":"Unconsciousness \u0026mdash; first aid. (n.d.)"}},{"displayLink":"firstresponse.org.uk/first-aid-az/3-general/first-aid/113-unconsciousness","link":"https://www.firstresponse.org.uk/first-aid-az/3-general/first-aid/113-unconsciousness","title":{"tagName":"span","source":"Unconsciousness. (n.d.)."}},{"displayLink":"cedars-sinai.org/health-library/diseases-and-conditions/v/vasovagal-syncope.html","link":"https://www.cedars-sinai.org/health-library/diseases-and-conditions/v/vasovagal-syncope.html","title":{"tagName":"span","source":"Vasovagal syncope. (n.d.)"}}],"byline":{"authors":[{"id":934,"name":{"display":"Jon Johnson","first":"Jon","last":"Johnson"},"link":"/authors/jon-johnson","type":{"value":"author","label":"Author"},"nid":"","specialties":[],"guestTitle":"","bio":{"text":"Jon is a writer from California and now floats somewhere on an island in the Mediterranean. He thinks most issues can be solved by petting a good dog, and he spends plenty of time doing so. Time not spent at his desk is probably spent making art or entertaining humans or other animals."},"avatar":{"title":"","width":500,"height":500,"src":"https://post.medicalnewstoday.com/wp-content/uploads/sites/3/2020/06/500x500_Jon_Johnson.png","alt":""}},{"id":5332,"name":{"display":"Alina Sharon","first":"Alina","last":"Sharon"},"link":"/authors/alina-sharon","type":{"value":"author","label":"Author"},"nid":"","specialties":[],"guestTitle":"","bio":{"text":"\u003cp data-pm-slice=\"1 1 []\"\u003eAlina Sharon is a Chicago-based editor for Medical News Today, Healthline, Healthgrades, and HelloMedicare focusing on health, wellness, and Medicare content. She has a master's degree in journalism and has worked as a writer and editor for over 10 years for U.S. and international media. She’s excited to dedicate herself to her passion for creating informative and reliable content that makes it easier for people to navigate their healthcare. Outside of work, she’s also the mom of two rambunctious boys. Connect with her on \u003ca class=\"ProsemirrorEditor-link\" href=\"https://www.linkedin.com/in/adsharon\"\u003eLinkedIn\u003c/a\u003e.\u003c/p\u003e"},"avatar":{"title":"","width":500,"height":500,"src":"https://post.medicalnewstoday.com/wp-content/uploads/2025/03/Alina-Sharon-500x500-Bio.png","alt":"Alina Sharon"}}],"medicalReviewers":[{"id":120,"name":{"display":"Carissa Stephens, R.N., CCRN, CPN","first":"Carissa","last":"Stephens, RN, CCRN, CPN"},"userLogin":"rinilope","links":{"website":"","facebook":"","linkedin":"https://www.linkedin.com/in/carissa-stephens-a168434","twitter":"","instagram":"","tiktok":""},"link":"/reviewers/carissa-stephens-rn-ccrn-cpn","type":{"value":"medical_reviewer","label":"Medical Advisor"},"nid":"122509","specialties":[],"guestTitle":"","bio":{"text":"Carissa Stephens is a pediatric nurse, with a special expertise in extracorporeal membrane oxygenation (ECMO). She is currently a nurse in a pediatric intensive care unit at Dell Children's Medical Center of Central Texas.\r\n\r\n\u003cstrong\u003eEducation\u003c/strong\u003e\r\n\u003cul\u003e\r\n \t\u003cli\u003eCollege of Charleston, BA\u003c/li\u003e\r\n \t\u003cli\u003eRoper Hospital School of Practical Nursing, LPN\u003c/li\u003e\r\n \t\u003cli\u003eExcelsior College, ASN\u003c/li\u003e\r\n \t\u003cli\u003eCapella University, BSN\u003c/li\u003e\r\n\u003c/ul\u003e\r\n\u003cstrong\u003eCertifications\u003c/strong\u003e\r\n\u003cul\u003e\r\n \t\u003cli\u003eCertified Pediatric Nurse (CPN)\u003c/li\u003e\r\n \t\u003cli\u003ePediatric Advanced Life Support (PALS)\u003c/li\u003e\r\n \t\u003cli\u003eCritical Care Registered Nurse (CCRN)\u003c/li\u003e\r\n\u003c/ul\u003e\r\n\u003cstrong\u003eProfessional Accomplishments\u003c/strong\u003e\r\n\u003cul\u003e\r\n \t\u003cli\u003eDaisy Award Recipient\u003c/li\u003e\r\n \t\u003cli\u003eNurse of the Year finalist\u003c/li\u003e\r\n \t\u003cli\u003eExcellence in Action Recipient\u003c/li\u003e\r\n\u003c/ul\u003e\r\n\u003cstrong\u003eAffiliations\u003c/strong\u003e\r\n\u003cul\u003e\r\n \t\u003cli\u003e\u003ca href=\"https://www.nursingworld.org/\"\u003eAmerican Nurses Association (ANA)\u003c/a\u003e\u003c/li\u003e\r\n \t\u003cli\u003e\u003ca href=\"https://www.aacn.org/\"\u003eAmerican Association of Critical-Care Nurses (AACN)\u003c/a\u003e\u003c/li\u003e\r\n\u003c/ul\u003e"},"avatar":{"title":"","width":500,"height":500,"src":"https://post.medicalnewstoday.com/wp-content/uploads/2024/12/Carissa-Stephens-new-format-500x500-1.png","alt":"Carissa Stephens"}}],"id":"mnt-1013634","updateReason":["The article was updated with additional information to ensure it provides our readers with a comprehensive overview of the topic."],"editor":"Alina Sharon","factCheckedBy":"","factCheckers":[],"articleHistory":{"2018-08-24":{"updateReason":[],"authors":"Jon Johnson","editor":"Alice Porter-McLaughlin","medicallyReviewedBy":"Nancy Moyer, MD"},"2023-05-30":{"updateReason":["The article was updated with additional information to ensure it provides our readers with a comprehensive overview of the topic."],"authors":"Jon Johnson, Alina Sharon","editor":"Alina Sharon","copyEditor":"Gianna D'Emilio"},"2021-06-29":{"medicallyReviewedBy":"Carissa Stephens, RN, CCRN, CPN"}},"articleDates":{"factChecked":{"date":null,"display":""},"medicallyReviewed":{"date":1624924800,"display":"June 29, 2021"},"published":{"date":1535133600,"display":"August 24, 2018"},"lastUpdates":{"date":1685404800,"display":"May 30, 2023"},"modified":{"date":1685447389,"display":"May 30, 2023"}},"type":"healthfeature","language":"en"},"readNext":{"items":[{"title":["What should you do if someone has a stroke?"],"text":["A stroke can be life-threatening, but knowing what to do can make all the difference. Here, find out how to spot the signs and what to do if they…"],"link":"/articles/319007","imageAlt":"What should you do if someone has a stroke?","thumbnail":"https://media.post.rvohealth.io/wp-content/uploads/sites/3/2021/02/GettyImages-946917168_thumb-1-732x549.jpg","medicallyReviewedBy":{"reviewerName":"Alana Biggers, M.D., MPH","reviewerImage":{"path":"https://media.post.rvohealth.io/wp-content/uploads/sites/3/2019/12/alana-biggers-1.png","width":200,"height":200,"altText":""},"specialties":[]},"isNutrition":false,"authors":[{"id":953,"name":{"display":"Jayne Leonard","first":"Jayne","last":"Leonard"},"userLogin":"jayneleonard","links":{"website":"","facebook":"","linkedin":"","twitter":"","instagram":"","tiktok":""},"link":"/authors/jayne-leonard","type":{"value":"author","label":"Author"},"nid":"","specialties":[],"guestTitle":"","bio":{"text":"Jayne is a qualified counselor and psychotherapist, and she holds a diploma in nutritional therapy. At present, she is completing a master's degree in counselling and psychotherapy. She is passionate about the influence of diet and lifestyle on mental health and well-being. Through her work in both private and not-for-profit settings, she hopes to empower others to take charge of their lives and improve their physical and mental health."},"avatar":{"title":"","width":500,"height":500,"src":"https://post.medicalnewstoday.com/wp-content/uploads/sites/3/2020/06/500x500_Jayne_Leonard.png","alt":""}}],"reviewedByHeader":"Medically reviewed by","language":"en"},{"title":["What to do for a concussion"],"text":["In this article, find out what to do for a concussion. Learn about the common signs and symptoms, how long recovery takes, and when to seek emergency…"],"link":"/articles/what-to-do-for-a-concussion","imageAlt":"What to do for a concussion","thumbnail":"https://media.post.rvohealth.io/wp-content/uploads/sites/3/2020/04/GettyImages-1156651310_thumb-732x549.jpg","medicallyReviewedBy":{"reviewerName":"Deborah Weatherspoon, Ph.D., MSN","reviewerImage":{"path":"https://media.post.rvohealth.io/wp-content/uploads/sites/3/2019/12/DebraWeatherspoon.png","width":200,"height":200,"altText":""},"specialties":[]},"isNutrition":false,"authors":[{"id":954,"name":{"display":"Jessica Caporuscio, PharmD","first":"Jessica","last":"Caporuscio, PharmD"},"userLogin":"jcaporuscio","links":{"website":"","facebook":"","linkedin":"","twitter":"","instagram":"","tiktok":""},"link":"/authors/jessica-caporuscio-pharm-d","type":{"value":"medical_reviewer","label":"Medical Advisor"},"nid":"","specialties":[],"guestTitle":"","bio":{"text":"Jessica is a clinical pharmacist with a doctorate in pharmacy. Her mission is to educate the public about disease prevention and healthy living. As a marathon runner and Ironman triathlete, she has personal reasons to keep herself fit and professional interests to share her knowledge with others.\r\n\r\n\u003cstrong\u003eTo keep up with Jessica, connect with her on \u003ca class=\"\u0026quot;button_followrel=\u0026quot;noopener\" href=\"//www.linkedin.com/in/libertymedicalwriting\u0026quot;\" target=\"\u0026quot;_blanktitle=\u0026quot;Follow\"\u003eLinkedIn\u003c/a\u003e or visit her \u003ca class=\"\u0026quot;button_followrel=\u0026quot;noopener\" href=\"//www.libertymedicalwriting.com\u0026quot;\" target=\"\u0026quot;_blanktitle=\u0026quot;Follow\"\u003ewebsite\u003c/a\u003e.\u003c/strong\u003e"},"avatar":{"title":"","width":500,"height":500,"src":"https://post.medicalnewstoday.com/wp-content/uploads/sites/3/2020/06/500x500_Jessica_Caporuscio.png","alt":""}}],"reviewedByHeader":"Medically reviewed by","language":"en"},{"title":["How and when to perform the Heimlich maneuver"],"text":["If someone nearby was choking on an object would you know what to do? The Heimlich maneuver, or abdominal thrusts, involves standing behind the person…"],"link":"/articles/319516","imageAlt":"How and when to perform the Heimlich maneuver","thumbnail":"https://media.post.rvohealth.io/wp-content/uploads/sites/3/2020/02/heimlich-maneuver-being-demonstrated-in-a-first-aid-class.jpg","medicallyReviewedBy":{"reviewerName":"Carissa Stephens, R.N., CCRN, CPN","reviewerImage":{"path":"https://post.medicalnewstoday.com/wp-content/uploads/2024/12/Carissa-Stephens-new-format-500x500-1.png","width":200,"height":200,"altText":""},"specialties":["Pediatrics"]},"isNutrition":false,"authors":[{"id":1595,"name":{"display":"Peter Morales-Brown","first":"Peter","last":"Morales-Brown"},"userLogin":"pebrown","links":{"website":"","facebook":"","linkedin":"","twitter":"","instagram":"","tiktok":""},"link":"/authors/peter-brown-1595","type":{"value":"author","label":"Author"},"nid":"","specialties":[],"guestTitle":"","bio":{"text":"\u003cdiv class=\"RichText3-paragraph--withVSpacingNormal RichText3-paragraph Typography Typography--m\"\u003ePeter is an experienced writer and editor based in the UK with a background in biomedical science. Driven by medical integrity, he takes pride in creating accurate and trustworthy articles to combat widespread health misinformation. He holds a particular interest in topics surrounding genetics, fitness, autoimmunity, hematology, and infectious conditions.\u003c/div\u003e\r\n\u003cdiv class=\"RichText3-paragraph--withVSpacingNormal RichText3-paragraph Typography Typography--m\"\u003e\u003c/div\u003e\r\n\u003cdiv class=\"RichText3-paragraph--withVSpacingNormal RichText3-paragraph Typography Typography--m\"\u003eOutside of work, he will likely be in the gym, watching television, supporting Arsenal F.C., or gallivanting around with his wife and pug.\u003c/div\u003e"},"avatar":{"title":"","src":"","alt":""}}],"reviewedByHeader":"Medically reviewed by","language":"en"},{"title":["Should you go to the emergency room or visit urgent care?"],"text":["Deciding whether to visit the emergency room or urgent care can be challenging. Learn more about how to decide here."],"link":"/articles/urgent-care-or-emergency-room","imageAlt":"Should you go to the emergency room or visit urgent care?","thumbnail":"https://media.post.rvohealth.io/wp-content/uploads/sites/3/2022/11/urgent_care_vs_emergency_room_broken_arm_732x549_thumb-732x549.jpg","medicallyReviewedBy":{"reviewerName":"Cynthia Taylor Chavoustie, MPAS, PA-C","reviewerImage":{"path":"https://post.medicalnewstoday.com/wp-content/uploads/2026/09/cynthia-taylor-chavoustie-500x500-bio.png","width":200,"height":200,"altText":""}},"isNutrition":false,"authors":[{"id":1061,"name":{"display":"Belinda Weber","first":"Belinda","last":"Weber"},"userLogin":"bweber","links":{"website":"","facebook":"","linkedin":"","twitter":"","instagram":"","tiktok":""},"type":{"value":"author","label":"Author"},"nid":"","specialties":[],"guestTitle":"","bio":{"text":""},"avatar":{"title":"","src":"","alt":""}}],"reviewedByHeader":"Medically reviewed by","language":"en"},{"title":["How to apply a tourniquet step by step"],"text":["If pressure does not stop bleeding, people can use a medical-grade or homemade tourniquet until emergency services arrive. Learn more here."],"link":"/articles/how-to-apply-a-tourniquet","imageAlt":"How to apply a tourniquet step by step","thumbnail":"https://media.post.rvohealth.io/wp-content/uploads/sites/3/2022/11/apply_tourniquet_GettyImages1243733132_Thumb-732x549.jpg","medicallyReviewedBy":{"reviewerName":"Carissa Stephens, R.N., CCRN, CPN","reviewerImage":{"path":"https://post.medicalnewstoday.com/wp-content/uploads/2024/12/Carissa-Stephens-new-format-500x500-1.png","width":200,"height":200,"altText":""},"specialties":["Pediatrics"]},"isNutrition":false,"authors":[{"id":983,"name":{"display":"Jennifer Huizen","first":"Jennifer","last":"Huizen"},"userLogin":"jhuizen","links":{"website":"","facebook":"","linkedin":"","twitter":"","instagram":"","tiktok":""},"link":"/authors/jennifer-huizen","type":{"value":"author","label":"Author"},"nid":"159196","specialties":[],"guestTitle":"","bio":{"text":"Jennifer Huizen holds a BA in Creative Writing and Postcolonial Literature, a BS in Microbiology and Environmental Science, and an MS in Science Journalism from Columbia University's Graduate School of Journalism. She lives in the United States, but remains a Canadian citizen. Jennifer lives with her rescue cat, Jim Carrey, and a jungle's worth of plants. In her free time you'll likely find her traveling, at the beach, reading, listening to podcasts, gardening, or hiking. You can learn more about Jennifer on \u003ca class=\"PrimaryLink BaseLink\" href=\"https://www.linkedin.com/in/jennifer-huizen-b61703aa\" target=\"_blank\" rel=\"noreferrer noopener\"\u003eLinkedIn\u003c/a\u003e."},"avatar":{"title":"","width":500,"height":500,"src":"https://post.medicalnewstoday.com/wp-content/uploads/sites/3/2023/07/Jennifer-Huizen-Headshot-500x500-Bio.png","alt":""}}],"reviewedByHeader":"Medically reviewed by","language":"en"}],"language":"en"},"isCorp":false,"isPremiumVideo":false,"isStandaloneVideo":false,"isStandaloneRecipe":false,"schemaObj":{"@context":"https://schema.org","publisher":{"@type":"Organization","name":"Medical News Today","logo":{"@type":"ImageObject","url":"https://cdn-prod.medicalnewstoday.com/structure/images/logo/logo-2017-640-60.png"}},"@type":"MedicalWebPage","headline":"What to do when someone is unconscious","description":"Knowing how to identify unconsciousness, how to help, and when to contact emergency services can be lifesaving. Learn about first aid, fainting, and more.","keywords":"","author":{"@type":"Person","name":"Jon Johnson"},"lastReviewed":"2021-06-29T00:00:00Z","url":"https://www.medicalnewstoday.com/articles/322872","datePublished":"2018-08-24T18:00:00Z","dateModified":"2023-05-30T00:00:00Z","articleSection":"Emergency Medicine,First Aid","correction":{"@type":"CorrectionComment","text":"The article was updated with additional information to ensure it provides our readers with a comprehensive overview of the topic.","datePublished":"2023-05-30"},"reviewedBy":"Carissa Stephens, R.N., CCRN, CPN","primaryImageOfPage":["https://post.medicalnewstoday.com/wp-content/uploads/sites/3/2021/06/GettyImages-1167497098_header-1024x575.jpg"],"thumbnail":["https://media.post.rvohealth.io/wp-content/uploads/sites/3/2021/06/GettyImages-1167497098_thumb.jpg"],"videoSchemaData":{"@context":"https://schema.org","@type":"VideoObject","name":"How to Perform CPR video","description":"This training video shows you how to perform CPR on an adult. Learn what lifesaving measures you can do to save someone's life with CPR. Dr. Williams show proper hand placement, compression ratio, and safety measures.","thumbnailUrl":"https://i.ytimg.com/vi/cosVBV96E2g/default.jpg","uploadDate":"2014-07-15T16:21:53Z","embedUrl":"https://www.youtube.com/embed/cosVBV96E2g"}},"hero":{}}},"ampLibs":{}},"pathname":"/tabbed","query":{"isControl":false,"url":"/articles/322872","adSyncFlag":false,"readNextModel":"control"},"publicPath":"https://assets.medicalnewstoday.com/_next/","appState":{"title":"First aid for unconsciousness: What to do and when to seek help","canonical":"https://www.medicalnewstoday.com/articles/322872","hrlContentId":"mnt-1013634","isArticle":true,"isMLP":false,"isContentSeries":false,"canonicalPath":"/articles/322872","pageTemplate":"Tabbed Article","templateType":"tabbedTemplate","versionId":2,"logMoreMetrics":true,"adsSponsored":false,"isCPUV":false,"newsletter":{"tags":"","categories":"emergency-medicine,first-aid"},"isSponsoredArticle":false,"targeting":{"k1":"firstaidandsafety","k2":"generichealth","k3":"health","kmeta":"asthma-aq-t1,hep_c-aq-t1,mm-aq-t1,type-2-diabetes-predictive-aq,depression-predictive-aq-1","msiteactive":"false","url":"/articles/322872","articleId":"mnt-1013634","adLayout":"REDUCED"},"categories":[{"name":"Emergency Medicine","slug":"emergency-medicine","link":"/categories/emergency-medicine","primary":true,"children":[]},{"name":"First Aid","slug":"first-aid","link":"/categories/first-aid","children":[]}],"subcategories":[],"widgets":{},"sponsoredNavMenu":false,"author":"Jon Johnson and Alina Sharon","editor":"Alina Sharon","contentForm":"Non-Head Term","type":"healthfeature","vertical":"General Health","language":"en","authOnboarding":{},"trackingTerms":[],"isPremiumVideo":false,"isStandaloneVideo":false,"isStandaloneRecipe":false,"hasDisabledPrerollJWPlayer":false,"isNewsArticle":false,"hasEmbeddedJWPlayer":false,"byline":{"authors":[{"id":934,"name":{"display":"Jon Johnson","first":"Jon","last":"Johnson"},"link":"/authors/jon-johnson","type":{"value":"author","label":"Author"},"nid":"","specialties":[],"guestTitle":"","bio":{"text":"Jon is a writer from California and now floats somewhere on an island in the Mediterranean. He thinks most issues can be solved by petting a good dog, and he spends plenty of time doing so. Time not spent at his desk is probably spent making art or entertaining humans or other animals."},"avatar":{"title":"","width":500,"height":500,"src":"https://post.medicalnewstoday.com/wp-content/uploads/sites/3/2020/06/500x500_Jon_Johnson.png","alt":""}},{"id":5332,"name":{"display":"Alina Sharon","first":"Alina","last":"Sharon"},"link":"/authors/alina-sharon","type":{"value":"author","label":"Author"},"nid":"","specialties":[],"guestTitle":"","bio":{"text":"\u003cp data-pm-slice=\"1 1 []\"\u003eAlina Sharon is a Chicago-based editor for Medical News Today, Healthline, Healthgrades, and HelloMedicare focusing on health, wellness, and Medicare content. She has a master's degree in journalism and has worked as a writer and editor for over 10 years for U.S. and international media. She’s excited to dedicate herself to her passion for creating informative and reliable content that makes it easier for people to navigate their healthcare. Outside of work, she’s also the mom of two rambunctious boys. Connect with her on \u003ca class=\"ProsemirrorEditor-link\" href=\"https://www.linkedin.com/in/adsharon\"\u003eLinkedIn\u003c/a\u003e.\u003c/p\u003e"},"avatar":{"title":"","width":500,"height":500,"src":"https://post.medicalnewstoday.com/wp-content/uploads/2025/03/Alina-Sharon-500x500-Bio.png","alt":"Alina Sharon"}}],"medicalReviewers":[{"id":120,"name":{"display":"Carissa Stephens, R.N., CCRN, CPN","first":"Carissa","