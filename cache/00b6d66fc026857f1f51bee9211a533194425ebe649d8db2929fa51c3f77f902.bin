</script><script src="https://rvo-cohesion.medicalnewstoday.com/cohesion/cohesion-tpo.min.js?cDomain=medicalnewstoday.com" async=""></script><link rel="preconnect" href="https://c.aps.amazon-adsystem.com"/><link rel="preload" href="https://config.aps.amazon-adsystem.com/configs/3083" as="script" fetchpriority="high"/><script src="https://config.aps.amazon-adsystem.com/configs/3083" async="" fetchpriority="high"></script><link rel="preload" href="https://client.aps.amazon-adsystem.com/publisher.js" as="script" fetchpriority="high"/><script src="https://client.aps.amazon-adsystem.com/publisher.js" async="" fetchpriority="high"></script><script>module={};__NEXT_DATA__={"buildId":"88d815f3-b930-4ebf-8934-bef2cedbe0d1","props":{"ga":{"k1":"firstaidandsafety","k2":"generichealth","kmeta":"asthma-aq-t1,hep_c-aq-t1,mm-aq-t1,type-2-diabetes-predictive-aq,depression-predictive-aq-1","contentType":"Tabbed Article","author":"Jon Johnson and Alina Sharon","articleType":"regular","sponsoredProgramId":"","articleId":"mnt-1013634","mainContentCategoryTags":"","publishedDate":"2021-06-11","updatedDate":"2023-05-30","medReviewer":"Carissa Stephens, R.N., CCRN, CPN","category":"Emergency Medicine,First Aid","subcategory":"","trackingTerms":"","ek1":"2f59d4c669c8fb99b18d626d67cd58e347","ekmeta":"2843d2dd70c8bf9ca1ce722f,2155d6ea7e84f38cfd9737,245d8bd46c84e6cc,3d49d6d0309bbf99b982647b72ce4eba4ea4868a3d5950a450f92adba1,2d55d6c778dae194bf8d2b6e74ce59fe5da28a98311745bc0bad,","contentForm":"Non-Head Term","type":"healthfeature"},"lang":"en","data":{"k1":"firstaidandsafety","sideEffectsWidget":{},"drugSavingsData":null,"id":"mnt-1013634","title":["What to do when someone is unconscious"],"articleHistory":{"2018-08-24":{"updateReason":[],"authors":"Jon Johnson","editor":"Alice Porter-McLaughlin","medicallyReviewedBy":"Nancy Moyer, MD"},"2023-05-30":{"updateReason":["The article was updated with additional information to ensure it provides our readers with a comprehensive overview of the topic."],"authors":"Jon Johnson, Alina Sharon","editor":"Alina Sharon","copyEditor":"Gianna D'Emilio"},"2021-06-29":{"medicallyReviewedBy":"Carissa Stephens, RN, CCRN, CPN"}},"updateReason":["The article was updated with additional information to ensure it provides our readers with a comprehensive overview of the topic."],"isFeature":false,"isListicle":false,"isPaidMedia":false,"isEditorialPaidMedia":false,"isTransactionalPaidMedia":false,"isMarketingLandingPage":false,"mktglpColorTheme":"","authors":[{"id":934,"name":{"display":"Jon Johnson","first":"Jon","last":"Johnson"},"link":"/authors/jon-johnson","type":{"value":"author","label":"Author"},"nid":"","specialties":[],"guestTitle":"","bio":{"text":"Jon is a writer from California and now floats somewhere on an island in the Mediterranean. He thinks most issues can be solved by petting a good dog, and he spends plenty of time doing so. Time not spent at his desk is probably spent making art or entertaining humans or other animals."},"avatar":{"title":"","width":500,"height":500,"src":"https://post.medicalnewstoday.com/wp-content/uploads/sites/3/2020/06/500x500_Jon_Johnson.png","alt":""},"bioBlurb":{"nodes":["Jon is a writer from California and now floats somewhere on an island in the Mediterranean. He thinks most issues can be solved by petting a good dog, and he…"]}},{"id":5332,"name":{"display":"Alina Sharon","first":"Alina","last":"Sharon"},"link":"/authors/alina-sharon","type":{"value":"author","label":"Author"},"nid":"","specialties":[],"guestTitle":"","bio":{"text":"\u003cp data-pm-slice=\"1 1 []\"\u003eAlina Sharon is a Chicago-based editor for Medical News Today, Healthline, Healthgrades, and HelloMedicare focusing on health, wellness, and Medicare content. She has a master's degree in journalism and has worked as a writer and editor for over 10 years for U.S. and international media. She’s excited to dedicate herself to her passion for creating informative and reliable content that makes it easier for people to navigate their healthcare. Outside of work, she’s also the mom of two rambunctious boys. Connect with her on \u003ca class=\"ProsemirrorEditor-link\" href=\"https://www.linkedin.com/in/adsharon\"\u003eLinkedIn\u003c/a\u003e.\u003c/p\u003e"},"avatar":{"title":"","width":500,"height":500,"src":"https://post.medicalnewstoday.com/wp-content/uploads/2025/03/Alina-Sharon-500x500-Bio.png","alt":"Alina Sharon"},"bioBlurb":{"nodes":["Alina Sharon is a Chicago-based editor for Medical News Today, Healthline, Healthgrades, and HelloMedicare focusing on health, wellness, and Medicare content…"]}}],"medicalReviewers":[{"id":120,"name":{"display":"Carissa Stephens, R.N., CCRN, CPN","first":"Carissa","last":"Stephens, RN, CCRN, CPN"},"userLogin":"rinilope","links":{"website":"","facebook":"","linkedin":"https://www.linkedin.com/in/carissa-stephens-a168434","twitter":"","instagram":"","tiktok":""},"link":"/reviewers/carissa-stephens-rn-ccrn-cpn","type":{"value":"medical_reviewer","label":"Medical Advisor"},"nid":"122509","specialties":[],"guestTitle":"","bio":{"text":"Carissa Stephens is a pediatric nurse, with a special expertise in extracorporeal membrane oxygenation (ECMO). She is currently a nurse in a pediatric intensive care unit at Dell Children's Medical Center of Central Texas.\r\n\r\n\u003cstrong\u003eEducation\u003c/strong\u003e\r\n\u003cul\u003e\r\n \t\u003cli\u003eCollege of Charleston, BA\u003c/li\u003e\r\n \t\u003cli\u003eRoper Hospital School of Practical Nursing, LPN\u003c/li\u003e\r\n \t\u003cli\u003eExcelsior College, ASN\u003c/li\u003e\r\n \t\u003cli\u003eCapella University, BSN\u003c/li\u003e\r\n\u003c/ul\u003e\r\n\u003cstrong\u003eCertifications\u003c/strong\u003e\r\n\u003cul\u003e\r\n \t\u003cli\u003eCertified Pediatric Nurse (CPN)\u003c/li\u003e\r\n \t\u003cli\u003ePediatric Advanced Life Support (PALS)\u003c/li\u003e\r\n \t\u003cli\u003eCritical Care Registered Nurse (CCRN)\u003c/li\u003e\r\n\u003c/ul\u003e\r\n\u003cstrong\u003eProfessional Accomplishments\u003c/strong\u003e\r\n\u003cul\u003e\r\n \t\u003cli\u003eDaisy Award Recipient\u003c/li\u003e\r\n \t\u003cli\u003eNurse of the Year finalist\u003c/li\u003e\r\n \t\u003cli\u003eExcellence in Action Recipient\u003c/li\u003e\r\n\u003c/ul\u003e\r\n\u003cstrong\u003eAffiliations\u003c/strong\u003e\r\n\u003cul\u003e\r\n \t\u003cli\u003e\u003ca href=\"https://www.nursingworld.org/\"\u003eAmerican Nurses Association (ANA)\u003c/a\u003e\u003c/li\u003e\r\n \t\u003cli\u003e\u003ca href=\"https://www.aacn.org/\"\u003eAmerican Association of Critical-Care Nurses (AACN)\u003c/a\u003e\u003c/li\u003e\r\n\u003c/ul\u003e"},"avatar":{"title":"","width":500,"height":500,"src":"https://post.medicalnewstoday.com/wp-content/uploads/2024/12/Carissa-Stephens-new-format-500x500-1.png","alt":"Carissa Stephens"},"bioBlurb":{"nodes":["Carissa Stephens is a pediatric nurse, with a special expertise in extracorporeal membrane oxygenation (ECMO). She is currently a nurse in a pediatric intensive…"]}}],"editors":[{"role":"Editor","name":{"display":"Alina Sharon"}}],"pinterestImage":{"path":"https://media.post.rvohealth.io/wp-content/uploads/sites/3/2021/06/GettyImages-1167497098_thumb.jpg"},"hideFeedback":false,"isMedicare":false,"isBlog":false,"publishSource":"wordpress","isAmpSupported":false,"categories":[{"name":"Emergency Medicine","slug":"emergency-medicine","link":"/categories/emergency-medicine","primary":true,"children":[]},{"name":"First Aid","slug":"first-aid","link":"/categories/first-aid","children":[]}],"language":{"current":"en","default":"en","language_data":{"en":{"id":1013634,"root_id":17110},"x-default":{"id":1013634,"root_id":17110}},"en":"https://www.medicalnewstoday.com/articles/322872/","x-default":"https://www.medicalnewstoday.com/articles/322872/"},"lang":"en","links":[{"rel":"alternate","hrefLang":"default","href":"en"},{"rel":"alternate","hrefLang":"language_data","href":{"en":{"id":1013634,"root_id":17110},"x-default":{"id":1013634,"root_id":17110}}},{"rel":"alternate","hrefLang":"en","href":"https://www.medicalnewstoday.com/articles/322872/"},{"rel":"alternate","hrefLang":"x-default","href":"https://www.medicalnewstoday.com/articles/322872/"}],"colorScheme":"default","isContentSeries":false,"brandCTAs":[],"treatmentComparison":[],"clusterNavV2":null,"pathingTilesData":{},"pathingCardsData":{},"inArticlePathingCardsData":[],"quantitativeTrustData":{},"isPrependRecipeH2":false,"isRecipeRoundup":false,"recipes":[],"breadcrumbsV2":[],"hideTabs":false,"tabs":[{"id":"_noHeaderPrefixedContent","title":null,"header":null,"body":[{"tagName":"div","block":"deck","source":"\u003cp class=\"css-u5b63i\"\u003eWhen someone becomes unconscious and unresponsive, it is essential to know what to do. This may include checking the vital signs and assessing for a serious injury until emergency services arrive. If a person is not breathing, it may be necessary to perform CPR.\u003c/p\u003e"},{"tagName":"p","source":"\u003ca href=\"https://ufhealth.org/unconsciousness-first-aid\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"content-link css-1h9c35y\"\u003eUnconsciousness \u003c/a\u003eis an unresponsive state. A person who is unconscious may seem like they are sleeping but may not respond to things like loud noises, being touched, or being shaken."},{"tagName":"div","attributes":{"data-preamp":"serena-chatbot"},"source":""},{"tagName":"p","source":"Fainting is a type of unconsciousness that happens suddenly and may only last a few seconds. Other types can last much longer. \u003cbr\u003e\u003cbr\u003eA person’s vital signs may change. Seek immediate medical attention if someone’s \u003ca class=\"content-link css-1h9c35y keywords\" title=\"What is the pulse and how do I check it?\" href=\"https://www.medicalnewstoday.com/articles/258118.php\"\u003epulse\u003c/a\u003e becomes weak or they stop breathing."}]},{"id":"what-to-do","title":"What to do","isCollapsable":false,"listicleSection":false,"qaQuestion":false,"header":["What to do first"],"body":[{"tagName":"div","source":"\u003cstyle data-emotion=\"css 18ktu0y\"\u003e.css-18ktu0y{max-width:1296px;margin:25px -20px;}@media(min-width:768px){.css-18ktu0y{margin:30px auto;}}@media(min-width: 550px){.css-18ktu0y{margin-left:auto;margin-right:auto;}}\u003c/style\u003e\u003cfigure class=\"css-18ktu0y\"\u003e\u003cspan class=\"css-1krkfdx\"\u003e\u003cspan class=\"css-1q1e3vo\"\u003e\u003cpicture class=\"css-ywxqgz\"\u003e\u003csource srcSet=\"//i0.wp.com/post.medicalnewstoday.com/wp-content/uploads/sites/3/2021/06/GettyImages-1167497098_header-1024x575.jpg?w=1575 750w\" media=\"(min-width: 1190px)\"/\u003e\u003csource srcSet=\"//i0.wp.com/post.medicalnewstoday.com/wp-content/uploads/sites/3/2021/06/GettyImages-1167497098_header-1024x575.jpg?w=1575 750w\" media=\"(min-width: 990px)\"/\u003e\u003csource srcSet=\"//i0.wp.com/post.medicalnewstoday.com/wp-content/uploads/sites/3/2021/06/GettyImages-1167497098_header-1024x575.jpg?w=1845 879w\" media=\"(min-width: 768px)\"/\u003e\u003cimg loading=\"eager\" src=\"//i0.wp.com/post.medicalnewstoday.com/wp-content/uploads/sites/3/2021/06/GettyImages-1167497098_header-1024x575.jpg?w=1155\u0026h=1528\" alt=\"\" class=\"css-bt1qz0\"/\u003e\u003c/picture\u003e\u003c/span\u003e\u003chl-share-overlay class=\"css-1hys987\"\u003e\u003ca class=\"icon-hl-pinterest css-19xpj7s\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" data-event=\"Any Page|Image Pinterest Click|Icon Clicked\" data-element-event=\"OPEN|CONTENTBLOCK|Any Page|Article Body|BUTTON|Image Widget Pinterest Click|\" href=\"https://www.pinterest.com/pin/create/button/?url=https%3A%2F%2Fwww.medicalnewstoday.com%2Farticles%2F322872\u0026media=https%3A%2F%2Fpost.medicalnewstoday.com%2Fwp-content%2Fuploads%2Fsites%2F3%2F2021%2F06%2FGettyImages-1167497098_header-1024x575.jpg\u0026description=First%20aid%20for%20unconsciousness%3A%20What%20to%20do%20and%20when%20to%20seek%20help\" title=\"Share on Pinterest\" data-pin-custom=\"true\" data-share-url=\"https://post.medicalnewstoday.com/wp-content/uploads/sites/3/2021/06/GettyImages-1167497098_header-1024x575.jpg\"\u003e\u003cspan class=\"css-11njuzm\"\u003eShare on Pinterest\u003c/span\u003e\u003c/a\u003e\u003c/hl-share-overlay\u003e\u003c/span\u003e\u003cstyle data-emotion=\"css tfcpvz\"\u003e.css-tfcpvz{color:#767474;display:block;font-size:14px;line-height:20px;margin-bottom:5px;margin-top:5px;}.css-tfcpvz a[href]{cursor:pointer;-webkit-text-decoration:underline;text-decoration:underline;border-color:currentColor;color:inherit;}.css-tfcpvz a[href]:hover{color:#f0533a;}.css-tfcpvz a[href]:hover img,.css-tfcpvz a[href]:hover .image{opacity:0.8;}.css-tfcpvz a[href]:hover svg{fill:currentColor;}.css-tfcpvz a[href]:active{color:#f0533a;}.css-tfcpvz a[href].content-link{-webkit-text-decoration:underline;text-decoration:underline;}.css-tfcpvz p{font-size:14px;}.css-tfcpvz li{font-size:14px;}\u003c/style\u003e\u003cfigcaption class=\"css-1ar5twp css-tfcpvz\"\u003eCineberg/Getty Images\u003c/figcaption\u003e\u003c/figure\u003e"},{"tagName":"p","source":"If someone seems unconscious or unresponsive, the \u003ca href=\"https://ufhealth.org/unconsciousness-first-aid\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"content-link css-1h9c35y\"\u003efirst thing to do\u003c/a\u003e is ask if they are OK in a loud voice. If they don’t respond, gently shake them. But if they might have a spinal cord injury, it is best not to move the person until emergency services arrive. \u003cbr\u003e\u003cbr\u003eIf a person still does not respond, follow these steps in this order:"},{"tagName":"ol","source":"\u003cli\u003eCheck that their airway is open, without signs of a blockage, such as labored or high-pitched breathing\u003c/li\u003e\u003cli\u003eLook for signs that they are breathing.\u003c/li\u003e\u003cli\u003eCheck for a pulse or heartbeat.\u003c/li\u003e"},{"tagName":"p","source":"Next, call or have someone else call emergency medical services. In the United States, dial 911. Do this if the person:"},{"tagName":"ul","source":"\u003cli\u003ehas no pulse or a weak one\u003c/li\u003e\u003cli\u003edoes not seem to be breathing\u003c/li\u003e\u003cli\u003edoes not respond or regain consciousness within 1 minute\u003c/li\u003e\u003cli\u003eappears to be severely injured, due to heavy bleeding, for example\u003c/li\u003e"},{"tagName":"p","source":"Do not hang up on the emergency services representative until they ask you to."},{"tagName":"p","source":"Check the person’s wrists and neck to see whether they have a first aid tag, which may have information about why they lost consciousness. Share the information on the tag with the representative."}]},{"id":"first-aid-steps","title":"First aid steps","isCollapsable":false,"listicleSection":false,"qaQuestion":false,"header":["First aid steps"],"body":[{"tagName":"p","source":"Before beginning any \u003ca href=\"https://www.redcross.org.uk/first-aid/learn-first-aid/unresponsive-and-breathing\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"content-link css-1h9c35y\"\u003efirst aid steps\u003c/a\u003e, it is essential to tell whether the unconscious person is breathing or not. "},{"tagName":"h3","source":"If the person is breathing"},{"tagName":"p","source":"If the person is conscious but seems dazed, ask them basic questions, such as what their name and birthday are or what today’s date is."},{"tagName":"p","source":"If the person is unable to answer correctly, they may be experiencing a change in mental status. Share this information with the emergency services representative."},{"tagName":"p","source":"If the person may have a spinal injury, leave them as they are. Take steps to keep their neck supported and still."},{"tagName":"p","source":"If the person is breathing and it is unlikely that they have a spinal injury, roll them into a recovery position on their side. Adjust their legs so their hips and knees form right angles. Tilt their head gently back to help keep their airway open."},{"tagName":"h3","source":"If the person is not breathing"},{"tagName":"p","source":"If an unconscious person is not breathing, it may be necessary to move them carefully onto their back while protecting their neck, so they can receive \u003ca href=\"http://depts.washington.edu/learncpr/quickcpr.html\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"content-link css-1h9c35y\"\u003ecardiopulmonary resuscitation (CPR)\u003c/a\u003e. We describe how to give CPR in the next section."},{"tagName":"p","source":"Call 911 before administering CPR."},{"tagName":"p","source":"If the person is moving, coughing, or breathing, this is a good sign. If none of these things happen, continue giving CPR until emergency assistance arrives."},{"tagName":"p","source":"If something is visible at the back of the throat or high in the throat, and it is blocking the airway, try to remove it by using one finger to sweep the mouth. Do not try to sweep away or grab anything that is not visible."},{"tagName":"p","source":"If the person is not breathing and has something lodged in their throat, continue performing the chest compressions of CPR and checking to see whether the object has dislodged."},{"tagName":"h3","source":"If the person is bleeding"},{"tagName":"p","source":"If the unconscious person is \u003ca href=\"https://www.redcross.org/content/dam/redcross/atg/PDFs/Take_a_Class/Adult_Ready_Reference_Card.pdf\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"content-link css-1h9c35y\"\u003ebleeding heavily\u003c/a\u003e, locate the injury and place strong, direct pressure on the wounded area to slow the flow of blood. Anyone who knows how should apply a \u003ca href=\"https://www.stopthebleed.org/resources-poster-booklet\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"content-link css-1h9c35y\"\u003etourniquet\u003c/a\u003e above the bleeding area to slow the bleeding until emergency services arrive. "}]},{"id":"cpr-steps","title":"CPR steps","isCollapsable":false,"listicleSection":false,"qaQuestion":false,"header":["How to perform CPR"],"body":[{"tagName":"p","source":"\u003ca href=\"https://www.medicalnewstoday.com/articles/324712\" class=\"content-link css-1h9c35y\"\u003eCPR\u003c/a\u003e is an emergency procedure to assist someone when they stop breathing and have no pulse. It involves chest compressions, which is the cardio part, and rescue breaths, which is the pulmonary part, of the name “cardiopulmonary resuscitation.”"},{"tagName":"p","source":"Only people with CPR training should give the rescue breath part of the procedure. To reduce the chances of injury, anyone without training should \u003ca href=\"http://depts.washington.edu/learncpr/quickcpr.html\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"content-link css-1h9c35y\"\u003eonly perform\u003c/a\u003e chest compressions, in steps 1–7 below. Chest compressions also help oxygen circulate."},{"tagName":"p","source":"Before starting CPR, try to wake the person again by calling their name loudly and asking if they are okay."},{"tagName":"p","source":"If the person is still unresponsive:"},{"tagName":"ul","source":"\u003cli\u003ePlace one hand on their forehead.\u003c/li\u003e\u003cli\u003ePlace the fingers of your other hand under the tip of their chin.\u003c/li\u003e\u003cli\u003eGently tilt their head back. The goal is for their tongue to move so it does not block their airway.\u003c/li\u003e"},{"tagName":"p","source":"But if the person may have a spinal injury:"},{"tagName":"ul","source":"\u003cli\u003eKneel near the top of their head.\u003c/li\u003e\u003cli\u003ePlace your hands on either side of their face.\u003c/li\u003e\u003cli\u003eGently lift the person’s jaw with your fingertips without moving their neck.\u003c/li\u003e"},{"tagName":"p","source":"When the person’s airway is open, follow these steps to \u003ca href=\"http://depts.washington.edu/learncpr/quickcpr.html\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"content-link css-1h9c35y\"\u003eperform CPR\u003c/a\u003e:"},{"tagName":"p","source":"1. Lay the person on their back on any flat, hard surface. Protect their neck from big movements if it looks like they might have a spinal injury."},{"tagName":"p","source":"2. Kneel next to their shoulders, so your torso is over their chest."},{"tagName":"p","source":"3. Put the palm and heel of your hand in the center of their chest."},{"tagName":"p","source":"4. Place your other hand directly on top of the first hand and interlock your fingers."},{"tagName":"p","source":"5. Keeping your elbows straight, bring your shoulders forward over your hands to give you more upper body strength."},{"tagName":"p","source":"6. Using the weight and force of your upper body, push straight down on their chest. Press it down at least 2.0 to 2.4 inches for adults, then release the pressure. This is one compression."},{"tagName":"p","source":"7. Do continual sets of 30 compressions at a rate of about two per second, or 100–120 compressions per minute."},{"tagName":"p","source":"Only people with CPR training should do the next steps, between sets of 30 compressions:"},{"tagName":"p","source":"8. Tilt the person’s head back and lift their chin to keep their airway open."},{"tagName":"p","source":"9. Pinch their nose and cover their open mouth with your open mouth, making an airtight seal."},{"tagName":"p","source":"10. Blow until you see their chest rise. This is one breath. Perform two breaths, letting the lungs relax between breaths."},{"tagName":"p","source":"Continue with the pattern of 30 compressions and two breaths until the emergency services arrive."},{"tagName":"p","source":"This video demonstrates how to perform CPR on an unconscious person:"},{"widget":{"widgetFormat":"wp-youtube","align":"full","embeddedVideoCode":"https://www.youtube.com/embed/cosVBV96E2g?feature=oembed","title":"How to Perform CPR video","aspectRatio":"16x9","engagementVideoJSON":[{"toolName":"Heart Health, Breast Cancer","videoID":"LPJ86BzTvko","articleURL":"https://www.healthline.com/health/best-exercises-for-high-blood-pressure"},{"toolName":"Heart Health","videoID":"LPJ86BzTvko","articleURL":"https://www.healthline.com/health/heart-health/guide-preventing-heart-disease"},{"toolName":"Heart Health","videoID":"LPJ86BzTvko","articleURL":"https://www.healthline.com/health/heart-health/how-to-improve-heart-health-quickly"},{"toolName":"Heart Health","videoID":"gnudf5IjfFQ","articleURL":"https://www.healthline.com/health/what-to-eat-when-you-have-high-cholesterol"},{"toolName":"Heart Health","videoID":"gnudf5IjfFQ","articleURL":"https://www.healthline.com/nutrition/fiber-and-cholesterol"},{"toolName":"Heart Health","videoID":"gnudf5IjfFQ","articleURL":"https://www.healthline.com/health/how-to-eat-more-vegetables-for-a-healthy-heart"},{"toolName":"Heart Health","videoID":"TDS7Lq2g3CE","articleURL":"https://www.healthline.com/health/10-best-foods-for-heart-health"},{"toolName":"Heart Health","videoID":"TDS7Lq2g3CE","articleURL":"https://www.healthline.com/health/where-is-cholesterol-found"},{"toolName":"Heart Health","videoID":"TDS7Lq2g3CE","articleURL":"https://www.healthline.com/health/how-to-check-blood-pressure-by-hand"},{"toolName":"Heart Health","videoID":"ZxWDZU08FbE","articleURL":"https://www.healthline.com/health/video/exercise-with-afib-what-you-need-to-know"},{"toolName":"Heart Health","videoID":"ZxWDZU08FbE","articleURL":"https://www.healthline.com/health/atrial-fibrillation-natural-alternative-treatments"},{"toolName":"Heart Health","videoID":"ZxWDZU08FbE","articleURL":"https://www.healthline.com/health/atrial-fibrillation-exercise"},{"toolName":"Heart Health","videoID":"okg8bvuB_vQ","articleURL":"https://www.healthline.com/health/video/easy-chair-exercises-for-limited-mobility"},{"toolName":"Heart Health","videoID":"okg8bvuB_vQ","articleURL":"https://www.healthline.com/health/high-blood-pressure-hypertension/flying-with-high-blood-pressure"},{"toolName":"Heart Health","videoID":"YtHZHm1a_Kc","articleURL":"https://www.healthline.com/health/video/how-to-prevent-heart-disease-with-food"},{"toolName":"Heart Health","videoID":"YtHZHm1a_Kc","articleURL":"https://www.healthline.com/nutrition/best-diet-for-heart-health"},{"toolName":"Heart Health","videoID":"YtHZHm1a_Kc","articleURL":"https://www.healthline.com/nutrition/how-to-eat-less-processed-food"},{"toolName":"Heart Health","videoID":"YtHZHm1a_Kc","articleURL":"https://www.healthline.com/health/high-blood-pressure-hypertension/acv"},{"toolName":"Psoriasis","videoID":"wjs2w7Cmkgw","articleURL":"https://www.healthline.com/health/the-2025-guide-to-eating-anti-inflammatory-for-a-healthier-you"},{"toolName":"Psoriasis","videoID":"wjs2w7Cmkgw","articleURL":"https://www.healthline.com/health/recipe-roundup-anti-inflammatory-meals"},{"toolName":"Psoriasis","videoID":"wjs2w7Cmkgw","articleURL":"https://www.healthline.com/health/anti-inflammatory-ra-diet"},{"toolName":"Psoriasis","videoID":"8jM0WC7HE0Y","articleURL":"https://www.healthline.com/health/can-hand-exercises-really-help-with-arthritis-pain-try-these"},{"toolName":"Psoriasis","videoID":"8jM0WC7HE0Y","articleURL":"https://www.healthline.com/health/rheumatoid-arthritis/hand-tools-for-people-with-rheumatoid-arthritis"},{"toolName":"Psoriasis","videoID":"PX1DqUzO_8Q","articleURL":"https://www.healthline.com/health/unlock-relief-exercise-for-managing-your-psoriatic-arthritis"},{"toolName":"Psoriasis","videoID":"PX1DqUzO_8Q","articleURL":"https://www.healthline.com/health/8-essential-everyday-exercises-for-ra-pain"},{"toolName":"Psoriasis","videoID":"hlqAkpcf1tI","articleURL":"https://www.healthline.com/health/anti-inflammatory-sheet-pan-salmon"},{"toolName":"Psoriasis","videoID":"hlqAkpcf1tI","articleURL":"https://www.healthline.com/health/psoriasis/fasting-for-psoriasis"},{"toolName":"Psoriasis","videoID":"FGJZ_Ql8nXE","articleURL":"https://www.healthline.com/health/is-your-psoriasis-skincare-routine-doing-more-harm-than-good"},{"toolName":"Psoriasis","videoID":"FGJZ_Ql8nXE","arti