miumVideo":false,"isStandaloneVideo":false,"isStandaloneRecipe":false,"hasDisabledPrerollJWPlayer":false,"isNewsArticle":false,"hasEmbeddedJWPlayer":false,"byline":{"authors":[{"id":934,"name":{"display":"Jon Johnson","first":"Jon","last":"Johnson"},"link":"/authors/jon-johnson","type":{"value":"author","label":"Author"},"nid":"","specialties":[],"guestTitle":"","bio":{"text":"Jon is a writer from California and now floats somewhere on an island in the Mediterranean. He thinks most issues can be solved by petting a good dog, and he spends plenty of time doing so. Time not spent at his desk is probably spent making art or entertaining humans or other animals."},"avatar":{"title":"","width":500,"height":500,"src":"https://post.medicalnewstoday.com/wp-content/uploads/sites/3/2020/06/500x500_Jon_Johnson.png","alt":""}},{"id":5332,"name":{"display":"Alina Sharon","first":"Alina","last":"Sharon"},"link":"/authors/alina-sharon","type":{"value":"author","label":"Author"},"nid":"","specialties":[],"guestTitle":"","bio":{"text":"\u003cp data-pm-slice=\"1 1 []\"\u003eAlina Sharon is a Chicago-based editor for Medical News Today, Healthline, Healthgrades, and HelloMedicare focusing on health, wellness, and Medicare content. She has a master's degree in journalism and has worked as a writer and editor for over 10 years for U.S. and international media. She’s excited to dedicate herself to her passion for creating informative and reliable content that makes it easier for people to navigate their healthcare. Outside of work, she’s also the mom of two rambunctious boys. Connect with her on \u003ca class=\"ProsemirrorEditor-link\" href=\"https://www.linkedin.com/in/adsharon\"\u003eLinkedIn\u003c/a\u003e.\u003c/p\u003e"},"avatar":{"title":"","width":500,"height":500,"src":"https://post.medicalnewstoday.com/wp-content/uploads/2025/03/Alina-Sharon-500x500-Bio.png","alt":"Alina Sharon"}}],"medicalReviewers":[{"id":120,"name":{"display":"Carissa Stephens, R.N., CCRN, CPN","first":"Carissa","last":"Stephens, RN, CCRN, CPN"},"userLogin":"rinilope","links":{"website":"","facebook":"","linkedin":"https://www.linkedin.com/in/carissa-stephens-a168434","twitter":"","instagram":"","tiktok":""},"link":"/reviewers/carissa-stephens-rn-ccrn-cpn","type":{"value":"medical_reviewer","label":"Medical Advisor"},"nid":"122509","specialties":[],"guestTitle":"","bio":{"text":"Carissa Stephens is a pediatric nurse, with a special expertise in extracorporeal membrane oxygenation (ECMO). She is currently a nurse in a pediatric intensive care unit at Dell Children's Medical Center of Central Texas.\r\n\r\n\u003cstrong\u003eEducation\u003c/strong\u003e\r\n\u003cul\u003e\r\n \t\u003cli\u003eCollege of Charleston, BA\u003c/li\u003e\r\n \t\u003cli\u003eRoper Hospital School of Practical Nursing, LPN\u003c/li\u003e\r\n \t\u003cli\u003eExcelsior College, ASN\u003c/li\u003e\r\n \t\u003cli\u003eCapella University, BSN\u003c/li\u003e\r\n\u003c/ul\u003e\r\n\u003cstrong\u003eCertifications\u003c/strong\u003e\r\n\u003cul\u003e\r\n \t\u003cli\u003eCertified Pediatric Nurse (CPN)\u003c/li\u003e\r\n \t\u003cli\u003ePediatric Advanced Life Support (PALS)\u003c/li\u003e\r\n \t\u003cli\u003eCritical Care Registered Nurse (CCRN)\u003c/li\u003e\r\n\u003c/ul\u003e\r\n\u003cstrong\u003eProfessional Accomplishments\u003c/strong\u003e\r\n\u003cul\u003e\r\n \t\u003cli\u003eDaisy Award Recipient\u003c/li\u003e\r\n \t\u003cli\u003eNurse of the Year finalist\u003c/li\u003e\r\n \t\u003cli\u003eExcellence in Action Recipient\u003c/li\u003e\r\n\u003c/ul\u003e\r\n\u003cstrong\u003eAffiliations\u003c/strong\u003e\r\n\u003cul\u003e\r\n \t\u003cli\u003e\u003ca href=\"https://www.nursingworld.org/\"\u003eAmerican Nurses Association (ANA)\u003c/a\u003e\u003c/li\u003e\r\n \t\u003cli\u003e\u003ca href=\"https://www.aacn.org/\"\u003eAmerican Association of Critical-Care Nurses (AACN)\u003c/a\u003e\u003c/li\u003e\r\n\u003c/ul\u003e"},"avatar":{"title":"","width":500,"height":500,"src":"https://post.medicalnewstoday.com/wp-content/uploads/2024/12/Carissa-Stephens-new-format-500x500-1.png","alt":"Carissa Stephens"}}],"id":"mnt-1013634","updateReason":["The article was updated with additional information to ensure it provides our readers with a comprehensive overview of the topic."],"editor":"Alina Sharon","factCheckedBy":"","factCheckers":[],"articleHistory":{"2018-08-24":{"updateReason":[],"authors":"Jon Johnson","editor":"Alice Porter-McLaughlin","medicallyReviewedBy":"Nancy Moyer, MD"},"2023-05-30":{"updateReason":["The article was updated with additional information to ensure it provides our readers with a comprehensive overview of the topic."],"authors":"Jon Johnson, Alina Sharon","editor":"Alina Sharon","copyEditor":"Gianna D'Emilio"},"2021-06-29":{"medicallyReviewedBy":"Carissa Stephens, RN, CCRN, CPN"}},"articleDates":{"factChecked":{"date":null,"display":""},"medicallyReviewed":{"date":1624924800,"display":"June 29, 2021"},"published":{"date":1535133600,"display":"August 24, 2018"},"lastUpdates":{"date":1685404800,"display":"May 30, 2023"},"modified":{"date":1685447389,"display":"May 30, 2023"}},"type":"healthfeature","language":"en"},"cesData":{"metaDescription":"Knowing how to identify unconsciousness, how to help, and when to contact emergency services can be lifesaving. Learn about first aid, fainting, and more.","title":"First aid for unconsciousness: What to do and when to seek help","iab_tag_tier_1":[],"iab_tag_tier_2":[],"mpdTags":[{"confidence":0.9510018598934815,"type":"topic_level_1","value":"health"},{"confidence":0.6180289943291906,"type":"topic_level_2","value":"physical_conditions"},{"confidence":0.3366459571730095,"type":"topic_level_3","value":"ear_nose_and_throat"},{"confidence":0.6784707580517172,"type":"topic_level_4","value":"difficulty_swallowing"},{"confidence":0.3161135415299129,"type":"entity","value":"unconsciousness"}]},"careJourney":{"engagementVideoJSON":[{"toolName":"Heart Health, Breast Cancer","videoID":"LPJ86BzTvko","articleURL":"htt