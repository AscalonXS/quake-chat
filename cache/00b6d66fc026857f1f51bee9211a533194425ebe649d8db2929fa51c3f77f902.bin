r":{"title":"","width":500,"height":500,"src":"https://post.medicalnewstoday.com/wp-content/uploads/sites/3/2020/06/500x500_Jon_Johnson.png","alt":""}},{"id":5332,"name":{"display":"Alina Sharon","first":"Alina","last":"Sharon"},"link":"/authors/alina-sharon","type":{"value":"author","label":"Author"},"nid":"","specialties":[],"guestTitle":"","bio":{"text":"<p data-pm-slice=\"1 1 []\">Alina Sharon is a Chicago-based editor for Medical News Today, Healthline, Healthgrades, and HelloMedicare focusing on health, wellness, and Medicare content. She has a master's degree in journalism and has worked as a writer and editor for over 10 years for U.S. and international media. She’s excited to dedicate herself to her passion for creating informative and reliable content that makes it easier for people to navigate their healthcare. Outside of work, she’s also the mom of two rambunctious boys. Connect with her on <a class=\"ProsemirrorEditor-link\" href=\"https://www.linkedin.com/in/adsharon\">LinkedIn</a>.</p>"},"avatar":{"title":"","width":500,"height":500,"src":"https://post.medicalnewstoday.com/wp-content/uploads/2025/03/Alina-Sharon-500x500-Bio.png","alt":"Alina Sharon"}}],"medicalReviewers":[{"id":120,"name":{"display":"Carissa Stephens, R.N., CCRN, CPN","first":"Carissa","last":"Stephens, RN, CCRN, CPN"},"userLogin":"rinilope","links":{"website":"","facebook":"","linkedin":"https://www.linkedin.com/in/carissa-stephens-a168434","twitter":"","instagram":"","tiktok":""},"link":"/reviewers/carissa-stephens-rn-ccrn-cpn","type":{"value":"medical_reviewer","label":"Medical Advisor"},"nid":"122509","specialties":[],"guestTitle":"","bio":{"text":"Carissa Stephens is a pediatric nurse, with a special expertise in extracorporeal membrane oxygenation (ECMO). She is currently a nurse in a pediatric intensive care unit at Dell Children's Medical Center of Central Texas.\r\n\r\n<strong>Education</strong>\r\n<ul>\r\n \t<li>College of Charleston, BA</li>\r\n \t<li>Roper Hospital School of Practical Nursing, LPN</li>\r\n \t<li>Excelsior College, ASN</li>\r\n \t<li>Capella University, BSN</li>\r\n</ul>\r\n<strong>Certifications</strong>\r\n<ul>\r\n \t<li>Certified Pediatric Nurse (CPN)</li>\r\n \t<li>Pediatric Advanced Life Support (PALS)</li>\r\n \t<li>Critical Care Registered Nurse (CCRN)</li>\r\n</ul>\r\n<strong>Professional Accomplishments</strong>\r\n<ul>\r\n \t<li>Daisy Award Recipient</li>\r\n \t<li>Nurse of the Year finalist</li>\r\n \t<li>Excellence in Action Recipient</li>\r\n</ul>\r\n<strong>Affiliations</strong>\r\n<ul>\r\n \t<li><a href=\"https://www.nursingworld.org/\">American Nurses Association (ANA)</a></li>\r\n \t<li><a href=\"https://www.aacn.org/\">American Association of Critical-Care Nurses (AACN)</a></li>\r\n</ul>"},"avatar":{"title":"","width":500,"height":500,"src":"https://post.medicalnewstoday.com/wp-content/uploads/2024/12/Carissa-Stephens-new-format-500x500-1.png","alt":"Carissa Stephens"}}],"id":"mnt-1013634","updateReason":["The article was updated with additional information to ensure it provides our readers with a comprehensive overview of the topic."],"editor":"Alina Sharon","factCheckedBy":"","factCheckers":[],"articleHistory":{"2018-08-24":{"updateReason":[],"authors":"Jon Johnson","editor":"Alice Porter-McLaughlin","medicallyReviewedBy":"Nancy Moyer, MD"},"2023-05-30":{"updateReason":["The article was updated with additional information to ensure it provides our readers with a comprehensive overview of the topic."],"authors":"Jon Johnson, Alina Sharon","editor":"Alina Sharon","copyEditor":"Gianna D'Emilio"},"2021-06-29":{"medicallyReviewedBy":"Carissa Stephens, RN, CCRN, CPN"}},"articleDates":{"factChecked":{"date":null,"display":""},"medicallyReviewed":{"date":1624924800,"display":"June 29, 2021"},"published":{"date":1535133600,"display":"August 24, 2018"},"lastUpdates":{"date":1685404800,"display":"May 30, 2023"},"modified":{"date":1685447389,"display":"May 30, 2023"}},"type":"healthfeature","language":"en"},"c