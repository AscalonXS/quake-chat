 <script>
  jQuery(window).on("scroll", onScroll);

function onScroll(event) {
  var scrollPos = jQuery(document).scrollTop();
  console.log("scrollPos",scrollPos);

  jQuery("#menu-center a").each(function () {
    var currLink = jQuery(this);
    var refElement = jQuery(currLink.attr("href"));

    console.log("refElement.offset().top", refElement.offset().top);
    if (
      refElement.offset().top - 160 <= scrollPos &&
      refElement.offset().top + refElement.height() > scrollPos
    ) {
      jQuery("#menu-center ul li a").removeClass("active");
      currLink.addClass("active");
    } else {
      if(refElement.offset().top >= scrollPos){
        if($( "#menu-center ul li").not( ":nth-child(1)").find('a').hasClass('active')){
          jQuery("#menu-center ul li a").first().removeClass("active");
        }else{
          jQuery("#menu-center ul li a").first().addClass("active");
        }
      }else{
         currLink.removeClass("active");
      }
    }
  });
}
jQuery(".tab-row a").each(function () {
  jQuery(this).on("click", function (event) {
    event.preventDefault();
    var currentId = jQuery(this).attr("href");
    setTimeout(() => {
      jQuery("html, body").animate(
        {
          scrollTop: jQuery(currentId).offset().top - 160
        },
        0
      );
    }, 0);
  });
});
	 

</script>
<script>
$(document).ready(function () {

    var limit = 80; // কত অক্ষর পর্যন্ত দেখাবে

    $(".read-more-text").each(function () {

        var fullText = $.trim($(this).text());

        if (fullText.length > limit) {

            var shortText = fullText.substring(0, limit);

            $(this).attr("data-full", fullText);
            $(this).attr("data-short", shortText);

            $(this).text(shortText + "...");
        } else {
            $(this).siblings(".read-more-btn").hide();
        }

    });

    $(".read-more-btn").on("click", function (e) {

        e.preventDefault();

        var btn = $(this);
        var text = btn.siblings(".read-more-text");

        text.stop(true, true).fadeOut(200, function () {

            if (btn.hasClass("expanded")) {

                text.text(text.attr("data-short") + "...");
                btn.removeClass("expanded").text("Read More");

            } else {

                text.text(text.attr("data-full"));
                btn.addClass("expanded").text("Read Less");

            }

            text.fadeIn(200);

        });

    });

});
	
var reviewCarousel = $(".google-review-carousel");

reviewCarousel.owlCarousel({
    autoplay: true,
    autoplayHoverPause: true,
    autoplayTimeout: 3000,
    autoplaySpeed: 800,
    margin: 16,
    loop: true,
    nav: true,
    dots: false,
	autoHeight:true,
    responsive: {
        0: {
            items: 1,
        },
        640: {
            items: 2,
        },
        1000: {
            items: 3,
        },
    },
    onInitialized: function () {
        $(".google-review-carousel .owl-prev").css("opacity", "0");
    },
    onTranslated: function () {
        $(".google-review-carousel .owl-prev").css("opacity", "1");
    }
});
</script>

