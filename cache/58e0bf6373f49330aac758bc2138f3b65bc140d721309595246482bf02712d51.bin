re you interested in?","questionType":"topic","cta":"Continue"},{"title":"For the topics you selected, what do you want to learn more about?","questionType":"subtopic","cta":"Continue"},{"title":"Where could you use more guidance?","questionType":"jtbd","cta":"Continue"}]}},"trackingTerms":[],"isPremiumVideo":false,"isStandaloneVideo":false,"isStandaloneRecipe":false,"hasDisabledPrerollJWPlayer":false,"isNewsArticle":false,"hasEmbeddedJWPlayer":false,"byline":{"authors":[{"id":193,"name":{"display":"Tim Jewell","first":"Tim","last":"Jewell"},"link":"/authors/tim-jewell","type":{"value":"author","label":"Author"},"nid":"","specialties":[],"guestTitle":"","bio":{"text":"Tim Jewell is a freelance writer, linguist, and communications expert based in Southern California. At age 4, he read a book called “1001 Questions about the Human Body” and has since dedicated his life to breaking down the complexities and stigmas around the human body and the cultures surrounding it, especially in relation to mental health, sexual health, and gender identity. Follow him on <a href=\"http://TimJewell16\">Twitter</a> and <a href=\"https://www.instagram.com/diakritik/\">Instagram</a>."},"avatar":{"title":"","width":200,"height":200,"src":"https://post.healthline.com/wp-content/uploads/2019/11/Tim_Jewell_bw.png","alt":""}}],"medicalReviewers":[{"id":114,"name":{"display":"Adithya Cattamanchi, M.D.","first":"Adithya","last":"Cattamanchi, MD"},"userLogin":"acattamanchi","links":{"website":"","facebook":"","linkedin":"https://www.linkedin.com/in/adithyacattamanchi/","twitter":"","instagram":"","tiktok":""},"link":"/reviewers/adithya-cattamanchi-md","type":{"value":"medical_reviewer","label":"Medical Advisor"},"nid":"122507","specialties":[],"guestTitle":"","bio":{"text":"Dr. Adithya Cattamanchi is an <a href=\"https://www.abms.org/board-certification/\">ABMS board certified</a> pulmonologist who also specializes in critical care medicine. He currently practices at UCI Health and is a professor of medicine at University of California Irvine.\r\n\r\n<strong>Education</strong>\r\n<ul>\r\n \t<li>Duke University, BA</li>\r\n \t<li>University of California, San Francisco School of Medicine, MD, MAS</li>\r\n</ul>\r\n<strong>Certifications</strong>\r\n<ul>\r\n \t<li>American Board of Internal Medicine - Pulmonary Medicine</li>\r\n \t<li>American Board of Internal Medicine - Critical Care</li>\r\n</ul>\r\n<strong>Professional Accomplishments</strong>\r\n<ul>\r\n \t<li>Researched the epidemiology and management of tuberculosis in high burden countries</li>\r\n \t<li>Published over 150 articles related to tuberculosis and other lung diseases in peer-reviewed medical journals</li>\r\n</ul>\r\n<strong>Affiliations</strong>\r\n<ul>\r\n \t<li><a href=\"https://www.thoracic.org/\">American Thoracic Society (ATS)</a></li>\r\n \t<li><a href=\"https://theunion.org/\">International Union Against Tuberculosis and Lung Disease</a></li>\r\n</ul>"},"avatar":{"title":"","width":500,"height":500,"src":"https://post.healthline.com/wp-content/uploads/2022/01/Adithya-Cattamanchi-500x500-Bio.png","alt":""}}],"id":"wp-651099","updateReason":[],"factCheckedBy":"","factCheckers":[],"articleHistory":[],"articleDates":{"factChecked":{"date":null,"display":""},"medicallyReviewed":{"date":1512115200,"display":"December 1, 2017"},"published":{"date":1512115200,"display":"December 1, 2017"},"lastUpdates":{"date":1537245471,"display":"September 18, 2018"},"modified":{"date":1537270671,"display":"September 18, 2018"}},"type":"healthfeature","language":"en"},"cesData":{"metaDescription":"A sucking chest wound is serious and, without prompt treatment, may be fatal.","title":"Sucking Chest Wound: First Aid, Treatment, and Recovery","iab_tag_tier_1":["300"],"iab_tag_tier_2":["300"],"mpdTags":[{"confidence":0.9043133415876209,"type":"topic_level_1","value":"health"},{"confidence":0.820710960062712,"type":"topic_level_2","value":"physical_conditions"},{"confidence":0.09449560181578197,"type":"topi