  (function () {
    var state = (window.SERVICIFY_CALENDAR_GUARD =
      window.SERVICIFY_CALENDAR_GUARD || { installed: false, pending: null });
    if (state.installed) return;
    state.installed = true;

    var SELECTOR =
      'a[href*="servicify-calendar"], a[data-original-href*="servicify-calendar"], button[data-href*="servicify-calendar"]';

    function onCalendarClick(event) {
      var target = event.target;
      if (!target || typeof target.closest !== "function") return;
      var trigger = target.closest(SELECTOR);
      if (!trigger) return;
      // Already wired up: its own handler opens the modal.
      if (trigger.hasAttribute("data-servicify-modal-bound")) return;
      // Only a live anchor can navigate; a <button data-href> just gets its
      // otherwise-lost click recorded.
      if (trigger.hasAttribute("href")) event.preventDefault();
      state.pending = { element: trigger, at: Date.now() };
    }

    document.addEventListener("click", onCalendarClick, true);
    // Middle-click never fires `click`, so it would park a 404 in a background tab.
    document.addEventListener("auxclick", onCalendarClick, true);
  })();
</script><div id="servicify-app-embed-container">
