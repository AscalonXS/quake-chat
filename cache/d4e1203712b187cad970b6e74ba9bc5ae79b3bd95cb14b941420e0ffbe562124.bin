\"id\":\"key-takeaways-title\",\"className\":\"text-base font-bold text-foreground md:text-[17px]\",\"children\":\"Key takeaways\"}],[\"$\",\"ul\",null,{\"className\":\"mt-3 space-y-2.5\",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"flex gap-3 text-[15.5px] leading-relaxed text-foreground md:text-base\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2.5,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-check mt-[3px] h-5 w-5 shrink-0 text-primary\",\"aria-hidden\":true,\"children\":[[\"$\",\"path\",\"1gmf2c\",{\"d\":\"M20 6 9 17l-5-5\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"children\":\"After a fall from height, a vehicle crash or a blow to the head, assume neck or back pain is spinal.\"}]]}],[\"$\",\"li\",\"1\",{\"className\":\"flex gap-3 text-[15.5px] leading-relaxed text-foreground md:text-base\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2.5,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-check mt-[3px] h-5 w-5 shrink-0 text-primary\",\"aria-hidden\":true,\"children\":[[\"$\",\"path\",\"1gmf2c\",{\"d\":\"M20 6 9 17l-5-5\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"children\":\"If there is no danger, keep the casualty where you found them; do not let them stand or sit.\"}]]}],[\"$\",\"li\",\"2\",{\"className\":\"flex gap-3 text-[15.5px] leading-relaxed text-foreground md:text-base\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2.5,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-check mt-[3px] h-5 w-5 shrink-0 text-primary\",\"aria-hidden\":true,\"children\":[[\"$\",\"path\",\"1gmf2c\",{\"d\":\"M20 6 9 17l-5-5\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"children\":\"Hold the head with both palms over the ears, without pulling or turning it.\"}]]}],[\"$\",\"li\",\"3\",{\"className\":\"flex gap-3 text-[15.5px] leading-relaxed text-foreground md:text-base\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2.5,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-check mt-[3px] h-5 w-5 shrink-0 text-primary\",\"aria-hidden\":true,\"children\":[[\"$\",\"path\",\"1gmf2c\",{\"d\":\"M20 6 9 17l-5-5\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"children\":\"Do not fit a neck collar unless trained; Turkish and international guidelines agree on this.\"}]]}],[\"$\",\"li\",\"4\",{\"className\":\"flex gap-3 text-[15.5px] leading-relaxed text-foreground md:text-base\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2.5,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-check mt-[3px] h-5 w-5 shrink-0 text-primary\",\"aria-hidden\":true,\"children\":[[\"$\",\"path\",\"1gmf2c\",{\"d\":\"M20 6 9 17l-5-5\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"children\":\"Breathing comes before the spine: roll a vomiting or unconscious casualty onto their side as one unit.\"}]]}]]}]]}]\n"])</script><script>self.__next_f.push([1,"26:[\"$\",\"details\",null,{\"className\":\"group mt-5 rounded-xl border border-border bg-surface lg:hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex min-h-12 cursor-pointer list-none items-ce