>self.__next_f.push([1,"{\"@context\":\"https://schema.org\",\"@type\":[\"MedicalWebPage\",\"BlogPosting\"],\"@id\":\"https://www.novaambulans.com/en/blog/spinal-neck-injury-first-aid-when-to-move\",\"headline\":\"Spinal \u0026 Neck Injury First Aid: When Not to Move Them\",\"description\":\"Neck or back pain, or numbness, tingling or weakness in the arms and legs after a fall from height, a traffic collision or a hard blow to the head points to a spinal injury. Call 112, keep the casualty in the position you found them if there is no danger, do not let them get up and hold their head still with both hands. Do not fit a neck collar unless you are trained. If they are unconscious but breathing, roll them onto their side keeping the head, neck and trunk in line; if they are not breathing, start Basic Life Support (BLS).\",\"image\":\"https://www.novaambulans.com/blog-images/omurga-boyun-yaralanmasi-ilk-yardim.webp\",\"datePublished\":\"2026-10-19T00:00:00+03:00\",\"dateModified\":\"2026-10-19T00:00:00+03:00\",\"lastReviewed\":\"2026-10-19T00:00:00+03:00\",\"inLanguage\":\"en-US\",\"specialty\":\"EmergencyMedicine\",\"contentLocation\":{\"@type\":\"City\",\"name\":\"İstanbul\",\"containedInPlace\":{\"@type\":\"Country\",\"name\":\"Turkey\"}},\"spatialCoverage\":{\"@type\":\"Place\",\"name\":\"İstanbul, Türkiye\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"İstanbul\",\"addressCountry\":\"TR\"}},\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://www.novaambulans.com/en/blog/spinal-neck-injury-first-aid-when-to-move\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"Nova Ambulans\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://www.novaambulans.com/nova-ambulans-logo.svg\"}},\"author\":{\"@type\":\"Organization\",\"name\":\"Nova Ambulans\",\"url\":\"https://www.novaambulans.com\"},\"audience\":{\"@type\":\"MedicalAudience\",\"audienceType\":\"Patient\"},\"medicalAudience\":{\"@type\":\"MedicalAudience\",\"audienceType\":\"Patient\"},\"citation\":[{\"@type\":\"CreativeWork\",\"@id\":\"https://www.ilkyardim.org.tr/dokumanlar/cep_kitap_2025.pdf#source\",\"name\":\"Türk Kızılay İlk Yardım Cep Kitabı 2025\",\"url\":\"https://www.ilkyardim.org.tr/dokumanlar/cep_kitap_2025.pdf\",\"inLanguage\":\"tr-TR\",\"publisher\":{\"@type\":\"Organization\",\"name\":\"Türk Kızılay\"},\"datePublished\":\"2025-10-16\",\"dateModified\":\"2026-10-19\"},{\"@type\":\"CreativeWork\",\"@id\":\"https://dosyamerkez.saglik.gov.tr/Eklenti/51010/0/sbacil-saglik-ilk-yardim-egitimi-kitabi-mayis-2025pdf.pdf#source\",\"name\":\"İlk Yardım Eğitim Kitabı (Mayıs 2025)\",\"url\":\"https://dosyamerkez.saglik.gov.tr/Eklenti/51010/0/sbacil-saglik-ilk-yardim-egitimi-kitabi-mayis-2025pdf.pdf\",\"inLanguage\":\"tr-TR\",\"publisher\":{\"@type\":\"Organization\",\"name\":\"T.C. Sağlık Bakanlığı Acil Sağlık Hizmetleri Genel Müdürlüğü\"},\"datePublished\":\"2025-05-16\",\"dateModified\":\"2026-10-19\"},{\"@type\":\"CreativeWork\",\"@id\":\"https://acilafet.saglik.gov.tr/TR-108329/9-yaralanmalarda-ilkyardim.html#source\",\"name\":\"İlk Yardım Eğitim Sunumları — 9. Yaralanmalarda İlkyardım\",\"url\":\"https://acilafet.saglik.gov.tr/TR-108329/9-yaralanmalarda-ilkyardim.html\",\"inLanguage\":\"tr-TR\",\"publisher\":{\"@type\":\"Organization\",\"name\":\"T.C. Sağlık Bakanlığı Acil Sağlık Hizmetleri Genel Müdürlüğü\"},\"datePublished\":\"2025-06-18\",\"dateModified\":\"2026-10-19\"},{\"@type\":\"CreativeWork\",\"@id\":\"https://www.kgm.gov.tr/SiteCollectionDocuments/KGMdocuments/Trafik/Trafik-kaza-ozetbilgi.pdf#source\",\"name\":\"2025 Yılı Trafik Kazalarına Ait Özet Bilgiler\",\"url\":\"https://www.kgm.gov.tr/SiteCollectionDocuments/KGMdocuments/Trafik/Trafik-kaza-ozetbilgi.pdf\",\"inLanguage\":\"tr-TR\",\"publisher\":{\"@type\":\"Organization\",\"name\":\"T.C. Karayolları Genel Müdürlüğü (veri kaynağı TÜİK)\"},\"datePublished\":\"2026-06-17\",\"dateModified\":\"2026-10-19\"},{\"@type\":\"CreativeWork\",\"@id\":\"https://www.who.int/news-room/fact-sheets/detail/spinal-cord-injury#source\",\"name\":\"Spinal cord injury — Fact sheet\",\"url\":\"https://www.who.int/news-room/fact-sheets/detail/spinal-cord-injury\",\"inLanguage\":\"en-US\",\"publisher\":{\"@type\":\"Organization\",\"name\":\"World Health Organization\"},\"datePublished\":\"2024-04-16\",\"dateModified\":\"2026-10-19\"},{\"@type\":\"CreativeWork\",\"@id\":\"https://pubmed.ncbi.nlm.nih.gov/41122841/#source\",\"name\":\"First Aid: 2025 International Liaison Committee on Resuscitation Consensus on Science With Treatment Recommendations\",\"url\":\"https://pubmed.ncbi.nlm.nih.gov/41122841/\",\"inLanguage\":\"en-US\",\"publisher\":{\"@type\":\"Organization\",\"name\":\"Circulation (American Heart Association) — PMID 41122841\"},\"datePublished\":\"2025-10-22\",\"dateModified\":\"2026-10-19\"},{\"@type\":\"CreativeWork\",\"@id\":\"https://pubmed.ncbi.nlm.nih.gov/42412097/#source\",\"name\":\"Traumatic spinal fractures: epidemiological and clinical evaluation in a forensic medicine clinic sample\",\"url\":\"https://pubmed.ncbi.nlm.nih.gov/42412097/\",\"inLanguage\":\"en-US\",\"publisher\":{\"@type\":\"Organization\",\"name\":\"Ulusal Travma ve Acil Cerrahi Dergisi — PMID 42412097\"},\"dateModified\":\"2026-10-19\"},{\"@type\":\"CreativeWork\",\"@id\":\"https://pubmed.ncbi.nlm.nih.gov/42458424/#source\",\"name\":\"Quality of life and health challenges among individuals with spinal cord injury in Türkiye: findings from the InSCI dataset\",\"url\":\"https://pubmed.ncbi.nlm.nih.gov/42458424/\",\"inLanguage\":\"en-US\",\"publisher\":{\"@type\":\"Organization\",\"name\":\"BMC Musculoskeletal Disorders — PMID 42458424\"},\"datePublished\":\"2026-07-15\",\"dateModified\":\"2026-10-19\"},{\"@type\":\"CreativeWork\",\"@id\":\"https://www.anzcor.org/home/first-aid/guideline-9-1-6-management-of-suspected-spinal-injury#source\",\"name\":\"Guideline 9.1.6 — Management of Suspected Spinal Injury\",\"url\":\"https://www.anzcor.org/home/first-aid/guideline-9-1-6-management-of-suspected-spinal-injury\",\"inLanguage\":\"en-US\",\"publisher\":{\"@type\":\"Organization\",\"name\":\"Australian and New Zealand Committee on Resuscitation\"},\"dateModified\":\"2026-10-19\"}],\"isBasedOn\":[\"https://www.ilkyardim.org.tr/dokumanlar/cep_kitap_2025.pdf\",\"https://dosyamerkez.saglik.gov.tr/Eklenti/51010/0/sbacil-saglik-ilk-yardim-egitimi-kitabi-mayis-2025pdf.pdf\",\"https://acilafet.saglik.gov.tr/TR-108329/9-yaralanmalarda-ilkyardim.html\",\"https://www.kgm.gov.tr/SiteCollectionDocuments/KGMdocuments/Trafik/Trafik-kaza-ozetbilgi.pdf\",\"https://www.who.int/news-room/fact-sheets/detail/spinal-cord-injury\",\"https://pubmed.ncbi.nlm.nih.gov/41122841/\",\"https://pubmed.ncbi.nlm.nih.gov/42412097/\",\"https://pubmed.ncbi.nlm.nih.gov/42458424/\",\"https://www.anzcor.org/home/first-aid/guideline-9-1-6-management-of-suspected-spinal-injury\"],\"speakable\":{\"@type\":\"SpeakableSpecification\",\"cssSelector\":[\".key-takeaways\",\"article \u003e .description\",\"h1\"],\"url\":\"https://www.novaambulans.com/en/blog/spinal-neck-injury-first-aid-when-to-move\"}}"])</script><script>self.__next_f.push([1,"5:[[\"$\",\"$L19\",null,{\"items\":[{\"name\":\"Home\",\"item\":\"https://www.novaambulans.com/en\"},{\"name\":\"Blog\",\"item\":\"https://www.novaambulans.com/en/blog\"},{\"name\":\"Spinal and Neck Injury First Aid: When Not to Move the Casualty, and When to Roll Them\",\"item\":\"https://www.novaambulans.com/en/blog/spinal-neck-injury-first-aid-when-to-move\"}]}],[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"id\":\"blog-breadcrumb-jsonld\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"BreadcrumbList\\\",\\\"itemListElement\\\":[{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":1,\\\"name\\\":\\\"Home\\\",\\\"item\\\":\\\"https://www.novaambulans.com/en\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":2,\\\"name\\\":\\\"Blog\\\",\\\"item\\\":\\\"https://www.novaambulans.com/en/blog\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":3,\\\"name\\\":\\\"Spinal and Neck Injury First Aid: When Not to Move the Casualty, and When to Roll Them\\\",\\\"item\\\":\\\"https://www.novaambulans.com/en/blog/spinal-neck-injury-first-aid-when-to-move\\\"}]}\"}}],[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$1a\"}}],\"$L1b\",\"$L1c\"]\n"])</script><script>self.__next_f.push([1,"1e:I[22016,[\"/_next/static/chunks/14zr3-mman5lo.js\",\"/_next/static/chunks/0kd2fiwchdadx.js\",\"/_next/static/chunks/065uoviml_0ot.js\",\"/_next/static/chunks/09vlc7xhn5abh.js\",\"/_next/static/chunks/0dv0_-e5tsref.js\",\"/_next/static/chunks/0ebfi1r6xnvnj.js\",\"/_next/static/chunks/0trve_7dlxj4x.js\",\"/_next/static/chunks/06dkrx0~.hv.m.js\"],\"\"]\n1d:Te44,"])</script><script>self.__next_f.push([1,"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"inLanguage\":\"en-US\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"How can you tell if someone has a spinal injury?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The Turkish Ministry of Health First Aid Training Book (May 2025) lists five signs: pain at the injury site, tenderness at the injury site, reduced or lost sensation below the injury, reduced or lost strength below it, and numbness, tingling or loss of feeling in the hands and feet [2]. The first two items are only pain and tenderness, so neck or back pain after a fall from height or a vehicle crash is enough to suspect a spinal injury even if the arms and legs move normally. In someone who is unconscious or has taken a blow to the head, a spinal injury is assumed until proven otherwise [2].\"}},{\"@type\":\"Question\",\"name\":\"Should you move someone with a suspected broken neck?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Not if there is no danger. The Turkish Red Crescent First Aid Pocket Book 2025 says people with a suspected spinal injury should not be moved unless there is danger, and should not be allowed to move either [1]. If there is danger such as fire, explosion, moving traffic, water or a risk of collapse, move the casualty to safety keeping the head, neck and trunk in line [9]. If they vomit or lose consciousness, roll them onto their side as one unit, again keeping the head, neck and trunk aligned, to protect the airway [2].\"}},{\"@type\":\"Question\",\"name\":\"Should you put a neck collar on a spinal injury?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No, unless you are trained. The Turkish Ministry of Health May 2025 book says so explicitly [2]. The 2025 first-aid statement of the International Liaison Committee on Resuscitation (ILCOR) also suggests that first aid providers do not use cervical collars; the studies it reviewed showed that collars reduce neck movement but can impair breathing and swallowing and raise the pressure inside the skull [6]. Holding the head still with both hands until the ambulance crew arrives is enough.\"}},{\"@type\":\"Question\",\"name\":\"What do you do if someone with a suspected spinal injury is unconscious but breathing?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"In an unconscious person the muscles relax and the tongue can block the airway [1]. That is why the Turkish Ministry of Health May 2025 book advises holding the head and neck by hand and placing the casualty in the recovery position while keeping the head, neck and spine in line [2]. Do it with two or more people if you can: one holds only the head and gives the commands, the others turn the body at the shoulder and hip. Check breathing every 2-3 minutes; if breathing stops, roll them onto their back and start Basic Life Support (BLS). The detailed chest compression technique is in our Basic Life Support (BLS) guide.\"}},{\"@type\":\"Question\",\"name\":\"Can someone who gets up and walks after a fall still have a broken spine?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. In the Turkish Ministry of Health May 2025 list of signs, pain and tenderness come before numbness or weakness [2]. In a 2026 study of 277 spinal fractures seen in Erzurum between 2020 and 2022, the most common site was the junction of the thoracic and lumbar spine (31.8%) [7]. Instead of driving someone with back pain after a fall from height or a crash to hospital yourself, call 112 and keep them lying down.\"}}],\"@id\":\"https://www.novaambulans.com/en/blog/spinal-neck-injury-first-aid-when-to-move#faq\",\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://www.novaambulans.com/en/blog/spinal-neck-injury-first-aid-when-to-move\"}}"])</script><script>self.__next_f.push([1,"1b:[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$1d\"}}]\n"])</script><script>self.__next_f.push([1,"1c:[\"$\",\"div\",null,{\"className\":\"bg-background text-foreground\",\"children\":[[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-[1120px] px-4 pt-5 md:px-8 md:pt-10\",\"children\":[\"$\",\"div\",null,{\"className\":\"lg:grid lg:grid-cols-[minmax(0,792px)_216px] lg:justify-center lg:gap-12\",\"children\":[[\"$\",\"div\",null,{\"className\":\"min-w-0\",\"children\":[[\"$\",\"nav\",null,{\"aria-label\":\"Breadcrumb\",\"className\":\"-mt-3 mb-1 md:mb-2\",\"children\":[\"$\",\"ol\",null,{\"className\":\"flex min-w-0 flex-wrap items-center gap-x-1 gap-y-1 text-[13px] text-muted-foreground\",\"children\":[[\"$\",\"li\",null,{\"className\":\"inline-flex items-center\",\"children\":[\"$\",\"$L1e\",null,{\"href\":\"/en\",\"className\":\"inline-flex min-h-11 items-center rounded-sm hover:text-foreground hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring\",\"children\":\"Home\"}]}],[\"$\",\"li\",null,{\"className\":\"inline-flex items-center gap-1\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-chevron-right h-3.5 w-3.5\",\"aria-hidden\":true,\"children\":[[\"$\",\"path\",\"mthhwq\",{\"d\":\"m9 18 6-6-6-6\"}],\"$undefined\"]}],[\"$\",\"$L1e\",null,{\"href\":\"/en/blog\",\"className\":\"inline-flex min-h-11 items-center rounded-sm hover:text-foreground hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring\",\"children\":\"Blog\"}]]}],[\"$\",\"li\",null,{\"className\":\"hidden min-w-0 max-w-full items-center gap-1 sm:inline-flex\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-chevron-right h-3.5 w-3.5 shrink-0\",\"aria-hidden\":true,\"children\":[[\"$\",\"path\",\"mthhwq\",{\"d\":\"m9 18 6-6-6-6\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"aria-current\":\"page\",\"className\":\"max-w-[15rem] truncate font-medium text-foreground sm:max-w-[30rem]\",\"children\":\"Spinal and Neck Injury First Aid: When Not to Move the Casualty, and When to Roll Them\"}]]}]]}]}],[\"$\",\"article\",null,{\"className\":\"-mx-4 border-y border-border bg-surface px-5 pb-10 pt-7 shadow-[0_1px_3px_rgba(15,23,36,0.06)] sm:mx-0 sm:rounded-2xl sm:border-x sm:px-8 md:px-12 md:pb-14 md:pt-11 lg:px-14\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-1.5 text-[13px] font-semibold leading-none text-foreground\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":true,\"className\":\"h-2 w-2 shrink-0 rounded-full\",\"style\":{\"background\":\"hsl(var(--primary))\"}}],\"Education\"]}],[\"$\",\"h1\",null,{\"className\":\"mt-4 text-[1.875rem] font-extrabold leading-[1.1] tracking-[-0.025em] text-foreground [text-wrap:balance] md:text-[2.5rem] lg:text-[2.75rem]\",\"children\":\"Spinal and Neck Injury First Aid: When Not to Move the Casualty, and When to Roll Them\"}],[\"$\",\"p\",null,{\"className\":\"description mt-4 text-[1.0625rem] leading-relaxed text-foreground/80 md:mt-5 md:text-[1.1875rem] md:leading-[1.65]\",\"children\":\"Neck or back pain, or numbness, tingling or weakness in the arms and legs after a fall from height, a traffic collision or a hard blow to the head points to a spinal injury. Call 112, keep the casualty in the position you found them if there is no danger, do not let them get up and hold their head still with both hands. Do not fit a neck collar unless you are trained. If they are unconscious but breathing, roll them onto their side keeping the head, neck and trunk in line; if they are not breathing, start Basic Life Support (BLS).\"}],[\"$\",\"dl\",null,{\"className\":\"mt-7 grid grid-cols-2 gap-x-6 gap-y-4 border-y border-border py-5 text-[15px] leading-snug sm:grid-cols-[minmax(0,1.6fr)_repeat(3,minmax(max-content,1fr))]\",\"children\":[[\"$\",\"div\",null,{\"className\":\"col-span-2 sm:col-span-1\",\"children\":[\"$L1f\",\"$L20\"]}],\"$L21\",\"$L22\",\"$L23\"]}],\"$L24\",\"$L25\",\"$L26\",\"$L27\",\"$L28\",\"$L29\",\"$L2a\",\"\",\"$L2b\",\"$L2c\",\"$L2d\",\"$L2e\"]}]]}],\"$L2f\"]}]}],\"$L30\",\"$L31\",\"$L32\"]}]\n"])</script><script>self.__next_f.push([1,"3b:I[67572,[\"/_next/static/chunks/14zr3-mman5lo.js\",\"/_next/static/chunks/0kd2fiwchdadx.js\",\"/_next/static/chunks/065uoviml_0ot.js\",\"/_next/static/chunks/09vlc7xhn5abh.js\",\"/_next/static/chunks/0dv0_-e5tsref.js\",\"/_next/static/chunks/0ebfi1r6xnvnj.js\",\"/_next/static/chunks/0trve_7dlxj4x.js\",\"/_next/static/chunks/06dkrx0~.hv.m.js\"],\"BlogCTA\"]\n3e:I[18772,[\"/_next/static/chunks/14zr3-mman5lo.js\",\"/_next/static/chunks/0kd2fiwchdadx.js\",\"/_next/static/chunks/065uoviml_0ot.js\",\"/_next/static/chunks/09vlc7xhn5abh.js\",\"/_next/static/chunks/0dv0_-e5tsref.js\",\"/_next/static/chunks/0ebfi1r6xnvnj.js\",\"/_next/static