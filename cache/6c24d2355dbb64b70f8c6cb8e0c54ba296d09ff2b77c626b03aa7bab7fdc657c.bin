<script id="jezcft-turnstile-frontend">
/**
 * Turnstile frontend script.
 *
 * Handles explicit rendering of Cloudflare Turnstile widgets for:
 *   - Regular page forms (Elementor + Gravity Forms)
 *   - Elementor popups (pre-rendered hidden in DOM)
 *   - Dynamically injected content (AJAX, etc.)
 *
 * Key insight: Elementor popups are pre-rendered in the DOM but hidden.
 * Turnstile fails silently on hidden containers, so we must skip hidden
 * widgets and only render them when they become visible (popup opens).
 *
 * @package Jezcft
 */

/* global turnstile, jezcftConfig, jQuery */

/**
 * Debounce timer for scheduled render calls.
 *
 * @type {number|null}
 */
var jezcftRenderTimer = null;

/**
 * Watches widgets skipped because they were hidden, so a form revealed later
 * by CSS (a Login/Register switch, tabs, an accordion) still gets its widget.
 * A display:none element never intersects; once it has a box in the viewport
 * the observer fires and a render is scheduled. Each render pass starts by
 * disconnecting it and re-observes only what is still hidden, so a widget
 * removed from the DOM (updated_checkout replaces the payment section) is not
 * held for the life of the page. rootMargin starts a form revealed below the
 * fold 400px early, so the challenge has a moment to solve. Null without
 * IntersectionObserver: those browsers keep the popup and DOM-insert paths.
 *
 * The callback re-tests jezcftIsVisible() rather than trusting isIntersecting
 * alone. A conforming engine reports a boxless element as not intersecting, so
 * the two agree and the test costs nothing; but an engine that reported one as
 * intersecting would have us unobserve and schedule a pass that skips the
 * widget again as hidden, re-observe it, and spin every 200ms forever. Keeping
 * a mismatched target observed ends that: when it truly gains a box the
 * intersection state changes and the callback fires again.
 *
 * @type {IntersectionObserver|null}
 */
var jezcftHiddenObserver = ( typeof IntersectionObserver === 'undefined' ) ? null : new IntersectionObserver( function( entries ) {
	var shown = false;
	entries.forEach( function( entry ) {
		if ( entry.isIntersecting && jezcftIsVisible( entry.target ) ) {
			jezcftHiddenObserver.unobserve( entry.target );
			shown = true;
		}
	} );
	if ( shown ) {
		jezcftScheduleRender();
	}
}, { rootMargin: '400px' } );

/**
 * Check if an element is visible (not inside a hidden container).
 *
 * @param {Element} el The element to check.
 * @return {boolean}
 */
function jezcftIsVisible( el ) {
	return !!( el.offsetWidth || el.offsetHeight || el.getClientRects().length );
}

/**
 * Width available for content inside an element: clientWidth minus padding.
 *
 * @param {Element|null} node The element to measure.
 * @return {number} 0 when the element is missing or has no layout width.
 */
function jezcftInnerWidth( node ) {
	if ( ! node || ! node.clientWidth ) {
		return 0;
	}
	var cs    = window.getComputedStyle( node );
	var inner = node.clientWidth - ( parseFloat( cs.paddingLeft ) || 0 ) - ( parseFloat( cs.paddingRight ) || 0 );
	// Fractional padding leaves a sub-pixel remainder on a shrink-wrapped
	// element; treat anything under 1px as no width so the parent is measured.
	return inner >= 1 ? inner : 0;
}

/**
 * Pick the size that fits the widget's container.
 *
 * Normal and flexible need at least 300px; in a narrower container (a sidebar
 * form) they are cut off on the right, so that widget renders compact instead.
 * An unknown width (0) keeps the configured size.
 *
 * @param {Element}          el   The widget element.
 * @param {string|undefined} size The configured size.
 * @return {string|undefined}
 */
function jezcftFitSize( el, size ) {
	var width = jezcftInnerWidth( el ) || jezcftInnerWidth( el.parentElement );
	return ( size !== 'compact' && width > 0 && width < 300 ) ? 'compact' : size;
}

/**
 * Render all unrendered AND visible Turnstile widgets on the page.
 * Widgets inside hidden containers (e.g. unopened popups) are skipped.
 */
function jezcftRenderWidgets() {
	if ( typeof turnstile === 'undefined' ) {
		return;
	}

	if ( jezcftHiddenObserver ) {
		jezcftHiddenObserver.disconnect();
	}

	var widgets = document.querySelectorAll( '.jezcft-turnstile-widget:not([data-jezcft-rendered])' );

	widgets.forEach( function( widget ) {
		// Skip widgets inside hidden containers (e.g. closed Elementor popups).
		// Turnstile fails silently on hidden elements. Watch them instead, so
		// one shown later by a CSS toggle renders when it appears.
		if ( ! jezcftIsVisible( widget ) ) {
			if ( jezcftHiddenObserver ) {
				jezcftHiddenObserver.observe( widget );
			}
			return;
		}
		var siteKey          = widget.getAttribute( 'data-sitekey' ) || jezcftConfig.siteKey;
		var theme            = widget.getAttribute( 'data-theme' ) || jezcftConfig.theme;
		var size             = jezcftFitSize( widget, widget.getAttribute( 'data-size' ) || jezcftConfig.size );
		var appearance       = widget.getAttribute( 'data-appearance' ) || jezcftConfig.appearance;
		var inputId          = widget.getAttribute( 'data-input-id' ) || '';
		var isCartVerify     = widget.getAttribute( 'data-cart-verification' ) === 'true';

		widget.setAttribute( 'data-jezcft-rendered', 'true' );

		turnstile.render( widget, {
			sitekey:            siteKey,
			theme:              theme,
			size:               size,
			appearance:         appearance,
			callback:           function( token ) {
				if ( inputId ) {
					var input = document.getElementById( inputId );
					if ( input ) {
						input.value = token;
					}
				}
				// Trigger AJAX verification for cart widgets.
				if ( isCartVerify && typeof window.jezcftCartVerify === 'function' ) {
					window.jezcftCartVerify( token );
				}
			},
			'expired-callback': function() {
				if ( inputId ) {
					var input = document.getElementById( inputId );
					if ( input ) {
						input.value = '';
					}
				}
			}
		} );
	} );
}

/**
 * Schedule a debounced render call.
 */
function jezcftScheduleRender() {
	if ( jezcftRenderTimer ) {
		clearTimeout( jezcftRenderTimer );
	}
	jezcftRenderTimer = setTimeout( function() {
		jezcftRenderTimer = null;
		jezcftRenderWidgets();
	}, 200 );
}

/**
 * Global callback invoked by the Cloudflare Turnstile API on load.
 */
function jezcftOnloadCallback() {
	jezcftRenderWidgets();
}

window.jezcftOnloadCallback = jezcftOnloadCallback;

/**
 * Helper: reset Turnstile widget and clear its hidden input.
 *
 * @param {Element} widget The .jezcft-turnstile-widget element.
 */
function jezcftResetWidget( widget ) {
	if ( ! widget || typeof turnstile === 'undefined' ) {
		return;
	}
	turnstile.reset( widget );
	var inputId = widget.getAttribute( 'data-input-id' );
	if ( inputId ) {
		var input = document.getElementById( inputId );
		if ( input ) {
			input.value = '';
		}
	}
}

/**
 * Attach re-arm listeners to Elementor forms.
 *
 * Elementor Pro dispatches its form events through jQuery's `.trigger()`, so
 * `addEventListener` on the form never fires for them - the same rule the
 * WooCommerce handler at the foot of this file was written to. Binding these
 * natively is what left a refused Elementor submission holding a spent token:
 * the reset never ran and every retry without a page reload replayed it (#45).
 *
 * Which events exist, read out of Elementor Pro 4.3.1
 * (`assets/js/elements-handlers.js`, the form handler's `onSuccess`):
 *
 *   - `submit_success` - triggered on a successful submission.
 *   - `error`          - triggered on a *failed* one. Ajax_Handler::send()
 *                        puts an `errors` key in every failure response and
 *                        an empty array is truthy in JS, so the trigger at
 *                        `elements-handlers.js:1431` is reached whether or not
 *                        a field error was recorded.
 *   - `submit_error`   - does NOT exist in 4.3.x. It appears nowhere in the
 *                        plugin. It is kept in the list below only as cheap
 *                        insurance for a version that does fire it; it is not
 *                        what makes this work.
 *
 * `error` is not exclusive to a submission: Elementor's `validateFileSize()`
 * triggers it on the form when a visitor picks an oversized attachment, on the
 * file input's `change`, before anything is submitted. Resetting there would
 * throw away a token the visitor had already earned and leave them submitting
 * into an empty field - the same lockout this fix exists to end, arrived at
 * from the other side. So `error` only re-arms after a submit has actually
 * been attempted. `submit_success` / `submit_error` need no such guard: they
 * cannot fire without one.
 *
 * @param {Element} container DOM element to search within.
 */
function jezcftBindElementorForms( container ) {
	if ( typeof jQuery === 'undefined' ) {
		return;
	}

	var forms = container.querySelectorAll( '.elementor-form' );
	forms.forEach( function( form ) {
		if ( form.getAttribute( 'data-jezcft-bound' ) ) {
			return;
		}
		form.setAttribute( 'data-jezcft-bound', 'true' );

		var $form     = jQuery( form );
		var submitted = false;
		var expiry    = null;

		function clearSubmitted() {
			submitted = false;
			if ( expiry ) {
				clearTimeout( expiry );
				expiry = null;
			}
		}

		function rearm() {
			clearSubmitted();

			// Every rendered widget in this form, not just the first. Two
			// Turnstile fields on one form post under the same name, so the
			// last one's token is the one spent - resetting only the first
			// would leave that form locked out after a refusal, which is the
			// bug this is here to fix.
			var widgets = form.querySelectorAll(
				'.jezcft-turnstile-widget[data-jezcft-rendered]'
			);
			widgets.forEach( function( widget ) {
				// The marker is set just before turnstile.render(), so a
				// widget whose render threw still carries it, and reset()
				// on one of those throws in turn. Unguarded, that would
				// abandon the loop and leave the widget after it holding
				// the token that was actually spent.
				try {
					jezcftResetWidget( widget );
				} catch ( e ) {}
			} );
		}

		// Bound through jQuery rather than natively so a programmatic
		// jQuery .trigger( 'submit' ) is seen as well as a real one.
		//
		// The flag has a backstop because a submission that never completes
		// answers with nothing at all - an aborted or hung request fires
		// neither `error` nor `submit_success` - and the flag would then stay
		// true for the life of the page, leaving the guard above silently not
		// guarding. A failure that does come back always fires `error`, so
		// this is a backstop and not the usual way the flag is cleared.
		//
		// The window is Turnstile's own token lifetime, not a round-trip
		// guess. Expiring sooner would be the worse mistake of the two: a
		// submission still in flight - a large attachment on a slow uplink -
		// would come back to a disarmed guard, its refusal would not re-arm
		// the widget, and the visitor would be stuck on a spent token, which
		// is the whole of #45. Past 300s there is nothing left to protect:
		// the token has expired, `expired-callback` above has emptied the
		// input, and Turnstile has refreshed the challenge by itself - that
		// last part is Turnstile's default `refresh-expired: auto`, which
		// this plugin never overrides. Setting `refresh-expired` to anything
		// else means revisiting this window.
		$form.on( 'submit', function() {
			submitted = true;
			if ( expiry ) {
				clearTimeout( expiry );
			}
			expiry = setTimeout( clearSubmitted, 300000 );
		} );

		$form.on( 'error', function() {
			if ( submitted ) {
				rearm();
			}
		} );

		$form.on( 'submit_error submit_success', rearm );
	} );
}

( function() {

	/**
	 * ── Page-level initialization ──
	 */
	document.addEventListener( 'DOMContentLoaded', function() {
		jezcftBindElementorForms( document );
	} );

	/**
	 * ── Elementor Popup show ──
	 *
	 * Elementor popups are pre-rendered in the DOM but hidden.
	 * jezcftRenderWidgets() skips hidden widgets on page load.
	 * When the popup opens, we render the now-visible widgets
	 * and bind Elementor form listeners.
	 *
	 * Listens on both window (3.9.0+) and document (jQuery, <3.9.0).
	 */
	function onPopupShow() {
		setTimeout( function() {
			jezcftRenderWidgets();
			jezcftBindElementorForms( document );
		}, 150 );
	}

	// Elementor Pro 3.9.0+ (native CustomEvent on window).
	window.addEventListener( 'elementor/popup/show', onPopupShow );

	// Also listen on document in case the event is dispatched there.
	document.addEventListener( 'elementor/popup/show', onPopupShow );

	// Elementor Pro < 3.9.0 (jQuery event on document).
	if ( typeof jQuery !== 'undefined' ) {
		jQuery( document ).on( 'elementor/popup/show', onPopupShow );
	}

	/**
	 * ── Elementor Popup hide cleanup ──
	 *
	 * When a popup closes, remove Turnstile instances so they
	 * re-render cleanly when the popup is opened again.
	 */
	function onPopupHide( popupId ) {
		if ( typeof turnstile === 'undefined' ) {
			return;
		}
		var popupEl = document.querySelector( '[data-elementor-id="' + popupId + '"]' );
		if ( ! popupEl ) {
			return;
		}
		var widgets = popupEl.querySelectorAll( '.jezcft-turnstile-widget[data-jezcft-rendered]' );
		widgets.forEach( function( widget ) {
			turnstile.remove( widget );
			widget.removeAttribute( 'data-jezcft-rendered' );
			var inputId = widget.getAttribute( 'data-input-id' );
			if ( inputId ) {
				var input = document.getElementById( inputId );
				if ( input ) {
					input.value = '';
				}
			}
		} );
	}

	window.addEventListener( 'elementor/popup/hide', function( e ) {
		if ( e.detail && e.detail.id ) {
			onPopupHide( e.detail.id );
		}
	} );

	if ( typeof jQuery !== 'undefined' ) {
		jQuery( document ).on( 'elementor/popup/hide', function( event, id ) {
			onPopupHide( id );
		} );
	}

	/**
	 * ── Global MutationObserver ──
	 *
	 * Catches dynamically injected widgets (AJAX, lazy loading, etc.)
	 * and new Elementor forms that need event binding.
	 */
	function startObserver() {
		if ( typeof MutationObserver === 'undefined' ) {
			return;
		}

		var observer = new MutationObserver( function( mutations ) {
			var hasNewWidget = false;
			var hasNewForm   = false;

			for ( var i = 0; i < mutations.length; i++ ) {
				var addedNodes = mutations[ i ].addedNodes;
				for ( var j = 0; j < addedNodes.length; j++ ) {
					var node = addedNodes[ j ];
					if ( node.nodeType !== 1 ) {
						continue;
					}

					if ( node.classList && node.classList.contains( 'jezcft-turnstile-widget' ) && ! node.getAttribute( 'data-jezcft-rendered' ) ) {
						hasNewWidget = true;
					}

					if ( ! hasNewWidget && node.querySelector && node.querySelector( '.jezcft-turnstile-widget:not([data-jezcft-rendered])' ) ) {
						hasNewWidget = true;
					}

					if ( node.querySelector && node.querySelector( '.elementor-form:not([data-jezcft-bound])' ) ) {
						hasNewForm = true;
					}
				}

				if ( hasNewWidget && hasNewForm ) {
					break;
				}
			}

			if ( hasNewWidget ) {
				jezcftScheduleRender();
			}

			if ( hasNewForm ) {
				setTimeout( function() {
					jezcftBindElementorForms( document );
				}, 200 );
			}
		} );

		var target = document.body || document.documentElement;
		observer.observe( target, { childList: true, subtree: true } );
	}

	if ( document.body ) {
		startObserver();
	} else {
		document.addEventListener( 'DOMContentLoaded', startObserver );
	}

	/**
	 * ── Gravity Forms AJAX handling ──
	 *
	 * Safety net for GF AJAX DOM replacement where MutationObserver
	 * may not catch innerHTML swaps.
	 */
	if ( typeof jQuery !== 'undefined' ) {
		jQuery( document ).on( 'gform_post_render', function( event, formId ) {
			var formWrapper = document.getElementById( 'gform_wrapper_' + formId );
			if ( ! formWrapper ) {
				return;
			}

			var unrendered = formWrapper.querySelectorAll( '.jezcft-turnstile-widget:not([data-jezcft-rendered])' );
			if ( unrendered.length > 0 ) {
				jezcftScheduleRender();
			}
		} );
	}

	/**
	 * ── WooCommerce checkout lifecycle ──
	 *
	 * WooCommerce's shortcode checkout dispatches two jQuery events on
	 * document.body that we absolutely must hook into:
	 *
	 *   • `checkout_error` — fired after a submit fails validation
	 *     (missing field, invalid coupon, gateway error, etc.). Without a
	 *     handler here, the Turnstile widget stays as it was — hidden
	 *     input still holding the spent token from the failed submit —
	 *     and the next Place Order re-posts it, which Cloudflare rejects
	 *     as `timeout-or-duplicate`. That was the customer-facing
	 *     "Security verification failed" lockout on ISS-2026-02169.
	 *
	 *   • `updated_checkout` — fired after WC rebuilds the checkout
	 *     fragments (address change, shipping method swap, coupon apply,
	 *     etc.). The widget lives inside `.woocommerce-checkout-payment`,
	 *     one of the replaced fragments, so the previous Turnstile
	 *     instance is orphaned in memory. We remove it explicitly and
	 *     schedule a fresh render on the new markup.
	 *
	 * Both events are jQuery-triggered — `addEventListener` on the form
	 * will NOT fire. Guarded behind the jQuery presence check that WC
	 * already loads on any page with a checkout shortcode.
	 *
	 * The same reset pattern is applied to the login / register / lost-
	 * password widgets so a failed submit on those forms also re-arms
	 * cleanly.
	 */
	if ( typeof jQuery !== 'undefined' ) {
		jQuery( document.body ).on( 'checkout_error', function() {
			// Reset every Turnstile widget currently inside the checkout form.
			// Scoped to `form.checkout` so we don't touch unrelated widgets
			// that might be on the same page (e.g. an Elementor form).
			var widgets = document.querySelectorAll(
				'form.checkout .jezcft-turnstile-widget[data-jezcft-rendered]'
			);
			widgets.forEach( function( widget ) {
				jezcftResetWidget( widget );
			} );
		} );

		jQuery( document.body ).on( 'updated_checkout', function() {
			// WC just innerHTML-replaced `.woocommerce-checkout-payment`, so the
			// previous Turnstile widget instance is orphaned (its DOM node is
			// detached and no longer reachable via querySelectorAll). The new
			// fragment contains fresh widget markup with no `data-jezcft-rendered`
			// attribute, which jezcftRenderWidgets() will pick up.
			//
			// Note: we cannot call turnstile.remove() on the orphaned instances
			// here — querySelectorAll only returns attached nodes, so we have
			// no handle to the old instance. Turnstile's internal registry may
			// hold a small amount of stale state per checkout AJAX cycle; it
			// gets reclaimed on the next full page load. Not worth tracking
			// rendered widgets in a WeakSet for this — the leak is bounded and
			// per-session.
			jezcftScheduleRender();
		} );
	}

	/**
	 * ── Theme My Login AJAX submissions ──
	 *
	 * TML's AJAX mode (Settings > TML > "Use AJAX", off by default) posts the
	 * form with jQuery and writes the response into `.tml-alerts` without
	 * replacing the form. The widget therefore survives a refusal still holding
	 * the token it just spent, and the next submit replays it — Cloudflare
	 * answers `timeout-or-duplicate` and the visitor is stuck on a form that
	 * will never accept them. That is #45 arriving by a third route, after
	 * WooCommerce's and Elementor's.
	 *
	 * TML publishes no event of its own, so this rides jQuery's global
	 * `ajaxComplete`, bound one-shot per submit. `.one()` matters: a page with
	 * other AJAX on it would otherwise reset the widget at unrelated moments
	 * and throw away a token the visitor had earned.
	 *
	 * Resetting after a SUCCESSFUL submission is harmless — TML redirects or
	 * reloads on success, so nothing is left to submit.
	 *
	 * Guarded behind jQuery because TML's AJAX mode is itself jQuery: with no
	 * jQuery there is no AJAX submit to re-arm.
	 */
	if ( typeof jQuery !== 'undefined' ) {
		jQuery( document ).on( 'submit', '.tml form[data-ajax="1"]', function() {
			var form = this;

			jQuery( document ).one( 'ajaxComplete', function() {
				var widgets = form.querySelectorAll(
					'.jezcft-turnstile-widget[data-jezcft-rendered]'
				);
				widgets.forEach( function( widget ) {
					// A widget whose render() threw still carries the rendered
					// marker, and reset() on one of those throws in turn. Without
					// the guard that would abandon the loop and leave the widget
					// after it holding the token that was actually spent.
					try {
						jezcftResetWidget( widget );
					} catch ( e ) {}
				} );
			} );
		} );
	}
} )();

</script>
