</p> <p>Rapid transport to the hospital, immediate medical interventions, and prompt treatment can help save lives in case of life-threatening chest injuries.</p> </div> </div> </div> <script type="module">function l(t,e){var o,r;t.setAttribute("aria-pressed",e?"true":"false"),(o=t.querySelector('[data-testid="like-heart-icon"]'))==null||o.classList.toggle("hidden",!e),(r=t.querySelector('[data-testid="unlike-heart-icon"]'))==null||r.classList.toggle("hidden",e)}async function d(t){var c;if(t.hasAttribute("data-loading"))return;const e=t.closest("[data-banner-root]");if(!e)return;const o=e.querySelectorAll("[data-like-count]"),r=Number.parseInt(((c=o[0])==null?void 0:c.textContent)??"0",10)||0,a=t.getAttribute("aria-pressed")==="true",i=a?r-1:r+1,s=()=>{l(t,a),o.forEach(n=>{n.textContent=String(r)})};t.setAttribute("data-loading","true"),l(t,!a),o.forEach(n=>{n.textContent=String(i)});try{(await fetch("/api/articles/like",{method:"POST",headers:{"Content-Type":"application/json","correlation-id":"call-from-browser","X-CSRF-Token":e.dataset.csrf??""},redirect:"manual",body:JSON.stringify({rootUrl:e.dataset.rooturl??"",legacyid:e.dataset.legacyid??"",love_count:i,articleType:1})})).ok||s()}catch{s()}finally{t.removeAttribute("data-loading")}}document.addEventListener("click",t=>{const e=t.target instanceof Element?t.target:null;if(!e)return;const o=e.closest("[data-copy-url]");if(o){const a=o.dataset.copyUrl;a&&navigator.clipboard.writeText(a);return}const r=e.closest("[data-like]");r&&d(r)});document.addEventListener("mousedown",t=>{const e=t.target instanceof Node?t.target:null;document.querySelectorAll("details[data-share-dropdown][open]").forEach(o=>{(!e||!o.contains(e))&&o.removeAttribute("open")})});</script></div><div class="max-w-184 pt-2 w-full lg:mb-2 mx-auto"><div data-eate-root> <div class="lg:border-y-2 border-y-gray-200 lg:py-2 font-nunito-sans"> <div class="flex flex-wrap justify-between items-center lg:px-5 pl-5"> <div class="text-sm w-full mb-5 lg:mb-