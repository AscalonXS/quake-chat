ansition-all after:duration-300 group-hover/link:after:w-full">Contact</span></a></li><li><a class="group/link relative inline-flex items-center gap-1.5 text-[13px] leading-snug text-white/75 hover:text-white py-0.5 transition-colors" href="https://icliniqsupport.freshdesk.com/support/tickets/new" target="_blank" rel="noopener nofollow"><span class="w-0 overflow-hidden opacity-0 -translate-x-1 transition-all duration-300 group-hover/link:w-3 group-hover/link:opacity-100 group-hover/link:translate-x-0"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 448 512" class="text-[9px] text-sky-400" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path d="M190.5 66.9l22.2-22.2c9.4-9.4 24.6-9.4 33.9 0L441 239c9.4 9.4 9.4 24.6 0 33.9L246.6 467.3c-9.4 9.4-24.6 9.4-33.9 0l-22.2-22.2c-9.5-9.5-9.3-25 .4-34.3L311.4 296H24c-13.3 0-24-10.7-24-24v-32c0-13.3 10.7-24 24-24h287.4L190.9 101.2c-9.8-9.3-10-24.8-.4-34.3z"></path></svg></span><span class="relative font-light text-white/70 hover:text-white whitespace-nowrap transition-transform duration-300 group-hover/link:translate-x-0.5 after:absolute after:left-0 after:-bottom-0.5 after:h-px after:w-0 after:bg-sky-400 after:transition-all after:duration-300 group-hover/link:after:w-full">Support</span></a></li><li><a class="group/link relative inline-flex items-center gap-1.5 text-[13px] leading-snug text-white/75 hover:text-white py-0.5 transition-colors" href="https://www.icliniq.com/p/terms"><span class="w-0 overflow-hidden opacity-0 -translate-x-1 transition-all duration-300 group-hover/link:w-3 group-hover/link:opacity-100 group-hover/link:translate-x-0"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 448 512" class="text-[9px] text-sky-400" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path d="M190.5 66.9l22.2-22.2c9.4-9.4 24.6-9.4 33.9 0L441 239c9.4 9.4 9.4 24.6 0 33.9L246.6 467.3c-9.4 9.4-24.6 9.4-33.9 0l-22.2-22.2c-9.5-9.5-9.3-25 .4-34.3L311.4 296H24c-13.3 0-24-10.7-24-24v-32c0-13.3 10.7-24 24-24h287.4L190.9 101.2c-9.8-9.3-10-24.8-.4-34.3z"></path></svg></span><span class="relative font-light text-white/70 hover:text-white whitespace-nowrap transition-transform duration-300 group-hover/link:translate-x-0.5 after:absolute after:left-0 after:-bottom-0.5 after:h-px after:w-0 after:bg-sky-400 after:transition-all after:duration-300 group-hover/link:after:w-full">Terms</span></a></li><li><a class="group/link relative inline-flex items-center gap-1.5 text-[13px] leading-snug text-white/75 hover:text-white py-0.5 transition-colors" href="https://www.icliniq.com/p/privacy"><span class="w-0 overflow-hidden opacity-0 -translate-x-1 transition-all duration-300 group-hover/link:w-3 group-hover/link:opacity-100 group-hover/link:translate-x-0"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 448 512" class="text-[9px] text-sky-400" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path d="M190.5 66.9l22.2-22.2c9.4-9.4 24.6-9.4 33.9 0L441 239c9.4 9.4 9.4 24.6 0 33.9L246.6 467.3c-9.4 9.4-24.6 9.4-33.9 0l-22.2-22.2c-9.5-9.5-9.3-25 .4-34.3L311.4 296H24c-13.3 0-24-10.7-24-24v-32c0-13.3 10.7-24 24-24h287.4L190.9 101.2c-9.8-9.3-10-24.8-.4-34.3z"></path></svg></span><span class="relative font-light text-white/70 hover:text-white whitespace-nowrap transition-transform duration-300 group-hover/link:translate-x-0.5 after:absolute after:left-0 after:-bottom-0.5 after:h-px after:w-0 after:bg-sky-400 after:transition-all after:duration-300 group-hover/link:after:w-full">Privacy</span></a></li><li><a class="group/link relative inline-flex items-center gap-1.5 text-[13px] leading-snug text-white/75 hover:text-white py-0.5 transition-colors" href="https://www.icliniq.com/p/advertisement-policy"><span class="w-0 overflow-hidden opacity-0 -translate-x-1 transition-all duration-300 group-hover/link:w-3 group-hover/link:opacity-100 group-hover/link:translate-x-0"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 448 512" class="text-[9px] text-sky-400" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path d="M190.5 66.9l22.2-22.2c9.4-9.4 24.6-9.4 33.9 0L441 239c9.4 9.4 9.4 24.6 0 33.9L246.6 467.3c-9.4 9.4-24.6 9.4-33.9 0l-22.2-22.2c-9.5-9.5-9.3-25 .4-34.3L311.4 296H24c-13.3 0-24-10.7-24-24v-32c0-13.3 10.7-24 24-24h287.4L190.9 101.2c-9.8-9.3-10-24.8-.4-34.3z"></path></svg></span><span class="relative font-light text-white/70 hover:text-white whitespace-nowrap transition-transform duration-300 group-hover/link:translate-x-0.5 after:absolute after:left-0 after:-bottom-0.5 after:h-px after:w-0 after:bg-sky-400 after:transition-all after:duration-300 group-hover/link:after:w-full">Ads Policy</span></a></li></ul></div></div></div><p class="text-[12px] lg:text-[11px] leading-relaxed font-normal text-white/70 mt-8 px-8 lg:px-16 py-4 bg-white/5 border-y border-white/15 text-center">Disclaimer: No content published on this website is intended to be a substitute for professional medical diagnosis, advice or treatment by a trained physician. Seek advice from your physician or other qualified healthcare providers with questions you may have regarding your symptoms and medical condition for a complete medical diagnosis. Do not delay or disregard seeking professional medical advice because of something you have read on this website. Read our<!-- --> <a class="text-white underline" href="https://www.icliniq.com/p/editorial-policy">Editorial Process</a> <!-- -->to know how we create content for health articles and queries.</p><div class="pt-8 flex flex-col lg:flex-row items-center justify-between gap-4"><div class="md:flex  items-center gap-4 md:gap-6"><div class="flex flex-wrap items-center justify-center gap-3 mb-4 md:mb-0 md:border-r border-white/15 md:pr-4"><img class="h-8 w-auto" src="https://assets.icliniq.com/icliniq-common/hippa.svg" alt="HIPAA Compliant" title="HIPAA Compliant" decoding="async" loading="lazy"/><a href="https://www.dmca.com/Protection/Status.aspx?ID=1a454a14-0c96-4301-85e3-4d008299e65e&amp;refurl=https://www.icliniq.com/#?" title="DMCA.com Protection Status" class="dmca-badge"><img class="h-8 w-auto bg-gray-200 rounded-md" src="https://images.dmca.com/Badges/dmca_protected_26_120.png?ID=5bb75367-c749-4ca0-92f0-7cddc96fd791" alt="DMCA.com Protection Status" decoding="async" loading="lazy"/></a><a href="https://seal.godaddy.com/verifySeal?sealID=c68QDgRKyjCOKwvDCjhsC68v3tZpTS3TdSn7s5WxVnmwmSKuMEamN5nzB" title="GoDaddy Verified &amp; Secured" target="_blank" rel="noopener nofollow"><img class="h-8 w-auto bg-gray-200 rounded-md" src="https://assets.icliniq.com/images/boot/godaddy_seal.gif" alt="GoDaddy Verified &amp; Secured" title="godaddy ssl seal" decoding="async" loading="lazy"/></a></div><div class="flex flex-wrap gap-2.5 justify-center items-center pr-4 md:pr-0"><span class="flex items-center justify-center h-8"><img class="h-8 w-auto" src="https://assets.icliniq.com/icliniq-common/visa.svg" alt="Visa" decoding="async" loading="lazy"/></span><span class="flex items-center justify-center h-8"><img class="h-8 w-auto" src="https://assets.icliniq.com/icliniq-common/mastercard.svg" alt="Master Card" decoding="async" loading="lazy"/></span><span class="flex items-center justify-center h-8"><img class="h-8 w-auto" src="https://assets.icliniq.com/icliniq-common/discover.svg" alt="Discover" decoding="async" loading="lazy"/></span><span class="flex items-center justify-center h-8"><img class="h-8 w-auto" src="https://assets.icliniq.com/icliniq-common/amex.svg" alt="Amex" decoding="async" loading="lazy"/></span><span class="flex items-center justify-center h-8"><img class="h-8 w-auto" src="https://assets.icliniq.com/icliniq-common/paypal.svg" alt="PayPal" decoding="async" loading="lazy"/></span></div></div><div class="px-3 text-center flex gap-2 items-center"><p class="nunito-sans text-white underline mb-1 text-sm">Screen Reader Access :</p><div class="inline-flex rounded-md shadow-sm" role="group"><button title="Decrease Font Size" id="btn-decrease" type="button" class="false flex items-center px-2 py-1 text-xs font-medium text-gray-700 bg-white border border-gray-200 rounded-l-full hover:bg-gray-100  focus:z-10"><svg xmlns="http://www.w3.org/2000/svg" height="1em" viewBox="0 0 384 512" class="fill-gray-700"><path d="M221.5 51.7C216.6 39.8 204.9 32 192 32s-24.6 7.8-29.5 19.7l-120 288-40 96c-6.8 16.3 .9 35 17.2 41.8s35-.9 41.8-17.2L93.3 384H290.7l31.8 76.3c6.8 16.3 25.5 24 41.8 17.2s24-25.5 17.2-41.8l-40-96-120-288zM264 320H120l72-172.8L264 320z"></path></svg><span>-</span></button><button title="Reset Font Size" type="button" class="flex items-center px-2 py-1 text-sm font-medium text-gray-700 bg-white border-t border-b border-gray-200 hover:bg-gray-100 focus:z-10   "><svg xmlns="http://www.w3.org/2000/svg" height="1em" viewBox="0 0 384 512" class="fill-gray-700"><path d="M221.5 51.7C216.6 39.8 204.9 32 192 32s-24.6 7.8-29.5 19.7l-120 288-40 96c-6.8 16.3 .9 35 17.2 41.8s35-.9 41.8-17.2L93.3 384H290.7l31.8 76.3c6.8 16.3 25.5 24 41.8 17.2s24-25.5 17.2-41.8l-40-96-120-288zM264 320H120l72-172.8L264 320z"></path></svg></button><button title="Increase Font Size" type="button" id="btn-increase" class="false flex items-center px-2 py-1 text-base font-medium text-gray-700 bg-white border border-gray-200 rounded-r-full hover:bg-gray-100  focus:z-10  "><svg xmlns="http://www.w3.org/2000/svg" height="1em" viewBox="0 0 384 512" class="fill-gray-700"><path d="M221.5 51.7C216.6 39.8 204.9 32 192 32s-24.6 7.8-29.5 19.7l-120 288-40 96c-6.8 16.3 .9 35 17.2 41.8s35-.9 41.8-17.2L93.3 384H290.7l31.8 76.3c6.8 16.3 25.5 24 41.8 17.2s24-25.5 17.2-41.8l-40-96-120-288zM264 320H120l72-172.8L264 320z"></path></svg><span>+</span></button></div></div></div><div class="mx-auto flex justify-center border-t border-white/15 mt-4 flex-col lg:flex-row items-center  justify-center "><p class="text-gray-300 text-[11px] tracking-wide order-2 lg:order-1 text-center lg:text-left mt-4 ">© 2026 iCliniq. All rights reserved.</p></div></div></footer><!--astro:end--></astro-island> </body></html><script>
  // In-body placement engine — a 1:1 vanilla port of the effects that lived in
  // the old TabularContent React island. Each article root (initial page load
  // AND chunks appended later by the infinite-scroll script, which calls
  // window.__icqEnhanceArticle) gets: the body ad moved after the intro <p>,
  // the footer-mobile ad after the <p> following the 2nd h2, the related card
  // after the <p> following the 3rd h2, the insights banner before the 4th h2,
  // and the micro-tool spliced in before the 2nd/3rd h2 (placement mode is
  // computed server-side into data-placement). All lookups are SCOPED to the
  // article root so duplicated ids across chained articles cannot cross-wire
  // (the old island had that first-match bug). h2 scroll offset is now a CSS
  // scroll-margin-top rule in article-content.css instead of class injection.
  (() => {
    const nextParagraphAfter = (el) => {
      let n = el.nextElementSibling;
      while (n && n.tagName.toLowerCase() !== "p") n = n.nextElementSibling;
      return n;
    };

    // H2s of the article body. When the server split the body around the
    // tool (saved slot), the H2s live in two wrappers; count across both.
    const bodyH2s = (root, contentDiv) => {
      const cont = root.querySelector('[id="article-content-data-continued"]');
      if (!cont || !root.querySelector('[data-ssr-placement="1"]')) {
        return contentDiv.getElementsByTagName("h2");
      }
      return root.querySelectorAll(
        '[id="article-content-data"] h2, [id="article-content-data-continued"] h2',
      );
    };

    const placeBodyAd = (root, contentDiv) => {
      const wrapper = root.querySelector('[data-slot="body-ad"]');
      if (!wrapper || wrapper.dataset.placed) return;
      const h2Tags = bodyH2s(root, contentDiv);
      if (!h2Tags || h2Tags.length === 0) return;
      const firstH2 = h2Tags[0];
      if (!firstH2 || !firstH2.parentNode) return;
      // Prefer the intro <p> before the first <h2>; else the first <p> after it.
      let introP = null;
      let prev = firstH2.previousElementSibling;
      while (prev) {
        if (prev.tagName.toLowerCase() === "p") {
          introP = prev;
          break;
        }
        prev = prev.previousElementSibling;
      }
      const insertAfter = introP ?? nextParagraphAfter(firstH2) ?? firstH2;
      try {
        insertAfter.parentNode?.insertBefore(wrapper, insertAfter.nextSibling);
        wrapper.style.display = "";
        wrapper.dataset.placed = "1";
      } catch (e) {
        console.warn("Failed to place body ad:", e);
      }
    };

    const placeFooterMobileAd = (root, contentDiv) => {
      const wrapper = root.querySelector('[data-slot="footer-mobile-ad"]');
      if (!wrapper || wrapper.dataset.placed) return;
      const h2Tags = bodyH2s(root, contentDiv);
      if (!h2Tags || h2Tags.length < 2 || !h2Tags[1]) return;
      const insertAfter = nextParagraphAfter(h2Tags[1]) ?? h2Tags[1];
      try {
        insertAfter.parentNode?.insertBefore(wrapper, insertAfter.nextSibling);
        wrapper.style.display = "";
        wrapper.dataset.placed = "1";
      } catch (e) {
        console.warn("Failed to place footer mobile ad:", e);
      }
    };

    const placeRelatedCard = (root, contentDiv) => {
      const card = root.querySelector('[data-slot="related-card"]');
      if (!card || card.dataset.placed) return;
      const h2Tags = bodyH2s(root, contentDiv);
      if (!h2Tags || h2Tags.length < 3 || !h2Tags[2]) return;
      const insertAfter = nextParagraphAfter(h2Tags[2]) ?? h2Tags[2];
      try {
        insertAfter.parentNode?.insertBefore(card, insertAfter.nextSibling);
        card.style.display = "block";
        card.dataset.placed = "1";
      } catch (e) {
        console.warn("Failed to place related article card:", e);
      }
    };

    const placeInsightsBanner = (root, contentDiv) => {
      const banner = root.querySelector('[data-slot="insights-banner"]');
      if (!banner || banner.dataset.placed) return;
      const h2Tags = bodyH2s(root, contentDiv);
      if (h2Tags && h2Tags.length > 3 && h2Tags[3] && h2Tags[3].parentNode) {
        try {
          h2Tags[3].parentNode.insertBefore(banner, h2Tags[3]);
          banner.style.display = "block";
          banner.dataset.placed = "1";
        } catch (e) {
          console.warn("Failed to place insights banner:", e);
        }
      } else {
        banner.style.display = "none";
      }
    };

    // Splice the micro-tool between two halves of the article body. Everything
    // from the split node onward moves into a cloned ".article-content" wrapper
    // so the tool sits between them as a sibling and article styles don't leak
    // into it. Placement mode comes from the server (data-placement):
    //   "second" → redesigned screeners split before the 2nd h2 (fallbacks:
    //              only h2 → that h2; no h2 → after 2nd <p>; else 1st h2)
    //   "third"  → legacy tools split before the 3rd h2 (fallback: after last h2)
    //   "section" → saved slot: after the top-level H2 section whose heading
    //              matches data-section-heading (else data-section-index,
    //              1-based); falls back to "third" when neither is found
    //   "before_faq" → saved slot: after the whole body, above the FAQ
    const normHeading = (t) =>
      (t || "").toLowerCase().replace(/[^a-z0-9]+/g, " ").trim();
    const sectionSplitNode = (dataDiv, toolDiv) => {
      const tops = Array.from(dataDiv.children).filter(
        (el) => el.tagName.toLowerCase() === "h2",
      );
      const want = normHeading(toolDiv.dataset.sectionHeading);
      let i = want ? tops.findIndex((h) => normHeading(h.textContent) === want) : -1;
      if (i < 0) {
        const n = parseInt(toolDiv.dataset.sectionIndex || "", 10);
        if (n >= 1 && n <= tops.length) i = n - 1;
      }
      if (i < 0) return undefined;
      // null = matched the last section → tool goes after the whole body.
      return tops[i + 1] ?? null;
    };
    // Ad slots pinned above the tool (US-only; server renders them only
    // when configured). Same spot for client- and server-placed tools.
    const placeMicroToolAds = (root, toolDiv) => {
      const parent = toolDiv.parentNode;
      if (!parent) return;
      for (const slot of ["microtool-top-ad", "microtool-mobile-ad"]) {
        const ad = root.querySelector('[data-slot="' + slot + '"]');
        if (ad && !ad.dataset.placed) {
          parent.insertBefore(ad, toolDiv);
          ad.style.display = "";
          ad.dataset.placed = "1";
        }
      }
    };

    const placeMicroTool = (root, contentDiv) => {
      const toolDiv = root.querySelector('[data-slot="micro-tool"]');
      if (toolDiv && toolDiv.dataset.ssrPlacement === "1") {
        placeMicroToolAds(root, toolDiv);
        return;
      }
      if (!toolDiv || toolDiv.dataset.placed) return;
      const dataDiv = root.querySelector('[id="article-content-data"]');
      const scrollContainer = root.querySelector('[id="article-content-scroll"]');
      if (!dataDiv || !scrollContainer) return;

      const h2Tags = contentDiv.getElementsByTagName("h2");
      const pTags = contentDiv.getElementsByTagName("p");
      let splitBeforeNode = null;
      let splitAfterNode = null;
      let placeAfterBody = false;
      let mode = toolDiv.dataset.placement;
      if (mode === "section") {
        const node = sectionSplitNode(dataDiv, toolDiv);
        if (node === undefined) mode = "third";
        else if (node === null) placeAfterBody = true;
        else splitBeforeNode = node;
      } else if (mode === "before_faq") {
        placeAfterBody = true;
      }

      if (mode === "section" || mode === "before_faq") {
        // resolved above
      } else if (mode === "second") {
        splitBeforeNode = h2Tags && h2Tags.length >= 2 ? h2Tags[1] : null;
        if (!splitBeforeNode && h2Tags.length === 1) {
          splitBeforeNode = h2Tags[0];
        } else if (!splitBeforeNode && pTags && pTags.length >= 2) {
          splitAfterNode = pTags[1];
        } else if (!splitBeforeNode && h2Tags.length >= 1) {
          splitBeforeNode = h2Tags[0];
        }
        if (!splitBeforeNode && !splitAfterNode) return;
      } else {
        if (h2Tags && h2Tags.length >= 3 && h2Tags[2]) {
          splitBeforeNode = h2Tags[2];
        } else if (h2Tags && h2Tags.length >= 1) {
          // Fewer than 3 h2s: insert AFTER the last h2.
          splitAfterNode = h2Tags[h2Tags.length - 1];
        }
        if (!splitBeforeNode && !splitAfterNode) return;
      }

      try {
        const articleWrapper = contentDiv;
        const afterWrapper = document.createElement("div");
        afterWrapper.className = articleWrapper.className;

        const nodesToMove = [];
        let found = false;
        const startNode = placeAfterBody ? null : splitBeforeNode ?? splitAfterNode.nextSibling;
        for (const child of placeAfterBody ? [] : Array.from(dataDiv.childNodes)) {
          if (splitBeforeNode) {
            if (child === splitBeforeNode) found = true;
            if (found) nodesToMove.push(child);
          } else {
            if (child === startNode) found = true;
            if (found) nodesToMove.push(child);
          }
        }

        if (nodesToMove.length > 0) {
          const afterDataDiv = document.createElement("div");
          afterDataDiv.id = "article-content-data-continued";
          for (const node of nodesToMove) afterDataDiv.appendChild(node);
          afterWrapper.appendChild(afterDataDiv);
        }

        scrollContainer.insertBefore(toolDiv, articleWrapper.nextSibling);
        if (nodesToMove.length > 0) {
          scrollContainer.insertBefore(afterWrapper, toolDiv.nextSibling);
        }

        placeMicroToolAds(root, toolDiv);

        toolDiv.style.display = "block";
        toolDiv.dataset.placed = "1";
      } catch (e) {
        console.warn("Failed to insert micro-tool:", e);
      }
    };

    // TOC scroll-spy: highlight the section whose heading most recently
    // crossed the sticky-header line (~208px, matching the CSS
    // scroll-margin-top). Replaces the old layout-thrashing scroll handler.
    const ACTIVE_LINK = ["text-secondary", "bg-blue-100"];
    const INACTIVE_LINK = ["text-gray-700"];
    const initScrollSpy = (root) => {
      const links = Array.from(root.querySelectorAll("[data-toc-link]"));
      if (links.length === 0) return;
      const targets = [];
      const linkFor = new Map();
      for (const link of links) {
        const id = link.getAttribute("data-toc-link");
        const target = id
          ? root.querySelector('[id="' + CSS.escape(id) + '"]')
          : null;
        if (target) {
          targets.push(target);
          linkFor.set(target, link);
        }
      }
      if (targets.length === 0) return;

      const setActive = (activeLink) => {
        for (const link of links) {
          const on = link === activeLink;
          link.classList.remove(...(on ? INACTIVE_LINK : ACTIVE_LINK));
          link.classList.add(...(on ? ACTIVE_LINK : INACTIVE_LINK));
          const num = link.querySelector("[data-toc-num]");
          if (num) {
            num.classList.toggle("text-secondary", on);
            num.classList.toggle("text-gray-400", !on);
          }
        }
      };

      let ticking = false;
      const update = () => {
        ticking = false;
        const line = 209; // sticky-header offset, matches scroll-margin-top
        let current = targets[0];
        for (const t of targets) {
          if (t.getBoundingClientRect().top <= line) current = t;
          else break;
        }
        setActive(linkFor.get(current));
      };
      window.addEventListener(
        "scroll",
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(update);
        },
        { passive: true },
      );
      root.addEventListener("click", (e) => {
        const link = e.target.closest("[data-toc-link]");
        if (link) setActive(link);
      });
    };

    const enhance = (root) => {
      const contentDiv = root.querySelector(
        '[id="article-content-scroll"] .article-content',
      );
      if (!contentDiv) return;
      // Same order as the old island's effects: body ad + footer-mobile ad,
      // related card, insights banner, then the micro-tool splice last.
      placeBodyAd(root, contentDiv);
      placeFooterMobileAd(root, contentDiv);
      placeRelatedCard(root, contentDiv);
      placeInsightsBanner(root, contentDiv);
      placeMicroTool(root, contentDiv);
      initScrollSpy(root);
    };

    // Appended infinite-scroll articles are enhanced via this hook (their own
    // inline scripts never execute after DOMParser + adoptNode).
    window.__icqEnhanceArticle = enhance;

    const init = () => {
      document.querySelectorAll(".infinite-article").forEach(enhance);
      // Compat event: the old ArticleContent island dispatched this after
      // mounting the body HTML.
      window.dispatchEvent(new CustomEvent("articleContentRendered"));
    };
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }

    // Deep-link scroll to the AI chat form (ported from the old island).
    const hashScroll = () => {
      if (window.location.hash !== "#article-chat-form") return;
      setTimeout(() => {
        const element = document.getElementById("article-chat-form");
        if (!element) return;
        element.scrollIntoView({ behavior: "smooth", block: "center" });
        const removeHashFromUrl = () => {
          const newUrl = window.location.href.split("#")[0];
          window.history.replaceState(null, "", newUrl);
        };
        if ("onscrollend" in window) {
          const handleScrollEnd = () => {
            removeHashFromUrl();
            window.removeEventListener("scrollend", handleScrollEnd);
          };
          window.addEventListener("scrollend", handleScrollEnd);
        } else {
          setTimeout(removeHashFromUrl, 1000);
        }
      }, 200);
    };
    if (document.readyState === "complete") {
      hashScroll();
    } else {
      window.addEventListener("load", hashScroll);
    }
  })();
</script><script>
  // Infinite article scroll. #infinite-articles-container carries the parent
  // article's data-candidate-slugs — the fixed list of same-affiliation
  // related-topic articles for this session (capped at 5). When the reader
  // reaches the MIDPOINT of the current last article we fetch the next un-loaded
  // candidate, splice out its .infinite-article element, and append it. We do
  // NOT cascade into a child chunk's own related topics: if the parent has N
  // related articles, the chain loads exactly N (then stops). URL + title +
  // canonical sync to whichever article is at viewport center via
  // history.replaceState — no navigation, so the back-button still returns to
  // the entry page.
  (() => {
    const container = document.getElementById("infinite-articles-container");
    if (!container) return;
    // Mobile-only feature. Desktop keeps the standard single-article view with
    // Related Topics as plain links. Matches the lg: Tailwind breakpoint (1024px).
    const isMobile = window.matchMedia("(max-width: 1023px)").matches;
    if (!isMobile) {
      console.log("[infinite-article] disabled", {
        reason: "desktop viewport",
      });
      return;
    }
    // Property gate (wellness/nativecare + allowed primary tag + has candidates).
    // The server computes this; see infiniteScrollEnabled.
    if (container.dataset.infiniteEnabled !== "true") {
      console.log("[infinite-article] disabled", {
        reason: "property not enabled",
      });
      return;
    }

    // Strip the post-Tags tail (Related Topics, Second Opinion CTA, Disclaimer,
    // footer ad, etc.) so the chained next article appends directly under Tags.
    const stripTail = (article) => {
      article
        .querySelectorAll(".infinite-article-tail")
        .forEach((el) => el.remove());
    };

    let candidateSlugs = [];
    try {
      candidateSlugs = JSON.parse(container.dataset.candidateSlugs || "[]");
    } catch {}

    const loadedSlugs = new Set();
    document
      .querySelectorAll(".infinite-article")
      .forEach((el) => loadedSlugs.add(el.dataset.slug));

    let isLoading = false;

    const log = (status, slug, extra) => {
      const tag = `[infinite-article] ${status}`;
      const payload = { slug, ...(extra || {}) };
      if (status === "error" || status === "http-error") {
        console.error(tag, payload);
      } else if (status === "skipped" || status === "no-chunk") {
        console.warn(tag, payload);
      } else {
        console.log(tag, payload);
      }
    };

    const loadNext = async (nextSlug, fromSlug, fromEl) => {
      if (!nextSlug) {
        log("skipped", fromSlug, { reason: "no-next-slug" });
        return;
      }
      if (isLoading) {
        log("skipped", nextSlug, { reason: "already-loading", fromSlug });
        return;
      }
      if (loadedSlugs.has(nextSlug)) {
        log("skipped", nextSlug, { reason: "already-loaded", fromSlug });
        return;
      }
      isLoading = true;
      loadedSlugs.add(nextSlug);
      const startedAt = performance.now();
      log("loading", nextSlug, { fromSlug, url: `/articles/${nextSlug}` });
      // GA4: fire when an infinite-scroll load is triggered.
      if (typeof window.gtag === "function") {
        window.gtag("event", "infinite-scroll", {
          from_slug: fromSlug,
          to_slug: nextSlug,
          loaded_count: loadedSlugs.size,
        });
      }
      try {
        const res = await fetch(`/articles/${nextSlug}`, {
          credentials: "same-origin",
        });
        log("response", nextSlug, {
          status: res.status,
          statusText: res.statusText,
          ok: res.ok,
          redirected: res.redirected,
          finalUrl: res.url,
          contentType: res.headers.get("content-type"),
        });
        if (!res.ok) {
          log("http-error", nextSlug, {
            status: res.status,
            statusText: res.statusText,
          });
          return;
        }
        const html = await res.text();
        const doc = new DOMParser().parseFromString(html, "text/html");
        const nextEl = doc.querySelector(".infinite-article");
        log("fetched", nextSlug, {
          status: res.status,
          bytes: html.length,
          hasInfiniteArticle: Boolean(nextEl),
          tookMs: Math.round(performance.now() - startedAt),
        });
        if (!nextEl) {
          log("no-chunk", nextSlug, {
            reason: ".infinite-article not found in response",
            bodyStart: html.slice(0, 200),
          });
          return;
        }

        // The chunk we just fetched KEEPS its own tail (Related Topics →
        // footer). Instead we strip the tail off the article we're chaining
        // FROM, so only the current last article ever shows the tail. When the
        // chain ends (5 loaded or candidates exhausted) the final article keeps
        // its tail, flowing the reader into Related Topics and the footer.
        const adopted = document.adoptNode(nextEl);
        if (fromEl) stripTail(fromEl);
        const sep = document.createElement("div");
        sep.className = "infinite-article-separator";
        sep.style.cssText =
          "max-width:736px;margin:40px auto 24px;padding:0 20px;display:flex;align-items:center;gap:12px;color:#6b7280;font-family:'Nunito Sans',sans-serif;font-size:13px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;";
        sep.innerHTML =
          '<span style="flex:1;height:1px;background:#e5e7eb;"></span>' +
          "<span>Up Next</span>" +
          '<span style="flex:1;height:1px;background:#e5e7eb;"></span>';
        container.appendChild(sep);
        container.appendChild(adopted);
        log("appended", nextSlug, {
          href: adopted.dataset.href,
          title: adopted.dataset.title,
          inDom: document.body.contains(adopted),
          tookMs: Math.round(performance.now() - startedAt),
          totalLoaded: loadedSlugs.size,
        });
        try {
          wireUp(adopted);
        } catch (wireErr) {
          log("error", nextSlug, {
            phase: "wireUp",
            message: wireErr && wireErr.message,
          });
        }
        // Run the in-body placement engine on the appended article (its own
        // inline scripts never execute after DOMParser + adoptNode).
        try {
          window.__icqEnhanceArticle?.(adopted);
        } catch (enhanceErr) {
          log("error", nextSlug, {
            phase: "enhance",
            message: enhanceErr && enhanceErr.message,
          });
        }
      } catch (err) {
        log("error", nextSlug, { message: err && err.message });
      } finally {
        isLoading = false;
      }
    };

    // Pick the next un-loaded slug from the parent's fixed candidate list.
    const pickNextSlug = () => {
      return candidateSlugs.find((s) => s && !loadedSlugs.has(s)) || "";
    };

    const hasMoreCandidates = () =>
      candidateSlugs.some((s) => s && !loadedSlugs.has(s));

    // Trigger the next load when the reader reaches the MIDPOINT of the current
    // last article — i.e. the viewport center crosses the article's vertical
    // midpoint. Driven by the throttled scroll handler.
    const maybeTriggerNext = () => {
      if (isLoading || !hasMoreCandidates()) return;
      const articles = document.querySelectorAll(".infinite-article");
      const last = articles[articles.length - 1];
      if (!last) return;
      const rect = last.getBoundingClientRect();
      const midpoint = rect.top + rect.height / 2;
      if (midpoint > window.innerHeight / 2) return; // not yet halfway read
      const fromSlug = last.dataset.slug;
      const nextSlug = pickNextSlug();
      log("trigger", fromSlug, { nextSlug: nextSlug || "(none)" });
      loadNext(nextSlug, fromSlug, last);
    };

    let scrollTimer = 0;
    const updateUrlFromScroll = () => {
      const mid = window.innerHeight / 2;
      let active = null;
      for (const el of document.querySelectorAll(".infinite-article")) {
        const r = el.getBoundingClientRect();
        if (r.top <= mid && r.bottom >= mid) {
          active = el;
          break;
        }
      }
      if (!active) return;
      const href = active.dataset.href;
      const title = active.dataset.title;
      if (href && window.location.pathname !== href) {
        const fromUrl = window.location.pathname;
        window.history.replaceState(null, "", href);
        if (title) document.title = title;
        // Keep <link rel="canonical"> in sync with the article in view: swap only
        // its path so the protocol + host stay whatever the SSR canonical used.
        const canonical = document.querySelector('link[rel="canonical"]');
        if (canonical) {
          try {
            const c = new URL(canonical.href);
            c.pathname = href;
            canonical.setAttribute("href", c.toString());
          } catch {}
        }
        log("url-changed", active.dataset.slug, { from: fromUrl, to: href });
      }
    };
    window.addEventListener(
      "scroll",
      () => {
        if (scrollTimer) return;
        scrollTimer = window.setTimeout(() => {
          scrollTimer = 0;
          updateUrlFromScroll();
          maybeTriggerNext();
        }, 120);
      },
      { passive: true },
    );

    const wireUp = (el) => {
      if (hasMoreCandidates()) {
        log("watching", el.dataset.slug, {
          nextSlug: pickNextSlug() || "(none)",
          remaining: candidateSlugs.filter((s) => !loadedSlugs.has(s)),
        });
      } else {
        log("end-of-chain", el.dataset.slug, {
          reason: "candidate list exhausted — final article keeps its tail",
        });
      }
    };

    // Tails are stripped LAZILY (only when an article gets a successor below it,
    // see loadNext). We deliberately do NOT strip the initial article's tail:
    // if there are no candidates — or once the chain ends — the last article
    // must keep its tail so the reader still gets Related Topics + footer.
    const initial = document.querySelectorAll(".infinite-article");
    log("init", null, {
      container: "#infinite-articles-container",
      initialCount: initial.length,
      candidateSlugs,
    });
    initial.forEach(wireUp);
    // Cover the case where the first article is short enough that its midpoint
    // is already above viewport center before any scroll fires.
    maybeTriggerNext();
  })();
</script><style>
  .rhap_volume-bar-area {
    width: 100% !important;
  }
  .rhap_container {
    background: transparent;
    width: 100%;
  }

  @media (max-width: 576px) {
    .rhap_volume-container {
      position: absolute;
      top: 105px;
      margin: auto;
      bottom: 0px;
      height: 20px;
      left: 0px;
      width: 100px;
      right: 0px;
    }

    .rhap_main {
      position: relative;
    }
  }
  a:focus {
    text-decoration: underline;
  }
  .breadcrums-layout {
    background-color: #f9fafb;
    border-bottom: 2px solid #e1effe;
  }

  .abstract-content {
    background-color: #f8f9ff;
  }
  .article-content h2 {
    font-size: 22px;
    margin-bottom: 10px;
    font-weight: 600;
  }
  .article-content li {
    font-size: 18px;
    line-height: 32px;
  }
  .article-content h2 strong {
    font-weight: 600;
  }
  .article-content p {
    margin-bottom: 25px;
    font-size: 18px;
    line-height: 32px;
  }
  .article-content a[href] {
    color: #276bdb;
    text-decoration: underline;
    font-size: 18px;
    line-height: 32px;
  }
  .article-content a[href]:hover {
    color: #1341a3;
  }

  .article-content table {
    /* No display:block / width:100% here: those forced the table full-width and
       stopped the source's own margin:auto from centering. Letting it keep the
       native display:table lets the table shrink to content and center itself.
       max-width keeps wide tables from overflowing on mobile. */
    border-collapse: collapse;
    margin-bottom: 25px;
    max-width: 100%;
    font-size: 18px;
    line-height: 32px;
  }
  .article-content table thead {
    background-color: #f3f4f6;
  }
  .article-content table th {
    font-weight: 700;
    text-align: left;
    padding: 10px 16px;
    border: 1px solid #d1d5db;
  }
  .article-content table td {
    padding: 10px 16px;
    border: 1px solid #d1d5db;
  }
  .article-content table tr:nth-child(even) {
    background-color: #f9fafb;
  }
  /* Cells wrap their text in <p>, which picks up the global
     `.article-content p { margin-bottom: 25px }` rule and adds empty space
     below each cell. Reset it so cells only have their own padding. */
  .article-content table td p,
  .article-content table th p {
    margin: 0;
  }
  .article-content p img {
    margin: auto;
  }
  .article-content ul,
  .article-content ol {
    list-style: disc;
    padding-left: 30px;
    margin-bottom: 10px;
    font-size: 18px;
    line-height: 32px;
  }
  .article-content #icliniq-key-takeaway {
    background-color: #e1effe;
    font-size: 16px !important;
    line-height: 18px;
    padding: 24px;
    border-radius: 8px;
  }
  .article-content #icliniq-key-takeaway li {
    list-style: disc;
    margin-left: 30px;
  }
  .article-content #icliniq-key-takeaway p {
    font-size: 16px !important;
    margin-bottom: 0;
  }
  .article-content #icliniq-key-takeaway li#heading-li-keytakeaway {
    list-style: none;
    padding-left: 0;
    font-size: 18px !important;
    margin-bottom: 24px;
    margin-left: 0px;
    font-weight: 700;
    text-decoration: underline;
  }
  .article-content #icliniq-key-takeaway #heading-li-keytakeaway h2 {
    font-size: 18px !important;
  }
  .article-content #icliniq-key-takeaway .linkText-keytakeaway {
    margin-left: 0px;
    margin-top: 24px;
    list-style: none;
    padding-left: 0;
  }
  .swiper-button-disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  @keyframes fade-in-up {
    0% {
      opacity: 0;
    }
    100% {
      transform: translateY(0);
      opacity: 1;
    }
  }
  .video-floating {
    display: none;
  }
  .video-floating iframe {
    max-width: 100%;
    max-height: 100%;
  }

  .video-floating.stuck {
    display: block;
    position: fixed;
    bottom: 20px;
    left: 20px;
    width: 260px;
    height: 145px;
    transform: translateY(200%);
    animation: fade-in-up 0.75s ease forwards;
    z-index: 1;
  }
  .icon-close-video {
    position: absolute;
    right: 7px;
    top: 7px;
    color: #fff;
    z-index: 999999;
    cursor: pointer;
  }
  .scene {
    position: relative;
    z-index: 2;
    height: 220px;
    width: 220px;
    display: grid;
    place-items: center;
  }

  .cube-wrapper {
    transform-style: preserve-3d;
    animation: bouncing 2s infinite;
  }

  .cube {
    transform-style: preserve-3d;
    transform: rotateX(45deg) rotateZ(45deg);
    animation: rotation 2s infinite;
  }

  .cube-faces {
    transform-style: preserve-3d;
    height: 80px;
    width: 80px;
    position: relative;
    transform-origin: 0 0;
    transform: translateX(0) translateY(0) translateZ(-40px);
  }

  .cube-face {
    position: absolute;
    inset: 0;
    background: #1341a3;
    border: solid 5px #96c6f7;
  }
  .cube-face.shadow {
    transform: translateZ(-80px);
    animation: bouncing-shadow 2s infinite;
  }
  .cube-face.top {
    transform: translateZ(80px);
  }
  .cube-face.front {
    transform-origin: 0 50%;
    transform: rotateY(-90deg);
  }
  .cube-face.back {
    transform-origin: 0 50%;
    transform: rotateY(-90deg) translateZ(-80px);
  }
  .cube-face.right {
    transform-origin: 50% 0;
    transform: rotateX(-90deg) translateY(-80px);
  }
  .cube-face.left {
    transform-origin: 50% 0;
    transform: rotateX(-90deg) translateY(-80px) translateZ(80px);
  }

  @keyframes rotation {
    0% {
      transform: rotateX(45deg) rotateY(0) rotateZ(45deg);
      animation-timing-function: cubic-bezier(0.17, 0.84, 0.44, 1);
    }
    50% {
      transform: rotateX(45deg) rotateY(0) rotateZ(225deg);
      animation-timing-function: cubic-bezier(0.76, 0.05, 0.86, 0.06);
    }
    100% {
      transform: rotateX(45deg) rotateY(0) rotateZ(405deg);
      animation-timing-function: cubic-bezier(0.17, 0.84, 0.44, 1);
    }
  }
  @keyframes bouncing {
    0% {
      transform: translateY(-40px);
      animation-timing-function: cubic-bezier(0.76, 0.05, 0.86, 0.06);
    }
    45% {
      transform: translateY(40px);
      animation-timing-function: cubic-bezier(0.23, 1, 0.32, 1);
    }
    100% {
      transform: translateY(-40px);
      animation-timing-function: cubic-bezier(0.76, 0.05, 0.86, 0.06);
    }
  }
  @keyframes bouncing-shadow {
    0% {
      transform: translateZ(-80px) scale(1.3);
      animation-timing-function: cubic-bezier(0.76, 0.05, 0.86, 0.06);
      opacity: 0.05;
    }
    45% {
      transform: translateZ(0);
      animation-timing-function: cubic-bezier(0.23, 1, 0.32, 1);
      opacity: 0.3;
    }
    100% {
      transform: translateZ(-80px) scale(1.3);
      animation-timing-function: cubic-bezier(0.76, 0.05, 0.86, 0.06);
      opacity: 0.05;
    }
  }
  @keyframes shine {
    0% {
      left: -150%;
    }
    100% {
      left: 150%;
    }
  }

  .shine-effect {
    pointer-events: none; /* ensure you can still click the button */
  }

  .group:hover .shine-effect {
    /* If you want to use a single-time animation on hover, you can do: */
    animation: shine 0.75s forwards;
  }
  @keyframes pop-up {
    0% {
      transform: translateY(-350px);
      opacity: 0;
    }
    100% {
      transform: translateY(0);
      opacity: 1;
    }
  }
  @keyframes pop-down {
    0% {
      transform: translateY(0);
      opacity: 1;
    }
    100% {
      transform: translateY(-350px);
      opacity: 0;
    }
  }
  .animation-pop-up {
    animation: pop-up 0.4s ease-out forwards;
  }

  .animation-pop-down {
    animation: pop-down 0.4s ease-out forwards;
  }

  .wld-chat-ai ol {
    list-style-type: number;
    padding-left: 30px;
    margin-top: 10px;
  }
  .wld-chat-ai ul {
    list-style-type: disc;
    padding-left: 30px;
    margin-top: 10px;
  }
  .wld-chat-ai ol li,
  .wld-chat-ai ul li {
    padding: 0 0 10px 0;
  }
  #prompt-textarea::-webkit-scrollbar {
    width: 5px;
  }
  #prompt-textarea::-webkit-scrollbar-track {
    background: #f1f1f1;
  }
  #prompt-textarea::-webkit-scrollbar-thumb {
    background: #888;
    border-radius: 5px;
  }
  #prompt-textarea::-webkit-scrollbar-thumb:hover {
    background: #555;
  }
  .card .inner {
    background: #ffffff;
  }
  .chat-answer p {
    margin-bottom: 20px;
  }
</style><script>
  document.addEventListener("DOMContentLoaded", () => {
    // Shift article content left when body2 ad is visible
    const adBody2 = document.querySelector(".ads-card-padding-checkpoint");
    const articleCardWrapper = document.getElementById("article-card-wrapper");

    // One rAF-coalesced layout pass: ALL layout reads happen first, then all
    // style writes. The previous version ran two independent handlers on the
    // same events (padding shift wrote styles, then footer-ad alignment read
    // getBoundingClientRect), which forced a synchronous reflow per event —
    // DevTools flagged it under "Forced reflow".
    let layoutScheduled = false;
    const applyAdLayout = () => {
      layoutScheduled = false;

      // --- READS (no writes until all measurements are taken) ---
      const vw = window.innerWidth;
      const isLowResLarge = vw >= 1024 && vw < 1400;
      // getBoundingClientRect returns 0 when display:none (below lg breakpoint)
      const rect = adBody2 ? adBody2.getBoundingClientRect() : { width: 0 };
      const adIsVisible = isLowResLarge && rect.width >= 300;

      const footerAd = document.querySelector(".top-90");
      const microTool = document.getElementById("micro-tool-inline");
      const footerSkyAd = document.querySelector(".footer-skyscraper-ad");
      const microToolShown =
        microTool && footerSkyAd && microTool.style.display !== "none";
      let skyTopPx = null;
      if (microToolShown && vw >= 1024) {
        const microToolRect = microTool.getBoundingClientRect();
        const scrollY = window.scrollY || document.documentElement.scrollTop;
        skyTopPx = Math.round(microToolRect.top + scrollY) + 20;
      }

      // --- WRITES ---
      if (articleCardWrapper) {
        articleCardWrapper.style.paddingRight = adIsVisible ? "150px" : "";
      }
      if (isLowResLarge) {
        if (adBody2) adBody2.style.right = "0";
        if (footerAd) footerAd.style.right = "5";
      } else {
        if (adBody2) adBody2.style.removeProperty("right");
        if (footerAd) footerAd.style.removeProperty("right");
      }
      if (microToolShown) {
        if (skyTopPx !== null) {
          footerSkyAd.style.top = skyTopPx + "px";
        } else {
          footerSkyAd.style.removeProperty("top");
        }
      }
    };
    const scheduleAdLayout = () => {
      if (layoutScheduled) return;
      layoutScheduled = true;
      requestAnimationFrame(applyAdLayout);
    };

    if (adBody2) {
      new ResizeObserver(scheduleAdLayout).observe(adBody2);
      new MutationObserver(scheduleAdLayout).observe(adBody2, {
        childList: true,
        subtree: true,
      });
    }

    // Re-check on every window resize (handles lg breakpoint show/hide transitions)
    window.addEventListener("resize", scheduleAdLayout);
    scheduleAdLayout();

    // Bounded retry: articles without a micro-tool never show the div, so the
    // old unconditional 500ms re-poll looped forever. ~15s covers slow loads.
    let alignAttempts = 0;
    const tryAlignFooterAd = () => {
      const microTool = document.getElementById("micro-tool-inline");
      if (microTool && microTool.style.display !== "none") {
        // Wait a bit for layout to settle after micro tool is inserted
        setTimeout(scheduleAdLayout, 300);
      } else if (++alignAttempts < 30) {
        setTimeout(tryAlignFooterAd, 500);
      }
    };

    tryAlignFooterAd();
  });
</script><script>(function(){const microToolSlug = "emergency_chest_injury_awareness_builder";

  // Deep link into the embedded micro tool: /articles/...#<tool-slug>, as sent
  // by the search popup / deck's micro-tools listing for tools that have no
  // public tool page.
  //
  // The browser's own fragment scroll can't do this. #micro-tool-inline starts
  // display:none and empty - it's a client:visible island the placement script
  // above reveals once the widget mounts - so at hash-scroll time there is
  // nothing to scroll to. Poll until it has actually rendered, then scroll,
  // then correct once for layout that settled underneath us.
  (function () {
    var HASHES = ["#micro-tools", "#micro-tool"];
    if (microToolSlug) HASHES.push("#" + microToolSlug.replace(/_/g, "-"));
    if (HASHES.indexOf(window.location.hash) === -1) return;

    var attempts = 0;
    var scrollToTool = function () {
      var el = document.getElementById("micro-tool-inline");
      if (el && el.style.display !== "none" && el.offsetHeight > 0) {
        el.scrollIntoView({ behavior: "smooth", block: "start" });
        setTimeout(function () {
          el.scrollIntoView({ behavior: "smooth", block: "start" });
        }, 800);
        return;
      }
      // ~15s: articles whose tool never renders just stop trying.
      if (++attempts < 60) setTimeout(scrollToTool, 250);
    };

    scrollToTool();
  })();
})();</script>