@media (min-width: 1200px) {
  /* Hover bridge on the parent item, so the flyout's overflow can't clip it */
  .header-template .header-nav .sub-menu .menu-item-has-children::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 100%;
    width: 35px;
  }
}

/* Animations off: no sliding or fading, but keep a 300ms close delay */
@media (min-width: 1200px) and (prefers-reduced-motion: reduce) {
  .header-template .header-nav .sub-menu {
    transform: none !important;
    transition: opacity 0s .3s, visibility 0s .3s !important;
  }
  .header-template .header-nav .menu-item-has-children:hover > .sub-menu {
    transition: opacity 0s 0s, visibility 0s 0s !important;
  }
}

@media (max-width: 767px) {
    /* accessiBe floating button (inside a shadow root, exposed as a part) */
    ::part(acsb-trigger) {
        display: none !important;
    }

    /* reCAPTCHA badge (branding text must be shown near the forms instead) */
    .grecaptcha-badge {
        visibility: hidden !important;
    }
}

/* ============================================================
   Fixes from recent troubleshooting.
   If any of these also live in Elementor > Site Settings > Custom CSS,
   delete them there so each rule exists in only one place.
   ============================================================ */

/* Stop anything from making the page scroll sideways */
body {
    overflow-x: clip;
}

/* Attorney carousel: keep its "peek" inside its own section */
@media (max-width: 1199px) {
    .team {
        overflow: hidden;
    }
}

/* Base table */
.responsive-table, .responsive-table-dark {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.5em;
	margin-top:1em;
}

/* Cells */
.responsive-table th,
.responsive-table td {
    padding: 15px;
    border: 1px solid #143e78;
    vertical-align: middle;
}

/* Header row */
.responsive-table thead th {
    background-color: #091356;
    color: #ffffff;
    border: 2px solid #143e78;
    text-align: center;
	font-weight:bold;
}

/* Cells */
.responsive-table-dark th,
.responsive-table-dark td {
    padding: 15px;
    border: 1px solid #143e78;
    vertical-align: middle;
	background-color:#ffffff;
	color:#091a31;
}

/* Header row */
.responsive-table-dark thead th {
    background-color: #f4c55b;
    color: #091a31;
    border: 2px solid #143e78;
    text-align: center;
}
/* Tables become stacked cards on phones */
@media (max-width: 767px) {
    table.responsive-table,
    table.responsive-table tbody,
    table.responsive-table tr,
    table.responsive-table td,
    table.responsive-table-dark,
    table.responsive-table-dark tbody,
    table.responsive-table-dark tr,
    table.responsive-table-dark td {
        display: block;
        width: 100%;
    }
    table.responsive-table thead,
    table.responsive-table-dark thead {
        display: none;
    }
    table.responsive-table tr,
    table.responsive-table-dark tr {
        border: 1px solid #143e78;
        margin-bottom: 16px;
    }
    table.responsive-table td,
    table.responsive-table-dark td {
        border: none;
        padding: 10px 15px;
			width:auto!important;
    }
    table.responsive-table td:first-child {
        background-color: #091356;
        color: #ffffff;
        font-weight: bold;
    }
    table.responsive-table-dark td:first-child {
        background-color: #f4c55b;
        color: #091a31;
        font-weight: bold;
    }
    table.responsive-table td[data-label]::before,
    table.responsive-table-dark td[data-label]::before {
        content: attr(data-label);
        display: block;
        font-size: 12px;
        font-weight: bold;
        text-transform: uppercase;
        opacity: 0.7;
        margin-bottom: 4px;
    }
}

@media (max-width: 767px) {
  .elementor-nav-menu > li.pll-parent-menu-item > a.elementor-item .pll-switcher-label {
    display: none;
  }
}

