.page-type-practice-areas .atf-highlights, .page-type-practices-areas-es .atf-highlights, .page-type-lander .atf-highlights, .page-type-lander-es .atf-highlights, .page-type-php .atf-highlights, .page-type-php-es .atf-highlights {
