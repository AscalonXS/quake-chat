/* === ATF Highlights Box  === */
.atf-highlights{
  margin:12px 0 14px;
  padding:10px 14px;
  border:1px solid rgba(0,0,0,.10);
  /*border-left:4px solid #0b1b33; Arash dark blue */
  border-radius:12px;
  box-shadow:0 4px 12px rgba(0,0,0,.06);
}

.atf-highlights__title{
  margin:0 0 6px;
  font-size:.92rem;               /* smaller */
  line-height:1.2;
  font-weight:700;                /* less bold */
  color:#091a31;                  /* Arash yellow (same as previous border) */
}

.atf-highlights ul{
  margin:0;
  padding-left:1.05em;
}

.atf-highlights li{
  margin:4px 0;
  font-size:.88rem;               /* smaller */
  line-height:1.35;
  color:#13233a;
}

.atf-highlights li strong{
  font-weight:700;                /* reduce strong weight inside bullets */
}

.atf-highlights__note{
  margin:8px 0 0;
  padding-top:8px;
  border-top:1px solid rgba(0,0,0,.08);
  font-size:.86rem;               /* smaller tip */
  line-height:1.35;
  color:#233a57;
}

.atf-highlights__note strong{
  font-weight:700;                /* reduce Tip: weight */
}

@media (max-width:768px){
  .atf-highlights{
    padding:10px 12px;
    border-radius:10px;
  }
}

/* Base table */
.custom-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.5em;
	margin-top:1em;
}

/* Cells */
.custom-table th,
.custom-table td {
    padding: 15px;
    border: 1px solid #143e78;
    vertical-align: middle;
}

/* Header row */
.custom-table thead th {
    background-color: #091356;
    color: #ffffff;
    border: 2px solid #143e78;
    text-align: center;
	font-weight:bold;
}

.custom-table-dark {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.5em;
	margin-top:1em;
}

/* Cells */
.custom-table-dark th,
.custom-table-dark td {
    padding: 15px;
    border: 1px solid #143e78;
    vertical-align: middle;
	background-color:#ffffff;
	color:#091a31;
}

/* Header row */
.custom-table-dark thead th {
    background-color: #f4c55b;
    color: #091a31;
    border: 2px solid #143e78;
    text-align: center;
}

.decimal-unordered-list{
list-style-type:decimal-leading-zero!important;
margin-left:30px!important;
}
.decimal-unordered-list li{
padding-left:10px;
margin-bottom:1em;
}
.decimal-unordered-list li::marker{
color:#1864C5;
}
.page-type-lander .fadeInUp,.page-type-lander-es .fadeInUp,.page-type-practice-areas .fadeInUp,.page-type-practices-areas-es .fadeInUp,.page-type-php .fadeInUp,.page-type-php-es .fadeInUp{
animation-name:none;
}

.page-type-lander .elementor-invisible,.page-type-lander-es .elementor-invisible,.page-type-practice-areas .elementor-invisible,.page-type-practices-areas-es .elementor-invisible,.page-type-php .elementor-invisible,.page-type-php-es .elementor-invisible
{
visibility: visible!important;
}

