    <script>
      $(document).ready(function() {
        $('.cookies').hide();
        function checkCookieConsent() {
          return document.cookie.split('; ').find(row => row.startsWith('cookieConsent='));
        }

        // Show the popup if no consent cookie is found
        if (!checkCookieConsent()) {
          $('.cookies').show();
        }
      });

      // Handle Accept button click
      $('#acceptCookies').on('click', function() {
        document.cookie = "cookieConsent=accepted; path=/; max-age=" + (60 * 60 * 24); // 1 day
        $.ajax({
          url: '/api/cookie-consent',
          method: 'POST',
          data: {
            consent: 1,
            _token: "6Xtkm2IoG4NAAaDVzVF9qtK1YiWj4nrqcHB4SH3N" // Include CSRF token
          },
          success: function(response) {
            $('.cookies').hide();
          },
          error: function(xhr) {
            console.error('Failed to save consent:', xhr.responseText);
          }
        });
      });

      // Handle Reject button click
      $('#rejectCookies').on('click', function() {
        document.cookie = "cookieConsent=rejected; path=/; max-age=" + (60 * 60 * 24); // 1 day
        $.ajax({
          url: '/api/cookie-consent',
          method: 'POST',
          data: {
            consent: 0,
            _token: "6Xtkm2IoG4NAAaDVzVF9qtK1YiWj4nrqcHB4SH3N" // Include CSRF token
          },
          success: function(response) {
            $('.cookies').hide();
          },
          error: function(xhr) {
            console.error('Failed to save consent:', xhr.responseText);
          }
        });
      });

      function checkGridItems() {
        $(".results-grid").each(function () {
          let count = $(this).find(".result-item").length;

          if (count === 2) {
            $(this).addClass("two-items");
          } else {
            $(this).removeClass("two-items");
          }
        });
      }

      // initial
      $(window).on("load", function () {
        checkGridItems();
      });

      // dynamic (safe)
      setInterval(checkGridItems, 1000);

      (function () {
        const wrapper = document.querySelector(".doctor-search-wrapper");
        const dropdown = document.querySelector(".mj-search-dropdown");
        const input = document.getElementById("doctorSearch");

        if (!wrapper || !dropdown || !input) return;

        // SHOW on typing
        input.addEventListener("input", function () {
          if (this.value.trim() !== "") {
            dropdown.style.display = "block";
          } else {
            dropdown.style.display = "none";
          }
        });


        input.addEventListener("focus", function () {
          if (this.value.trim() !== "") {
            dropdown.style.display = "block";
          }
        });

        // HIDE on outside click
        document.addEventListener("click", function (e) {
          if (!wrapper.contains(e.target)) {
            dropdown.style.display = "none";
          }
        });

        // Prevent close on inside click
        wrapper.addEventListener("click", function (e) {
          e.stopPropagation();
        });

      })();
    </script>

         <script>

        $(document).ready(function () {
              var lastScrollTop = 0;
              var $nav = $('.main-nav');

              function handleScroll() {
                  if ($(window).width() >= 1024) {
                      var scrollTop = $(window).scrollTop();

                      if (scrollTop > 50) {
                          if (scrollTop > lastScrollTop) {
                              // Scroll DOWN â†’ hide
                              $nav.stop(true, true).slideUp(200);
                          } else {
                              // Scroll UP â†’ show
                              $nav.stop(true, true).slideDown(200);
                          }
                      }

                      lastScrollTop = scrollTop;
                  }
              }

              $(window).on('scroll', handleScroll);
          });

          // $(document).ready(function () {
          //   $("body").addClass("loading");

          //   setTimeout(function () {
