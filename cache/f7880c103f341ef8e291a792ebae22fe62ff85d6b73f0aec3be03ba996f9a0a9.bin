          <script>
        window.gtranslateSettings = {
          "default_language": "en",
          "url_structure": "sub_directory",
          "languages": ["en", "hi", "bn", "pa", "ru", "ar", "mr", "te", "fr", "so"],
          "wrapper_selector": ".gtranslate_wrapper",
          "horizontal_position": "left",
          "vertical_position": "top"
        };
