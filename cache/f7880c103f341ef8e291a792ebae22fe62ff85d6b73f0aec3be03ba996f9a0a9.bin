  <!-----------------  Common Popup Start here -------------->
  <script>
    $(document).ready(function () {
      function openPopup(popupClass) {
        $(".mjx-super-overlay").fadeIn(200);
        $(popupClass).addClass("mjx-active");
        $("body").addClass("mjx-no-scroll");
      }

      function closePopup() {
        $(".mjx-super-overlay").fadeOut(200);
        $(".mjx-popup").removeClass("mjx-active");
        $("body").removeClass("mjx-no-scroll");
      }

      // open form popup
      $(".mjx-open-form-popup").on("click", function () {
        openPopup(".mjx-form-popup");
      });

      // open image popup
      $(".mjx-open-image-popup").on("click", function () {
        openPopup(".mjx-image-popup");
      });

      // close button
      $(".mjx-close-popup").on("click", function () {
        closePopup();
      });

      // overlay click
      $(".mjx-super-overlay").on("click", function () {
        closePopup();
      });

      // ESC key (extra pro feature 😉)
      $(document).on("keydown", function (e) {
        if (e.key === "Escape") {
          closePopup();
        }
      });
    });
  </script>

  

