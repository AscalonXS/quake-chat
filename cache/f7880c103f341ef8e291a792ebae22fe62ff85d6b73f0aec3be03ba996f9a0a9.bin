        <div class="container">
            <div class="blog-content blog-detail-content pillar-tb-special">
                <div class="blog-detail-head">
                    <h1 class="heading mb-20">Heat Stroke vs. Heat Exhaustion: Symptoms &amp; First Aid</h1>

                    <div class="post-meta notranslate">
                        Medically Reviewed By

                                                 
                                                    <strong><a href="https://www.medanta.org/hospitals-near-me/lucknow-hospital/speciality/emergency/doctor/dr-lokendra-gupta">Dr. Lokendra Gupta</a></strong>, MD (Anesthesiology)|MRCEM|Fellow National Board Critical Care Medicine|MBBS,   Director                        
                        <strong>
                                                            -                                     <a href="https://www.medanta.org/hospitals-near-me/lucknow-hospital/speciality/emergency">Emergency</a>
                                                                                    </strong> 
                    </div>
                    <div class="post-date mb-20">
                        
                                                    Updated on: Jun 25, 2025
                         <br>

                        Published on: Jun 25, 2025
                    </div> 

                    <div class="share-post mb-30">
                        <div class="shareaholic-canvas" data-app="share_buttons" data-app-id="33131271"></div>
                    </div>
                                            <div class="mb-20 blog-bnr">
                            <img
                                src="https://medanta.s3.ap-south-1.amazonaws.com/blogs/June2025/FXft0iKXM9pc0CBCeocxg10tr2TP5L-metaSGVhdCBTdHJva2UgdnMuIEhlYXQgRXhoYXVzdGlvbl8gU3ltcHRvbXMgJiBGaXJzdCBBaWQucG5n-.png"
                                width="1000"
