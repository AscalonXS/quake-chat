    <script>
      document.addEventListener('DOMContentLoaded', function() {
        var banner = document.getElementById('ui-replacement-banner');
        if (!banner) { return; }
        var key = banner.getAttribute('data-dismiss-key');
        var isHidden = false;
        try { isHidden = localStorage.getItem(key) === '1'; } catch (e) {}
        if (!isHidden) { banner.style.display = 'flex'; }
        var closeBtn = document.getElementById('ui-replacement-banner-close');
        if (closeBtn) {
          closeBtn.addEventListener('click', function() {
            try { localStorage.setItem(key, '1'); } catch (e) {}
            banner.style.display = 'none';
          });
        }
      });
    </script>
    
