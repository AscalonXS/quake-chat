g.org/~/media/For%20Patients/faq018.pdf?http://www.acog.org/~/media/For%20Patients/faq018.pdf?dmc=1=20140703T2121569354\",\"aria-label\":\"$undefined\",\"prefetch\":false,\"className\":\"$undefined\",\"children\":[\"http://www.acog.org/~/media/For%20Patients/faq018.pdf?dmc=1=20140703T2121569354\"]}],\". Accessed July 3, 2014.\"]}]]}]\nf5:[\"$\",\"$1\",\"rich-text\",{\"children\":[[\"$\",\"$1\",\"5f0f75f85aab\",{\"children\":[\"National Highway Traffic Safety Administration. Buckle up in pregnancy. \",[\"$\",\"$L89\",\"91gyw04txs9\",{\"target\":\"$undefined\",\"href\":\"http://www.nhtsa.dot.gov/people/injury/airbags/Internet_Services_Group/ISG-Restricted/Buckle-Up%20America/pregnancybrochure/BUA_PregnancyNHTSAchange.pdf\",\"aria-label\":\"$undefined\",\"prefetch\":false,\"className\":\"$undefined\",\"children\":[\"http://www.nhtsa.dot.gov/people/injury/airbags/Internet_Services_Group/ISG-Restricted/Buckle-Up%20America/pregnancybrochure/BUA_PregnancyNHTSAchange.pdf\"]}],\". Accessed July 3, 2014.\"]}]]}]\nf6:[\"$\",\"$1\",\"rich-text\",{\"children\":[[\"$\",\"$1\",\"de1991006867\",{\"children\":[\"American College of Obstetricians and Gynecologists. Intimate partner violence. ACOG Committee Opinion No. 518. \",[\"$\",\"em\",\"plhsriu1rtn\",{\"children\":[\"Obstet Gynecol.\"]}],\" 2012;119(2 pt 1):412-417.\"]}]]}]\nf7:[\"$\",\"$1\",\"rich-text\",{\"children\":[[\"$\",\"$1\",\"aba7aa1ab299\",{\"children\":[\"AAP Committee on Fetus and Newborn and ACOG Committee on Obstetric Practice Editors. \",[\"$\",\"em\",\"81d2l4tu3pa\",{\"children\":[\"Guidelines for Perinatal Care\"]}],\" . 7th ed. Elk Grove, Ill.: American Academy of Pediatrics; 2012: 131–132, 246–248.\"]}]]}]\nf8:[\"$\",\"$1\",\"rich-text\",{\"children\":[[\"$\",\"$1\",\"304a57bfadfb\",{\"children\":[\"American Academy of Family Physicians. AAFP policies. Violence (position paper). \",[\"$\",\"$L89\",\"voae7p5nc5i\",{\"target\":\"$undefined\",\"href\":\"https://www.aafp.org/about/policies/all/v"])</script><scrip