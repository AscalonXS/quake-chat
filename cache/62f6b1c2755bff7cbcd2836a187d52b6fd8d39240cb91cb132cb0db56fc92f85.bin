ow as possible under the protuberant portion of the abdomen and the shoulder belt positioned off to the side of the uterus, between the breasts and over the midportion of the clavicle. All women of childbearing age should be routinely screened for intimate partner violence."])</script><script>self.__next_f.push([1,"61:T12d9,"])</script><script>self.__next_f.push([1,"{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Organization\",\"@id\":\"https://www.aafp.org/#Organization\",\"name\":\"American Academy of Family Physicians\",\"url\":\"https://www.aafp.org\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://dgnvxbcc3-res.cloudinary.com/image/upload/v1779209767/aafp_navigation_desktop.svg\",\"width\":146,\"height\":58},\"nonprofitStatus\":\"Nonprofit501c6\",\"alternateName\":\"AAFP\",\"sameAs\":[\"https://en.wikipedia.org/wiki/American_Academy_of_Family_Physicians\",\"https://x.com/aafp\",\"https://www.instagram.com/the_aafp\",\"https://www.youtube.com/user/AAFPmedia\",\"https://www.facebook.com/familymed\",\"https://www.linkedin.com/company/american-academy-of-family-physicians/\",\"https://www.tiktok.com/@the_aafp\",\"https://bsky.app/profile/aafp.org\",\"https://www.threads.com/@the_aafp\",\"https://integrationacademy.ahrq.gov/bhi-directory/parent-organization/23237\",\"https://www.primarycareforamerica.org/partner/american-academy-of-family-physicians/\"]},{\"@type\":\"WebSite\",\"@id\":\"https://www.aafp.org/#Website\",\"url\":\"https://www.aafp.org\",\"publisher\":{\"@id\":\"https://www.aafp.org/#Organization\"}},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"2014\",\"item\":\"https://www.aafp.org/afp/2014\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Nov 15, 2014\",\"item\":\"https://www.aafp.org/afp/2014/1115\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Trauma in Pregnancy: Assessment, Management, and Prevention\",\"item\":\"https://www.aafp.org/afp/2014/1115/p717\"}]},{\"@ty