document.head.appendChild(s);
})();</script><div class="base-page "><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://www.aafp.org/#Organization","name":"American Academy of Family Physicians","url":"https://www.aafp.org","logo":{"@type":"ImageObject","url":"https://dgnvxbcc3-res.cloudinary.com/image/upload/v1779209767/aafp_navigation_desktop.svg","width":146,"height":58},"nonprofitStatus":"Nonprofit501c6","alternateName":"AAFP","sameAs":["https://en.wikipedia.org/wiki/American_Academy_of_Family_Physicians","https://x.com/aafp","https://www.instagram.com/the_aafp","https://www.youtube.com/user/AAFPmedia","https://www.facebook.com/familymed","https://www.linkedin.com/company/american-academy-of-family-physicians/","https://www.tiktok.com/@the_aafp","https://bsky.app/profile/aafp.org","https://www.threads.com/@the_aafp","https://integrationacademy.ahrq.gov/bhi-directory/parent-organization/23237","https://www.primarycareforamerica.org/partner/american-academy-of-family-physicians/"]},{"@type":"WebSite","@id":"https://www.aafp.org/#Website","url":"https://www.aafp.org","publisher":{"@id":"https://www.aafp.org/#Organization"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"2014","item":"https://www.aafp.org/afp/2014"},{"@type":"ListItem","position":2,"name":"Nov 15, 2014","item":"https://www.aafp.org/afp/2014/1115"},{"@type":"ListItem","position":3,"name":"Trauma in Pregnancy: Assessment, Management, and Prevention","item":"https://www.aafp.org/afp/2014/1115/p717"}]},{"@type":"MedicalWebPage","@id":"https://www.aafp.org/afp/2014/1115/p717/#Webpage","url":"https://www.aafp.org/afp/2014/1115/p717","isPartOf":{"@id":"https://www.aafp.org/#Website"},"medicalAudience":"https://schema.org/Clinician"},{"@id":"https://www.aafp.org/afp/#Periodical","@type":"Periodical","url":"https://www.aafp.org/afp","image":"https://dgnvxbcc3-res.cloudinary.com/image/upload/v1779209772/american_family_physician_navigation_desktop.svg","name":"American Family Physician","alternateName":"AFP","publisher":{"@id":"https://www.aafp.org/#Organization"},"issn":["1532-0650","0002-838X"]},{"@id":"https://www.aafp.org/afp/#Volume-90","@type":"PublicationVolume","volumeNumber":90,"isPartOf":{"@id":"https://www.aafp.org/afp/#Periodical"}},{"@type":"PublicationIssue","@id":"https://www.aafp.org/afp/2014/1115/#Issue","issueNumber":10,"datePublished":"2014-11-15","isPartOf":{"@id":"https://www.aafp.org/afp/#Volume-90"}},{"@type":["Article","MedicalScholarlyArticle"],"url":"https://www.aafp.org/afp/2014/1115/p717","@id":"https://www.aafp.org/afp/2014/1115/p717/#Article","description":"Trauma complicates one in 12 pregnancies, and is the leading nonobstetric cause of death among pregnant women. The most common traumatic injuries are motor vehicle crashes, assaults, falls, and intimate partner violence. Nine out of 10 traumatic injuries during pregnancy are classified as minor, yet 60% to 70% of fetal losses after trauma are a result of minor injuries. In minor trauma, four to 24 hours of tocodynamometric monitoring is recommended. Ultrasonography has low sensitivity, but high specificity, for placental abruption. The Kleihauer-Betke test should be performed after major trauma to determine the degree of fetomaternal hemorrhage, regardless of Rh status. To improve the effectiveness of cardiopulmonary resuscitation, clinicians should perform left lateral uterine displacement by tilting the whole maternal body 25 to 30 degrees. Unique aspects of advanced cardiac life support include early intubation, removal of all uterine and fetal monitors, and performance of perimortem cesarean delivery. Proper seat belt use reduces the risk of maternal and fetal injuries in motor vehicle crashes. The lap belt should be placed as low as possible under the protuberant portion of the abdomen and the shoulder belt positioned off to the side of the uterus, between the breasts and over the midportion of the clavicle. All women of childbearing age should be routinely screened for intimate partner violence.","headline":"Trauma in Pregnancy: Assessment, Management, and Prevention","datePublished":"2014-11-15","publisher":{"@id":"https://www.aafp.org/#Organization","@type":"Organization"},"author":[{"@type":"Person","name":"NEIL J. MURPHY"},{"@type":"Person","name":"JEFFREY D. QUINLAN"}],"mainEntityOfPage":{"@type":"MedicalWebPage","@id":"https://www.aafp.org/afp/2014/1115/p717/#Webpage","url":"https://www.aafp.org/afp/2014/1115/p717","isPartOf":{"@id":"https://www.aafp.org/#Website"},"medicalAudience":"https://schema.org/Clinician"},"inLanguage":"en-US","isAccessibleForFree":true,"isPartOf":{"@id":"https://www.aafp.org/afp/2014/1115/#Issue"},"sameAs":"https://pubmed.ncbi.nlm.nih.gov/25403036/","articleSection":"Articles","identifier":[{"@type":"PropertyValue","propertyID":"PMID","value":"25403036"}]}]}</script><div class="skip-link-container"><a class="btn skip-link" href="#main-content" aria-disabled="false"><span class="btn__label">Skip to main content</span></a></div><header data-uid="fb539064-7622-4e7d-a553-48efd24038ee" data-login-url="https://www.aafp.org/cgi-bin/lg.pl" data-logout-url="https://www.aafp.org/cgi-bin/logout.pl" data-enable-login="true" data-aafp-user-js-url="https://www.aafp.org/jsparse/AAFPUser.js" data-disable-userjs-load="true" data-aafp-cmp-is="top-navigation" data-gtm-code="GTM-W2NKFV5H" class="top-navigation top-navigation--resizing-links"><div class="top-navigation__container"><div class="top-navigation__content" data-aafp-focus-trap="mobile"><div class="top-navigation__hamburger-logo" data-aafp-focus-trap="desktop"><div class="top-navigation__hamburger-container"><button id="top-navigation-hamburger" type="button" class="top-navigation__hamburger" aria-expanded="false" aria-label="Open menu" data-open-label="Open menu" data-close-label="Close menu"><div class="hamburger-icon" aria-hidden="true"><div class="hamburger-icon__lines"><span></span><span></span