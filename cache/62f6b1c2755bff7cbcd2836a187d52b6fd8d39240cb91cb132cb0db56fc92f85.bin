-1,\"children\":[\"2013\",\"$undefined\"]}]}],[\"$\",\"li\",\"main-sub-nav-item-15\",{\"children\":[\"$\",\"a\",null,{\"href\":\"/afp/2012\",\"target\":\"_self\",\"tabIndex\":-1,\"children\":[\"2012\",\"$undefined\"]}]}],[\"$\",\"li\",\"main-sub-nav-item-16\",{\"children\":[\"$\",\"a\",null,{\"href\":\"/afp/2011\",\"target\":\"_self\",\"tabIndex\":-1,\"children\":[\"2011\",\"$undefined\"]}]}],[\"$\",\"li\",\"main-sub-nav-item-17\",{\"children\":[\"$\",\"a\",null,{\"href\":\"/afp/2010\",\"target\":\"_self\",\"tabIndex\":-1,\"children\":[\"2010\",\"$undefined\"]}]}],[\"$\",\"li\",\"main-sub-nav-item-18\",{\"children\":[\"$\",\"a\",null,{\"href\":\"/afp/2009\",\"target\":\"_self\",\"tabIndex\":-1,\"children\":[\"2009\",\"$undefined\"]}]}],[\"$\",\"li\",\"main-sub-nav-item-19\",{\"children\":[\"$\",\"a\",null,{\"href\":\"/afp/2008\",\"target\":\"_self\",\"tabIndex\":-1,\"children\":[\"2008\",\"$undefined\"]}]}],\"$La9\",\"$Laa\",\"$Lab\",\"$Lac\",\"$Lad\",\"$Lae\",\"$Laf\",\"$Lb0\",\"$Lb1\",\"$Lb2\"]}]]}]}]]}],\"$Lb3\",\"$Lb4\",\"$Lb5\",\"$Lb6\",\"$Lb7\",\"$Lb8\"]}]}]]}]}],\"$Lb9\",\"$Lba\"]}]}]]}],\"$Lbb\"]}]\n"])</script><script>self.__next_f.push([1,"80:[\"$\",\"a\",null,{\"href\":\"https://www.aafp.org/ams/account/portal/journals\",\"target\":\"_self\",\"children\":\"Journal subscriptions\"}]\n81:[\"$\",\"li\",\"link-3\",{\"className\":\"my-account-main-nav-list-item\",\"children\":[\"$\",\"a\",null,{\"href\":\"https://www.aafp.org/ams/account/portal/payments\",\"target\":\"_self\",\"children\":\"Payments \u0026 donations\"}]}]\n82:[\"$\",\"li\",\"link-4\",{\"className\":\"my-account-main-nav-list-item\",\"children\":[\"$\",\"a\",null,{\"href\":\"https://www.aafp.org/ams/account/portal/profile\",\"target\":\"_self\",\"children\":\"Profile\"}]}]\n83:[\"$\",\"div\",null,{\"className\":\"sec-nav\",\"children\":[\"$\",\"ul\",null,{\"className\":\"sec-nav__list\",\"children\":[\"$\",\"li\",null,{\"children\":[\"$\",\"a\",null,{\"href\":\"https://www.aafp.org/cgi-bin/logout.pl\",\"target\":\"_self\",\"children\":\"Log out\"}]}]}]}]\n84:[\"$\",\"div\",null,{\"className\":\"my-account-flyout__bg\"}]\nbc:T7c4,"])</script><script>self.__next_f.push([1,"\u003ctable frame=\"hsides\" rules=\"groups\"\u003e\u003cthead\u003e\u003ctr\u003e\u003cth align=\"left\" valign=\"bottom\"\u003e\u003ci\u003eClinical recommendation\u003c/i\u003e\u003c/th\u003e\u003cth align=\"left\" valign=\"bottom\"\u003e\u003ci\u003eEvidence rating\u003c/i\u003e\u003c/th\u003e\u003cth align=\"left\" valign=\"bottom\"\u003e\u003ci\u003eReferences\u003c/i\u003e\u003c/th\u003e\u003c/tr\u003e\u003c/thead\u003e\u003ctbody\u003e\u003ctr\u003e\u003ctd align=\"left\" valign=\"top\"\u003ePregnant women at greater than 20 weeks' gestation who have experienced trauma should be monitored for a minimum of four hours by tocodynamometry.\u003c/td\u003e\u003ctd align=\"left\" valign=\"top\"\u003eC\u003c/td\u003e\u003ctd align=\"left\" valign=\"top\"\u003e\u003csup\u003e\u003ca href=\"#afp20141115p717-b8\"\u003e8\u003c/a\u003e\u003c/sup\u003e, \u003csup\u003e\u003ca href=\"#afp20141115p717-b12\"\u003e12\u003c/a\u003e\u003c/sup\u003e \u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd align=\"left\" valign=\"top\"\u003eThe Kleihauer-Betke test should be performed in all pregnant women who sustain major trauma.\u003c/td\u003e\u003ctd align=\"left\" valign=\"top\"\u003eC\u003c/td\u003e\u003ctd align=\"left\" valign=\"top\"\u003e\u003csup\u003e\u003ca href=\"#afp20141115p717-b8\"\u003e8\u003c/a\u003e\u003c/sup\u003e, \u003csup\u003e\u003ca href=\"#afp20141115p717-b12\"\u003e12\u003c/a\u003e\u003c/sup\u003e \u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd align=\"left\" valign=\"top\"\u003ePerimortem cesarean delivery after cardiac arrest may improve neonatal and maternal outcomes, and is not harmful.\u003c/td\u003e\u003ctd align=\"left\" valign=\"top\"\u003eC\u003c/td\u003e\u003ctd align=\"left\" valign=\"top\"\u003e\u003csup\u003e\u003ca href=\"#afp20141115p717-b16\"\u003e16\u003c/a\u003e\u003c/sup\u003e, \u003csup\u003e\u003ca href=\"#afp20141115p717-b19\"\u003e19\u003c/a\u003e\u003c/sup\u003e, \u003csup\u003e\u003ca href=\"#afp20141115p717-b20\"\u003e20\u003c/a\u003e\u003c/sup\u003e, \u003csup\u003e\u003ca href=\"#afp20141115p717-b22\"\u003e22\u003c/a\u003e\u003c/sup\u003e \u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd align=\"left\" valign=\"top\"\u003ePregnant women who are occupants in motor vehicles should wear lap and shoulder seat belts, and should not turn off air bags.\u003c/td\u003e\u003ctd align=\"left\" valign=\"top\"\u003eC\u003c/td\u003e\u003ctd align=\"left\" valign=\"top\"\u003e\u003csup\u003e\u003ca href=\"#afp20141115p717-b28\"\u003e28\u003c/a\u003e\u003c/sup\u003e, \u003csup\u003e\u003ca href=\"#afp20141115p717-b29\"\u003e29\u003c/a\u003e\u003c/sup\u003e \u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd align=\"left\" valign=\"top\"\u003eAll women of childbearing age should be screened for intimate partner violence.\u003c/td\u003e\u003ctd align=\"left\" valign=\"top\"\u003eB\u003c/td\u003e\u003ctd align=\"left\" valign=\"top\"\u003e\u003csup\u003e\u003ca href=\"#afp20141115p717-b31\"\u003e31\u003c/a\u003e\u003c/sup\u003e, \u003csup\u003e\u003ca href=\"#afp20141115p717-b33\"\u003e33\u003c/a\u003e\u003c/sup\u003e \u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e"])</script><script>self.__next_f.push([1,"8c:[[\"$\",\"div\",\"ce9b74e88a56\",{\"className\":\"text-block mb-body-para body-copy has-rich-text container text-container\",\"id\":\"$undefined\",\"children\":[\"$\",\"$1\",\"rich-text\",{\"children\":[[\"$\",\"p\",\"a9e5334c8d88\",{\"children\":[\"Family physicians, regardless of their involvement in intrapartum care, often evaluate pregnant women after minor accidents, falls, or motor vehicle crashes. Trauma complicates one in 12 pregnancies, and is the leading nonobstetric cause of death among pregnant women.\",[\"$\",\"sup\",\"ixq5rk8jpy\",{\"children\":[[\"$\",\"$L89\",\"ixq5rk8jpy\",{\"target\":\"$undefined\",\"href\":\"#afp20141115p717-b1\",\"aria-label\":\"$undefined\",\"prefetch\":false,\"className\":\"$undefined\",\"children\":[\"1\"]}],\"–\",[\"$\",\"$L89\",\"6mlp2ecd4ms\",{\"target\":\"$undefined\",\"href\":\"#afp20141115p717-b3\",\"aria-label\":\"$undefined\",\"prefetch\":false,\"className\":\"$undefined\",\"children\":[\"3\"]}]]}],\" Traumatic injuries to pregnant women are unintentional (motor vehicle crashes [48%], falls [25%], poisonings, and burns) or intentional (assaults/intimate partner violence [IPV; 17%], suicide [3.3%], homicide, and gunshot wounds [4%]).\",[\"$\",\"sup\",\"ty7cmbw4s7l\",{\"children\":[[\"$\",\"$L89\",\"ty7cmbw4s7l\",{\"target\":\"$undefined\",\"href\":\"#afp20141115p717-b2\",\"aria-label\":\"$undefined\",\"prefetch\":false,\"className\":\"$undefined\",\"children\":[\"2\"]}],\",\",[\"$\",\"$L89\",\"88fc387t77d\",{\"target\":\"$undefined\",\"href\":\"#afp20141115p717-b4\",\"aria-label\":\"$undefined\",\"prefetch\":false,\"className\":\"$undefined\",\"children\":[\"4\"]}]]}],\" Injuries are classified as minor or major trauma. By convention, minor trauma does not involve the abdomen, rapid compression, deceleration, or shearing forces, and the patient does not report pain, vaginal bleeding, loss of fluid, or decreased fetal movement.\",[\"$\",\"$L89\",\"tny1udsdeso\",{\"target\":\"$undefined\",\"href\":\"#afp20141115p717-b5\",\"aria-label\":\"$undefined\",\"prefetch\":false,\"className\":\"$undefined\",\"children\":[[\"$\",\"sup\",\"tny1udsdeso\",{\"children\":[\"5\"]}]]}],\" Nine out of 10 traumatic injuries during pregnancy are classified as minor. However, of fetal losses associated with trauma, 60% to 70% follow minor injuries.\",[\"$\",\"$L89\",\"nk06tvrcqgr\",{\"target\":\"$undefined\",\"href\":\"#afp20141115p717-b4\",\"aria-label\":\"$undefined\",\"prefetch\":false,\"className\":\"$undefined\",\"children\":[[\"$\",\"sup\",\"nk06tvrcqgr\",{\"children\":[\"4\"]}]]}]]}]]}]}],[\"$\",\"$L9c\",\"2b1ba190de3e\",{\"pin\":\"afp20141115p717-ut1\",\"numberText\":\"$undefined\",\"heading\":{\"level\":\"h3\",\"text\":[\"$\",\"$1\",\"rich-text\",{\"children\":[[\"$\",\"$1\",\"8020da09fb7f\",{\"children\":[\"SORT: KEY RECOMMENDATIONS FOR PRACTICE\"]}]]}],\"secondaryText\":null},\"subheading\":null,\"citation\":null,\"description\":[\"$\",\"$1\",\"rich-text\",{\"children\":[[\"$\",\"p\",\"f0d556be331b\",{\"children\":[[\"$\",\"em\",\"d471vg9q7a\",{\"children\":[\"A = consistent, good-quality patient-oriented evidence; B = inconsistent or limited-quality patient-oriented evidence; C = consensus, disease-oriented evidence, usual practice, expert opinion, or case series. For information about the SORT evidence rating system, go to \",[\"$\",\"$L89\",\"pgbt35usco8\",{\"target\":\"$undefined\",\"href\":\"https://www.aafp.org/afpsort\",\"aria-label\":\"$undefined\",\"prefetch\":false,\"className\":\"$undefined\",\"children\":[\"https://www.aafp.org/afpsort\"]}],\".\"]}]]}]]}],\"image\":{\"src\":\"https://dgnvxbcc3-res.cloudinary.com/image/upload/v1773080162/Journals/Automation/AFP/2014/1115/p717-ut1-gif.gif\",\"alt\":\"\",\"width\":1191,\"height\":1078,\"focalPoint\":\"middle_center\",\"aspectRatio\":\"auto\"},\"table\":\"$bc\",\"noRightsText\":\"$undefined\",\"displaySettings\":{\"hideEnlarge\":\"$undefined\",\"hidePrint\":\"$undefined\",\"hideDescription\":\"$undefined\",\"showImageInline\":true},\"isPrint\":false,\"nntRating\":\"$undefined\",\"i18n\":{\"enlarge\":\"Enlarge\",\"print\":\"Print\"}}],\"$Lbd\",\"$Lbe\",\"$Lbf\",\"$Lc0\",\"$Lc1\",\"$Lc2\",\"$Lc3\",\"$Lc4\",\"$Lc5\",\"$Lc6\",\"$Lc7\",\"$Lc8\",\"$Lc9\",\"$Lca\",\"$Lcb\",\"$Lcc\",\"$Lcd\",\"$Lce\",\"$Lcf\",\"$Ld0\",\"$Ld1\",\"$Ld2\",\"$Ld3\",\"$Ld4\",\"$Ld5\",\"$Ld6\",\"$Ld7\",\"$Ld8\",\"$Ld9\",\"$Lda\",\"$Ldb\",\"$Ldc\",\"$Ldd\",\"$Lde\",\"$Ldf\",\"$Le0\",\"$Le1\",\"$Le2\"]\n"])</script><script>self.__next_f.push([1,"8d:[\"$\",\"$Le3\",null,{\"heading\":\"Author information\",\"disclosures\":[[\"$\",\"$1\",\"rich-text\",{\"children\":[[\"$\",\"p\",\"b52691393534\",{\"children\":[\"NEIL J. MURPHY, MD, is a staff member in the Dept. of Obstetrics and Gynecology at Alaska Native Medical Center in Anchorage, and an associate professor in the Dept. of Family Medicine at the University of Washington in Seattle.\"]}]]}],[\"$\",\"$1\",\"rich-text\",{\"children\":[[\"$\",\"p\",\"7f0a3be1d772\",{\"children\":[\"JEFFREY D. QUINLAN, MD, is an associate professor in and vice chair of the Dept. of Family Medicine at the Uniformed Services University of the Health Sciences in Bethesda, Md.\"]}]]}],[\"$\",\"$1\",\"rich-text\",{\"children\":[[\"$\",\"p\",\"146204ae9fef\",{\"children\":[\"Author disclosure: No relevant financial affiliations.\"]}]]}],[\"$\",\"$1\",\"rich-text\",{\"children\":[[\"$\",\"p\",\"2df295567bbe\",{\"children\":[[\"$\",\"em\",\"hw1ye3g3w6v\",{\"children\":[\"Address correspondence to Neil J. Murphy, MD, Alaska Native Medical Center, 4320 Diplomacy Dr., PCC-OB/GYN, Anchorage, AK 99508 (e-mail: \",[\"$\",\"$L89\",\"eb2tuwhqupp\",{\"target\":\"$undefined\",\"href\":\"mailto:njmurphy@southcentralfoundation.com\",\"aria-label\":\"$undefined\",\"prefetch\":false,\"className\":\"$undefined\",\"children\":[\"njmurphy@southcentralfoundation.com\"]}],\"). Reprints are not available from the authors\"]}],\".\"]}]]}]]}]\n"])</script><script>self.__next_f.push([1,"8e:[\"$\",\"$Le4\",null,{\"id\":\"references\",\"inline\":false,\"expandedByDefault\":false,\"heading\":\"Reference(s)\",\"references\":[{\"text\":[\"$\",\"$1\",\"rich-text\",{\"children\":[[\"$\",\"$1\",\"25af5246ad91\",{\"children\":[\"Mirza FG, Devine PC, Gaddipati S. Trauma in pregnancy: a systematic approach. \",[\"$\",\"em\",\"56fkpwtxh9a\",{\"children\":[\"Am J Perinatol.\"]}],\" 2010;27(7):579-586.\"]}]]}],\"anchor\":\"afp20141115p717-b1\"},{\"text\":[\"$\",\"$1\",\"rich-text\",{\"children\":[[\"$\",\"$1\",\"f2be322c39bc\",{\"children\":[\"El Kady D. Perinatal outcomes of traumatic injuries during pregnancy. \",[\"$\",\"em\",\"t0f6