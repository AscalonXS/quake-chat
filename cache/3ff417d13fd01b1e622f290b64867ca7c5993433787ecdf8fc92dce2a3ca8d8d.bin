    <!-- HowTo Schema - CPR -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": "How to Perform CPR on an Adult",
      "description": "Step-by-step instructions for performing cardiopulmonary resuscitation (CPR) on an adult who is not breathing.",
      "image": "https://imedic.health/images/cpr-instructions.jpg",
      "estimatedCost": {
        "@type": "MonetaryAmount",
        "currency": "USD",
        "value": "0"
      },
      "totalTime": "PT10M",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Ensure safety",
          "text": "Check the area for any dangers to yourself or the casualty before approaching.",
          "url": "https://imedic.health/en/first-aid/general/first-aid-guide#cpr"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Check for response",
          "text": "Tap the person's shoulders and ask loudly: Are you okay? Look for any response.",
          "url": "https://imedic.health/en/first-aid/general/first-aid-guide#cpr"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Call for help",
          "text": "If no response, call emergency services immediately or ask someone else to call while you start CPR.",
          "url": "https://imedic.health/en/first-aid/general/first-aid-guide#cpr"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Open the airway",
          "text": "Place the person on their back. Tilt their head back by lifting the chin to open the airway.",
          "url": "https://imedic.health/en/first-aid/general/first-aid-guide#cpr"
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Check for breathing",
          "text": "Look, listen, and feel for normal breathing for no more than 10 seconds. Gasping is not normal breathing.",
          "url": "https://imedic.health/en/first-aid/general/first-aid-guide#cpr"
        },
        {
          "@type": "HowToStep",
          "position": 6,
          "name": "Start chest compressions",
          "text": "Place the heel of your hand on the center of the chest. Put your other hand on top and interlock fingers. Push hard and fast: 100-120 compressions per minute, at least 5cm deep.",
          "url": "https://imedic.health/en/first-aid/general/first-aid-guide#cpr"
        },
        {
          "@type": "HowToStep",
          "position": 7,
          "name": "Give rescue breaths if trained",
          "text": "After 30 compressions, give 2 rescue breaths if you are trained. Pinch the nose, lift the chin, seal your mouth over theirs, and blow for about 1 second until the chest rises.",
          "url": "https://imedic.health/en/first-aid/general/first-aid-guide#cpr"
        },
        {
          "@type": "HowToStep",
          "position": 8,
          "name": "Continue CPR",
          "text": "Continue with cycles of 30 compressions and 2 breaths until emergency services arrive, an AED is available, or the person starts breathing normally.",
          "url": "https://imedic.health/en/first-aid/general/first-aid-guide#cpr"
        }
      ]
    }
    </script>

