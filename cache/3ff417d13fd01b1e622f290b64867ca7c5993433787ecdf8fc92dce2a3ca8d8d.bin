                            <div class="fact-label">Survival Rate</div>
                            <div class="fact-value" data-ai-fact="true">2-3x higher</div>
                            <div class="fact-label">with bystander CPR</div>
                        </div>
                        <div class="fact-item">
                            <div class="fact-label">Golden Hour</div>
                            <div class="fact-value" data-ai-fact="true">60 minutes</div>
                            <div class="fact-label">critical trauma window</div>
                        </div>
