t%20top%20%3D%20container.scrollTop%20%2B%20%28tRect.top%20-%20cRect.top%29%20-%20offset%3B%0D%0A%20%20%20%20%20%20const%20smooth%20%3D%20%21window.matchMedia%28%27%28prefers-reduced-motion%3A%20reduce%29%27%29.matches%3B%0D%0A%20%20%20%20%20%20try%7B%0D%0A%20%20%20%20%20%20%20%20container.scrollTo%28%7B%20top%3A%20Math.max%280%2C%20top%29%2C%20behavior%3A%20smooth%20%3F%20%27smooth%27%20%3A%20%27auto%27%20%7D%29%3B%0D%0A%20%20%20%20%20%20%7Dcatch%28_%29%7B%0D%0A%20%20%20%20%20%20%20%20container.scrollTop%20%3D%20Math.max%280%2C%20top%29%3B%0D%0A%20%20%20%20%20%20%7D%0D%0A%20%20%20%20%7D%0D%0A%0D%0A%20%20%20%20if%28burger%20%26%26%20drawer%20%26%26%20closeBtn%29%7B%0D%0A%20%20%20%20%20%20burger.addEventListener%28%27click%27%2C%20e%3D%3E%7B%20e.preventDefault%28%29%3B%20openDrawer%28%29%3B%20%7D%29%3B%0D%0A%20%20%20%20%20%20closeBtn.addEventListener%28%27click%27%2C%20%28%29%3D%3E%20closeDrawer%28%29%29%3B%0D%0A%20%20%20%20%20%20drawer.addEventListener%28%27click%27%2C%20e%3D%3E%7B%20if%28e.target.matches%28%27a%27%29%29%20closeDrawer%28%29%3B%20%7D%29%3B%0D%0A%0D%0A%20%20%20%20%20%20%2F%2F%20Expander%3A%20open%20li%20and%20prime%20EACH%20stack%20to%20index%200%0D%0A%20%20%20%20%20%20drawer.querySelectorAll%28%27.m-expander%27%29.forEach%28function%28btn%29%7B%0D%0A%20%20%20%20%20%20%20%20btn.addEventListener%28%27click%27%2C%20function%28%29%7B%0D%0A%20%20%20%20%20%20%20%20%20%20const%20li%20%3D%20btn.closest%28%27.m-item%27%29%3B%0D%0A%20%20%20%20%20%20%20%20%20%20const%20isOpen%20%3D%20li.classList.toggle%28%27open%27%29%3B%0D%0A%20%20%20%20%20%20%20%20%20%20btn.setAttribute%28%27aria-expanded%27%2C%20isOpen%20%3F%20%27true%27%20%3A%20%27false%27%29%3B%0D%0A%0D%0A%20%20%20%20%20%20%20%20%20%20if%28isOpen%29%7B%0D%0A%20%20%20%20%20%20%20%20%20%20%20%20li.querySelectorAll%28%27.m-stack%27%29.forEach%28stack%20%3D%3E%20activateInStack%28stack%2C%200%29%29%3B%0D%0A%20%20%20%20%20%20%20%20%20%20%7D%0D%0A%20%20%20%20%20%20%20%20%7D%29%3B%0D%0A%20%20%20%20%20%20%7D%29%3