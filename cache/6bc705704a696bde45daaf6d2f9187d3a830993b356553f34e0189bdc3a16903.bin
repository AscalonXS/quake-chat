					<script defer src="data:text/javascript,%28%20%28%29%20%3D%3E%20%7B%0A%09%09%09%09%09const%20lazyloadRunObserver%20%3D%20%28%29%20%3D%3E%20%7B%0A%09%09%09%09%09%09const%20lazyloadBackgrounds%20%3D%20document.querySelectorAll%28%20%60.e-con.e-parent%3Anot%28.e-lazyloaded%29%60%20%29%3B%0A%09%09%09%09%09%09const%20lazyloadBackgroundObserver%20%3D%20new%20IntersectionObserver%28%20%28%20entries%20%29%20%3D%3E%20%7B%0A%09%09%09%09%09%09%09entries.forEach%28%20%28%20entry%20%29%20%3D%3E%20%7B%0A%09%09%09%09%09%09%09%09if%20%28%20entry.isIntersecting%20%29%20%7B%0A%09%09%09%09%09%09%09%09%09let%20lazyloadBackground%20%3D%20entry.target%3B%0A%09%09%09%09%09%09%09%09%09if%28%20lazyloadBackground%20%29%20%7B%0A%09%09%09%09%09%09%09%09%09%09lazyloadBackground.classList.add%28%20%27e-lazyloaded%27%20%29%3B%0A%09%09%09%09%09%09%09%09%09%7D%0A%09%09%09%09%09%09%09%09%09lazyloadBackgroundObserver.unobserve%28%20entry.target%20%29%3B%0A%09%09%09%09%09%09%09%09%7D%0A%09%09%09%09%09%09%09%7D%29%3B%0A%09%09%09%09%09%09%7D%2C%20%7B%20rootMargin%3A%20%27200px%200px%20200px%200px%27%20%7D%20%29%3B%0A%09%09%09%09%09%09lazyloadBackgrounds.forEach%28%20%28%20lazyloadBackground%20%29%20%3D%3E%20%7B%0A%09%09%09%09%09%09%09lazyloadBackgroundObserver.observe%28%20lazyloadBackground%20%29%3B%0A%09%09%09%09%09%09%7D%20%29%3B%0A%09%09%09%09%09%7D%3B%0A%09%09%09%09%09const%20events%20%3D%20%5B%0A%09%09%09%09%09%09%27DOMContentLoaded%27%2C%0A%09%09%09%09%09%09%27elementor%2Flazyload%2Fobserve%27%2C%0A%09%09%09%09%09%5D%3B%0A%09%09%09%09%09events.forEach%28%20%28%20event%20%29%20%3D%3E%20%7B%0A%09%09%09%09%09%09document.addEventListener%28%20event%2C%20lazyloadRunObserver%20%29%3B%0A%09%09%09%09%09%7D%20%29%3B%0A%09%09%09%09%7D%20%29%28%29%3B"></script>
			<script defer src="data:text/javascript,%2F%2A%20Slider%20photos%20fix%20v2%20%2820%20Nov%202026%29.%20FlyingPress%20lazy-loads%20background%20images%3A%20it%20adds%20the%20class%0D%0A%20%20%20flying-press-lazy-bg%20and%20removes%20it%20when%20the%20element%20scrolls%20into%20view.%20Elementor%20carousels%20that%0D%0A%20%20%20loop%20make%20copies%20of%20their%20slides%20after%20FlyingPress%20has%20started%20watching%2C%20so%20the%20copies%20%28and%20some%0D%0A%20%20%20off-screen%20slides%29%20never%20lose%20the%20class%20and%20show%20a%20blank%20card.%20This%20keeps%20lazy%20loading%3A%20when%20a%0D%0A%20%20%20carousel%20comes%20within%20300px%20of%20the%20screen%2C%20every%20photo%20inside%20it%20-%20copies%20included%20-%20is%20shown.%0D%0A%20%20%20Nothing%20outside%20carousels%20is%20touched.%20Safe%20to%20switch%20off%20at%20any%20time.%20%2A%2F%0D%0A%28function%20%28%29%20%7B%0D%0A%20%20var%20C%20%3D%20%27flying-press-lazy-bg%27%3B%0D%0A%20%20function%20show%28sw%29%20%7B%0D%0A%20%20%20%20if%20%28sw.classList.contains%28C%29%29%20%7B%20sw.classList.remove%28C%29%3B%20%7D%0D%0A%20%20%20%20var%20els%20%3D%20sw.querySelectorAll%28%27.%27%20%2B%20C%29%3B%0D%0A%20%20%20%20for%20%28var%20i%20%3D%200%3B%20i%20%3C%20els.length%3B%20i%2B%2B%29%20%7B%20els%5Bi%5D.classList.remove%28C%29%3B%20%7D%0D%0A%20%20%7D%0D%0A%20%20var%20io%20%3D%20window.IntersectionObserver%20%3F%20new%20IntersectionObserver%28function%20%28entries%29%20%7B%0D%0A%20%20%20%20for%20%28var%20i%20%3D%200%3B%20i%20%3C%20entries.length%3B%20i%2B%2B%29%20%7B%0D%0A%20%20%20%20%20%20if%20%28entries%5Bi%5D.isIntersecting%29%20%7B%20entries%5Bi%5D.target.setAttribute%28%27data-sf-near%27%2C%20%271%27%29%3B%20show%28entries%5Bi%5D.target%29%3B%20%7D%0D%0A%20%20%20%20%7D%0D%0A%20%20%7D%2C%20%7B%20rootMargin%3A%20%27300px%200px%27%20%7D%29%20%3A%20null%3B%0D%0A%20%20function%20scan%28%29%20%7B%0D%0A%20%20%20%20var%20sws%20%3D%20document.querySelectorAll%28%27.swiper%2C%20.swiper-container%27%29%3B%0D%0A%20%