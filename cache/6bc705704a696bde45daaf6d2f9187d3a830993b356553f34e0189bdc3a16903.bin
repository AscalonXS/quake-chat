/* Button Hover*/
.bthv {
	opacity: 0;
	transition-duration: .75s;
}

.bthv:hover {
	opacity: 1;
}
i.fal.fa-map-marker-alt {
    margin-top: 0px;
}
.elementor-icon-box-icon {
    margin-bottom: 0px !important;
}
body .wwtc_courses_main .wwtc_courses_field select {
    height: 50px;
	margin: 1px 1px 17px 1px;
    color: #333;
	}

#table-wrapper {
  position:relative;
}
#table-scroll {
  height:532px;
  overflow:auto;  
  margin-top:20px;
}
#table-wrapper table {
  width:100%;

}
#table-wrapper table *:not(.vTimeTableLocation *) {
  background;
  color:black;
}
#table-wrapper table thead th .text {
  position:absolute;   
  top:-20px;
  z-index:2;
  height:20px;
  width:35%;
  border:1px solid red;
}
.vTimeTableLocation {
    margin-left: -140px;
}

body .course-book-now-button {
	
	margin-top:-20px;
	
}

/**Linkned style **/
.ads-link .eael-elements-flip-box-front-container::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6); /* Black color with 0.8 opacity */
    z-index: 1; /* Ensure the overlay sits on top of the background */
}

.ads-link .elementor-61125 .elementor-element.elementor-element-fc6da31 .eael-elements-flip-box-front-container * {
    position: relative;
    z-index: 2; /* Ensure content within the container sits above the overlay */
}
.eael-elements-slider-display-table {
    width: 100%;
    z-index: 1;
}

/** NDIS style **/
.head-bene h4 {
	min-height: 57px;
}
.head-bene p {
	min-height: 96px;
}
.heading-align {
    min-height: 70px;
}
.heading-align-sec {
	min-height: 43px;
}
  .hero-form-ndis {
    max-width: 4000px;
}

@media screen and (max-width: 1024px) {
  .left-blank {
    display: none !important;
  }
}


/** Sticky Notes **/

.csn-card-html ul, .csn-card-html ol
{
    text-align: left;
    margin: 8px 0 !important;
    padding-left: 21px !important;
    color: inherit;
}
/* Tablet portrait only */
@media (min-width: 768px) and (max-width: 1024px) {
  .map-container iframe {
    height: 350px;
  }
}
@media (max-width: 430px) {
    i.fal.fa-map-marker-alt {
        margin-top: 0px !important;
        height: .8em;
    }  
	.map-container iframe, 	.map-container-2 iframe {
    height: 330px;
  }
}</style>
