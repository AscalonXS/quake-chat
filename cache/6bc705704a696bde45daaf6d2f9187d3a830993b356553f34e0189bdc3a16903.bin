/* Start custom CSS for container, class: .elementor-element-2ae4580d */.online-courses-bar {
  position: fixed;
  /*top: 78px;*/
  
  opacity: 0;
  pointer-events: none;
  z-index: 99;
  position: absolute;
  bottom: -16px;
}

.elementor-sticky--effects .online-courses-bar {
  opacity: 1;
  pointer-events: auto;
  
}


.elementor-sticky--effects + .online-courses-bar,
.elementor-sticky--effects ~ .online-courses-bar {
  opacity: 1;
  pointer-events: auto;
  
}

