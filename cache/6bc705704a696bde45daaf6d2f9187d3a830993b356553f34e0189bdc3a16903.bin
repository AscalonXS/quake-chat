<style type="text/css">
.post-ao {
  font-family: var(--e-global-typography-text-font-family, "Inter"), sans-serif;
  font-size: 18px;
  font-weight: var(--e-global-typography-text-font-weight, 400);
  line-height: 1.8;                    /* audit: 32.4px / 18px */
  color: var(--e-global-color-text, #333333);
}
 
/* ---- headings --------------------------------------------------------------
   h2 was already token-driven for family / weight / colour. */
 
.post-ao h2 {
  font-family: var(--e-global-typography-primary-font-family, "Poppins"), sans-serif;
  font-weight: var(--e-global-typography-primary-font-weight, 600);
  color: var(--e-global-color-primary, #116914);
  font-size: 2rem;                     /* 32px */
  line-height: 1.3em;
}
 
/* FIX 1 — h3 had Poppins hardcoded, so a global font change would leave it
   behind while h2 followed. */
/* FIX 2 — h3 had no responsive sizing at all. At 28px flat it overtook h2
   (27px) below 767px, inverting the hierarchy. Steps added below. */
.post-ao h3 {
  font-family: var(--e-global-typography-primary-font-family, "Poppins"), sans-serif;
  font-size: 1.75rem;                  /* 28px */
  font-weight: 500;
  line-height: 1.3em;
  color: inherit;                      /* resolves to #333333 */
  margin-top: 8px;
  margin-bottom: 16px;
}
 
@media (max-width: 1024px) {
  .post-ao h3 { font-size: 1.5rem; }   /* 24px, under h2's 29px */
}
 
@media (max-width: 767px) {
  .post-ao h3 { font-size: 1.375rem; } /* 22px, under h2's 27px */
}
 
/* Content ships as <h3><strong>…</strong></h3> in places. */
.post-ao :is(h1,h2,h3,h4,h5,h6) :is(strong,b) {
  font-weight: inherit;
}
 
/* ---- lists -----------------------------------------------------------------
   FIX 3 — an inline <style> block sets `ul { color: black }`, so list items
   render #000 while paragraphs render #333. Visible inconsistency. The class
   scope (0,1,1) outranks that bare `ul` (0,0,1). */
 
.post-ao :is(ul, ol) {
  color: inherit;
  margin-left: 25px;
  padding-left: 5px;
}
 
.post-ao li {
  margin-bottom: 0.4em;
}
 
/* ---- inline ----------------------------------------------------------------
   Content uses <b> rather than <strong>. Both styled; prefer <strong> going
   forward since it carries semantic emphasis for screen readers. */
 
.post-ao p {
  margin-bottom: 14.4px;
}
 
.post-ao :is(strong, b) {
  font-weight: 700;                    /* was UA `bolder`, face-dependent */
}
 
/* ---- links -----------------------------------------------------------------
   FIX 4 — audit found no :hover rule anywhere. The only state was :active at
   #333366, a browser-default purple that clashes with the brand red.
   FIX 5 — no :focus-visible either, so keyboard users had no visible position
   across ~30 links per post. */
 
.post-ao a {
  color: var(--e-global-color-9fdff24, #e31d36);
  text-decoration: none;
  transition: color .15s ease;
}
 
.post-ao a:hover {
  text-decoration: underline;
  text-underline-offset: 0.15em;
}
 
.post-ao a:active {
  color: var(--e-global-color-9fdff24, #e31d36);
}
 
.post-ao a:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 2px;
  border-radius: 2px;
}
 
/* ---- images ----------------------------------------------------------------
   Already correct — max-width 100% + height auto, and the markup carries
   width/height attributes (aspect-ratio computed as 960/540), so CLS is fine. */
 
.post-ao img {
  display: inline-block;
  max-width: 100%;
  height: auto;
}
 
/* ---- tables ---------------------------------------------------------------- */
 
.post-ao table {
  border-collapse: collapse;
  width: 100%;
  font-size: 0.9em;                    /* 16.2px against the 18px body */
  margin: 0 0 15px;
  background-color: transparent;
}
 
.post-ao td {
  padding: 15px;
  border: 1px solid rgba(128, 128, 128, 0.5);
  line-height: 1.5;
  vertical-align: top;
}
 
/* Existing zebra striping, preserved */
.post-ao table tbody > tr:nth-child(odd) > td {
  background-color: rgba(128, 128, 128, 0.07);
}
 
.post-ao table tbody tr:hover > td {
  background-color: rgba(128, 128, 128, 0.1);
}
 
/* Tables bold the first row instead of using <th>. Screen readers announce
   column context from <th> and get nothing from a bolded <td>. This styles
   real header cells for when you switch. */
.post-ao th {
  padding: 15px;
  border: 1px solid rgba(128, 128, 128, 0.5);
  background-color: rgba(128, 128, 128, 0.14);
  font-weight: 700;
  text-align: left;
  line-height: 1.5;
  vertical-align: top;
}
	
.post-ao iframe[src*="youtube.com"],
.post-ao iframe[src*="youtu.be"]{
 width: 100%;
 max-width: 100%;
 aspect-ratio: 16 / 9;
 height: auto;
}
 
@media (max-width: 600px) {
  .post-ao table { display: block; overflow-x: auto; }
}	
</style>

<style type="text/css">/* ============================================================================
 * FAQ Accordion styles — pair with faq-accordion.js
 * ----------------------------------------------------------------------------
 * Values taken from the live audit. Loads AFTER post-styles-merged.css.
 * ========================================================================== */

.post-ao .faq {
  /* Matches the table cell border already used across the site. If full-width
     dividers read heavy at 8 rows, drop the alpha to 0.3 — nothing else
     depends on this value. */
  --faq-rule:    rgba(128, 128, 128, 0.5);

  /* Link red. Signals "this row is interactive" using the colour the site
     already reserves for interaction, rather than inventing a new one. */
  --faq-accent:  var(--e-global-color-9fdff24, #e31d36);

  /* Same tint as the table zebra stripe. */
  --faq-open-bg: rgba(128, 128, 128, 0.07);

  --faq-speed:   200ms;

  border-block-start: 1px solid var(--faq-rule);
  margin-block: 3rem;
}

.post-ao .faq__item {
  border-block-end: 1px solid var(--faq-rule);
  scroll-margin-top: 6rem;          /* clears the sticky header on deep links */
  padding: 0 1rem;
}

.post-ao .faq__item:has([aria-expanded="true"]) {
  background: var(--faq-open-bg);
}

/* ---- question row ----------------------------------------------------------
   .faq__q carries a real heading tag for the document outline, so without this
   it inherits the post h3/h4 rule — 28px with 8px/16px margins, which would
   blow the row height apart. (0,2,0) beats that rule's (0,1,1).

   font-family and colour are deliberately left to inherit: Poppins and #333
   arrive from the heading rule and are correct. */

.post-ao .faq__q {
  margin: 0;
  font-size: 1.125rem;              /* 18px, matching body */
  line-height: 1.4;
}

.post-ao .faq__trigger {
  all: unset;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  width: 100%;
  min-height: 44px;                 /* touch target floor */
  padding: 1.15rem 0;
  cursor: pointer;
  font-weight: 600;
  line-height: 1.4;
  transition: color var(--faq-speed) ease;
}

.post-ao .faq__trigger:hover {
  color: var(--faq-accent);
}

/* Matches the link focus ring in post-styles-merged.css. */
.post-ao .faq__trigger:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 4px;
  border-radius: 2px;
}

/* ---- indicator -------------------------------------------------------------
   The SVG strokes with currentColor, so it tracks the hover colour for free. */

.post-ao .faq__icon {
  flex: none;
  transition: transform var(--faq-speed) ease;
}

.post-ao .faq__trigger[aria-expanded="true"] .faq__icon {
  transform: rotate(180deg);
}

/* ---- panel -----------------------------------------------------------------
   0fr -> 1fr animates to natural content height. No JS measurement, and no
   max-height guess that silently clips a long answer. */

.post-ao .faq__panel {
  display: grid;
  grid-template-rows: 0fr;
  transition: grid-template-rows var(--faq-speed) ease-out;
}

.post-ao .faq__panel[data-open="true"] {
  grid-template-rows: 1fr;
}

.post-ao .faq__panel-inner {
  overflow: hidden;                 /* required for the grid technique */
  min-height: 0;
}

/* hidden="until-found" must stay laid out, so display:none is not an option */
.post-ao .faq__panel[hidden="until-found"] {
  display: grid;
}

/* ---- answer content --------------------------------------------------------
   Inter 18px / 1.8 and #333 inherit from .post-ao. Only spacing needs setting. */

.post-ao .faq__panel-inner > :first-child { margin-block-start: 0; }
.post-ao .faq__panel-inner > :last-child  { margin-block-end: 1.15rem; }

.post-ao .faq__panel :is(ul, ol) {
  margin-block-end: 1.15rem;
}

/* Links inside answers keep the standard treatment from post-styles-merged.css,
   including hover underline and focus ring. Nothing needed here. */

/* ---- accessibility floors -------------------------------------------------- */

@media (prefers-reduced-motion: reduce) {
  .post-ao .faq__panel,
  .post-ao .faq__icon,
  .post-ao .faq__trigger {
    transition: none;
  }
}

/* The site already prints with `* { color: #000 }` and transparent backgrounds,
   so only the collapse state needs undoing. */
@media print {
  .post-ao .faq__panel { grid-template-rows: 1fr !important; }
  .post-ao .faq__icon  { display: none; }
  .post-ao .faq__item  { break-inside: avoid; }
}

/* ---- no-JS fallback --------------------------------------------------------
   The script only emits .faq markup after it has successfully parsed a FAQ, so
   if JS is blocked or parsing fails the questions and answers stay as plain
   readable text. Nothing is hidden that cannot be un-hidden. */</style>

<script type="text/javascript" defer src="data:text/javascript,%2F%2A%20%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%0D%0A%20%2A%20FAQ%20Accordion%20%E2%80%94%20progressive%20enhancement%20for%20Elementor%20post%20content%0D%0A%20%2A%20----------------------------------------------------------------------------%0D%0A%20%2A%20Finds%20an%20existing%20FAQ%20in%20the%20post%20body%20and%20converts%20it%20into%20a%20keyboard-%0D%0A%20%2A%20accessible%20accordion.%20You%20do%20not%20change%20how%20posts%20are%20written%2C%20and%20already-%0D%0A%20%2A%20published%20posts%20convert%20too.%0D%0A%20%2A%0D%0A%20%2A%20Recognises%20several%20markup%20shapes%2C%20not%20just%20bold-question%20%2B%20paragraph%3A%0D%0A%20%2A%20%20%20-%20definition%20lists%20%20%20%20%20%20%3Cdl%3E%3Cdt%3EQ%3C%2Fdt%3E%3Cdd%3EA%3C%2Fdd%3E%3C%2Fdl%3E%0D%0A%20%2A%20%20%20-%20sub-headings%20%20%20%20%20%20%20%20%20%20%3Ch4%3EQ%3C%2Fh4%3E%3Cp%3EA%3C%2Fp%3E%0D%0A%20%2A%20%20%20-%20peer%20headings%20%20%20%20%20%20%20%20%20%3Ch3%3EQ%3F%3C%2Fh3%3E%3Cp%3EA%3C%2Fp%3E%20%20%28same%20level%20as%20the%20FAQ%20heading%29%0D%0A%20%2A%20%20%20-%20fully%20bold%20paragraph%20%20%3Cp%3E%3Cstrong%3EQ%3C%2Fstrong%3E%3C%2Fp%3E%3Cp%3EA%3C%2Fp%3E%0D%0A%20%2A%20%20%20-%20labelled%20paragraph%20%20%20%20%3Cp%3E%3Cstrong%3EQ%3A%3C%2Fstrong%3E%20%E2%80%A6%3F%3C%2Fp%3E%3Cp%3EA%3C%2Fp%3E%0D%0A%20%2A%20%20%20-%20plain%20question%20%20%20%20%20%20%20%20%3Cp%3EQ%3F%3C%2Fp%3E%3Cp%3EA%3C%2Fp%3E%0D%0A%20%2A%20%20%20-%20list%20items%20%20%20%20%20%20%20%20%20%20%20%20%3Cul%3E%3Cli%3E%3Cstrong%3EQ%3C%2Fstrong%3E%3Cp%3EA%3C%2Fp%3E%3C%2Fli%3E%3C%2Ful%3E%0D%0A%20%2A%0D%0A%20%2A%20Each%20detector%20runs%20independently%20and%20the%20best-scoring%20result%20wins%2C%20so%20mixed%0D%0A%20%2A%20or%20unusual%20posts%20degrade%20to%20the%20shape%20that%20actually%20fits%20rather%20than%20failing.%0D%0A%20%2A%0D%0A%20%2A%20Questions%20render%20as%20role%3D%22heading%22%20by%20default%20so%20plugin%20Table%20of%20Contents%0D%0A%20%2A%20widgets%20%28which%20scan%20for%20h1%E2%80%93h6%20tags%29%20do%20not%20absorb%20them.%20Screen-reader%20heading%0D%0A%20%2A%20navigation%20still%20works.%20Set%20headingMode%3A%27native%27%20to%20opt%20back%20into%20real%20tags.%0D%0A%20%2A%0D%0A%20%2A%20Pair%20with%20faq-accordion.css.%0D%0A%20%2A%20%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%3D%20%2A%2F%0D%0A%0D%0A%28function%20%28%29%20%7B%0D%0A%20%20%27use%20strict%27%3B%0D%0A%0D%0A%20%20const%20DEFAULTS%20%3D%20%7B%0D%0A%20%20%20%20root%3A%20%27.post-ao%27%2C%0D%0A%20%20%20%20container%3A%20%27.faq-block%27%2C%0D%0A%20%20%20%20%2F%2F%20Unanchored%2C%20so%20FAQ%20need%20not%20be%20the%20first%20word%20%28%22White%20Card%20FAQs%22%29.%0D%0A%20%20%20%20%2F%2F%20Covers%20FAQ%20%2F%20FAQs%20%2F%20FAQ%27s%20%2F%20F.A.Q.%2C%20%22frequently%20asked%22%2C%20%22commonly%20asked%22%2C%0D%0A%20%20%20%20%2F%2F%20%22common%20questions%22%2C%20%22questions%20and%20answers%22%2C%20%22Q%26A%22%2C%20%22people%20also%20ask%22%2C%0D%0A%20%20%20%20%2F%2F%20and%20%22your%20questions%20answered%22.%0D%0A%20%20%20%20headingPattern%3A%20%2F%28%3F%3A%5Cbfaqs%3F%5Cb%7C%5Cbf%5C.a%5C.q%5C.%3F%7C%5Cbfrequently%5Cs%2Basked%5Cb%7C%5Cbcommonly%5Cs%2Basked%5Cb%7C%5Cbcommon%5Cs%2Bquestions%3F%5Cb%7C%5Cbquestions%3F%5Cs%2A%28%3F%3A%26%7Cand%29%5Cs%2Aanswers%3F%5Cb%7C%5Cbq%5Cs%2A%26%5Cs%2Aa%5Cb%7C%5Cbpeople%5Cs%2Balso%5Cs%2Bask%5Cb%7C%5Cbquestions%5Cs%2Banswered%5Cb%29%2Fi%2C%0D%0A%0D%0A%20%20%20%20%2F%2F%20If%20no%20heading%20matches%20the%20pattern%2C%20scan%20every%20heading%20and%20accept%20the%20best%0D%0A%20%20%20%20%2F%2F%20block%20only%20if%20it%20yields%20at%20least%20this%20many%20Q%26A%20pairs.%200%20disables.%0D%0A%20%20%20%20fallbackMinGroups%3A%203%2C%0D%0A%20%20%20%20%2F%2F%20Extra%20CSS%20boundary%2C%20on%20top%20of%20the%20built-in%20checks%20below.%0D%0A%20%20%20%20stopAt%3A%20%27hr%2C%20.faq-end%27%2C%0D%0A%20%20%20%20headingMode%3A%20%27aria%27%2C%20%20%20%20%20%2F%2F%20%27aria%27%20%3D%20TOC-invisible%20%7C%20%27native%27%20%3D%20real%20%3ChN%3E%0D%0A%20%20%20%20allowMultiple%3A%20true%2C%0D%0A%20%20%20%20openFirst%3A%20true%2C%0D%0A%20%20%20%20findInPage%3A%20true%2C%0D%0A%20%20%20%20idPrefix%3A%20%27faq%27%0D%0A%20%20%7D%3B%0D%0A%0D%0A%20%20const%20BLOCKS%20%3D%20%27h1%2Ch2%2Ch3%2Ch4%2Ch5%2Ch6%2Cp%2Cul%2Col%2Cdl%2Ctable%2Cfigure%2Cblockquote%2Cpre%27%3B%0D%0A%20%20const%20ANSWER_TAGS%20%3D%20%2F%5E%28P%7CUL%7COL%7CTABLE%7CFIGURE%7CBLOCKQUOTE%7CPRE%7CDIV%7CH%5B1-6%5D%29%24%2F%3B%0D%0A%0D%0A%20%20%2F%2F%20Third-party%20accordions.%20Content%20inside%20these%20is%20skipped%20rather%20than%20used%20as%0D%0A%20%20%2F%2F%20a%20reason%20to%20abort%20%E2%80%94%20an%20unrelated%20toggle%20elsewhere%20in%20the%20post%20is%20harmless.%0D%0A%20%20const%20EXISTING%20%3D%20%27.elementor-accordion%2C%20.elementor-toggle%2C%20details%27%3B%0D%0A%0D%0A%20%20%2F%2A%20--%20helpers%20--------------------------------------------------------------%20%2A%2F%0D%0A%0D%0A%20%20const%20isHeading%20%3D%20el%20%3D%3E%20%2F%5EH%5B1-6%5D%24%2F.test%28el.tagName%29%3B%0D%0A%20%20const%20level%20%3D%20el%20%3D%3E%20%28isHeading%28el%29%20%3F%20%2Bel.tagName%5B1%5D%20%3A%2099%29%3B%0D%0A%20%20const%20text%20%3D%20el%20%3D%3E%20%28el.textContent%20%7C%7C%20%27%27%29.trim%28%29%3B%0D%0A%20%20const%20endsWithQuestion%20%3D%20el%20%3D%3E%20%2F%5C%3F%5Cs%2A%24%2F.test%28text%28el%29%29%3B%0D%0A%0D%0A%20%20const%20slug%20%3D%20s%20%3D%3E%20s.toLowerCase%28%29.replace%28%2F%5B%5E%5Cw%5Cs-%5D%2Fg%2C%20%27%27%29.trim%28%29%0D%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20.replace%28%2F%5Cs%2B%2Fg%2C%20%27-%27%29.slice%280%2C%2060%29%3B%0D%0A%0D%0A%20%20%2F%2A%2A%0D%0A%