<script>

let onsiteIndex = 0;

const onsiteTrack =
document.getElementById('onsiteTrack');

const onsiteReviews =
document.querySelectorAll('.onsite-review');

function onsiteUpdate(){
onsiteTrack.style.transform =
`translateX(-${onsiteIndex * 100}%)`;
}

function onsiteNext(){
onsiteIndex =
(onsiteIndex + 1) %
onsiteReviews.length;
onsiteUpdate();
}

function onsitePrev(){
onsiteIndex =
(onsiteIndex - 1 + onsiteReviews.length)
% onsiteReviews.length;
onsiteUpdate();
}

setInterval(onsiteNext,7000);

</script>

