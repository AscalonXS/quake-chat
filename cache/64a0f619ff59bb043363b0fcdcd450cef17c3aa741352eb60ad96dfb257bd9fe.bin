<style>

.onsite-review-wrapper{
max-width:1200px;
margin:60px auto;
padding:20px;
}

.onsite-review-heading{
text-align:center;
margin-bottom:40px;
}

.onsite-review-heading h2{
font-size:38px;
font-weight:700;
color:#009639;
margin-bottom:10px;
}

.onsite-review-heading p{
font-size:18px;
color:#000;
margin-bottom:15px;
}

.review-links{
font-size:16px;
font-weight:600;
line-height:1.8;
}

.review-links a{
color:#B90404;
text-decoration:none;
}

.review-links a:hover{
text-decoration:underline;
}

.onsite-carousel{text-align:center;
overflow:hidden;
position:relative;
}

.onsite-track{
display:flex;
transition:all .6s ease;
}

.onsite-review{
min-width:100%;
box-sizing:border-box;
background:#fff;
padding:40px;
border-radius:15px;
box-shadow:0 10px 30px rgba(0,0,0,.08);
}

.onsite-stars{
font-size:28px;
color:#ffc107;
margin-bottom:20px;
}

.onsite-text{
font-size:22px;
line-height:1.8;
color:#333;
margin-bottom:30px;
font-style:italic;
}

.onsite-author{
font-size:18px;
font-weight:700;
color:#B90404;
}

.onsite-source{
font-size:14px;
color:#777;
margin-top:5px;
}

.onsite-nav{
text-align:center;
margin-top:25px;
}

.onsite-nav button{
background:#B90404;
border:none;
color:white;
padding:12px 20px;
margin:0 5px;
border-radius:5px;
cursor:pointer;
font-weight:600;
}

.onsite-nav button:hover{
background:#8f0303;
}

@media(max-width:768px){

.onsite-review{
padding:25px;
}

.onsite-text{
font-size:18px;
}

.onsite-review-heading h2{
font-size:28px;
}

.review-links{
font-size:14px;
}

}

</style>

