		<li id="menu-item-23267" class="menu-item menu-item-type-post_type menu-item-object-page menu-item-23267"><a href="https://firstaidsafetytraining.com/first-aid-training-north-east/first-aid-training-south-tyneside/first-aid-training-south-shields/" class="menu-link"><span class="ast-icon icon-arrow"></span><span class="menu-text">South Shields</span></a></li>		<li id="menu-item-23281" class="menu-item menu-item-type-post_type menu-item-object-page menu-item-23281"><a href="https://firstaidsafetytraining.com/first-aid-training-north-east/first-aid-training-south-tyneside/first-aid-training-jarrow/" class="menu-link"><span class="ast-icon icon-arrow"></span><span class="menu-text">Jarrow</span></a></li>		<li id="menu-item-23280" class="menu-item menu-item-type-post_type menu-item-object-page menu-item-23280"><a href="https://firstaidsafetytraining.com/first-aid-training-north-east/first-aid-training-south-tyneside/first-aid-training-hebburn/" class="menu-link"><span class="ast-icon icon-arrow"></span><span class="menu-text">Hebburn</span></a></li>		<li id="menu-item-23279" class="menu-item menu-item-type-post_type menu-item-object-page menu-item-23279"><a href="https://firstaidsafetytraining.com/first-aid-training-north-east/first-aid-training-south-tyneside/first-aid-training-boldon/" class="menu-link"><span class="ast-icon icon-arrow"></span><span class="menu-text">Boldon</span></a></li>		<li id="menu-item-23282" class="menu-item menu-item-type-post_type menu-item-object-page menu-item-23282"><a href="https://firstaidsafetytraining.com/first-aid-training-north-east/first-aid-training-south-tyneside/first-aid-training-whitburn-and-cleadon/" class="menu-link"><span class="ast-icon icon-arrow"></span><span class="menu-text">Whitburn and Cleadon</span></a></li>	</ul>
