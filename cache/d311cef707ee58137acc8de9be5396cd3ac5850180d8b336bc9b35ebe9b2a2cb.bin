px}textarea{height:120px;border:0}footer{padding:30px 10px}footer a:visited{color:silver}ul.bullets li:before,footer li:before{content:""}ul.bullets li:before{margin:0}ul.bullets li{padding:6px 0}.info{float:left;width:40px;height:40px;margin-right:8px}.warning{margin:10px 0;border:solid 1px #C9A0A0}.menu{color:#E5D07F}.spp{line-height:1.8;padding:6px 0 10px}.space{margin:15px 0 30px}.space2{margin-top:30px}.pspace{padding-top:12px}blockquote{margin:0}dd,.pv,blockquote p{margin:15px 0 15px 15px;padding:0 0 0 7px;border-left:2px solid #8B0201}.fimgl,.fimgr{max-width:40%;height:auto}.fimgl{float:left;margin:0 .7em .7em 0}.fimgr{float:right;margin:0 0 .7em .7em}.mainnews{display:grid;grid-template-columns:1fr;gap:0 1rem}.permalink{display:block;font-family:inherit;font-size:.9em;overflow-wrap:anywhere;user-select:all;-webkit-user-select:all}@media(min-width:768px){.spadsspc{min-height:90px}html{background:#F6F9FC}header,main,.sim,.refcite,.spads{padding:0 20px}.mainnews{grid-template-columns:1fr 1fr}main li,.stopics li{padding:4px 0 4px 15px}.brnv{padding:0 10px}.group-items{padding-left:15px}}@media(min-width:951px){body{border-inline:1px solid #e3e3e3}header,footer{width:auto;margin-inline:-1px}}</style><meta name="robots" content="max-snippet:-1, max-image-preview:large, max-video-preview:-1"><link rel="icon" type="image/svg+xml" href="https://www.disabled-world.com/favicon.svg" sizes="any"><link rel="icon" href="https://www.disabled-world.com/favicon.ico" sizes="48x48"><link rel="icon" type="image/png" href="https://www.disabled-world.com/favicon-96x96.png" sizes="96x96"><link rel="icon" type="image/png" sizes="192x192" href="https://www.disabled-world.com/maskable-icon.png"><link rel="icon" type="image/png" sizes="512x512" href="https://www.disabled-world.com/android-chrome-512x512.png"><link rel="apple-touch-icon" sizes="180x180" href="https://www.disabled-world.com/apple-touch-icon.png"><meta name="apple-mobile-web-app-title" content="Disabled World"><link rel="manifest" href="https://www.disabled-world.com/site.webmanifest"><meta name="theme-color" content="#ffffff"><link rel="alternate" type="application/rss+xml" title="First Aid Basics: Emergency Care Before Help Arrives" href="https://www.disabled-world.com/medical/first-aid/rss.xml"><meta name="application-name" content="Disabled World"><meta property="og:locale" content="en_US"><meta name="author" content="Disabled World"><meta property="og:title" content="First Aid Basics: Emergency Care Before Help Arrives"><meta property="og:image" content="https://www.disabled-world.com/pics/imgdesign/disabledworldcover.webp"><meta property="og:site_name" content="Disabled World"><meta property="article:published_time" content="2004-05-01T00:00:00Z"><meta property="article:modified_time" content="2026-11-02T21:51:41Z"><meta property="og:url" content="https://www.disabled-world.com/medical/first-aid/"><meta property="og:type" content="article"><meta property="og:description" content="Learn what first aid is, its three key aims to preserve life, promote recovery, and prevent harm, plus why CPR and a first aid kit matter in an emergency."><meta name="twitter:card" content="summary_large_image"><meta name="twitter:site" content="@DisabledWorld"><script type="application/ld+json">{"@context":"https://schema.org","@type":"CollectionPage","mainEntityOfPage":{"@type":"WebPage","@id":"https://www.disabled-world.com/disability/blogs/"},"name":"Disability Blogs: Stories and Writings Regarding Disabilities","headline":"Disability Blogs: Stories and Writings Regarding Disabilities","description":"Explore personal disability stories, reflections on identity, and the debate over motivation versus inspiration from voices across the worldwide community","inLanguage":"en-US","image":{"@type":"ImageObject","url":"https://www.disabled-world.com/pics/imgdesign/disabledworldcover.webp","height":"570","width":"1000"},"isPartOf":{"@type":"WebSite","name":"Disabled World","url":"https://www.disabled-world.com/"},"datePublished":"2004-05-01T00:00:00Z","dateModified":"2026-11-02","author":{"@type":"Organization","name":"Disabled World","url":"https://www.disabled-world.com/"},"editor":{"@type":"Person","name":"Ian C. Langtree","jobTitle":"Founder and Editor-in-Chief","url":"https://www.disabled-world.com/info/langtree.php"},"publisher":{"@type":"Organization","name":"Disabled World","url":"https://www.disabled-world.com/","logo":{"@type":"ImageObject","url":"https://www.disabled-world.com/pics/imgdesign/logo-sq.webp","width":"570","height":"570"}}}</script></head><body><div id="skip"><a href="#content" aria-label="Skip to main content">Skip to Main Content</a> <a class="skip-link" href="#footer" aria-label="Skip to footer">Skip to footer</a></div><header><span class="ptop"><a href="https://www.disabled-world.com/" title="Disabled World"><svg role="img" aria-label="Logo of Disabled World" class="logo"><g transform="translate(4,4)" stroke="#E5D07F" fill="none" stroke-width="1"><circle cx="12" cy="12" r="11" /><ellipse cx="12" cy="12" rx="5" ry="11" /><ellipse cx="12" cy="12" rx="11" ry="5" /></g><text x="33" y="24" font-size="21" fill="#FFFFFF">Disabled</text><text x="111" y="24" font-size="21" fill="#E5D07F">World</text></svg></a><span class="tnav"><a href="https://www.disabled-world.com/info/menu.php"><span class="menu">&#9776;</span>Menu</a></span></span><div id="ddg"><form target="_blank" action="https://duckduckgo.com/" method="get" rel="nofollow"><input placeholder="Search Disabled World" name="q" type="search" aria-label="Search Disabled World"><button type="submit">Search</button><input value="www.disabled-world.com" name="sites" type="hidden"><input type="hidden" name="ko" value="-2"><input type="hidden" name="k1" value="-1"><input type="hidden" name="kz" value="-1"><input type="hidden" name="km" value="m"></form></div></header><nav class="brnv"><ul itemscope itemtype="https://schema.org/BreadcrumbList"><li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem"><a itemprop="item" title="Go to Home page" href="https://www.disabled-world.com/"><span itemprop="name"><strong>Home</strong></span></a><meta itemprop="position" content="1"></li><li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem"><a itemprop="item" href="https://www.disabled-world.com/medical/"><span itemprop="name">Medical</span></a><meta itemprop="position" content="2"></li><li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" aria-current="page"><em><span itemprop="name">First Aid</span></em><meta itemprop="position" content="3"></li></ul><span class="brnv-news"><span aria-hidden="true">&#128240;</span> <a href="https://www.disabled-world.com/news/">What's New</a></span></nav><main><h1 id="content">First Aid Basics: Emergency Care Before Help Arrives</h1><p><span class="ltred">Author:</span> Disabled World (DW)<br><span class="ltred">Updated/Revised Date:</span> 2 Nov 2026<p class="spp"><span class="ltred">Table of Contents:</span><br><a href=#synopsis>Synopsis</a> - <a href="#definition">Definition</a> - <a href="#overview">About This Section</a> - <a href="#faq">FAQs</a> - <a href="#publications">Publications</a> - <a href="#subtopics">Subtopics</a><h2 id="synopsis">Synopsis</h2><p>Learn what first aid is, its three key aims to preserve life, promote recovery, and prevent harm, plus why CPR and a first aid kit matter in an emergency.</p><h2 id="glance">At a Glance</h2><ul class="bullets"><li><span class="red">1 -</span> The use of CPR dates back to 1740.</li><li><span class="red">2 -</span> About 73 percent of cardiac arrests outside the hospital happen at home.</li><li><span class="red">3 -</span> Immediate bystander CPR can double or triple a person's chance of survival.</li><li><span class="red">4 -</span> St. John Ambulance estimates up to 150,000 people a year could be helped if more people knew first aid.</li></ul><div class="spads spadsspc"><!-- CAT-Top-Display --><ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-1372083601437131" data-ad-slot="5813304659" data-ad-format="auto" data-full-width-responsive="true"></ins><script>(adsbygoogle = window.adsbygoogle || []).push({});</script></div><h2 id="definition">Topic Definition</h2><dl aria-labelledby="definition-heading"><dt><dfn>First Aid</dfn></dt><dd><p>First aid is the initial care given to a person who is suddenly ill or injured, provided to preserve life, keep the condition from getting worse, and support recovery until professional medical help can take over. It is usually carried out by an ordinary person rather than a trained clinician, and it ranges from simple actions like placing an adhesive bandage on a cut to life-saving measures such as performing CPR while waiting for an ambulance. Much of it rests on common sense and basic techniques that need little equipment, yet effective care, especially for serious situations, calls for proper instruction and hands-on training. At its heart, first aid rests on three aims that guide every response: preserving life, promoting recovery, and preventing further harm.</p></dd></dl><h2 id="overview">Overview</h2><p><span class="red">Important Disclaimer:</span> This information is not intended as a substitute for professional medical advice, emergency treatment or formal first-aid training. Do NOT use this information to diagnose or develop a treatment plan for a health problem or disease without consulting a qualified health care provider. If you're in a life-threatening or emergency medical situation, seek medical assistance immediately.</p>
<p>First aid is the provision of initial care for an illness or injury. But knowing the correct thing to do if someone has a nosebleed or cut is also important. First aid is defined as the assistance given to any person suffering a sudden illness or injury, with care provided to preserve life, prevent the condition from worsening, or promote recovery. It is usually performed by a lay person to a sick or injured casualty until definitive medical treatment can be accessed. It includes initial intervention in a serious condition before professional medical help is available, such as performing CPR while awaiting an ambulance, as well as the complete treatment of minor conditions, such as applying an adhesive bandage to a cut. First aid - the care given before emergency medical help arrives - can literally mean the difference between life and death.</p>
<p>The use of CPR dates all the way back to 1740, yet even today, most people still don't know how to perform it. Given properly, and immediately, to sudden cardiac arrest victims, CPR can save lives. Up to 150,000 people a year could be given a chance to live if more people knew first aid, says charity St. John Ambulance.</p>
<ul><li>Only about 9 percent of adults treated by emergency medical services for a cardiac arrest outside the hospital survive to leave the hospital (2021 U.S. data).</li><li>More than 350,000 cardiac arrests occur outside the hospital in the United States each year, and about 73 percent of them happen in homes, according to the <a href="https://cpr.heart.org/en/resources/cpr-facts-and-stats" target="_blank" rel="noopener">American Heart Association</a>.</li><li>Statistically speaking, if called on to administer CPR in an emergency, the life you save is likely to be someone at home: a child, a spouse, a parent, or a friend.</li><li>Effective bystander CPR provided immediately after sudden cardiac arrest can double or triple a victim's chance of survival, but only about 40 percent of people who have a cardiac arrest outside the hospital receive CPR from a bystander.</li></ul><div class="spads"><!-- CAT-SumCont-Display --><ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-1372083601437131" data-ad-slot="8451980242" data-ad-format="auto" data-full-width-responsive="true"></ins><script>(adsbygoogle = window.adsbygoogle || []).push({});</script></div><h3 id="accidents">Accidents</h3>
<ul><li>The primary response to an accident is the most important!</li><li>Often, first aid given at the scene can improve the victim's chances of survival and a good recovery.</li><li>The right response is better than an incorrect, quick one.</li><li>Any response, even if it is wrong, is better than none.</li></ul>
<p>Certain self-limiting illnesses or minor injuries may not require further medical care past the first aid intervention. It generally consists of a series of simple and, in some cases, potentially life-saving techniques that an individual can be trained to perform with minimal equipment. The key aims of first aid can be summarized in three key points:</p>
<ul><li>Preserve life - The overriding aim of all medical care, including first aid, is to save lives</li><li>Promote recovery - First aid also involves trying to start the recovery process from the illness or injury, and in some cases might involve completing a treatment, such as in the case of applying an adhesive bandage to a small wound.</li><li>Prevent further harm - Also sometimes called prevent the condition from worsening, this covers both external factors, such as moving a patient away from any cause of harm, and applying first aid techniques to prevent worsening of the condition, such as applying pressure to stop a bleed becoming dangerous.</li></ul>
<h3 id="first-aid-common-sense">Much of First Aid is Common Sense</h3>
<p>Basic principles, such as knowing to use an adhesive bandage or applying direct pressure to a bleed, are often acquired passively through life experiences. However, to provide effective, life-saving first aid interventions requires instruction and practical training. This is especially true where it relates to potentially fatal illnesses and injuries, such as those that require cardiopulmonary resuscitation (CPR); these procedures may be invasive, and carry a risk of further injury to the patient and the provider.</p>
<h3 id="learn-first-aid-save-lives">Learn First Aid and Save Lives</h3>
<p>First aid doesn't take long to learn, but can help to save lives.</p>
<p>First aid training is often available through community organizations such as the Red Cross and St. John Ambulance, or through commercial providers, who will train people for a fee.</p>
<p>St. John Ambulance believes that everyone should learn at least the basic first aid techniques. You may need to use them at any time at home, at school or work, or even while you're traveling. Knowing what to do can make the difference to a person's recovery, and you could even save their life.</p>
<h3 id="first-aid-kits">First Aid Kits</h3>
<p>It is important to have a first aid kit available.</p>
<p>Keep one at home and one in your car. It should include a first-aid guide. Read the guide to learn how to use the items, so you are ready in case an emergency happens. It is also advised to be prepared for illness while traveling locally or to a foreign country.</p><div class="spads"><!-- CAT-Above-Faq-Display --><ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-1372083601437131" data-ad-slot="3225461884" data-ad-format="auto" data-full-width-responsive="true"></ins><script>(adsbygoogle = window.adsbygoogle || []).push({});</script></div><h2 id="faq">Frequently Asked Questions</h2><h3 id="items-basic-first-aid-kit">What items should a basic first aid kit contain?</h3><p>A basic kit should hold adhesive bandages, sterile gauze, medical tape, antiseptic wipes, scissors, gloves, a first aid guide, and any personal medicines you may need.</p><h3 id="first-aid-kit-checked">How often should a first aid kit be checked?</h3><p>Check your kit every few months to replace used, expired, or damaged items and to make sure everything is present and ready before an emergency happens.</p><h3 id="recovery-position">What does the recovery position do?</h3><p>The recovery position places an unconscious but breathing person on their side to keep the airway open and reduce the risk of choking on fluids.</p><h3 id="long-first-aid-course-usually">How long does a first aid course usually take?</h3><p>Many basic first aid and CPR courses run from a few hours to a full day, though more advanced or workplace certifications can take longer to complete.</p><h3 id="legal-trouble-giving-first-aid">Can you get in legal trouble for giving first aid?</h3><p>Many regions have Good Samaritan laws that protect people who help in good faith during an emergency, though the exact protections vary by location.</p><h3 id="difference-between-first-aid-cpr">What is the difference between first aid and CPR?</h3><p>First aid covers a wide range of care for illness and injury, while CPR is one specific technique used to support circulation and breathing during cardiac arrest.</p><h3 id="move-injured-person-while-giving">Should you move an injured person while giving first aid?</h3><p>Avoid moving an injured person unless they face an immediate danger, since unnecessary movement can worsen injuries, especially to the head, neck, or spine.</p><h3 id="aed-anyone-use-one">What is an AED and can anyone use one?</h3><p>An automated external defibrillator, or AED, is a portable device that checks the heart rhythm and can give an electric shock to restart it during cardiac arrest. AEDs give spoken instructions, so untrained bystanders can use them safely.</p><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What items should a basic first aid kit contain?","acceptedAnswer":{"@type":"Answer","text":"A basic kit should hold adhesive bandages, sterile gauze, medical tape, antiseptic wipes, scissors, gloves, a first aid guide, and any personal medicines you may need."}},{"@type":"Question","name":"How often should a first aid kit be checked?","acceptedAnswer":{"@type":"Answer","text":"Check your kit every few months to replace used, expired, or damaged items and to make sure everything is present and ready before an emergency happens."}},{"@type":"Question","name":"What does the recovery position do?","acceptedAnswer":{"@type":"Answer","text":"The recovery position places an unconscious but breathing person on their side to keep the airway open and reduce the risk of choking on fluids."}},{"@type":"Question","name":"How long does a first aid course usually take?","acceptedAnswer":{"@type":"Answer","text":"Many basic first aid and CPR courses run from a few hours to a full day, though more advanced or workplace certifications can take longer to complete."}},{"@type":"Question","name":"Can you get in legal trouble for giving first aid?","acceptedAnswer":{"@type":"Answer","text":"Many regions have Good Samaritan laws that protect people who help in good faith during an emergency, though the exact protections vary by location."}},{"@type":"Question","name":"What is the difference between first aid and CPR?","acceptedAnswer":{"@type":"Answer","text":"First aid covers a wide range of care for illness and injury, while CPR is one specific technique used to support circulation and breathing during cardiac arrest."}},{"@type":"Question","name":"Should you move an injured person while giving first aid?","acceptedAnswer":{"@type":"Answer","text":"Avoid moving an injured person unless they face an immediate danger, since unnecessary movement can worsen injuries, especially to the head, neck, or spine."}},{"@type":"Question","name":"What is an AED and can anyone use one?","acceptedAnswer":{"@type":"Answer","text":"An automated external defibrillator, or AED, is a portable device that checks the heart rhythm and can give an electric shock to restart it during cardiac arrest. AEDs give spoken instructions, so untrained bystanders can use them safely."}}]}</script><div class="spads"><!-- CAT-Bottom-Inarticle --><ins class="adsbygoogle" style="display:block; text-align:center;" data-ad-layout="in-article" data-ad-format="fluid" data-ad-client="ca-pub-1372083601437131" data-ad-slot="9091296733"></ins><script>(adsbygoogle = window.adsbygoogle || []).push({});</script></div><p class="spp"></p><hr><p class="attrib"><svg class="info"><path fill="#0a497a" d="M7.6 0A7.6 7.6 0 0 0 0 7.4v22.9C0 34.6 3.4 38 7.6 38h22.9c4.2 0 7.6-3.4 7.6-7.6V7.5c0-4.2-3.4-7.6-7.6-7.6Zm0 1h22.9C34.1 1 37 4 37 7.6v22.9c0 3.5-3 6.5-6.5 6.5H7.6a6.5 6.5 0 0 1-6.4-6.5v-23a6.4 6.4 0 0 1 6.4-6.4Zm1.7 2a6.4 6.4 0 0 0-6.4 6.3v19.5c0 3.5 2.9 6.4 6.4 6.4h19.5c3.5 0 6.4-2.9 6.4-6.4v-11a.3.3 0 1 0-.6 0v11a5.8 5.8 0 0 1-5.8 5.7H9.3a5.8 5.8 0 0 1-5.8-5.8V9.2a5.8 5.8 0 0 1 5.8-5.8H29a.3.3 0 1 0 0-.6Zm10 5.6c-.8 0-1.5.2-2 .7-.5.5-.8 1.1-.8 1.8 0 .4 0 .7.2 1a2.8 2.8 0 0 0 1.5 1.4l1 .2a2.7 2.7 0 0 0 2-.8 2.4 2.4 0 0 0 0-3.6 2.8 2.8 0 0 0-2-.7Zm0 .6c.5 0 1 .2 1.5.6a1.8 1.8 0 0 1 0 2.7c-.4.4-1 .6-1.5.6a2.4 2.4 0 0 1-1.6-.6l-.5-.6a1.7 1.7 0 0 1-.1-.8c0-.5.2-1 .6-1.3.4-.4 1-.6 1.6-.6Zm15.6 2a.3.3 0 0 0-.3.3v1.1c0 .2.1.3.3.3a.3.3 0 0 0 .3-.3v-1.1a.3.3 0 0 0-.3-.3Zm0 2.3a.3.3 0 0 0-.3.3V16c0 .2.1.3.3.3a.3.3 0 0 0 .3-.3v-2.3a.3.3 0 0 0-.3-.3Zm-20 1.8a.3.3 0 0 0-.3.3V17c0 .2.2.3.3.3 2.2 0 2.2.7 2.2 1v8c0 .2 0 .9-2.2.9a.3.3 0 0 0-.3.3V29l.3.3h8.8a.3.3 0 0 0 .3-.3v-1.5a.3.3 0 0 0-.3-.3c-1 0-1.6-.2-1.9-.5a.6.6 0 0 1-.2-.4V15.5a.3.3 0 0 0-.3-.3Zm.3.6h5.9v10.5c0 .3 0 .6.3.8.3.4 1 .6 2 .6v1h-8.2v-1c.9 0 2.5-.1 2.5-1.4v-8c0-1-.9-1.5-2.5-1.6Zm0 0"/></svg> Curated and edited by <a href="https://www.disabled-world.com/info/langtree.php" rel="author">Ian C. Langtree</a>, Founder and Editor-in-Chief, Disabled World. This section is maintained by the Disabled World editorial team. Last updated: <time datetime="2026-11-02">2 Nov 2026</time></p></main><div class="sim"><h2 id="publications" class="handpoint">Latest Publications</h2><div class="mainnews"><div><h3><a href="https://www.disabled-world.com/medical/first-aid/battery-honey.php">Child Swallowed Button Battery? Honey May Reduce Injury</a></h3><p>Study finds drinking honey or Carafate, a cherry flavored duodenal ulcer prescription, may help reduce esophageal damage from button batteries swallowed by kids. Published: 12 Jun 2018.</p></div><div><h3><a href="https://www.disabled-world.com/medical/first-aid/stopthebleed.php">Quake Kare's ER Blood Stopper Kit Stops Severe Bleeding from Penetrating Wounds</a></h3><p>March 31 is National Stop the Bleed Day – help save a life. Quake Kare ER Blood Stopper Kit stops severe bleeding from penetrating wounds. Published: 28 Mar 2018.</p></div><div><h3><a href="https://www.disabled-world.com/medical/first-aid/updated.php">Updated First Aid Guidelines</a></h3><p>The American Red Cross and American Heart Association announced changes to guidelines for administering first aid. Published: 16 Oct 2015.</p></div><div><h3><a href="https://www.disabled-world.com/medical/first-aid/burn.php">Burns: Types and First Aid Treatment</a></h3><p>Burns are categorized as first, second, or third degree depending upon how badly the person's skin has been damaged. Each of the common burns people experience may cause any of these three types of burns. Published: 15 Feb 2015.</p></div><div><h3><a href="https://www.disabled-world.com/medical/first-aid/wound-care.php">Wound Care Basics: Bandages and Skin Moisture</a></h3><p>Information regarding proper skin care by dressing and caring for wounds to help prevent infection. Published: 13 Jan 2014.</p></div><div><h3><a href="https://www.disabled-world.com/medical/first-aid/cold-stress.php">Hypothermia: Symptoms, Prevention, Treatment</a></h3><p>Information regarding Hypothermia, a dangerous condition marked by an unusually low internal body temperature. Published: 3 Nov 2013.</p></div></div><p class="morelink"><a href="https://www.disabled-world.com/medical/first-aid-2/">See the full list of publications</a></p></div><div class="spads"><!-- CAT-Multiplex-Bottom --><ins class="adsbygoogle" style="display:block" data-ad-format="autorelaxed" data-ad-client="ca-pub-1372083601437131" data-ad-slot="2211391987"></ins><script>(adsbygoogle = window.adsbygoogle || []).push({});</script></div><h2 class="handpoint" id="subtopics">Subtopics</h2><nav aria-label="Sub category topics menu" itemscope itemtype="https://schema.org/SiteNavigationElement"><div class="group stopics"><div class=col><ul class="group-items"><li><a itemprop="url" href="https://www.disabled-world.com/medical/"><span itemprop="name">Medical</span></a></li></ul></div></div></nav><div class="refcite"><p class="ltred">Share or cite this page:</p><code class="permalink">&lt;a href="https://www.disabled-world.com/medical/first-aid/"&gt;First Aid Basics: Emergency Care Before Help Arrives&lt;/a&gt;: Learn what first aid is, its three key aims to preserve life, promote recovery, and prevent harm, plus why CPR and a first aid kit matter in an emergency.</code><p class="warning"><svg class="info" aria-hidden="true" focusable="false"><g fill="#C9A0A0"><path d="M37.6 32 21 3.4a2.4 2.4 0 0 0-4.2 0L.3 32.1a2.4 2.4 0 0 0 2.1 3.7h33.2a2.4 2.4 0 0 0 2-3.8Zm-2 2.4H2.4a1 1 0 0 1-.9-1.6L18.1 4.1c.2-.3.5-.5.9-.5s.7.2.9.5l16.5 28.7a1 1 0 0 1-.8 1.6Zm0 0"/><path d="m19.8 26 .3-13h-2.8l.4 13Zm-1.1 1.9c-1 0-1.7.7-1.7 1.8 0 1 .7 1.8 1.7 1.8s1.7-.8 1.7-1.8-.7-1.8-1.7-1.8Zm0 0"/></g></svg>While we aim to provide accurate, up-to-date information, our content is for general informational purposes only and is not a substitute for professional advice. Consult a qualified professional about your specific situation.</p></div><footer id="footer"><nav><div class="group"><div class="col"><ul style="-webkit-columns:12rem;columns:12rem" class="group-items"><li><a href="https://www.disabled-world.com/info/about.php">About Us</a></li><li><a href="https://www.disabled-world.com/info/history.php">Our History</a></li><li><a href="https://www.disabled-world.com/info/contact.php">Contact Us</a></li><li><a href="https://www.disabled-world.com/info/terms.php">Terms of Service</a></li><li><a href="https://www.disabled-world.com/info/privacy.php">Privacy Policy</a></li><li><a href="https://www.disabled-world.com/info/accessibility.php">Accessibility</a></li><li><a href="https://www.disabled-world.com/info/editorial-policy.php">Editorial Policy</a></li><li><a href="https://www.disabled-world.com/info/cited-by.php">Who Cites Us</a></li><li><a href="https://www.disabled-world.com/info/advertise.php">Advertising Policy</a></li><li><a href="https://www.disabled-world.com/info/contributors.php">Contributors</a></li><li><a href="https://www.disabled-world.com/info/submit-news.php">Submissions</a></li><li><a href="https://www.disabled-world.com/info/dwsm.php">Connect with Us</a></li><li><a href="https://www.disabled-world.com/info/error-reporting.php">Report an Error</a></li><li><a href="https://www.d