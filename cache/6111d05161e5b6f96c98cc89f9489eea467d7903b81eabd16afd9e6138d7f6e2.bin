8\",{\"className\":\"mb-rem12px pl-rem12px text-gray-800 print:mb-rem4px text-rem19px leading-rem34px print:text-rem15px print:leading-rem20px print:font-normal \",\"children\":[\"Pain\"]}]]}],[\"$\",\"p\",\"dc227f3414"])</script><script>self.__next_f.push([1,"2b\",{\"data-identity\":\"paragraph-element\",\"className\":\"text-gray-800 my-rem16px text-rem19px leading-rem34px print:text-rem15px print:leading-rem20px print:font-normal print:my-rem8px  \",\"children\":[\"Other serious symptoms are possible when electric shocks are more severe. These serious symptoms include:\"]}],[\"$\",\"ul\",\"85f447bdd1b1-parent\",{\"data-identity\":\"unordered-list\",\"className\":\"my-rem16px mx-0 pl-[1.25rem] list-disc marker:text-brandBlue-500 print:marker:text-black marker:pl-rem24px print:my-rem8px print:text-rem15px print:leading-rem20px print:font-normal  \",\"children\":[[\"$\",\"li\",\"85f447bdd1b1\",{\"className\":\"mb-rem12px pl-rem12px text-gray-800 print:mb-rem4px text-rem19px leading-rem34px print:text-rem15px print:leading-rem20px print:font-normal \",\"children\":[\"Abdominal pain\"]}],[\"$\",\"li\",\"b0de41900179\",{\"className\":\"mb-rem12px pl-rem12px text-gray-800 print:mb-rem4px text-rem19px leading-rem34px print:text-rem15px print:leading-rem20px print:font-normal \",\"children\":[\"Broken bones (from the electricity itself or from shock-related spasms)\"]}],[\"$\",\"li\",\"9b5a8b5ae25d\",{\"className\":\"mb-rem12px pl-rem12px text-gray-800 print:mb-rem4px text-rem19px leading-rem34px print:text-rem15px print:leading-rem20px print:font-normal \",\"children\":[\"Chest pain\"]}],[\"$\",\"li\",\"066419753eab\",{\"className\":\"mb-rem12px pl-rem12px text-gray-800 print:mb-rem4px text-rem19px leading-rem34px print:text-rem15px print:leading-rem20px print:font-normal \",\"children\":[\"Dislocated joints (from the force of muscle spasms)\"]}],\"$L5b\",\"$L5c\",\"$L5d\",\"$L5e\",\"$L5f\",\"$L60\",\"$L61\"]}],\"$L62\",\"$L63\",\"$L64\",\"$L65\",\"$L66\",\"$L67\",\"$L68\