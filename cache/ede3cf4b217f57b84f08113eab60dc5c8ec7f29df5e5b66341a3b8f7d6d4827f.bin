						</div>
				</div>
				<div class="elementor-element elementor-element-eea9fa8 elementor-hidden-mobile elementor-widget elementor-widget-button" data-id="eea9fa8" data-element_type="widget" data-e-type="widget" data-widget_type="button.default">
				<div class="elementor-widget-container">
									<div class="elementor-button-wrapper">
					<a class="elementor-button elementor-button-link elementor-size-sm" href="https://samedaycpr.com/classes/">
						<span class="elementor-button-content-wrapper">
									<span class="elementor-button-text">REGISTER NOW</span>
					</span>
