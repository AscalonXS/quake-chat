{
	margin-top:auto;
}
span.no_of_reviews:before,
.reviews_avg{
	display: none;
}
.course-type-buttons button.course-type-btn{
    border: 1px solid #B1181E !important;
    margin-bottom: 0;
    font-size: 22px;
    font-family: "Josefin Sans", sans-serif;
    line-height: 1;
    padding: 30px 30px 60px 400px;
    min-height: 300px;
}
.course-type-buttons button.course-type-btn:hover{
	background: #B1181E;
	color: #fff;
}
.button_text {
	font-weight: 400;
	margin-top: 25px;
	font-size: 15px;
	line-height: 1.5;
	color: #000000;
}
.course-type-buttons button.course-type-btn:hover .button_text{
	color: #ffffff;
}
.show_class_box_wrap button.course-type-btn:after {
    content: "";
    position: absolute;
    background-repeat: no-repeat;
    background-size: contain;
    left: 20px;
    width: 350px;
    height: calc(100% - 40px);
    top: 20px;
    border-radius: 10px;
}
.show_class_box_wrap button.course-type-btn[data-value ^=
ACLS]:after
{
background-image:url('https://samedaycpr.com/wp-content/uploads/2026/05/25-3000-acls-provider-ecard.png');
}

.show_class_box_wrap button.course-type-btn[data-value ^=
BLS]:after
{
background-image:url('https://samedaycpr.com/wp-content/uploads/2026/05/25-3001-bls-provider-ecard.png');
}

.show_class_box_wrap button.course-type-btn[data-value ^=
PALS]:after
{
background-image:url('https://samedaycpr.com/wp-content/uploads/2026/05/25-3006-pals-provider-ecard-1.png');
}
@media(max-width: 767px){
	  button.course-type-btn:before{
        left: calc(50% - 57px);
    }
	.show_class_box_wrap button.course-type-btn {
			padding: 300px 30px 60px;
			min-height: 300px;
		}
		.show_class_box_wrap button.course-type-btn:after {
			width: calc(100% - 40px);
			height: 250px;
		}
	.elementor-widget-html .elementor-widget-container{
		overflow-x: hidden;
	}
	.elementor-widget-html [referrerpolicy="no-referrer-when-downgrade"]{
