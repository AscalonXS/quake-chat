    -webkit-backdrop-filter: blur(12px);
    border-radius:50px;
    padding:8px 10px 8px 8px;
}

.menu-sign-in,.menu-cart{
	display:none!important;
}

.date-today{
	display:none;
}

@media(max-width:767px){
	.menu-sign-in,.menu-cart{
		display:block!important;
	}
}

