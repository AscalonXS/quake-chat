<style id="wp-custom-css">
html {
	scroll-padding : 280px;
}
body,input,textarea,p,span,a{font-family: "Josefin Sans", Sans-serif;}
/* Global CSS for class link box */
.elementor-widget.elementor-widget-image-box{
	position: relative;
}
.elementor-widget.elementor-widget-image-box div{
	position: static !important;
}
.elementor-widget.elementor-widget-image-box .elementor-image-box-title > a::after{
	content:"";
	display: block;
	width: 100%;
	height: 100%;
	opacity: 0;
	z-index:99;
	position: absolute;
	top: 0;
	left: 0;
}
/* Global CSS */

