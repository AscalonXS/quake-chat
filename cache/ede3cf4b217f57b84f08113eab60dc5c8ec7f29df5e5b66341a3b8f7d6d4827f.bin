/* ASL CSS */
@media(max-width:767px){
	.show_class_box_wrap button.course-type-btn{
		flex: 0 0 100%;
	}
	.asl-panel-inner .sl-main-cont-box {
		display: none;
	}
	.asl-panel-inner.show_it .sl-main-cont-box {
		display: block;
	}
}
.registration_links .heading_title {
	--sl-font-size: 14px;
	font-weight: 600;
	padding-top: 10px;
}
.registration_link_wrapper {
	display: flex;
	flex-direction: column;
	gap: 5px;
}
.asl-wrapper .reviews{
	display: flex;
	align-items: center;
	padding-block: 5px 0;
	line-height: 1;
	background: transparent !important;
	color: inherit;
	font-family: "Josefin Sans", Sans-serif;
	transition: 0.3s all ease-in-out;
}
.asl-wrapper .reviews:hover{
	color: #cb2800;
}
.stars_rating{
	font-size: 24px !important;
	line-height: 1 !important;
	color: transparent;
	background: linear-gradient(90deg, #ed9e3b var(--star-width), #ed9e3b57 var(--star-width));
	background-clip: text;
}
span.reviews_avg, span.no_of_reviews {
	font-size: 14px !important;
	line-height: 24px !important;
	padding-left: 3px;
	font-weight: 500;
}
span.no_of_reviews:before{
	content: "- ";
}
#asl-storelocator.asl-cont .infoBox #style_0 .asl-buttons a.action{
	font-weight: 500;
	border-radius: 0;
	border: 1px solid;
	line-height: inherit;
	padding: 10px 15px !important;
	font-size: 14px;
	font-size: var(--sl-btn-size, 14px);
	width: 100%;
	margin: 0;
}
#asl-storelocator.asl-cont .infoBox #style_0 .asl-buttons{
	justify-content: start !important;
}
#asl-storelocator.asl-cont.asl-template-3 .sl-main-cont .btn.btn-asl{
	width: 100%;
}


.error404 div#page {
	max-width: 100%;
	padding-inline: 0 !important;
}

.course-type-buttons button.course-type-btn{
	transition: all 0.3s;
	background: #fff;
	position: relative;
	padding-bottom: 60px;
}
/* .course-type-buttons button.course-type-btn:hover{
box-shadow: 0 1px 15px #1018280f, 0 1px 15px #1018281a !important;
background: #B1181E !important;
color: #fff !important;
} */
button.course-type-btn:before {
    content: "Book Now";
    position: absolute;
    bottom: 30px;
    left: calc(50% + 130px);
    background: #B1181E;
    color: #fff;
    font-family: 'Josefin Sans';
    padding: 11px 25px 9px 25px;
    font-size: 14px !important;
    font-weight: 600 !important;
    border-radius: 5px;
    transition: all .25s;
}
.course-type-buttons button.course-type-btn:hover:before{
	background: #000;
}
/* footer 2025/8/18 */

.inside-footer-widgets div:nth-child(3) {
	flex-basis: 11%;
}

#menu-footer-menu-2 {
	display: flex;
	flex-wrap: wrap;
	gap: 0px;
}

#menu-footer-menu-2 > li {
	flex-basis: 47%;
}

/* single blog */

.single-post .site.grid-container.container{
	max-width:unset;
	padding:0;
}

.blog_right_cta{
	position:relative;
}

.blog_right_cta:after{
	content:'';
	position:absolute;
	background: linear-gradient(180deg, #b12d34 25%, #F2295B00 62%);
	width: 100%;
	width: 100%;
	height: 100%;
	left:0;
	top: 0;
	z-index: 0;
}

.single_blog_faq .e-n-accordion-item-title{
	position: relative;
}

.single_blog_faq .e-n-accordion-item-title:before {
	content: 'Q';
	position: absolute;
	font-family: "Josefin sans";
	font-size: 30px;
	font-weight: 600;
	left: 20px;
	top: 50%;
	transform: translatey(-50%);
	color:#E50113;
}

.single_toc ol{
	margin: 0;
}

@media(max-width:767px){
	.single_blog_faq .e-n-accordion-item-title:before {
		font-size: 20px;
	}
}
#asl-list .stars_rating{
	font-size: 14px;
}
.main-navigation ul ul{
	width: 218px;
	border: 1px solid #000;
}


/* quiz page */

.show {
	display: block !important;
}


.question_container , .not_both, .result_container{
	display:none;
}

.active-quiz{
	display: flex !important;
}

.question_container {
	box-shadow: rgba(100, 100, 111, 0.2) 0px 7px 29px 0px;
/* 	display : flex !important; */
}

.answer_container > div {
	padding: 20px;
	border-radius: 6px;
	box-shadow: rgba(60, 64, 67, 0.3) 0px 1px 2px 0px, rgba(60, 64, 67, 0.15) 0px 2px 6px 2px;
	gap: 15px;
}

.answer_container > div.right-ans {
	box-shadow: rgb(20 167 12) 0px 0px 6px 0px inset, rgb(20 167 12) 0px 0px 6px 0px inset;
}

.answer_container > div.right-ans .elementor-heading-title{
	color: #55B27D !important
}

.answer_container > div.right-ans .elementor-widget-container{
	color:#55B27D !important;
}

.answer_container > div.wrong-ans {
	box-shadow: rgb(255 7 7) 0px 0px 6px 0px inset, rgb(180 0 0) 0px 0px 6px 0px inset;
}

.answer_container > div.wrong-ans .elementor-widget-container{
	color:#B1181E !important;
}

@media(max-width: 767px){
	.answer_container > div {
		flex-wrap: nowrap;
		/* 		gap:10px; */
	}

	.answer .question_label{
		flex-basis:5%;
		display: flex;
		flex-wrap: nowrap;
	}

	.answer > div:last-child{
		flex-basis:93%;
	}

}
/* Mab Sorting */
#p-catlist{
	display: flex;
	flex-direction: column;
}
#p-catlist > li[data-order="1"] {
	order: 1;
}
#p-catlist > li[data-order="2"] {
	order: 2;
}
#p-catlist > li[data-order="3"] {
	order: 3;
}
#p-catlist > li[data-order="4"] {
	order: 4;
}
#p-catlist > li[data-order="5"] {
	order: 5;
}
#p-catlist > li[data-order="6"] {
	order: 6;
}
#p-catlist > li[data-order="7"] {
	order: 7;
}
#p-catlist > li[data-order="8"] {
	order: 8;
}

