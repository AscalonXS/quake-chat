		<script>
		jQuery(document).ready(function(){
		
		jQuery(document).on('click', '.asl-search-clr.asl-clear-btn', function(e){
			jQuery(".asl-panel-inner").removeClass("show_it");
			jQuery(".item-state").removeClass("show_it hide");
			jQuery(".item-state .colision").removeClass("show");
			jQuery(".item-state").attr("data-order", "");
			jQuery('#asl-list').removeClass('loading');
		})
		
		var ajaxurl = 'https://samedaycpr.com/wp-admin/admin-ajax.php';
		let fetchTimeoutId = null;
		function fetchPlaces(searchTerm){
			jQuery.ajax({
				url: ajaxurl,
				method: 'GET',
				data: {
					action: 'find_stores',
					zip: searchTerm
				},
				dataType: 'json',
				success: function(response) {
					if(response.success){
						var data = response.data;
						jQuery(".sl-item").parents(".item-state").addClass("hide");
						if(!data.length){
							if(!jQuery('#no_loc_found').length){
								jQuery('#asl-list').prepend('<p id="no_loc_found">No location found. Try different location.</p>');
								jQuery('.asl-panel-inner').addClass('show_it');
							}
							jQuery('.sl-main-cont-box').removeClass('loading');
							return;
						}
						jQuery('#no_loc_found').remove();
						jQuery.each(data, function (index, id) {
							var $state = jQuery(
								'.sl-item[data-id="' + id + '"]'
							).parents(".item-state");
							var orderVal = index + 1;
							$state.attr("data-order", orderVal);
							jQuery(".asl-panel-inner").addClass("show_it");
							jQuery('.sl-item[data-id="' + id + '"')
								.parents(".item-state")
								.removeClass("hide")
								.addClass("show_it");
							jQuery('.sl-item[data-id="' + id + '"')
								.parents(".item-state")
								.find("> a")
								.attr("aria-expanded", true);
							jQuery('.sl-item[data-id="' + id + '"')
								.parents(".item-state")
								.find(".colision")
								.addClass("show");
						});
						jQuery('.sl-main-cont-box').removeClass('loading');
					}
				}
			});
		}
		
			jQuery('#sl-main-search').on('input change', function(e){
			if (e.key === "Enter") {
				return;
			}
				

			var searchTerm = jQuery(this).val();
			if (!searchTerm.length) {
				jQuery(".asl-panel-inner").removeClass("show_it");
				jQuery(".item-state").removeClass("show_it hide");
				jQuery(".item-state .colision").removeClass("show");
				jQuery(".item-state").attr("data-order", "");
			}

			if (fetchTimeoutId) {
				clearTimeout(fetchTimeoutId);
			}

			if (/^\d+$/.test(searchTerm) && searchTerm.length > 2) {
				jQuery('.sl-main-cont-box').addClass('loading');
				fetchTimeoutId = setTimeout(() => {
					fetchPlaces(searchTerm);
				}, 1000);
			}


		})

	})
		</script>
				<style>
		label .addon-product-desc{
			display: none;
		}
		.addon-product-item {
			display: flex;
			justify-content: space-between;
			gap: 10px;
			align-items: center;
		}
		.addon-product-toggle{
			margin-bottom: 0;
		}
		.description_tooltip {
			display: grid;
			position: relative;
			width: 20px;
			height: 20px;
			flex: 0 0 20px;
			cursor: pointer;
			opacity: 0.6;
			transition: 0.3s all ease-in-out;
		}
		.description_tooltip:after {
			content: "";
			background: url(https://samedaycpr.com/wp-content/uploads/2026/04/arrow.png);
			position: absolute;
			right: -12px;
			top: 50%;
			display: inline-block;
			width: 14px;
			height: 9px;
			background-repeat: no-repeat;
			background-size: contain;
			transform: translateY(-50%) rotate(90deg);
			opacity: 0;
			pointer-events: none;
			transition: 0.3s all ease-in-out;
		}
		.description_tooltip svg{
			fill: #626367;
		}
		.description_tooltip .addon-product-desc{
			opacity: 0;
			pointer-events: none;
			position: absolute;
			background: rgb(55 58 65);
			color: #fff;
			font-size: 13px;
			padding: 8px;
			z-index: 99;
			border-radius: 5px;
			left: 28px;
			top: 50%;
			transform: translateY(-50%);
			margin-top: 0;
			transition: 0.3s all ease-in-out;
			max-width: 300px;
		}
		.description_tooltip:hover,
		.description_tooltip:hover:after,
		.description_tooltip:hover .addon-product-desc{
			opacity: 1;
			pointer-events: auto;
		}
		
		@media(max-width: 767px){
			.description_tooltip .addon-product-desc {
				right: -10px;
				left: unset;
				top: 27px;
				width: max-content;
				transform: unset;
			}
			.description_tooltip:after {
				left: 3px;
				top: 23px;
				transform: translateY(-50%) rotate(180deg);
				right: unset;
			}
		}
		</style>
	
		<script>
			jQuery(document).ready(function(){
				jQuery('#addon-products-section .addon-product-item').each(function(){
					jQuery(this).append('<div class="description_tooltip"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path d="M320 576C461.4 576 576 461.4 576 320C576 178.6 461.4 64 320 64C178.6 64 64 178.6 64 320C64 461.4 178.6 576 320 576zM288 224C288 206.3 302.3 192 320 192C337.7 192 352 206.3 352 224C352 241.7 337.7 256 320 256C302.3 256 288 241.7 288 224zM280 288L328 288C341.3 288 352 298.7 352 312L352 400L360 400C373.3 400 384 410.7 384 424C384 437.3 373.3 448 360 448L280 448C266.7 448 256 437.3 256 424C256 410.7 266.7 400 280 400L304 400L304 336L280 336C266.7 336 256 325.3 256 312C256 298.7 266.7 288 280 288z"/></svg></div>');
					jQuery(this).find('.description_tooltip').append(jQuery(this).find('.addon-product-desc'))
				})
			})
		</script>

	
<script>
jQuery(document).ready(function () {

    const url = new URL(window.location.href);
    const params = url.searchParams;

    const oId = params.get("cpr_oid");
    const oKey = params.get("cpr_okey");
    const cprIid = params.get("cpr_iid");

    var ajax_url = "https://samedaycpr.com/wp-admin/admin-ajax.php";
    var validate_order_nonce = "ff6dba042a";

    if (oId && oKey) {
        jQuery.ajax({
            url: ajax_url,
            type: "POST",
            data: {
                action: "cpr_validate_order",
                nonce: validate_order_nonce,
                cpr_oid: oId,
                cpr_okey: oKey,
                cpr_iid: cprIid,
            },
            success: function (response) {
                if (response.success) {

                    // show notes in a div selector location_notes_content
                    setTimeout(() => {
//                         jQuery('.location_modal_overlay').css('display', 'flex');
                        jQuery('.location_notes_content').html(response.data.notes);
// 						jQuery('body').css('overflow', 'hidden');
                    }, 0);

                }
            },
            error: function () {
                console.log("AJAX error");
            }
        });
    }
	
// 	jQuery(document).on('click', '.location_modal_overlay', function (e) {
// 		if (jQuery(e.target).is('.location_modal_overlay')) {
// 			jQuery(this).hide();
// 			jQuery('body').css('overflow', '');
// 		}
// 	});
	
// 	jQuery('.close_btn-container button').on('click', function () {
// 		jQuery('.location_modal_overlay').hide();
// 		jQuery('body').css('overflow', '');
// 	});
});
</script>
