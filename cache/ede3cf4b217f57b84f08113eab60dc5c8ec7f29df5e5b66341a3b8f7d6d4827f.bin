.footer_menu li:before{
	content: '';
	background-image: url('https://samedaycpr.com/wp-content/uploads/2025/07/arrow.svg');
	position: absolute;
	left: -2px;
	width: 9px;
	height: 9px;
	background-repeat: no-repeat;
	background-size: contain;
	top: 9.5px;
	transform: translateY(-50%);
	filter: brightness(0) saturate(100%) invert(36%) sepia(13%) saturate(2548%) hue-rotate(320deg) brightness(99%) contrast(85%);
}
.site-footer .social_media_list{
	text-align: center;
}
.header_social_media_list .social_media_list a[href="#"]{
	display: none;
}
.header_social_media_list .social_media_list .fa-linkedin:before{
