		max-width: 767px !important;
	}
}
.iframe_offset iframe{
	width: max(400px, 100%);
	max-width: unset;
}
.sl-main-cont-box.loading:after {
	content: "";
	position: absolute;
	inset: 0;
	background: #00000054;
	backdrop-filter: blur(2px);
}

/* START New Header Css */
.header_right_bar a {
	display: inline-block;
}
.header_right_bar .menu-bar-items {
	border-right: 1px solid #ddd;
	border-left: 1px solid #ddd;
}
.header_right_bar {
	font-family: 'Josefin Sans';
}
.header_right_bar .menu_right_bar >  .search_icon_wrap{
	border-left: 1px solid #fff
}
.header_right_bar .menu_right_bar > :is(.client-avatar-logout, .search_icon_wrap){
	padding-inline: 28px;
}
.header_right_bar .menu_right_bar > :is(.client-avatar-logout, .search_icon_wrap) a {
	display: flex;
	align-items: center;
	gap: 12px;
	line-height: 1em;
}
.header_right_bar .menu_right_bar > :is(.client-avatar-logout, .search_icon_wrap) a:hover {
	background: transparent;
}
.st_numbers span.elementor-icon-list-icon {
	height: 33px !important;
}
.st_numbers .elementor-icon-list-icon svg {
	margin-top: -28px !important;
}
.st_numbers .elementor-widget-container {
	position: relative !important;
	overflow: visible !important;
}
.st_numbers .elementor-widget-container:before {
	content: '' !important;
	position: absolute !important;
	top: 0 !important;
	right: -17px;
	clip-path: polygon(100% 0, 0 0, 0 100%) !important;
	background: #b1181e !important;
	width: 17px !important;
	height: 100% !important;
}
.st_numbers strong {
	color: #fdbb6f;
}
.n_header_menu .locator_map a.elementor-item {
	color: #b1181e !important;
	text-decoration: underline;
	text-decoration-thickness: 1px;
	text-underline-offset: 2px;
}
.n_header_menu .elementor-nav-menu .sub-arrow {
	padding: 5px;
}
@media(max-width: 1024px){
	.n_header_menu .elementor-nav-menu .sub-arrow {
		padding: 10px 15px 10px 35px;
	}
}
@media(max-width: 767px){
	.header_right_bar a {
		line-height: 35px;
	}
	.n_header_menu .has-submenu {
		display: flex;
		justify-content: space-between;
	}
	.n_header_menu .elementor-nav-menu--dropdown .elementor-sub-item{
		line-height: 1em;
	}
	.n_header_menu a.highlighted > span > svg > path {
		fill: #fff !important;
	}
}
