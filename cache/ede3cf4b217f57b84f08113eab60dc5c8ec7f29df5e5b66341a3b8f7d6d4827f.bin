/* new home design */
.customer-feedback .e-n-tabs-heading{
	flex-basis:30%;
	flex-flow:row wrap;
	gap:10px;
	
}
.customer-feedback .e-n-tabs-heading button{
	width:calc(30% - 5px);
	   padding: 0;
	    background-color: transparent !important;
}
.customer-feedback .e-n-tabs-heading button img{
	border-radius:20px;
	aspect-ratio:1;
	object-fit:cover;
	transition: 0.3s ease;
}
.customer-feedback .e-n-tabs-heading button img:hover{

/* transform: scale(1.05); */
}

.customer-feedback .e-n-tabs-content{
	flex-basis:65%;

}
.user-feedback{
    max-height: 100px;
/*     overflow-y: auto; */
}

.customer-feedback .elementor-widget-text-editor p
{
    display: -webkit-box;     
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;      
  overflow: hidden;           
  text-overflow: ellipsis;  
}

.select-list .elementor-heading-title {
    position: relative;
    padding-left: 24px;
}

.select-list .elementor-heading-title::before {
    content: "";
    width: 14px;
    height: 14px;
    border: 2px solid #54595F;
    border-radius: 50%;
    position: absolute;
    left: 0;
    top: 26%;
    transform: translateY(-50%);
}
.select-list .elementor-heading-title:hover::before {
    border: 2px solid #B1181E;
}

.select-list .elementor-heading-title::after {
    content: "";
    width: 6px;
    height: 6px;
    background: #B1181E;
    border-radius: 50%;
    position: absolute;
    left: 4px;
    top: 26%;
    transform: translateY(-50%);
    opacity: 0;
    transition: 0.3s;
}


.select-list .elementor-heading-title.active::after {
    opacity: 1;
}
@media(max-width:767px)
{
.customer-feedback .e-n-tabs-heading button img{
width:70px;
}
	.user-feedback{
    max-height: 200px;

}
}

.rpi-card_block .rpi-img-wrap img {
    opacity: 0;
    position: relative;
    z-index: 2;
}

.rpi-card_block .rpi-img-wrap::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 50px;
    height: 50px;

    background-image: url('https://samedaycpr.com/wp-content/uploads/2026/01/same-day-cpr-logo.png'); 
    background-size: cover;
    background-repeat: no-repeat;
