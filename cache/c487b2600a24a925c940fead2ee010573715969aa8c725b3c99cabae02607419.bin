            <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
            
            {
                "@type": "Question",
                "name": "How long should you flush a chemical burn with water during first aid?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Flush chemical burns with cool running water for at least 15-20 minutes continuously. This minimum time ensures complete chemical removal from skin surfaces. For alkali burns, flushing may need to continue longer since these substances penetrate deeper into tissue layers."
                }
            },
            
            {
                "@type": "Question",
                "name": "Can you use milk or other liquids instead of water for chemical burn first aid?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Use only clean water for chemical burn first aid. Milk, juice, or other liquids may contain substances that react with the chemical or complicate medical treatment. Water is the safest and most effective option for removing chemicals from skin."
                }
            },
            
            {
                "@type": "Question",
                "name": "When should you call 911 for a chemical burn versus treating at home?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Call 911 immediately for burns larger than 3 inches, eye exposure, airway involvement, or unknown chemicals. Also seek emergency care if the victim shows signs of shock, difficulty breathing, or severe pain that doesn&#039;t improve with initial treatment."
                }
            },
            
            {
                "@type": "Question",
                "name": "Is it safe to drive someone to the hospital after chemical burn first aid?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "If the victim is alert and stable after initial treatment, driving may be acceptable for minor burns. However, call 911 for severe burns, eye injuries, or if symptoms worsen during transport. Chemical burns can cause delayed complications requiring immediate intervention."
                }
            },
            
            {
                "@type": "Question",
                "name": "How do you know if chemical burn first aid was effective or if complications developed?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Watch for increasing pain, spreading redness, swelling, or signs of infection like fever or pus. Effective first aid should result in stable or improving symptoms. Seek medical attention if pain worsens or new symptoms develop within 24 hours."
                }
            }
            
        ]
    }
</script>
        
    

    
    

    

    
    
    
    

    
    
    
        
            
        
            
                
            
        
            
        
            
        
            
        
            
        
            
        
            
        
    
    
        
    
    
        
