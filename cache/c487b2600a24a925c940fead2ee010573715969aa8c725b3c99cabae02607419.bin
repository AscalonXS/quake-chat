                <img src="https://production-doctronic-statamic-assets.s3.us-east-1.amazonaws.com/footer/patient-oath-badge.svg" alt="Doctronic Patient Oath" width="167" height="167" loading="lazy" class="w-[167px] h-[167px]">
                <p class="text-[18px] md:text-[28px] font-semibold text-[#1B1B18] leading-[1.4] text-center" style="letter-spacing: -0.02em;">
