<script>
    document.addEventListener('DOMContentLoaded', function () {
        if (!window.location.pathname.startsWith('/blog')) { return; }
        document.querySelectorAll('header a[href="https://www.doctronic.ai"]').forEach(function (link) {
            link.addEventListener('click', function () {
                if (typeof fireBlogStartConsultClick === 'function') {
                    fireBlogStartConsultClick({
                        location: 'blog_nav',
                        button_text: this.textContent.trim(),
                        button_url: this.href,
                        is_tpa: window.location.pathname.includes('/tpa')
                    });
                }
            });
        });
    });
</script>

        
