span{width:20px;height:20px;background:transparent url(../img/arrow-down-white.svg) no-repeat 50%/contain;margin-left:10px;display:inline-block}</style><script>document.addEventListener("DOMContentLoaded", function () {
    const list = document.querySelector("#services-spectrum-list");



    function activateItem(item, index) {
        // Get the latest list of items
        const items = document.querySelectorAll("#services-spectrum-list li");



        // Remove 'active' class from all service-content panels
        document.querySelectorAll("[id^='service-content-panel-']").forEach(el => {
            el.classList.remove("active");
        });



        // Remove 'active' class from all list items
        items.forEach(li => li.classList.remove("active"));



        // Add 'active' class to the clicked/hovered list item
        item.classList.add("active");



        // Add 'active' class to the corresponding service-content panel
        const targetElement = document.getElementById(`service-content-panel-${index}`);
        if (targetElement) {
            targetElement.classList.add("active");
        }
    }



    function updateEventListeners() {
        const isWideScreen = window.innerWidth >= 1200;



        // Get fresh references to all list items
        let items = document.querySelectorAll("#services-spectrum-list li");



        // Remove all event listeners before adding new ones
        items.forEach((item, index) => {
            item.replaceWith(item.cloneNode(true));
        });



        // Get new list items after replacement
        items = document.querySelectorAll("#services-spectrum-list li");



        items.forEach((item, index) => {
            if (isWideScreen) {
                item.addEventListener("mouseenter", function () {
                    activateItem(item, index);
                });
            } else {
                item.addEventListener("click", function () {
                    activateItem(item, index);
                });
            }
        });
    }



    updateEventListeners();
    window.addEventListener("resize", updateEventListeners);
});</script><link
