                background: url("/migrated/f2992d9b3dcafb99cb50142e.png") no-repeat top center #FFFFFF;
                border-bottom: 2px solid #125586;
                max-width: 435px;
                margin: 0 auto;
                border-radius: 8px;
                box-shadow: 0 0 16px 0 rgba(0, 0, 0, 0.16);
                text-align: center;
            }

