document.addEventListener('DOMContentLoaded', function () {
    const faqItems = document.querySelectorAll('footer.test-footer .container .footer-menu-list');

    faqItems.forEach(item => {
        const header = item.querySelector('footer.test-footer .container p.h3');
        header.addEventListener('click', function () {
            // Remove 'open' class from all other items
            faqItems.forEach(otherItem => {
                if (otherItem !== item) {
                    otherItem.classList.remove('open');
                }
            });

            // Toggle the 'open' class on the clicked item
            item.classList.toggle('open');
        });
    });
});
	
	document.addEventListener('DOMContentLoaded', function () {
