/*Home Temp Css Start*/
.home-temp-banner-section{background:#F6F9FE; padding:0;}
.home-temp-banner-section .banner-left{max-width:508px;  padding:24.3px 0;}
.home-temp-banner-section .banner-left p{
    margin: 0;font-size:14px; line-height:18px; color:#000;
}
.home-temp-banner-section h1{ font-size:36px; line-height:41px; font-weight:600; padding:0; margin:0 0; color:#000;}
.home-temp-banner-section .container {
    position: relative;
}
.home-temp-banner-section .img-box{ position:absolute; top:0; right:0;}
.home-temp-banner-section .img-box .tab-img,.home-temp-banner-section .img-box .mob-img{ display:none;}
.home-temp-banner-section h3{font-size:32px; font-weight:700; line-height:42px; color:#125586;margin:5px 0;}
.home-temp-banner-section h3 sup{
    font-size: 18px;
    line-height: 28px;
}
.home-temp-banner-section .steps-box{
    background: #fff;
    padding: 16px;
    border-radius: 8px;
    border: 1px solid #B6DBF5;
    position: absolute;
    top: 42px;
    right: 37px;
    z-index: 10;
    max-width: 247px;
    text-align: center;
    font-size: 16px;
    line-height: 24px;
}
.home-temp-banner-section .steps-box h4{
    font-size: 16px;
    line-height: 24px;
    font-weight: 500; padding:0; margin:0 0 5px;
}
	.home-temp-banner-section .steps-box ol {
    padding: 0;
    margin: 0 0 0 0;
    counter-reset: item;
    list-style-type: none;
    position: relative;
    text-align: left;
}

        .home-temp-banner-section .steps-box ol li {
    position: relative;
    z-index: 10;
    padding-left: 33px;
    display: block;
    margin-bottom: 10px;
}
	.home-temp-banner-section .steps-box ol li:last-child{ margin-bottom:0;}

        .home-temp-banner-section .steps-box ol li::marker {
            color: #fff;
            font-size: 19px;
        }
	
.home-temp-banner-section .steps-box ol li::before {
    position: absolute;
    content: "";
    display: block;
    width: 24px;
    height: 24px;
    top: 0;
    left: 0;
    background: #125586;
    z-index: -1;
    border-radius: 50px;
    content: counter(item) "";
    counter-increment: item;
    color: #fff;
    text-align: center;
    line-height: 24px;
    font-size: 12px;
}
.home-temp-banner-section .star-box{
font-family: Poppins; font-weight: 400; font-size: 16px; line-height: 24px; letter-spacing: 0%; text-align: center; vertical-align: middle;
margin-top:7px; color:#083651;}
.home-temp-banner-section .stars img{ vertical-align:bottom;}
.home-temp-banner-section .star-count{  font-family: Poppins; font-weight: 700; font-size: 20px; line-height: 24px; letter-spacing: 0%; text-align: center; color:#000;}
.home-temp-banner-section .banner_btn a{ font-size:16px; line-height:20px; font-weight:500; padding:11px 52.5px; background:#C82825; border-radius:4px; text-transform:capitalize; min-width:200px;}
.home-temp-banner-section .banner_btn{
    display: flex;
    align-items: center;
}
.home-temp-banner-section .banner_btn a:hover{ background:#000;}
/*Banner css End*/

/*Nav css Start*/
.nav-container {
  max-width: 1140px;
  padding: 0 10px;
  margin: 0 auto;
}
/* Navbar Styling */
.navbar-main{
  background:#125586;
}
.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #fff;
  position: relative;
	padding:0;
}

.nav-links {
  display: flex;
  gap: 0;
  margin: 0;
  padding: 0;
}

.nav-links a {
    padding-top: 27px!important;
    padding-bottom: 14px!important;
	padding-left: 0!important;
    padding-right: 0!important;
    font-size: 16px ;
    font-weight: 400 ;
    color: #fff ;text-decoration: none;display: block; line-height: 1; margin-bottom:13px;
}
.nav-links a.active{border-bottom:2px solid #fff;}
.nav-links li{padding-left: 23px!important;
    padding-right: 23px!important;}
.nav-links li:first-child a{ padding-left: 0;}
.nav-links li{position: relative;}
.nav-links a:hover,.nav-links a.selected{
    color: #D8D8D8;
}
 .nav-links li.menu-item-has-children:hover > .sub-menu{
  visibility: visible;
  opacity: 1;
  -webkit-transition: all 300ms ease-out;
  transition: all 300ms ease-out;
}
.nav-links li.menu-item-has-children .sub-menu {
  position: absolute;
  top: 70px;
  left: -12px;
  z-index: 9999;
  visibility: hidden;
  opacity: 0;
  box-shadow: 0 4px 10px -2px rgba(0, 0, 0, 0.1);
  text-align: left;
  width: 656px !important;
    background: #fff !important;
    border-radius: 5px !important;
    border: 1px solid #767676!important;
    padding-bottom: 15px;
    min-width: 220px;
    margin: 0; padding:24px 0;
}
.nav-links li.menu-item-has-children .sub-menu li.menu-item {
  display: inline-block !important;
  width: 43.6% !important;
  margin: 5px 3% !important;
  border-bottom: 1px solid #ccc; /*vertical-align:top; min-height:59px;*/
}
.nav-links li.menu-item-has-children .sub-menu:after {
  content: "";
  position: absolute;
  top: -14px;
  left: 65px;
  background: url("/migrated/861742f7cb44d7f03a283a17.png") no-repeat;
  width: 29px;
  height: 15px;
}
.nav-links li.menu-item-has-children .sub-menu a {
  font-weight: 400 ;
  font-size: 14px ;
  line-height: 18px ;
  color: #030303 ;
  padding: 11px 10px 11px 0!important;
  display: block;
  background: url("/migrated/dfdd3373859b22c8a3ea74ba.png") no-repeat 100%;
}
.nav-links li.menu-item-has-children .sub-menu a:hover{color: #999;}
.navbar-main .red-btn a{
  font-size: 16px ;
  font-weight: 500 ;
  color: #fff ;
  background: #b51d1a ;
  border-radius: 5px ;
  padding: 10.5px 24px;
	text-transform:uppercase;
  text-decoration: none;
}
.navbar-main .red-btn a:hover{background: #000;}

/* Hamburger Menu */
.menu-toggle {
  display: none;
}

.hamburger {
  display: none;
  flex-direction: column;
  cursor: pointer;
  gap: 2px;
}

.hamburger span {
  width: 15px;
  height: 3px;
  background-color: #000;
}
.dt-hide{ display: none;}
.down-arrow{ margin-left: 10px;}
.nav-links a:hover .down-arrow svg path {
  fill: #D8D8D8;
}
.navbar-main .header-logo{padding:15px;}
.navbar-main .spanish_link{ display:none;}
