/* Parent positioning */
.menu-item-has-children > a {
  position: relative;
  padding-right: 18px;
}

/* Arrow icon */
.menu-item-has-children > a::after {
  content: "";
  position: absolute;
  right: -15px;
  top: 50%;
  width: 8px;
  height: 8px;
  border-right: 2px solid #333;
  border-bottom: 2px solid #333;
  transform: translateY(-50%) rotate(45deg);
  transition: transform 0.3s ease;
}

/* Rotate arrow on hover */
.menu-item-has-children:hover > a::after {
  transform: translateY(-50%) rotate(-135deg);
}

/* Mega dropdown */
.menu-item-has-children > .sub-menu {
    position: absolute;
    left: 0;
    top: 100%;
    width: 755px;
    background: #fff;
    border-radius: 16px;
    padding: 51px 32px 24px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px 65px;
    box-shadow: 0 24px 56px rgba(167, 174, 186, 0.16);
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    z-index: 999;
}
.menu-item-has-children > .sub-menu:after {content:""; position:absolute; top:51px; left:50%; background:#E2DEDE; width:1px; height:75%; transform:translatex(-50%);}
.menu-item-has-children > .sub-menu:before {content:"Courses"; position:absolute; top:17px; left:32px; width:100%; height:18px; font-size:12px; color:#97A3B7; font-weight:600;}

/* Show on hover */
.menu-item-has-children:hover > .sub-menu {
  opacity: 1;
  visibility: visible;
}
.menu-item-has-children > .sub-menu li{
    padding-left: 36px;
    position: relative;
	border-bottom:1px solid transparent;
}
/* Menu item links */
.sub-menu li a {
  display: flex;
  align-items: center;
  padding: 0;
  font-size: 16px;
	line-height:20px;
  color: #030303;
  text-decoration: none;
  transition: background 0.2s ease;
}

/* Hover */
.sub-menu li a:hover {
  color: #1D88D7;
}
.menu-item-has-children > .sub-menu li:hover {
    border-bottom: 1px solid #1D88D7;
}
