            // Remove 'open' class from all other items
            faqItems.forEach(otherItem => {
                if (otherItem !== item) {
                    otherItem.classList.remove('open');
                }
            });

            // Toggle the 'open' class on the clicked item
            item.classList.toggle('open');
        });
    });
});
	
