<style id="curio-article-header-style-inline-css">
/* Article header. */
.curio-article-header {
	--ah-cols-8: calc(var(--col-w) * 8 + var(--grid-gap) * 7);
	--ah-cols-6: calc(var(--col-w) * 6 + var(--grid-gap) * 5);
	font-family: var(--f-primary);
	color: var(--c-text);
}

/* Tag size, box and colors come from the shared tag rule in base.css (--fs-tag);
   the parent link uses the same size. */
.curio-article-header__terms {
	display: flex;
	align-items: center;
	font-size: var(--fs-tag);
	line-height: 1.2;
}

.curio-article-header__eyebrow {
	font-weight: 700;
	text-transform: uppercase;
}

/* Parent category before the tag: "ANIMALS › AQUATIC". Plain navy text, same type as the tag. */
.curio-article-header__terms.has-parent {
	flex-wrap: wrap;
	row-gap: 0.25rem;
}

.curio-article-header__parent {
	position: relative;
	font-weight: 700;
	text-transform: uppercase;
	color: var(--c-navy);
}

/* At least a 24px-tall hit area without a bigger box (as for the tags). */
.curio-article-header__parent::after {
	content: "";
	position: absolute;
	top: min(0px, calc(100% - 22px));
	right: -2px;
	bottom: -2px;
	left: -2px;
}

.curio-article-header__parent:hover,
.curio-article-header__parent:focus-visible {
	text-decoration: underline;
	text-underline-offset: 0.2em;
}

.curio-article-header__sep {
	margin: 0 0.5em;
	font-weight: 700;
	color: var(--c-navy);
}

.curio-article-header__title {
	margin-bottom: 0.625rem;
	font-size: 2rem;
	font-weight: 700;
	line-height: 1.125;
	color: var(--c-heading);
}

.curio-article-header__deck {
	display: block;
	font-size: 1.125rem;
	font-weight: 300;
	line-height: 1.3333333333;
	color: var(--c-text);
}

.curio-article-header__deck a {
	color: var(--c-link);
	text-decoration: underline;
	text-decoration-thickness: 1px;
	text-underline-offset: 0.18em;
}

.curio-article-header__media {
	position: relative;
	overflow: hidden;
	aspect-ratio: 16 / 9;
	background-color: var(--c-gray-light);
}

.curio-article-header__media img {
	position: absolute;
	inset: 0;
	width: 100%;
	height: 100%;
	object-fit: cover;
}

.curio-article-header__caption {
	margin: 0.5rem 0;
	font-size: 0.875rem;
	font-weight: 300;
	line-height: 1.4285714286;
	color: var(--c-heading);
}

.curio-article-header__caption a {
	border-bottom: 1px solid;
	color: inherit;
}

.curio-article-header__caption a:hover,
.curio-article-header__caption a:focus-visible {
	color: var(--c-black);
	text-decoration: none;
}

.curio-article-header .curio-caption,
.curio-article-header .curio-credit {
	display: block;
}

.curio-article-header .curio-caption:not(:only-child) {
	margin-bottom: 0.5rem;
}

.curio-article-header .curio-credit {
	font-size: var(--fs-credit);
	line-height: 1.2;
	letter-spacing: 0.075em;
	text-transform: uppercase;
}

@media (min-width: 64rem) {
	.curio-article-header__title {
		font-size: 2.375rem;
		line-height: 1.1052631579;
	}
}

/* -------------------------------------------------------------
 * Default: text column (6 cols) above a wider image (8 cols).
 * ----------------------------------------------------------- */
/* Doubled class: outranks core's flow-layout margin reset on template groups. */
.curio-article-header.curio-article-header--default {
	width: var(--content-max);
	margin: 0 auto 1.375rem;
}

.curio-article-header--default .curio-article-header__content {
	margin: 0 auto 1.125rem;
}

.curio-article-header--default .curio-article-header__terms {
	margin-bottom: 0.625rem;
}

.curio-article-header--default .curio-article-header__deck {
	margin-bottom: 1rem;
}

.curio-article-header--default .curio-article-header__media {
	margin-bottom: 0.375rem;
}

.curio-article-header--default.no-media .curio-article-header__content {
	margin-bottom: 0;
}

@media (min-width: 64rem) {
	.curio-article-header.curio-article-header--default {
		width: var(--ah-cols-8);
		margin-bottom: 2.75rem;
	}

	.curio-article-header--default .curio-article-header__content {
		width: var(--ah-cols-6);
		margin-bottom: 2.25rem;
	}

	.curio-article-header--default .curio-article-header__media {
		margin-bottom: 0.75rem;
	}
}

/*# sourceURL=https://biologyinsights.com/wp-content/themes/curio/blocks/article-header/style.css */
</style>
<style id="curio-article-byline-style-inline-css">
/* Article share row (on a full-width rule) + byline. */
.curio-article-meta {
	--block-max-width: min(100%, 42.5rem);
	width: var(--content-max);
	margin: 0 auto;
	font-family: var(--f-primary);
	color: var(--c-text);
}

.curio-article-meta--with-sidebar {
	--block-max-width: min(100%, 40rem);
}

/* Share row */
.curio-share {
	position: relative;
	z-index: 0;
	display: flex;
	justify-content: center;
	margin-bottom: 3.75rem;
}

.curio-share::before {
	content: "";
	position: absolute;
	top: 50%;
	left: 0;
	z-index: -1;
	width: 100%;
	height: 1px;
	background-color: var(--c-text);
}

.curio-share__list {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 0.25rem;
	margin: 0;
	padding: 0.25rem 1.25rem;
	border: 1px solid var(--c-text);
	background-color: var(--c-white);
	list-style: none;
}

.curio-share__item {
	margin: 0;
}

.curio-share__link {
	display: flex;
	align-items: center;
	justify-content: center;
	min-width: 2.625rem;
	height: 2.75rem;
	padding: 0;
	border: 0;
	background: none;
	color: var(--c-link);
	cursor: pointer;
}

.curio-share__link .curio-icon {
	width: 1.25rem;
	height: 1.25rem;
}

.curio-share__item--email .curio-icon,
.curio-share__item--x .curio-icon {
	width: 1.125rem;
	height: 1.125rem;
}

.curio-share__link:hover,
.curio-share__link:focus-visible {
	color: var(--c-black);
}

@media (prefers-reduced-motion: no-preference) {
	.curio-share__link {
		transition: color 250ms ease-in-out;
	}
}

/* Byline: "By …" + date, in the text column. */
.curio-article-byline,
.curio-article-meta__after {
	width: var(--block-max-width);
	margin-inline: auto;
}

.curio-article-byline {
	position: relative;
	margin-bottom: 2.25rem;
}

.curio-article-byline__row {
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	gap: 0.5rem 0.875rem;
	margin-bottom: 0.5rem;
}

.curio-article-byline__authors {
	margin: 0;
	font-size: 1.125rem;
	font-weight: 300;
	line-height: 1.2222222222;
}

.curio-article-byline__authors a {
	font-weight: 700;
	color: var(--c-link);
	text-decoration: none;
}

.curio-article-byline__authors a:hover,
.curio-article-byline__authors a:focus-visible {
	color: var(--c-link);
	text-decoration: underline;
	text-decoration-thickness: 1px;
	text-underline-offset: 0.2em;
}

.curio-article-byline__date {
	margin: 0;
	font-size: 0.75rem;
	font-weight: 300;
	line-height: 1.4166666667;
}

@media (min-width: 64rem) {
	/* The reference sets the date inline in a 1.3 line box here. */
	.curio-article-byline__date {
		line-height: 1.3rem;
	}
}

/* Output of the curio_after_byline hook (e.g. an audio player). */
.curio-article-meta__after {
	margin-bottom: var(--block-rhythm);
}

@media (min-width: 64rem) {
	.curio-article-meta--with-sidebar .curio-article-byline,
	.curio-article-meta--with-sidebar .curio-article-meta__after {
		margin-right: calc(20.625rem + var(--grid-gap));
	}
}

@media print {
	.curio-share {
		display: none;
	}
}

/* Small phones: tighten the share row so all seven buttons fit on 320px screens. */
@media (max-width: 23.9375rem) {
	.curio-share__list {
		gap: 0;
		padding-inline: 0.5rem;
	}

	.curio-share__link {
		min-width: 2.375rem;
	}
}

/* ---------------------------------------------------------------
 * "Cite" button + panel (opens under the byline).
 * ------------------------------------------------------------- */
.curio-citebox__button {
	display: inline-flex;
	align-items: center;
	gap: 0.375rem;
	min-height: 2rem;
	padding: 0 0.75rem;
	border: 1px solid var(--c-rule);
	border-radius: 999px;
	background: var(--c-white);
	color: var(--c-primary);
	font: 700 0.8125rem/1 var(--f-primary);
	cursor: pointer;
}

.curio-citebox__button:hover,
.curio-citebox__button:focus-visible,
.curio-citebox__button[aria-expanded="true"] {
	border-color: var(--c-primary);
}

.curio-citebox__button .curio-icon {
	width: 0.875rem;
	height: 0.875rem;
	color: var(--c-secondary);
}

.curio-citebox__panel {
	position: absolute;
	top: calc(100% + 0.5rem);
	left: 0;
	z-index: 20;
	width: min(32.5rem, 100%);
	padding: 1rem 1.125rem 1.125rem;
	border: 1px solid var(--c-rule);
	border-radius: 0.625rem;
	background: var(--c-white);
	box-shadow: 0 0.875rem 2.5rem rgba(20, 16, 40, 0.18);
	color: var(--c-text);
}

.curio-citebox__panel[hidden] {
	display: none;
}

.curio-citebox__top {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 0.625rem;
	margin-bottom: 0.625rem;
}

.curio-citebox__heading {
	margin: 0;
	font-size: 0.875rem;
	font-weight: 700;
	line-height: 1.2;
	letter-spacing: 0.075em;
	text-transform: uppercase;
	color: var(--c-text);
}

.curio-citebox__close {
	display: grid;
	place-items: center;
	width: 2rem;
	height: 2rem;
	padding: 0;
	border: 0;
	border-radius: 0.375rem;
	background: none;
	color: var(--c-text);
	cursor: pointer;
}

.curio-citebox__close:hover,
.curio-citebox__close:focus-visible {
	background: var(--c-gray-light);
}

.curio-citebox__close .curio-icon {
	width: 1.125rem;
	height: 1.125rem;
}

.curio-citebox__label {
	display: block;
	margin-bottom: 0.25rem;
	font-size: 0.75rem;
	font-weight: 300;
}

.curio-citebox__select-wrap {
	position: relative;
	display: inline-block;
}

.curio-citebox__select {
	min-width: 8rem;
	min-height: 2.375rem;
	padding: 0 2.25rem 0 0.75rem;
	border: 1px solid var(--c-rule);
	border-radius: 0.375rem;
	background: var(--c-white);
	color: var(--c-text);
	font: 600 0.875rem/1 var(--f-primary);
	appearance: none;
	cursor: pointer;
}

.curio-citebox__select-icon {
	position: absolute;
	top: 50%;
	right: 0.75rem;
	width: 0.875rem;
	height: 0.875rem;
	color: var(--c-primary);
	pointer-events: none;
	transform: translateY(-50%);
}

.curio-citebox__text {
	margin: 0.75rem 0;
	padding: 0.875rem 1rem 0.875rem 2.125rem;
	border-radius: 0.375rem;
	background: var(--c-gray-light);
	font-size: 0.9375rem;
	font-weight: 400;
	line-height: 1.6;
	text-indent: -1.125rem;
	overflow-wrap: anywhere;
}

.curio-citebox__text[hidden] {
	display: none;
}

.curio-citebox__copy {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	gap: 0.5rem;
	min-height: 2.5rem;
	padding: 0 1rem;
	border: 1.5px solid var(--c-primary);
	border-radius: 999px;
	background: var(--c-white);
	color: var(--c-primary);
	font: 700 0.875rem/1 var(--f-primary);
	cursor: pointer;
}

.curio-citebox__copy:hover,
.curio-citebox__copy:focus-visible,
.curio-citebox__copy.is-done {
	background: var(--c-primary);
	color: var(--c-white);
}

.curio-citebox__copy .curio-icon {
	width: 0.9375rem;
	height: 0.9375rem;
}

.curio-citebox__note {
	margin: 0.625rem 0 0;
	font-size: 0.75rem;
	font-weight: 300;
	line-height: 1.4;
}

@media print {
	.curio-citebox {
		display: none;
	}
}

/*# sourceURL=https://biologyinsights.com/wp-content/themes/curio/blocks/article-byline/style.css */
</style>
<link rel='stylesheet' id='curio-footnotes-css' href='https://biologyinsights.com/wp-content/themes/curio/assets/css/footnotes.css?ver=1792200228' media='all' />
<style id="curio-article-footer-style-inline-css">
/* Article footer: Citations, author bios. */
.curio-article-footer {
	clear: both;
	margin-bottom: 5rem;
	font-family: var(--f-primary);
	color: var(--c-text);
}

.curio-article-footer > * {
	max-width: var(--block-max-width, min(100%, 42.5rem));
	margin-inline: auto;
}

@media (min-width: 64rem) {
	.curio-article-footer {
		margin-bottom: 8.125rem;
	}

	.curio-article-footer--with-sidebar > * {
		margin-right: 0;
	}
}

.curio-article-footer :where(p, li) a:not([class]) {
	color: var(--c-link);
	text-decoration: underline;
	text-decoration-thickness: 1px;
	text-underline-offset: 0.18em;
}

.curio-article-footer :where(p, li) a:not([class]):hover,
.curio-article-footer :where(p, li) a:not([class]):focus-visible {
	color: var(--c-link);
	text-decoration-thickness: 2px;
}

@media (prefers-reduced-motion: no-preference) {
	.curio-article-footer :where(p, li) a:not([class]) {
		transition: color 250ms ease-in-out;
	}
}

.curio-article-footer strong {
	font-weight: 700;
}

/* End-of-article headings (Citations; Related Content matches):
   one style. */
.curio-article-footer {
	--end-heading-gap: 1rem;
}

.curio-citations__heading {
	margin: 0 0 var(--end-heading-gap);
	font-family: var(--f-primary);
	font-size: 1.5rem;
	font-weight: 800;
	line-height: 1.2;
	color: var(--c-heading);
	text-wrap: balance;
}

@media (min-width: 64rem) {
	.curio-citations__heading {
		font-size: 1.625rem;
	}
}

/* Citations */
.curio-citations {
	margin-bottom: 3.125rem;
	font-size: 0.875rem;
	line-height: 1.4285714286;
}

.curio-citations p {
	margin: 0;
}

.curio-citations p + p {
	margin-top: 1rem;
}

/* Author bio */
.curio-author-bio {
	display: flex;
	padding: 1rem;
	background-color: var(--c-gray-light);
	color: var(--c-white);
}

.curio-author-bio:not(:last-child) {
	margin-bottom: 1rem;
}

.curio-author-bio__figure {
	flex: 0 0 5rem;
	margin: 0 var(--grid-gap) 0 0;
}

.curio-author-bio__photo {
	position: relative;
	display: block;
	width: 5rem;
	aspect-ratio: 1;
	overflow: hidden;
	border-radius: 50%;
	background-color: color-mix(in srgb, var(--c-white) 20%, transparent);
}

.curio-author-bio__photo img {
	position: absolute;
	inset: 0;
	width: 100%;
	height: 100%;
	object-fit: cover;
}

.curio-author-bio__content {
	flex: 1 1 auto;
	min-width: 0;
}

.curio-author-bio__heading {
	margin: 0 0 0.375rem;
	font-size: 1.125rem;
	font-weight: 700;
	line-height: 1.2222222222;
	color: var(--c-white);
}

.curio-author-bio__heading a {
	color: inherit;
	text-decoration: none;
}

.curio-author-bio__heading a:hover,
.curio-author-bio__heading a:focus-visible {
	text-decoration: underline;
}

.curio-author-bio__title {
	margin: -0.125rem 0 0.375rem;
	font-size: 0.75rem;
	font-weight: 700;
	line-height: 1.1666666667;
	letter-spacing: 0.075em;
	text-transform: uppercase;
}

.curio-author-bio__bio {
	font-size: 0.875rem;
	line-height: 1.2857142857;
}

.curio-author-bio__bio p {
	margin: 0;
}

.curio-author-bio__bio p + p {
	margin-top: 0.5rem;
}

.curio-author-bio__bio a {
	border-bottom: 1px solid;
	color: inherit;
	text-decoration: none;
}

@media print {
	.curio-author-bio {
		display: none;
	}
}

/*# sourceURL=https://biologyinsights.com/wp-content/themes/curio/blocks/article-footer/style.css */
</style>
<link rel='stylesheet' id='curio-rich-text-css' href='https://biologyinsights.com/wp-content/themes/curio/assets/css/rich-text.css?ver=1792200228' media='all' />
<style id="curio-article-body-style-2-inline-css">
/* Article body: text column (+ footer). */
.curio-article-body {
	--block-max-width: min(100%, 42.5rem);
	width: var(--content-max);
	margin: 0 auto;
	font-family: var(--f-primary);
	color: var(--c-text);
}

.curio-article-body__content {
	min-width: 0;
}

.curio-article-body__text {
	margin-bottom: var(--block-rhythm);
}

/* No article footer: keep the footer's bottom spacing. */
.curio-article-body__text:last-child {
	margin-bottom: 5rem;
}

@media (min-width: 64rem) {
	.curio-article-body__text:last-child {
		margin-bottom: 8.125rem;
	}
}

/* Password form. */
.curio-article-body__password .post-password-form {
	margin: 0 0 3.75rem;
}

.curio-article-body__password .post-password-form label {
	display: inline-flex;
	flex-wrap: wrap;
	align-items: center;
	gap: 0.5rem;
}

.curio-article-body__password input[type="password"] {
	box-sizing: border-box;
	max-width: 100%;
	height: 2.5rem;
	padding: 0 0.75rem;
	border: 1px solid var(--c-gray-mid);
	border-radius: 3px;
	font: inherit;
}

.curio-article-body__password input[type="submit"] {
	height: 2.5rem;
	margin-top: 0.5rem;
	padding: 0 1.25rem;
	border: 0;
	border-radius: var(--radius-button);
	background-color: var(--c-tag);
	color: var(--c-tag-text);
	font: 700 0.875rem/1 var(--f-primary);
	letter-spacing: 0.075em;
	text-transform: uppercase;
	cursor: pointer;
}

.curio-article-body__password input[type="submit"]:is(:hover, :focus-visible) {
	background-color: var(--c-navy);
	color: var(--c-white);
}

.curio-article-body__password input:focus-visible {
	outline: 2px solid var(--c-primary);
	outline-offset: 2px;
}

/*# sourceURL=https://biologyinsights.com/wp-content/themes/curio/blocks/article-body/style.css */
</style>
<style id="curio-related-content-style-inline-css">
/* Related Content: compact bulleted list of titles under the article (inside the text column). */

/* Doubled class: WordPress's flow-layout reset (:root :where(.is-layout-flow) > *) has the same weight and loads later. */
.curio-related.curio-related {
	margin: 0;
	padding: 1.375rem 0 3.125rem;
	border-top: 2px solid var(--c-text);
	font-family: var(--f-primary);
}

/* Same heading style as Citations (article-footer). */
.curio-related__heading {
	margin: 0 0 0.5rem;
	color: var(--c-heading);
	font-family: var(--f-primary);
	font-size: 1.5rem;
	font-weight: 800;
	line-height: 1.2;
	text-wrap: balance;
}

@media (min-width: 64rem) {
	.curio-related__heading {
		font-size: 1.625rem;
	}
}

.curio-related__list {
	margin: 0;
	padding: 0;
	list-style: none;
}

/* Square bullet + one flowing line: title, then category and date in small type. */
.curio-related__item {
	position: relative;
	padding: 0.5rem 0 0.5rem 1.0625rem;
	font-size: 1.0625rem;
	line-height: 1.4;
}

.curio-related__item::before {
	content: "";
	position: absolute;
	top: calc(0.5rem + 0.55em);
	left: 0;
	width: 0.4375rem;
	height: 0.4375rem;
	background-color: var(--c-tag);
}

.curio-related__title {
	color: var(--c-heading);
	font-weight: 600;
	text-decoration: none;
	text-wrap: pretty;
}

.curio-related__title:hover,
.curio-related__title:focus-visible {
	text-decoration: underline;
}

/* Phones: category and date on their own line under the title, so short and long
   titles line up the same way. Wider screens: on the same line as the title. */
.curio-related__meta {
	display: block;
	margin-top: 0.125rem;
	white-space: nowrap;
}

@media (min-width: 48rem) {
	.curio-related__meta {
		display: inline;
		margin-top: 0;
		margin-left: 0.25rem;
	}
}

/* Amber tag: size, box and colors come from the shared tag rule in base.css. */
.curio-related__topic {
	font-weight: 700;
	text-transform: uppercase;
}

a.curio-related__topic {
	position: relative;
}

.curio-related__sep {
	margin: 0 0.125rem;
	color: var(--c-rule);
	font-size: 0.75rem;
}

.curio-related__date {
	color: var(--c-text);
	font-size: 0.78125rem;
	font-variant-numeric: tabular-nums;
	opacity: 0.75;
}

/* "More in <subcategory> ›" link under the list. */
.curio-related__more {
	margin: 0.875rem 0 0;
	font-size: 1rem;
	line-height: 1.4;
}

.curio-related__more-link {
	display: inline-block;
	padding: 0.125rem 0;
	color: var(--c-link);
	font-weight: 700;
	text-decoration: none;
}

.curio-related__more-link:hover,
.curio-related__more-link:focus-visible {
	text-decoration: underline;
	text-underline-offset: 0.2em;
}

.curio-related__more-arrow {
	display: inline-block;
	margin-left: 0.3em;
	font-size: 1.125em;
	line-height: 1;
}

/* The article footer and the body text keep a large bottom gap for the page end.
   When this list follows, drop whatever ends the article to zero and let the
   list's top margin set the gap, so it is the same whatever comes last
   (body text, Citations or an author bio). */
.curio-single__article:has(.curio-related) :is(
	.curio-article-body__content > :last-child,
	.curio-article-footer > :last-child
) {
	margin-bottom: 0;
}

.curio-related.curio-related {
	margin-top: 2.5rem;
}

@media (min-width: 64rem) {
	.curio-related.curio-related {
		margin-top: 3.125rem;
	}
}

.curio-related--empty.curio-related--empty {
	padding: 1rem;
	border: 1px dashed var(--c-rule);
	font-size: 0.875rem;
}

@media print {
	.curio-related {
		display: none;
	}
}

/*# sourceURL=https://biologyinsights.com/wp-content/themes/curio/blocks/related-content/style.css */
</style>
<style id="wp-block-group-inline-css">
.wp-block-group{box-sizing:border-box}:where(.wp-block-group.wp-block-group-is-layout-constrained){position:relative}
/*# sourceURL=https://biologyinsights.com/wp-includes/blocks/group/style.min.css */
</style>
<style id="curio-ad-rail-style-inline-css">
/*
 * Ad sidebar: a fixed 300px column (never narrower) shown from 1024px up.
 * The sidebar is stretched to the article's height; the top slot sits beside
 * the headline and the sticky slot (its direct child) travels the rest of
 * the column. Anything a network appends to the sidebar follows the sticky
 * slot, near the top, and can stick for the full length too.
 */
.curio-ad-rail {
	display: none;
}

@media (min-width: 64rem) {
	.curio-ad-rail {
		/* Pinned (compact) header height (--curio-header-pinned-h, 57px by default)
		   + admin bar + a small gap, so sticky ads clear the header. */
		--curio-ad-sticky-top: calc(var(--wp-admin--admin-bar--height, 0px) + var(--curio-header-pinned-h, 3.5625rem) + 0.5rem);
		display: flex;
		flex-direction: column;
		width: 18.75rem;
		min-width: 18.75rem;
		max-width: 18.75rem;
	}

	.curio-ad-rail__slot {
		width: 100%;
		text-align: center;
	}

	/*
	 * Hold space for the top ad (300x250) when its code is saved in Curio
	 * Settings, so the column doesn't jump while it loads. With no saved code
	 * the slot is empty and takes no room, so a network (Mediavine Journey,
	 * Raptive) that fills #curio-sidebar itself starts at the top of the column.
	 * The sidebar is only rendered where ads are allowed.
	 */
	.curio-ad-rail__slot--top.is-filled {
		min-height: 15.625rem;
		margin-bottom: 2.5rem;
	}

	/* Nothing sits below the sticky slot, so it only reserves space for saved code. */
	.curio-ad-rail__slot--sticky {
		position: sticky;
		top: var(--curio-ad-sticky-top);
	}

	.curio-ad-rail__slot--sticky.is-filled {
		min-height: 15.625rem;
	}

	/* Ad code sometimes adds its own wrappers; keep them within the column. */
	.curio-ad-rail__slot > * {
		max-width: 100%;
		margin-inline: auto;
	}

	.curio-ad-rail__hint {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 15.625rem;
		border: 1px dashed var(--c-gray-mid);
		color: var(--c-gray-mid);
		font: 0.75rem/1.4 var(--f-primary);
	}
}

/*
 * Short laptop screens (a 1366x768 laptop shows about 657px): the sticky ad
 * pins right under the header so a 300x600 fits (57 + 600 = 657px). Its label
 * then slides under the header while pinned and shows again when unpinned.
 */
@media (min-width: 64rem) and (max-height: 47.5rem) {
	.curio-ad-rail {
		--curio-ad-sticky-top: calc(var(--wp-admin--admin-bar--height, 0px) + var(--curio-header-pinned-h, 3.5625rem));
	}
}

@media print {
	.curio-ad-rail {
		display: none !important;
	}
}

/*# sourceURL=https://biologyinsights.com/wp-content/themes/curio/blocks/ad-rail/style.css */
</style>
<style id="curio-site-footer-style-inline-css">
/* Site footer (dark). */
.curio-site-footer {
	padding: 2.125rem 0 1.75rem;
	background-color: var(--c-navy);
	color: var(--c-white);
	font-family: var(--f-primary);
	font-weight: 300;
}

.curio-site-footer a {
	color: var(--c-white);
}

.curio-site-footer a:focus-visible {
	outline-color: var(--c-white);
}

.curio-site-footer ul {
	list-style: none;
	margin: 0;
	padding: 0;
}

/* The footer ends with the copyright line: no closing rule or empty band below it. */
.curio-site-footer__container {
	width: var(--content-max);
	margin: 0 auto;
}

.curio-site-footer__branding {
	margin-bottom: 1.875rem;
}

.curio-site-footer__logo {
	display: block;
	width: max-content;
	max-width: 100%;
	margin-bottom: 0.9375rem;
	line-height: 0;
}

.curio-site-footer__logo:hover {
	text-decoration: none;
}

.curio-site-footer__logo .curio-logo--text {
	/* Placeholder wordmark: same box as the reference logo (width ≈ 10.43 × height). */
	width: 10.43em;
	max-width: 100%;
	font-size: 1.5rem;
	line-height: 1;
}

.curio-site-footer__logo img {
	width: auto;
	max-width: 100%;
	height: 1.5rem;
}

.curio-site-footer__description {
	margin-bottom: 1.875rem;
	font-size: 0.8125rem;
	line-height: 1.3846153846;
}

.curio-site-footer__description p:not(:last-child) {
	margin-bottom: 0.75rem;
}

.curio-site-footer__description a {
	border-bottom: 1px solid;
	text-decoration: none;
}

.curio-site-footer__sites {
	font-size: 1rem;
	line-height: 1.125;
}

.curio-site-footer__site:not(:last-child) {
	margin-bottom: 0.625rem;
}

.curio-site-footer__info {
	font-size: 0.75rem;
	line-height: 1.5;
}

.curio-site-footer__menus {
	margin-bottom: 1.875rem;
}

.curio-site-footer__nav:not(:last-of-type) {
	margin-bottom: 1.25rem;
}

.curio-site-footer__heading {
	margin-bottom: 0.625rem;
	color: inherit;
	font-family: var(--f-primary);
	font-size: 0.75rem;
	font-weight: 700;
	line-height: 1.5;
	letter-spacing: 0.075em;
	text-transform: uppercase;
}

.curio-site-footer__menu {
	font-size: 0.8125rem;
	line-height: 1.3846153846;
}

.curio-site-footer__menu-item {
	margin-bottom: 0.5rem;
}

.curio-site-footer__menu + .curio-site-footer__social {
	margin-top: 1.25rem;
}

.curio-site-footer__social {
	display: flex;
	flex-wrap: wrap;
}

.curio-site-footer__social-item:not(:last-child) {
	margin-right: 1rem;
}

.curio-site-footer__social-link {
	display: block;
}

.curio-site-footer__social-link .curio-icon {
	display: block;
	width: 1.25rem;
	height: 1.25rem;
}

.curio-site-footer__social-link:hover,
.curio-site-footer__social-link:focus-visible {
	opacity: 0.8;
}

.curio-site-footer__legal {
	font-size: 0.75rem;
	line-height: 1.5;
	text-align: right;
}

.curio-site-footer__address {
	display: inline;
	font-style: normal;
}

.curio-site-footer__phone {
	display: block;
}

.curio-site-footer__page + .curio-site-footer__page::before {
	content: "|";
	display: inline-block;
	margin: 0 0.375rem;
	text-decoration: none;
}

@media (min-width: 64rem) {
	.curio-site-footer__content {
		display: flex;
		justify-content: space-between;
		margin-bottom: 1.25rem;
	}

	.curio-site-footer__branding {
		flex-shrink: 0;
		width: calc(var(--col-w) * 6 + var(--grid-gap) * 5);
		margin-bottom: 0;
	}

	.curio-site-footer__logo .curio-logo--text {
		font-size: 2.125rem;
	}

	.curio-site-footer__logo img {
		height: 2.125rem;
	}

	.curio-site-footer__description {
		width: calc(var(--col-w) * 5 + var(--grid-gap) * 4);
	}

	.curio-site-footer__info {
		padding-top: 0.75rem;
	}

	.curio-site-footer__menus {
		display: flex;
		justify-content: flex-end;
		width: calc(var(--col-w) * 6 + var(--grid-gap) * 5);
		margin-bottom: 0;
		margin-left: auto;
	}

	.curio-site-footer__nav {
		width: calc(var(--col-w) * 2 + var(--grid-gap));
	}

	.curio-site-footer__nav:not(:last-of-type) {
		margin-bottom: 0;
		margin-right: 3.125rem;
	}

	.curio-site-footer__social-link .curio-icon {
		margin-bottom: 0.625rem;
	}

	.curio-site-footer__phone {
		display: inline;
	}

	.curio-site-footer__phone.has-sep::before,
	.curio-site-footer__page.has-sep::before {
		content: "|";
		display: inline-block;
		margin: 0 0.375rem;
	}
}

@media (min-width: 80rem) {
	.curio-site-footer__description {
		width: calc(var(--col-w) * 4 + var(--grid-gap) * 3);
	}

	.curio-site-footer__sites {
		display: flex;
	}

	.curio-site-footer__site:not(:last-child) {
		margin-bottom: 0;
		margin-right: 1.75rem;
	}

	.curio-site-footer__menus {
		width: calc(var(--col-w) * 5 + var(--grid-gap) * 4);
	}
}

/* Centered layout: logo, description, one row of links, social icons, legal line. */
.curio-site-footer--centered .curio-site-footer__center {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 1rem;
	margin-bottom: 1.75rem;
	text-align: center;
}

.curio-site-footer--centered .curio-site-footer__logo {
	margin: 0;
}

.curio-site-footer--centered .curio-site-footer__logo .curio-logo--text {
	width: auto;
}

.curio-site-footer--centered .curio-site-footer__description {
	max-width: 32rem;
	margin: 0;
}

.curio-site-footer--centered .curio-site-footer__sites {
	display: flex;
	flex-wrap: wrap;
	justify-content: center;
	gap: 0.5rem 1.75rem;
}

.curio-site-footer--centered .curio-site-footer__site:not(:last-child) {
	margin: 0;
}

.curio-site-footer__row {
	display: flex;
	flex-wrap: wrap;
	justify-content: center;
	gap: 0.625rem 1.5rem;
	font-size: 0.875rem;
	font-weight: 600;
	line-height: 1.4;
}

.curio-site-footer__row a {
	text-decoration: none;
}

.curio-site-footer__row a:hover,
.curio-site-footer__row a:focus-visible {
	text-decoration: underline;
}

.curio-site-footer--centered .curio-site-footer__social {
	justify-content: center;
}

.curio-site-footer--centered .curio-site-footer__social-link .curio-icon {
	margin-bottom: 0;
}

.curio-site-footer--centered .curio-site-footer__legal {
	text-align: center;
}

@media (min-width: 64rem) {
	.curio-site-footer--centered .curio-site-footer__logo .curio-logo--text {
		font-size: 2.125rem;
	}

	.curio-site-footer--centered .curio-site-footer__logo img {
		height: 2.125rem;
	}

	.curio-site-footer--centered .curio-site-footer__description {
		width: auto;
	}
}

@media print {
	.curio-site-footer {
		display: none;
	}
}

/* Drawn wordmark: its own width, never the 10.43em placeholder box. */
.curio-logo.curio-logo--svg.curio-logo--svg {
	width: auto;
}


/*# sourceURL=https://biologyinsights.com/wp-content/themes/curio/blocks/site-footer/style.css */
</style>
