/* Consent controls only: isolate from theme button/block spacing. */
#cc--main { --cc-bg:#fff; --cc-text:#263746; --cc-btn-primary-bg:#0a5b94; --cc-btn-primary-text:#fff; --cc-btn-primary-hover-bg:#012d3e; --cc-btn-primary-hover-text:#fff; --cc-btn-secondary-bg:#edf3f7; --cc-btn-secondary-text:#263746; --cc-btn-secondary-hover-bg:#dce8f0; --cc-btn-secondary-hover-text:#263746; --cc-toggle-bg-on:#0a5b94; --cc-toggle-bg-readonly:#cad8e1; }
#cc--main #cm { width:440px!important; max-width:calc(100vw - 32px)!important; left:auto!important; right:16px!important; bottom:16px!important; padding:24px!important; border-radius:12px!important; box-shadow:0 5px 30px rgba(0,0,0,.18)!important; font:16px/1.5 Arial,sans-serif!important; }
#cc--main #c-inr,#cc--main #c-inr-i { width:auto!important; max-width:none!important; margin:0!important; padding:0!important; }
#cc--main #c-ttl { margin:0 0 10px!important; font-size:18px!important; line-height:1.35!important; font-weight:700!important; }
#cc--main #c-txt { font-size:14px!important; line-height:1.6!important; }
#cc--main button,#cc--main .has-background { margin:0!important; margin-block:0!important; text-transform:none!important; letter-spacing:normal!important; min-height:0!important; }
#cc--main #c-bns { display:flex!important; flex-wrap:wrap!important; gap:10px!important; margin:18px 0 0!important; padding:0!important; }
#cc--main #c-bns .c-bn { flex:1 1 120px!important; width:auto!important; padding:12px 16px!important; border-radius:6px!important; text-align:center!important; font:600 14px/1.4 Arial,sans-serif!important; }
#cc--main button.cc-link { display:inline!important; background:transparent!important; color:var(--cc-btn-primary-bg)!important; padding:0!important; border:0!important; border-bottom:1px solid currentColor!important; border-radius:0!important; font:600 14px/1.6 Arial,sans-serif!important; height:auto!important; box-shadow:none!important; }
#cc--main #s-inr { font-family:Arial,sans-serif!important; }
@media(max-width:480px) { #cc--main #cm { right:12px!important; bottom:12px!important; max-width:calc(100vw - 24px)!important; padding:20px!important; max-height:calc(100dvh - 24px)!important; overflow-y:auto!important; } }

</style>
