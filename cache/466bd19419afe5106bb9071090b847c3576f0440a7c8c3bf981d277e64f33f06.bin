comingUrl":"/pregnancy/your-life/what-should-i-do-if-im-in-a-car-accident-while-im-pregnant_7235","artifactType":"Article","artifactId":7235,"legacyRedirectId":null,"urlType":"Custom","targetUrl":null,"whereToGoNext":{"relativeUrl":"/pregnancy/your-life/what-should-i-do-if-im-in-a-car-accident-while-im-pregnant_7235","mayHavePersonalization":true,"contentPages":[{"id":40009240,"pageType":"Article","title":"14 raw and captivating photos of postpartum women","brandedContentSponsor":"","imgUrlThumb":"https://assets.babycenter.com/ims/2022/02/Ericalophotography-postpartum_4x3.jpg","imgAltText":"postpartum woman holding twin newborns to breast","expertPage":{"title":"Kelly Bailey","__typename":"ContentPageData"},"expertName":{"namePrefix":"","nameSuffix":"","__typename":"PersonPageData"},"medicalReviewerPage":null,"medicalReviewerName":null,"factCheckerPage":null,"factCheckerName":null,"urlMappings":[{"incomingUrl":"/pregnancy/hear-from-moms/14-raw-and-captivating-photos-of-postpartum-women_40009240","__typename":"UrlMapping"}],"contentPageFiling":[{"title":"Pregnancy","__typename":"ContentPageFiling"},{"title":"Hear From Pregnant Moms","__typename":"ContentPageFiling"},{"title":"Labor \u0026 Delivery Stories ","__typename":"ContentPageFiling"},{"title":"14 raw and captivating photos of postpartum women","__typename":"ContentPageFiling"}],"__typename":"ContentPageData"},{"id":40008432,"pageType":"SlideShow","title":"Best baby hats","brandedContentSponsor":"","imgUrlThumb":"https://assets.babycenter.com/ims/2023/03/best-baby-hats-mar2023_4x3.jpg","imgAltText":"Best baby hats","expertPage":{"title":"Maria Masters","__typename":"ContentPageData"},"expertName":{"namePrefix":null,"nameSuffix":null,"__typename":"PersonPageData"},"medicalReviewerPage":null,"medicalReviewerName":null,"factCheckerPage":{"title":"Joyce Slaton","__typename":"ContentPageData"},"factCheckerName":{"namePrefix":"","nameSuffix":"","expertise":"Commerce editor and CPST","__typename":"PersonPageData"},"urlMappings":[{"incomingUrl":"/baby-products/clothes-and-shoes/best-baby-hats_40008432","__typename":"UrlMapping"}],"contentPageFiling":[{"title":"Baby Products","__typename":"ContentPageFiling"},{"title":"Clothes \u0026 Shoes","__typename":"ContentPageFiling"},{"title":"Boy \u0026 Girl Clothes","__typename":"ContentPageFiling"},{"title":"Best baby hats","__typename":"ContentPageFiling"}],"__typename":"ContentPageData"},{"id":20000455,"pageType":"Video","title":"How to wear your hair during labor","brandedContentSponsor":"","imgUrlThumb":"https://assets.babycenter.com/ims/2017/12/US_how-to-wear-your-hair-during-labor_video-still_4x3.jpg","imgAltText":"A woman with dark curly hair wearing a purple tank top is braiding her hair, shown from behind against a plain light background.","expertPage":null,"expertName":null,"medicalReviewerPage":null,"medicalReviewerName":null,"factCheckerPage":null,"factCheckerName":null,"urlMappings":[{"incomingUrl":"/pregnancy/your-body/how-to-wear-your-hair-during-labor_20000455","__typename":"UrlMapping"}],"contentPageFiling":[{"title":"Pregnancy","__typename":"ContentPageFiling"},{"title":"Your Body","__typename":"ContentPageFiling"},{"title":"Labor \u0026 Delivery","__typename":"ContentPageFiling"},{"title":"How to wear your hair during labor","__typename":"ContentPageFiling"}],"__typename":"ContentPageData"},{"id":41002250,"pageType":"Article","title":"Pregnant with quadruplets? Here's what to know","brandedContentSponsor":"","imgUrlThumb":"https://assets.babycenter.com/ims/2026/11/pregnant-with-quadruplets_4x3.webp","imgAltText":"Four yellow-handled pacifiers arranged in a row against a light blue background.","expertPage":{"title":"Colleen de Bellefonds","__typename":"ContentPageData"},"expertName":{"namePrefix":null,"nameSuffix":null,"__typename":"PersonPageData"},"medicalReviewerPage":{"title":"Layan Alrahmani","__typename":"ContentPageData"},"medicalReviewerName":{"namePrefix":"","nameSuffix":"M.D.","expertise":"ob-gyn, MFM","__typename":"PersonPageData"},"factCheckerPage":null,"factCheckerName":null,"urlMappings":[{"incomingUrl":"/pregnancy/your-baby/quadruplets_41002250","__typename":"UrlMapping"}],"contentPageFiling":[{"title":"Pregnancy","__typename":"ContentPageFiling"},{"title":"Your Baby","__typename":"ContentPageFiling"},{"title":"Twins \u0026 More","__typename":"ContentPageFiling"},{"title":"Pregnant with quadruplets? Here's what to know","__typename":"ContentPageFiling"}],"__typename":"ContentPageData"},{"id":7239,"pageType":"Article","title":"Pregnant and buckling up: The safest way to wear your seatbelt","brandedContentSponsor":"","imgUrlThumb":"https://assets.babycenter.com/ims/2017/07/Rain-Web-Res-037_4x3.jpg","imgAltText":"Pregnant woman smiling as she fastens her seatbelt inside a parked car.","expertPage":{"title":"Rebekah Wahlberg","__typename":"ContentPageData"},"expertName":{"namePrefix":"","nameSuffix":"","__typename":"PersonPageData"},"medicalReviewerPage":{"title":"Cheryl Axelrod","__typename":"ContentPageData"},"medicalReviewerName":{"namePrefix":"","nameSuffix":"M.D.","expertise":"ob-gyn","__typename":"PersonPageData"},"factCheckerPage":null,"factCheckerName":null,"urlMappings":[{"incomingUrl":"/pregnancy/health-and-safety/is-it-safe-to-use-a-seat-belt-during-pregnancy_7239","__typename":"UrlMapping"}],"contentPageFiling":[{"title":"Pregnancy","__typename":"ContentPageFiling"},{"title":"Health \u0026 Safety","__typename":"ContentPageFiling"},{"title":"Pregnancy Health","__typename":"ContentPageFiling"},{"title":"Pregnant and buckling up: The safest way to wear your seatbelt","__typename":"ContentPageFiling"}],"__typename":"ContentPageData"},{"id":7877,"pageType":"Article","title":"Can you run while pregnant?","brandedContentSponsor":"","imgUrlThumb":"https://assets.babycenter.com/ims/2024/03/iStock-1327666772_4x3.jpg","imgAltText":"Pregnant woman jogging on a wooden path","expertPage":{"title":"Kandis Lake","__typename":"ContentPageData"},"expertName":{"namePrefix":null,"nameSuffix":"R.N.","__typename":"PersonPageData"},"medicalReviewerPage":{"title":"Catherine Cram","__typename":"ContentPageData"},"medicalReviewerName":{"namePrefix":"","nameSuffix":"M.S.","expertise":"exercise physiologist","__typename":"PersonPageData"},"factCheckerPage":null,"factCheckerName":null,"urlMappings":[{"incomingUrl":"/pregnancy/diet-and-fitness/can-you-run-while-pregnant_7877","__typename":"UrlMapping"}],"contentPageFiling":[{"title":"Pregnancy","__typename":"ContentPageFiling"},{"title":"Diet \u0026 Fitness","__typename":"ContentPageFiling"},{"title":"Fitness","__typename":"ContentPageFiling"},{"title":"Can you run while pregnant?","__typename":"ContentPageFiling"}],"__typename":"ContentPageData"},{"id":6832,"pageType":"Article","title":"When can we start taking our child to the movies?","brandedContentSponsor":"","imgUrlThumb":"https://assets.babycenter.com/ims/2016/07/iStock_52174564_4x3.jpg","imgAltText":"mother and father with boy and girl sitting in the movies","expertPage":{"title":"Susanne Ayers Denham","__typename":"ContentPageData"},"expertName":{"namePrefix":null,"nameSuffix":"Ph.D.","__typename":"PersonPageData"},"medicalReviewerPage":null,"medicalReviewerName":null,"factCheckerPage":null,"factCheckerName":null,"urlMappings":[{"incomingUrl":"/toddler/playtime/when-can-we-start-taking-our-child-to-the-movies_6832","__typename":"UrlMapping"}],"contentPageFiling":[{"title":"Toddler","__typename":"ContentPageFiling"},{"title":"Playtime","__typename":"ContentPageFiling"},{"title":"Games, Playdates \u0026 Entertainment","__typename":"ContentPageFiling"},{"title":"When can we start taking our child to the movies?","__typename":"ContentPageFiling"}],"__typename":"ContentPageData"},{"id":1425791,"pageType":"Article","title":"Placental abruption","brandedContentSponsor":"","imgUrlThumb":"https://assets.babycenter.com/ims/2020/04/PLACENTA-ABRUPTION-FINAL-with-text-updated_4x3.jpg","imgAltText":"Illustration showing placenta detached from uterus causing blood clot and external bleeding during pregnancy.","expertPage":{"title":"Kate Marple","__typename":"ContentPageData"},"expertName":{"namePrefix":null,"nameSuffix":null,"__typename":"PersonPageData"},"medicalReviewerPage":{"title":"Layan Alrahmani","__typename":"ContentPageData"},"medicalReviewerName":{"namePrefix":"","nameSuffix":"M.D.","expertise":"ob-gyn, MFM","__typename":"PersonPageData"},"factCheckerPage":null,"factCheckerName":null,"urlMappings":[{"incomingUrl":"/pregnancy/health-and-safety/placental-abruption_1425791","__typename":"UrlMapping"}],"contentPageFiling":[{"title":"Pregnancy","__typename":"ContentPageFiling"},{"title":"Health \u0026 Safety","__typename":"ContentPageFiling"},{"title":"Complications","__typename":"ContentPageFiling"},{"title":"Placental abruption","__typename":"ContentPageFiling"}],"__typename":"ContentPageData"},{"id":40009318,"pageType":"Article","title":"13 of the most precious photos of multiples","brandedContentSponsor":"","imgUrlThumb":"https://assets.babycenter.com/ims/2022/03/raisingouryoungs-multiples_4x3.jpg","imgAltText":"mom with quadruplets","expertPage":{"title":"Kelly Bailey","__typename":"ContentPageData"},"expertName":{"namePrefix":"","nameSuffix":"","__typename":"PersonPageData"},"medicalReviewerPage":null,"medicalReviewerName":null,"factCheckerPage":null,"factCheckerName":null,"urlMappings":[{"incomingUrl":"/pregnancy/hear-from-moms/13-of-the-most-precious-photos-of-multiples_40009318","__typename":"UrlMapping"}],"contentPageFiling":[{"title":"Pregnancy","__typename":"ContentPageFiling"},{"title":"Hear From Pregnant Moms","__typename":"ContentPageFiling"},{"title":"Labor \u0026 Delivery Stories ","__typename":"ContentPageFiling"},{"title":"13 of the most precious photos of multiples","__typename":"ContentPageFiling"}],"__typename":"ContentPageData"},{"id":40007984,"pageType":"Article","title":"What to know about PPROM, PROM, and what's about to happen next","brandedContentSponsor":"","imgUrlThumb":"https://assets.babycenter.com/ims/2025/12/Stocksy_txp0db6d20bvcD400_Medium_683307_4x3.jpg","imgAltText":"Colorful, iridescent soap bubbles with swirling pastel hues and shimmering surface.","expertPage":{"title":"Maggie Panos","__typename":"ContentPageData"},"expertName":{"namePrefix":"","nameSuffix":"","__typename":"PersonPageData"},"medicalReviewerPage":{"title":"Layan Alrahmani","__typename":"ContentPageData"},"medicalReviewerName":{"namePrefix":"","nameSuffix":"M.D.","expertise":"ob-gyn, MFM","__typename":"PersonPageData"},"factCheckerPage":null,"factCheckerName":null,"urlMappings":[{"incomingUrl":"/pregnancy/health-and-safety/leaking-amniotic-fluid-premature-rupture-of-membranes_40007984","__typename":"UrlMapping"}],"contentPageFiling":[{"title":"Pregnancy","__typename":"ContentPageFiling"},{"title":"Health \u0026 Safety","__typename":"ContentPageFiling"},{"title":"Complications","__typename":"ContentPageFiling"},{"title":"What to know about PPROM, PROM, and what's about to happen next","__typename":"ContentPageFiling"}],"__typename":"ContentPageData"},{"id":40009498,"pageType":"Article","title":"12 of the sweetest photos of siblings attending birth","brandedContentSponsor":"","imgUrlThumb":"https://assets.babycenter.com/ims/2022/02/jennavanloon.doulatog-siblings_4x3.jpg","imgAltText":"family reunion in maternity ward","expertPage":{"title":"Kelly Bailey","__typename":"ContentPageData"},"expertName":{"namePrefix":"","nameSuffix":"","__typename":"PersonPageData"},"medicalReviewerPage":null,"medicalReviewerName":null,"factCheckerPage":null,"factCheckerName":null,"urlMappings":[{"incomingUrl":"/pregnancy/hear-from-moms/12-of-the-sweetest-photos-of-siblings-attending-birth_40009498","__typename":"UrlMapping"}],"contentPageFiling":[{"title":"Pregnancy","__typename":"ContentPageFiling"},{"title":"Hear From Pregnant Moms","__typename":"ContentPageFiling"},{"title":"Labor \u0026 Delivery Stories ","__typename":"ContentPageFiling"},{"title":"12 of the sweetest photos of siblings attending birth","__typename":"ContentPageFiling"}],"__typename":"ContentPageData"},{"id":40009138,"pageType":"Article","title":"12 of the most beautiful home birth photos","brandedContentSponsor":"","imgUrlThumb":"https://assets.babycenter.com/ims/2022/01/saltcitybirthandnewborn-homebirth_4x3.jpg","imgAltText":"mom in bathtub holding her newborn baby","expertPage":{"title":"Kelly Bailey","__typename":"ContentPageData"},"expertName":{"namePrefix":"","nameSuffix":"","__typename":"PersonPageData"},"medicalReviewerPage":null,"medicalReviewerName":null,"factCheckerPage":null,"factCheckerName":null,"urlMappings":[{"incomingUrl":"/pregnancy/hear-from-moms/12-of-the-most-beautiful-home-birth-photos_40009138","__typename":"UrlMapping"}],"contentPageFiling":[{"title":"Pregnancy","__typename":"ContentPageFiling"},{"title":"Hear From Pregnant Moms","__typename":"ContentPageFiling"},{"title":"Labor \u0026 Delivery Stories ","__typename":"ContentPageFiling"},{"title":"12 of the most beautiful home birth photos","__typename":"ContentPageFiling"}],"__typename":"ContentPageData"}],"__typename":"WhereToGoNextPayload"},"__typename":"UrlMappingQueryResponse"},"pageContent":{"type":"Article","active":true,"props":{"artifact":{"article":{"id":7235,"type":"ExpertQuestion","__typename":"ArticleData"},"contentPage":{"id":7235,"bodyDisplay":"\u003cp\u003eYou're moving along the main street, minding your own business when suddenly \u0026ndash; bam! You get hit from behind. It's jarring when you're \u003cem\u003enot\u003c/em\u003e pregnant, but when you're expecting, the anxiety is even worse.\u003c/p\u003e \u003cp\u003eAny time you're in a car accident while you're pregnant \u0026ndash; whether it's a minor fender-bender or a more serious collision \u0026ndash; it's best to be examined by a healthcare provider as soon as possible, no matter how far along you are in your pregnancy.\u003c/p\u003e\u003cdiv data-transform=\"advertisement\" data-mobile-type=\"medrec\" data-desktop-type=\"connatix\"\u003e \u003c/div\u003e \u003cdiv class=\"takeaways\"\u003e \u003ch3\u003eKey Takeaways\u003c/h3\u003e \u003cul\u003e \u003cli\u003eAfter an accident, evaluate how you're feeling. If you're concerned at all about your health, have someone drive you straight to the ER or call an ambulance.\u003c/li\u003e \u003cli\u003eIf you feel alright, still call your healthcare provider, explain the situation, and follow their advice.\u003c/li\u003e \u003c/ul\u003e \u003c/div\u003e \u003ch2 id=\"what-to-do-immediately-after-a-car-accident\"\u003eWhat to do immediately after a car accident\u003c/h2\u003e \u003cp\u003eTake a second to breathe, reassure yourself that you're okay, and evaluate how you're feeling. If you have any concerns about your body, your pregnancy, or you feel like you or your baby may be injured or in distress, go straight to the ER. Call 911 or have your partner or someone else take you there.\u003c/p\u003e \u003cp\u003e\"The first concern of emergency medical personnel is the well-being of the pregnant woman,\" says \u003ca href=\"/expert-rebecca-amaru\"\u003eDr. Rebecca Amaru\u003c/a\u003e, a New York-based ob-gyn. \"Her life is not more valuable because she is pregnant, and her first concern can and should be her own health. What that means is that when she is in an accident, the ABCs [Airway, Breathing, and Circulation] of EMS care should focus on her, not her pregnancy.\"\u003c/p\u003e \u003cp\u003eEven if you feel fine, it's still best to call your healthcare provider as soon as possible to describe your accident, discuss any symptoms you're having, and talk about potential next steps. They may direct you to the ER or their offices to be checked out.\u003c/p\u003e \u003cp\u003e\"I was in a car accident at 27 weeks,\" shares one mom in the \u003ca href=\"https://community.babycenter.com/\"\u003eBabyCenter Community\u003c/a\u003e. \"In that case, I had to go in for monitoring and even still everything was fine.\"\u003c/p\u003e\u003cdiv data-transform=\"advertisement\" data-mobile-type=\"connatix\" data-desktop-type=\"native\"\u003e \u003c/div\u003e\u003cdiv data-transform=\"embeddedRegPromo\"\u003e \u003c/div\u003e \u003ch2 id=\"what-can-happen-if-im-in-a-car-accident-while-pregnant\"\u003eWhat can happen if I'm in a car accident while pregnant?\u003c/h2\u003e \u003cp\u003eWith car accidents or any kind of jarring impact while you're pregnant, the main cause for concern is \u003ca href=\"/pregnancy/health-and-safety/placental-abruption_1425791\"\u003eplacental abruption\u003c/a\u003e, when the placenta separates from the inner wall of your uterus before delivery. The womb offers some protection for your baby and placenta during a sudden impact, such as slamming on the brakes; but even if the jolt didn't feel that severe, it can still potentially separate the placenta from the uterus.\u003c/p\u003e \u003cp\u003ePlacental abruption is rare in any case except a serious accident, but it's important to rule out because it can lead to serious problems including \u003ca href=\"/pregnancy/health-and-safety/subchorionic-bleeding-during-pregnancy_40005840\"\u003ehemorrhage\u003c/a\u003e, \u003ca href=\"/pregnancy/health-and-safety/miscarriage-signs-causes-and-treatment_252\"\u003emiscarriage\u003c/a\u003e, or \u003ca href=\"/pregnancy/health-and-safety/preterm-labor-and-birth_1055\"\u003epremature labor\u003c/a\u003e. Yet even with an abruption, you may not notice any symptoms. That's why it's important to have an exam to verify that you're okay and your baby is, too.\u003c/p\u003e \u003cp\u003e\"I got into an accident where someone hit me from behind,\" shares another mom in the Community. \"It wasn't bad at all, but my husband said I should go anyway because you just never know. I'm not trying to scare [anyone], but I had a small rupture in my placenta which caused me to bleed\u0026hellip; When it came time for labor, I bled very heavily, which was really scary. Always get checked after getting into an accident.\"\u003c/p\u003e\u003cdiv data-transform=\"advertisement\" data-mobile-type=\"native\" data-desktop-type=\"medrec\"\u003e \u003c/div\u003e \u003cp\u003eOnce you\u0026rsquo;re home, it's normal to feel extra alert to every twinge. The \u003ca href=\"https://babycenter.onelink.me/nZLz/e9beyzbt\"\u003eBabyCenter app\u003c/a\u003e can help you keep track of symptoms, monitor your baby\u0026rsquo;s movements, and get clear, medically reviewed guidance on what deserves a call to your provider. Peace of mind matters \u0026ndash; especially after something scary.\u003c/p\u003e \u003ch2 id=\"what-will-happen-at-the-hospital-after-a-car-accident\"\u003eWhat will happen at the hospital after a car accident?\u003c/h2\u003e \u003cp\u003eIn the ER, you'll be checked out and, once your overall condition is stable, you'll receive a thorough obstetric exam and ultrasound to check on your baby and placenta. Depending on how far along you are and any symptoms you have, such as bleeding or contractions, you and your baby may be monitored for several hours or more. If you're\u0026nbsp;\u003ca href=\"/pregnancy/health-and-safety/rh-factor_1480\"\u003eRh-negative\u003c/a\u003e, you may get a shot of Rh immunoglobulin if there's any chance that your blood has mixed with your baby's.\u003c/p\u003e \u003cp\u003e\"If there is direct abdominal contact, i.e. with a seatbelt, 24 hours of monitoring in the hospital is likely in the second and third trimesters,\" Dr. Amaru says.\u003c/p\u003e \u003cp\u003eAfter you receive the okay to go home, you'll need to keep an eye out for \u003ca href=\"/pregnancy/your-body/vaginal-bleeding-or-spotting-during-pregnancy_3081\"\u003evaginal bleeding\u003c/a\u003e, \u003ca href=\"/pregnancy/health-and-safety/leaking-amniotic-fluid-premature-rupture-of-membranes_40007984\"\u003eleaking fluid\u003c/a\u003e, contractions or other \u003ca href=\"/pregnancy/your-body/cramps-during-pregnancy_204\"\u003ecramping or abdominal pain\u003c/a\u003e, or a change in your baby's movement. If you experience any of these symptoms, call your healthcare provider right away.\u003c/p\u003e \u003cp\u003eThis can be an emotionally difficult and scary time, so it\u0026rsquo;s important to take care of your mental health after an accident, too, by reaching out to trusted family members, friends, or a counselor if you want to talk about how you're feeling.\u003c/p\u003e\u003cdiv data-transform=\"advertisement\" data-mobile-type=\"medrec\" data-desktop-type=\"medrec\"\u003e \u003c/div\u003e \u003ch2 id=\"safety-tips-for-driving-while-pregnant\"\u003eSafety tips for driving while pregnant\u003c/h2\u003e \u003cul\u003e \u003cli\u003e\u003cstrong\u003eAlways wear a properly fastened seat belt throughout pregnancy.\u003c/strong\u003e This means ensuring that a three-point seatbelt, complete with both the lap and shoulder straps, are in \u003ca href=\"/pregnancy/health-and-safety/is-it-safe-to-use-a-seat-belt-during-pregnancy_7239\"\u003ethe proper location\u003c/a\u003e. Don't wrap the lap belt above or in front of your belly.\u003c/li\u003e \u003cli\u003e\u003cstrong\u003eDon't text and drive.\u003c/strong\u003e While it may seem like sending a quick text is harmless, it\u0026rsquo;s easy to be distracted and not see an accident that could have been avoided. Other distracted driving that can lead to an accident includes eating, feeding a child or finding a toy for them, using your GPS, changing the music, and putting on makeup.\u003c/li\u003e \u003cli\u003e\u003cstrong\u003eMake sure your car's airbags work.\u003c/strong\u003e Try to keep 10 inches between the steering wheel and your breastbone. Consider angling the steering wheel, if it tilts, toward your breastbone rather than your belly or your head.\u003c/li\u003e \u003cli\u003e\u003cstrong\u003eKeep emergency contact information with you.\u003c/strong\u003e This can be something as simple as a card in your wallet that lets first responders know who to call if need be.\u003c/li\u003e \u003cli\u003e\u003cstrong\u003eConsider a pregnancy ID bracelet.\u003c/strong\u003e This should be engraved with your due date, your blood type, and any other medical information that would be crucial for an ER physician to know in case of an emergency.\u003c/li\u003e \u003c/ul\u003e \u003cp\u003eA car accident during pregnancy is scary \u0026ndash; even if it\u0026rsquo;s minor. Trust your instincts, get checked out, and remember: Taking care of yourself is the very best way to take care of your baby.\u003c/p\u003e","showAffiliateDisclaimer":false,"showRegistryModal":false,"summary":null,"imgAltText":"Pregnant woman wearing a seatbelt, focused, driving a car on a daytime road.","imgPhotoCredit":"iStock.com / SolStock","showRegGate":false,"regGateTitle":null,"regGateIntro":null,"active":true,"body":"\u003cp\u003eYou're moving along the main street, minding your own business when suddenly \u0026ndash; bam! You get hit from behind. It's jarring when you're \u003cem\u003enot\u003c/em\u003e pregnant, but when you're expecting, the anxiety is even worse.\u003c/p\u003e \u003cp\u003eAny time you're in a car accident while you're pregnant \u0026ndash; whether it's a minor fender-bender or a more serious collision \u0026ndash; it's best to be examined by a healthcare provider as soon as possible, no matter how far along you are in your pregnancy.\u003c/p\u003e\u003cdiv data-transform=\"advertisement\" data-mobile-type=\"medrec\" data-desktop-type=\"connatix\"\u003e \u003c/div\u003e \u003cdiv class=\"takeaways\"\u003e \u003ch3\u003eKey Takeaways\u003c/h3\u003e \u003cul\u003e \u003cli\u003eAfter an accident, evaluate how you're feeling. If you're concerned at all about your health, have someone drive you straight to the ER or call an ambulance.\u003c/li\u003e \u003cli\u003eIf you feel alright, still call your healthcare provider, explain the situation, and follow their advice.\u003c/li\u003e \u003c/ul\u003e \u003c/div\u003e \u003ch2 id=\"what-to-do-immediately-after-a-car-accident\"\u003eWhat to do immediately after a car accident\u003c/h2\u003e \u003cp\u003eTake a second to breathe, reassure yourself that you're okay, and evaluate how you're feeling. If you have any concerns about your body, your pregnancy, or you feel like you or your baby may be injured or in distress, go straight to the ER. Call 911 or have your partner or someone else take you there.\u003c/p\u003e \u003cp\u003e\"The first concern of emergency medical personnel is the well-being of the pregnant woman,\" says \u003ca href=\"/expert-rebecca-amaru\"\u003eDr. Rebecca Amaru\u003c/a\u003e, a New York-based ob-gyn. \"Her life is not more valuable because she is pregnant, and her first concern can and should be her own health. What that means is that when she is in an accident, the ABCs [Airway, Breathing, and Circulation] of EMS care should focus on her, not her pregnancy.\"\u003c/p\u003e \u003cp\u003eEven if you feel fine, it's still best to call your healthcare provider as soon as possible to describe your accident, discuss any symptoms you're having, and talk about potential next steps. They may direct you to the ER or their offices to be checked out.\u003c/p\u003e \u003cp\u003e\"I was in a car accident at 27 weeks,\" shares one mom in the \u003ca href=\"https://community.babycenter.com/\"\u003eBabyCenter Community\u003c/a\u003e. \"In that case, I had to go in for monitoring and even still everything was fine.\"\u003c/p\u003e\u003cdiv data-transform=\"advertisement\" data-mobile-type=\"connatix\" data-desktop-type=\"native\"\u003e \u003c/div\u003e\u003cdiv data-transform=\"embeddedRegPromo\"\u003e \u003c/div\u003e \u003ch2 id=\"what-can-happen-if-im-in-a-car-accident-while-pregnant\"\u003eWhat can happen if I'm in a car accident while pregnant?\u003c/h2\u003e \u003cp\u003eWith car accidents or any kind of jarring impact while you're pregnant, the main cause for concern is \u003ca href=\"/pregnancy/health-and-safety/placental-abruption_1425791\"\u003eplacental abruption\u003c/a\u003e, when the placenta separates from the inner wall of your uterus before delivery. The womb offers some protection for your baby and placenta during a sudden impact, such as slamming on the brakes; but even if the jolt didn't feel that severe, it can still potentially separate the placenta from the uterus.\u003c/p\u003e \u003cp\u003ePlacental abruption is rare in any case except a serious accident, but it's important to rule out because it can lead to serious problems including \u003ca href=\"/pregnancy/health-and-safety/subchorionic-bleeding-during-pregnancy_40005840\"\u003ehemorrhage\u003c/a\u003e, \u003ca href=\"/pregnancy/health-and-safety/miscarriage-signs-causes-and-treatment_252\"\u003emiscarriage\u003c/a\u003e, or \u003ca href=\"/pregnancy/health-and-safety/preterm-labor-and-birth_1055\"\u003epremature labor\u003c/a\u003e. Yet even with an abruption, you may not notice any symptoms. That's why it's important to have an exam to verify that you're okay and your baby is, too.\u003c/p\u003e \u003cp\u003e\"I got into an accident where someone hit me from behind,\" shares another mom in the Community. \"It wasn't bad at all, but my husband said I should go anyway because you just never know. I'm not trying to scare [anyone], but I had a small rupture in my placenta which caused me to bleed\u0026hellip; When it came time for labor, I bled very heavily, which was really scary. Always get checked after getting into an accident.\"\u003c/p\u003e\u003cdiv data-transform=\"advertisement\" data-mobile-type=\"native\" data-desktop-type=\"medrec\"\u003e \u003c/div\u003e \u003cp\u003eOnce you\u0026rsquo;re home, it's normal to feel extra alert to every twinge. The \u003ca href=\"https://babycenter.onelink.me/nZLz/e9beyzbt\"\u003eBabyCenter app\u003c/a\u003e can help you keep track of symptoms, monitor your baby\u0026rsquo;s movements, and get clear, medically reviewed guidance on what deserves a call to your provider. Peace of mind matters \u0026ndash; especially after something scary.\u003c/p\u003e \u003ch2 id=\"what-will-happen-at-the-hospital-after-a-car-accident\"\u003eWhat will happen at the hospital after a car accident?\u003c/h2\u003e \u003cp\u003eIn the ER, you'll be checked out and, once your overall condition is stable, you'll receive a thorough obstetric exam and ultrasound to check on your baby and placenta. Depending on how far along you are and any symptoms you have, such as bleeding or contractions, you and your baby may be monitored for several hours or more. If you're\u0026nbsp;\u003ca href=\"/pregnancy/health-and-safety/rh-factor_1480\"\u003eRh-negative\u003c/a\u003e, you may get a shot of Rh immunoglobulin if there's any chance that your blood has mixed with your baby's.\u003c/p\u003e \u003cp\u003e\"If there is direct abdominal contact, i.e. with a seatbelt, 24 hours of monitoring in the hospital is likely in the second and third trimesters,\" Dr. Amaru says.\u003c/p\u003e \u003cp\u003eAfter you receive the okay to go home, you'll need to keep an eye out for \u003ca href=\"/pregnancy/your-body/vaginal-bleeding-or-spotting-during-pregnancy_3081\"\u003evaginal bleeding\u003c/a\u003e, \u003ca href=\"/pregnancy/health-and-safety/leaking-amniotic-fluid-premature-rupture-of-membranes_40007984\"\u003eleaking fluid\u003c/a\u003e, contractions or other \u003ca href=\"/pregnancy/your-body/cramps-during-pregnancy_204\"\u003ecramping or abdominal pain\u003c/a\u003e, or a change in your baby's movement. If you experience any of these symptoms, call your healthcare provider right away.\u003c/p\u003e \u003cp\u003eThis can be an emotionally difficult and scary time, so it\u0026rsquo;s important to take care of your mental health after an accident, too, by reaching out to trusted family members, friends, or a counselor if you want to talk about how you're feeling.\u003c/p\u003e\u003cdiv data-transform=\"advertisement\" data-mobile-type=\"medrec\" data-desktop-type=\"medrec\"\u003e \u003c/div\u003e \u003ch2 id=\"safety-tips-for-driving-while-pregnant\"\u003eSafety tips for driving while pregnant\u003c/h2\u003e \u003cul\u003e \u003cli\u003e\u003cstrong\u003eAlways wear a properly fastened seat belt throughout pregnancy.\u003c/strong\u003e This means ensuring that a three-point seatbelt, complete with both the lap and shoulder straps, are in \u003ca href=\"/pregnancy/health-and-safety/is-it-safe-to-use-a-seat-belt-during-pregnancy_7239\"\u003ethe proper location\u003c/a\u003e. Don't wrap the lap belt above or in front of your belly.\u003c/li\u003e \u003cli\u003e\u003cstrong\u003eDon't text and drive.\u003c/strong\u003e While it may seem like sending a quick text is harmless, it\u0026rsquo;s easy to be distracted and not see an accident that could have been avoided. Other distracted driving that can lead to an accident includes eating, feeding a child or finding a toy for them, using your GPS, changing the music, and putting on makeup.\u003c/li\u003e \u003cli\u003e\u003cstrong\u003eMake sure your car's airbags work.\u003c/strong\u003e Try to keep 10 inches between the steering wheel and your breastbone. Consider angling the steering wheel, if it tilts, toward your breastbone rather than your belly or your head.\u003c/li\u003e \u003cli\u003e\u003cstrong\u003eKeep emergency contact information with you.\u003c/strong\u003e This can be something as simple as a card in your wallet that lets first responders know who to call if need be.\u003c/li\u003e \u003cli\u003e\u003cstrong\u003eConsider a pregnancy ID bracelet.\u003c/strong\u003e This should be engraved with your due date, your blood type, and any other medical information that would be crucial for an ER physician to know in case of an emergency.\u003c/li\u003e \u003c/ul\u003e \u003cp\u003eA car accident during pregnancy is scary \u0026ndash; even if it\u0026rsquo;s minor. Trust your instincts, get checked out, and remember: Taking care of yourself is the very best way to take care of your baby.\u003c/p\u003e","noIndex":false,"seoCanonicalUrlMetatag":"","seoDescription":"","seoTitle":"What to do if you're in a car accident (even a minor one) while pregnant","teaser":"First things first: The most important thing is making sure you're okay.","title":"What to do if you're in a car accident (even a minor one) while pregnant","imgUrlMain":"https://assets.babycenter.com/ims/2020/04/iStock-680677544_wide.jpg","imgUrlThumb":"https://assets.babycenter.com/ims/2020/04/iStock-680677544_4x3.jpg","sourcesPublic":"\u003cp\u003eNational Institutes of Health, National Library of Medicine, \u003cem\u003eActa Obstetricia et Gynecologica Scandinavica\u003c/em\u003e, \u003ca href=\"https://pubmed.ncbi.nlm.nih.gov/9174423/\" target=\"_blank\" rel=\"noopener\"\u003eMotor vehicle accident during the second or third trimester of pregnancy\u003c/a\u003e, April 1997.\u003c/p\u003e\n\u003cp\u003eEvery Stage Health From the American College of Obstetrics \u0026 Gynecologists, \u003ca href=\"https://www.acog.org/womens-health/faqs/car-safety-for-pregnant-women-babies-and-children\" target=\"_blank\" rel=\"noopener\"\u003eCar Safety for Pregnant Women, Babies, and Children\u003c/a\u003e, January 2024.\u003c/p\u003e","versionHistory":"\u003cp\u003eDate: Feb 10, 2026\u003c/p\u003e\r\n\u003cp\u003eEditors: Maggie Panos, Rebekah Wahlberg\u003c/p\u003e\r\n\u003cp\u003eUpdates to copy, formatting, and sources; medically reviewed for accuracy.\u003c/p\u003e","pageType":"Article","pageLayout":null,"createDate":"1999-03-09T00:00:00.000Z","updateDate":"2026-05-21T00:58:02.000Z","brandedContentSponsor":"","isNews":false,"excludeFromAdvertising":false,"keywords":"","doNotTrack":false,"adZoneOverride":"","jsonAttributes":"{\"faq\":{\"content\":[]}}","byline":null,"__typename":"ContentPageData","brandedContentSponsorImg":"","brandedContentSponsorUrl":"","showByline":true,"lastReviewedDate":"2026-02-10T00:00:00.000Z","expertPage":{"title":"Alexandra Frost","__typename":"ContentPageData","imgUrlMain":"https://assets.babycenter.com/ims/2021/10/Alex-Frost-headshot.jpg","summary":"Alexandra Frost is a Cincinnati-based freelance journalist, content marketing writer, copywriter, and editor focusing on health and wellness, parenting, real estate, business, education, and lifestyle. Away from the keyboard, Frost is also mom to four sons under age 7 who keep things chaotic, fun, and interesting.","urlMappings":[{"incomingUrl":"/expert-alexandra-frost","__typename":"UrlMapping"}]},"factCheckerPage":null,"medicalReviewerPage":{"title":"Rebecca Amaru, M.D.","__typename":"ContentPageData","imgUrlMain":"https://assets.babycenter.com/ims/2024/12/rebecca-amaru-bio-pic-dec-2024.jpg","summary":"\u003cp\u003eDr. Rebecca Amaru is a board-certified ob-gyn in private practice at Brasner, Blumberg \u0026amp; Amaru in Manhattan, New York City. Her practice interests include low- and moderate-risk obstetrics, breastfeeding support, adolescent gynecology, sexual and psychosocial health throughout women's lifespans.\u0026nbsp;\u003c/p\u003e","urlMappings":[{"incomingUrl":"/expert-rebecca-amaru","__typename":"UrlMapping"}]},"expertName":{"namePrefix":null,"nameSuffix":null,"expertise":"writer","__typename":"PersonPageData","type":"Expert"},"factCheckerName":null,"medicalReviewerName":{"namePrefix":"","nameSuffix":"","expertise":"ob-gyn","__typename":"PersonPageData"},"displayToc":false,"tableOfContents":"","embeddedPolls":[]},"contentPageFiling":[{"id":7659,"url":"/pregnancy","title":"Pregnancy","adTargeting":"pregnancy","adTargetingAdUnit":null,"entityId":41000002,"__typename":"ContentPageFiling"},{"id":9510,"url":"/pregnancy/your-life","title":"Your Life","adTargeting":"pregnancy-your-life","adTargetingAdUnit":"","entityId":41000201,"__typename":"ContentPageFiling"},{"id":9568,"url":null,"title":"Travel","adTargeting":"pregnancy-travel","adTargetingAdUnit":null,"entityId":41000748,"__typename":"ContentPageFiling"},{"id":624,"url":"/pregnancy/your-life/what-should-i-do-if-im-in-a-car-accident-while-im-pregnant_7235","title":"What to do if you're in a car accident (even a minor one) while pregnant","adTargeting":null,"adTargetingAdUnit":null,"entityId":7235,"__typename":"ContentPageFiling"}],"__typename":"Article"},"urlMapping":{"incomingUrl":"/pregnancy/your-life/what-should-i-do-if-im-in-a-car-accident-while-im-pregnant_7235","artifactType":"Article","artifactId":7235,"legacyRedirectId":null,"urlType":"Custom","targetUrl":null,"whereToGoNext":{"relativeUrl":"/pregnancy/your-life/what-should-i-do-if-im-in-a-car-accident-while-im-pregnant_7235","mayHavePersonalization":true,"contentPages":[{"id":40009240,"pageType":"Article","title":"14 raw and captivating photos of postpartum women","brandedContentSponsor":"","imgUrlThumb":"https://assets.babycenter.com/ims/2022/02/Ericalophotography-postpartum_4x3.jpg","imgAltText":"postpartum woman holding twin newborns to breast","expertPage":{"title":"Kelly Bailey","__typename":"ContentPageData"},"expertName":{"namePrefix":"","nameSuffix":"","__typename":"PersonPageData"},"medicalReviewerPage":null,"medicalReviewerName":null,"factCheckerPage":null,"factCheckerName":null,"urlMappings":[{"incomingUrl":"/pregnancy/hear-from-moms/14-raw-and-captivating-photos-of-postpartum-women_40009240","__typename":"UrlMapping"}],"contentPageFiling":[{"title":"Pregnancy","__typename":"ContentPageFiling"},{"title":"Hear From Pregnant Moms","__typename":"ContentPageFiling"},{"title":"Labor \u0026 Delivery Stories ","__typename":"ContentPageFiling"},{"title":"14 raw and captivating photos of postpartum women","__typename":"ContentPageFiling"}],"__typename":"ContentPageData"},{"id":40008432,"pageType":"SlideShow","title":"Best baby hats","brandedContentSponsor":"","imgUrlThumb":"https://assets.babycenter.com/ims/2023/03/best-baby-hats-mar2023_4x3.jpg","imgAltText":"Best baby hats","expertPage":{"title":"Maria Masters","__typename":"ContentPageData"},"expertName":{"namePrefix":null,"nameSuffix":null,"__typename":"PersonPageData"},"medicalReviewerPage":null,"medicalReviewerName":null,"factCheckerPage":{"title":"Joyce Slaton","__typename":"ContentPageData"},"factCheckerName":{"namePrefix":"","nameSuffix":"","expertise":"Commerce editor and CPST","__typename":"PersonPageData"},"urlMappings":[{"incomingUrl":"/baby-products/clothes-and-shoes/best-baby-hats_40008432","__typename":"UrlMapping"}],"contentPageFiling":[{"title":"Baby Products","__typename":"ContentPageFiling"},{"title":"Clothes \u0026 Shoes","__typename":"ContentPageFiling"},{"title":"Boy \u0026 Girl Clothes","__typename":"ContentPageFiling"},{"title":"Best baby hats","__typename":"ContentPageFiling"}],"__typename":"ContentPageData"},{"id":20000455,"pageType":"Video","title":"How to wear your hair during labor","brandedContentSponsor":"","imgUrlThumb":"https://assets.babycenter.com/ims/2017/12/US_how-to-wear-your-hair-during-labor_video-still_4x3.jpg","imgAltText":"A woman with dark curly hair wearing a purple tank top is braiding her hair, shown from behind against a plain light background.","expertPage":null,"expertName":null,"medicalReviewerPage":null,"medicalReviewerName":null,"factCheckerPage":null,"factCheckerName":null,"urlMappings":[{"incomingUrl":"/pregnancy/your-body/how-to-wear-your-hair-during-labor_20000455","__typename":"UrlMapping"}],"contentPageFiling":[{"title":"Pregnancy","__typename":"ContentPageFiling"},{"title":"Your Body","__typename":"ContentPageFiling"},{"title":"Labor \u0026 Delivery","__typename":"ContentPageFiling"},{"title":"How to wear your hair during labor","__typename":"ContentPageFiling"}],"__typename":"ContentPageData"},{"id":41002250,"pageType":"Article","title":"Pregnant with quadruplets? Here's what to know","brandedContentSponsor":"","imgUrlThumb":"https://assets.babycenter.com/ims/2026/11/pregnant-with-quadruplets_4x3.webp","imgAltText":"Four yellow-handled pacifiers arranged in a row against a light blue background.","expertPage":{"title":"Colleen de Bellefonds","__typename":"ContentPageData"},"expertName":{"namePrefix":null,"nameSuffix":null,"__typename":"PersonPageData"},"medicalReviewerPage":{"title":"Layan Alrahmani","__typename":"ContentPageData"},"medicalReviewerName":{"namePrefix":"","nameSuffix":"M.D.","expertise":"ob-gyn, MFM","__typename":"PersonPageData"},"factCheckerPage":null,"factCheckerName":null,"urlMappings":[{"incomingUrl":"/pregnancy/your-baby/quadruplets_41002250","__typename":"UrlMapping"}],"contentPageFiling":[{"title":"Pregnancy","__typename":"ContentPageFiling"},{"title":"Your Baby","__typename":"ContentPageFiling"},{"title":"Twins \u0026 More","__typename":"ContentPageFiling"},{"title":"Pregnant with quadruplets? Here's what to know","__typename":"ContentPageFiling"}],"__typename":"ContentPageData"},{"id":7239,"pageType":"Article","title":"Pregnant and buckling up: The safest way to wear your seatbelt","brandedContentSponsor":"","imgUrlThumb":"https://assets.babycenter.com/ims/2017/07/Rain-Web-Res-037_4x3.jpg","imgAltText":"Pregnant woman smiling as she fastens her seatbelt inside a parked car.","expertPage":{"title":"Rebekah Wahlberg","__typename":"ContentPageData"},"expertName":{"namePrefix":"","nameSuffix":"","__typename":"PersonPageData"},"medicalReviewerPage":{"title":"Cheryl Axelrod","__typename":"ContentPageData"},"medicalReviewerName":{"namePrefix":"","nameSuffix":"M.D.","expertise":"ob-gyn","__typename":"PersonPageData"},"factCheckerPage":null,"factCheckerName":null,"urlMappings":[{"incomingUrl":"/pregnancy/health-and-safety/is-it-safe-to-use-a-seat-belt-during-pregnancy_7239","__typename":"UrlMapping"}],"contentPageFiling":[{"title":"Pregnancy","__typename":"ContentPageFiling"},{"title":"Health \u0026 Safety","__typename":"ContentPageFiling"},{"title":"Pregnancy Health","__typename":"ContentPageFiling"},{"title":"Pregnant and buckling up: The safest way to wear your seatbelt","__typename":"ContentPageFiling"}],"__typename":"ContentPageData"},{"id":7877,"pageType":"Article","title":"Can you run while pregnant?","brandedContentSponsor":"","imgUrlThumb":"https://assets.babycenter.com/ims/2024/03/iStock-1327666772_4x3.jpg","imgAltText":"Pregnant woman jogging on a wooden path","expertPage":{"title":"Kandis Lake","__typename":"ContentPageData"},"expertName":{"namePrefix":null,"nameSuffix":"R.N.","__typename":"PersonPageData"},"medicalReviewerPage":{"title":"Catherine Cram","__typename":"ContentPageData"},"medicalReviewerName":{"namePrefix":"","nameSuffix":"M.S.","expertise":"exercise physiologist","__typename":"PersonPageData"},"factCheckerPage":null,"factCheckerName":null,"urlMappings":[{"incomingUrl":"/pregnancy/diet-and-fitness/can-you-run-while-pregnant_7877","__typename":"UrlMapping"}],"contentPageFiling":[{"title":"Pregnancy","__typename":"ContentPageFiling"},{"title":"Diet \u0026 Fitness","__typename":"ContentPageFiling"},{"title":"Fitness","__typename":"ContentPageFiling"},{"title":"Can you run while pregnant?","__typename":"ContentPageFiling"}],"__typename":"ContentPageData"},{"id":6832,"pageType":"Article","title":"When can we start taking our child to the movies?","brandedContentSponsor":"","imgUrlThumb":"https://assets.babycenter.com/ims/2016/07/iStock_52174564_4x3.jpg","imgAltText":"mother and father with boy and girl sitting in the movies","expertPage":{"title":"Susanne Ayers Denham","__typename":"ContentPageData"},"expertName":{"namePrefix":null,"nameSuffix":"Ph.D.","__typename":"PersonPageData"},"medicalReviewerPage":null,"medicalReviewerName":null,"factCheckerPage":null,"factCheckerName":null,"urlMappings":[{"incomingUrl":"/toddler/playtime/when-can-we-start-taking-our-child-to-the-movies_6832","__typename":"UrlMapping"}],"contentPageFiling":[{"title":"Toddler","__typename":"ContentPageFiling"},{"title":"Playtime","__typename":"ContentPageFiling"},{"title":"Games, Playdates \u0026 Entertainment","__typename":"ContentPageFiling"},{"title":"When can we start taking our child to the movies?","__typename":"ContentPageFiling"}],"__typename":"ContentPageData"},{"id":1425791,"pageType":"Article","title":"Placental abruption","brandedContentSponsor":"","imgUrlThumb":"https://assets.babycenter.com/ims/2020/04/PLACENTA-ABRUPTION-FINAL-with-text-updated_4x3.jpg","imgAltText":"Illustration showing placenta detached from uterus causing blood clot and external bleeding during pregnancy.","expertPage":{"title":"Kate Marple","__typename":"ContentPageData"},"expertName":{"namePrefix":null,"nameSuffix":null,"__typename":"PersonPageData"},"medicalReviewerPage":{"title":"Layan Alrahmani","__typename":"ContentPageData"},"medicalReviewerName":{"namePrefix":"","nameSuffix":"M.D.","expertise":"ob-gyn, MFM","__typename":"PersonPageData"},"factCheckerPage":null,"factCheckerName":null,"urlMappings":[{"incomingUrl":"/pregnancy/health-and-safety/placental-abruption_1425791","__typename":"UrlMapping"}],"contentPageFiling":[{"title":"Pregnancy","__typename":"ContentPageFiling"},{"title":"Health \u0026 Safety","__typename":"ContentPageFiling"},{"title":"Complications","__typename":"ContentPageFiling"},{"title":"Placental abruption","__typename":"ContentPageFiling"}],"__typename":"ContentPageData"},{"id":40009318,"pageType":"Article","title":"13 of the most precious photos of multiples","brandedContentSponsor":"","imgUrlThumb":"https://assets.babycenter.com/ims/2022/03/raisingouryoungs-multiples_4x3.jpg","imgAltText":"mom with quadruplets","expertPage":{"title":"Kelly Bailey","__typename":"ContentPageData"},"expertName":{"namePrefix":"","nameSuffix":"","__typename":"PersonPageData"},"medicalReviewerPage":null,"medicalReviewerName":null,"factCheckerPage":null,"factCheckerName":null,"urlMappings":[{"incomingUrl":"/pregnancy/hear-from-moms/13-of-the-most-precious-photos-of-multiples_40009318","__typename":"UrlMapping"}],"contentPageFiling":[{"title":"Pregnancy","__typename":"ContentPageFiling"},{"title":"Hear From Pregnant Moms","__typename":"ContentPageFiling"},{"title":"Labor \u0026 Delivery Stories ","__typename":"ContentPageFiling"},{"title":"13 of the most precious photos of multiples","__typename":"ContentPageFiling"}],"__typen