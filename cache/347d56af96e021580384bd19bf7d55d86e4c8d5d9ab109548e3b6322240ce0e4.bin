</p> <div class="mt-3 flex gap-2"> <button type="button" data-consent="denied" class="flex-1 rounded-full border border-slate-200 px-4 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50"> Decline </button> <button type="button" data-consent="granted" class="flex-1 rounded-full bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-slate-800"> Accept </button> </div> </div> <script>
  (function () {
    var KEY = 'eq_cookie_consent';
    var banner = document.getElementById('eq-cookie-banner');
    if (!banner) return;

    function read() {
      try { return window.localStorage.getItem(KEY); } catch (e) { return null; }
    }
    function write(v) {
      try { window.localStorage.setItem(KEY, v); } catch (e) { /* private mode: choice lasts this page only */ }
    }

    // Withdrawing consent: drop first-party analytics cookies/storage, then
    // reload so already-running GA / Ahrefs / PostHog scripts are gone.
    function clearAnalyticsStorage() {
      var host = location.hostname.replace(/^www\./, '');
      document.cookie.split(';').forEach(function (part) {
        var name = part.split('=')[0].trim();
        if (/^(_ga|_gid|_gat|ph_|__ph)/.test(name)) {
          ['', '; domain=' + host, '; domain=.' + host].forEach(function (d) {
            document.cookie = name + '=; Max-Age=0; path=/' + d;
          });
        }
      });
      try {
        Object.keys(window.localStorage).forEach(function (k) {
          if (/^(ph_|__ph)/.test(k)) window.localStorage.removeItem(k);
        });
      } catch (e) { /* ignore */ }
    }

    banner.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-consent]');
      if (!btn) return;
      var value = btn.getAttribute('data-consent');
      var previous = read();
      write(value);
      banner.hidden = true;
      if (value === 'granted') {
        window.dispatchEvent(new Event('eq:consent-granted'));
      } else if (previous === 'granted') {
        clearAnalyticsStorage();
        location.reload();
      }
    });

    document.addEventListener('click', function (e) {
      if (e.target.closest('[data-cookie-settings]')) {
        e.preventDefault();
        banner.hidden = false;
      }
    });

    // No consent on this page load: sweep leftovers. PostHog re-persists its
    // ph_* cookie/localStorage on unload, so the clear done right before the
    // withdraw reload is not enough on its own. Trackers never load without
    // consent, so nothing can write them back after this point.
    var current = read();
    if (current !== 'granted') clearAnalyticsStorage();
    if (current !== 'granted' && current !== 'denied') banner.hidden = false;
  })();
