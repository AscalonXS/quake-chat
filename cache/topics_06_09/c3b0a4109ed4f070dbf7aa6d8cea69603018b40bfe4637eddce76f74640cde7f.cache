<script>
  $(document).ready(function() {

    $("#carouselResource").on("slide.bs.carousel",
      function(e) {
        var $e = $(e.relatedTarget);
        var idx = $e.index();
        var itemsPerSlide = 4;
        var totalItems = $(".carousel-item").length;

        if (idx >= totalItems - (itemsPerSlide - 1)) {
          var it = itemsPerSlide - (totalItems - idx);
          for (var i = 0; i < it; i++) {
            // append slides to end
            if (e.direction == "left") {
              $(".carousel-item")
                .eq(i)
                .appendTo(".carousel-inner");
              //.toggleClass('card carousel-item-left');
            } else {
              $(".carousel-item")
                .eq(0)
                .appendTo($(this).find(".carousel-inner"));
            }
          }
          //var id = e.relatedTarget.id;
        }
      });

    $("#subscription_form").on("submit",
      function (event) {

        var emailAddress = $(this).find('input[name="listServSubscribe"]');
        if ($.trim(emailAddress.val()) === "") {
          event.preventDefault();
        }
      });
  });

  $(function() {
    if (window.TracieAwsWaf) {
      window.TracieAwsWaf.warmUpToken();
      window.TracieAwsWaf.bindSilentTokenOnFormSubmit('#subscription_form', {
        requiredFields: ['#listServSubscribe'],
        errorContainerSelector: '#awsWafSubscribeMessage',
        errorMessage: 'Security verification failed. Please refresh the page and try again.'
      });
    }
  });
</script>
<!-- END FEATURED RESOURCES/ SUBSCRIBE -->

<script>

  $(document).ready(function () {
    // Fetch user's MRC documents if user is MRC member
    fetchUserMrcDocuments();
  });
  
  var isMember = 0;
  var isMrcMember = false;
  var userMrcDocumentIds = [];

  /**
   * Fetches the user's MRC training documents on page load
   * Requirements: 1.1, 2.1, 8.3
   */
  function fetchUserMrcDocuments() {
    // Check if user is MRC member
    if (!isMrcMember || isMember !== 1) {
      return;
    }

    // Make AJAX GET request to fetch user's MRC documents
    $.ajax({
      url: '/mrc/user-documents',
      type: 'GET',
      dataType: 'json',
      success: function(response) {
        if (response && response.success && response.documents) {
          // Store document IDs in JavaScript array for quick lookup
          userMrcDocumentIds = response.documents.map(function(doc) {
            return doc.DocumentID;
          });
          
          // Call updateCollectionStatusButtons function after data loads
          updateCollectionStatusButtons(userMrcDocumentIds);
        }
      },
      error: function(xhr, status, error) {
        // Handle errors gracefully (log to console, continue without status indicators)
        console.log('Unable to load MRC training documents:', error);
        // Continue without status indicators - no user-facing error message
      }
    });
  }

  /**
   * Updates the collection status buttons based on user's MRC document collection
   * Requirements: 2.1, 2.2, 2.3, 2.4
   */
  function updateCollectionStatusButtons(documentIds) {
    // Loop through all "Add Training" buttons on page
    $('.fa-graduation-cap').each(function() {
      var $button = $(this);
      var docId = $button.data('document-id');
      
      if (docId && documentIds.indexOf(docId) !== -1) {
        // Document is in user's collection - apply active styling
        $button.removeClass('fa-training-off').addClass('fa-training-on');
        $button.attr('data-in-training', 'true');
        $button.attr('title', 'Already in training');
        $button.attr('aria-label', 'Already in training');
        
        // Update status text
        var statusDiv = $('#training_status_' + docId);
        if (statusDiv.length) {
          statusDiv.text('Added');
        }
      } else {
        // Document is not in user's collection - apply inactive styling
        $button.removeClass('fa-training-on').addClass('fa-training-off');
        $button.attr('data-in-training', 'false');
        $button.attr('title', 'Add to training');
        $button.attr('aria-label', 'Add to training');
      }
    });
  }

  /**
   * Click handler for "Add Training" button
   * Requirements: 3.1, 3.3, 3.4, 7.1, 7.2, 7.4, 8.1
   */
  $('.fa-graduation-cap').click(function (e) {
    e.preventDefault(); // Prevent default button behavior
    
    // Validate user is MRC member
    if (!isMrcMember || isMember !== 1) {
      console.warn('Training feature is only available for MRC Members');
      alert('This feature is only available to MRC Members. Please contact support if you believe this is an error.');
      return;
    }
    
    var $button = $(this);
    var isInTraining = $button.attr('data-in-training') === 'true';
    
    // If already in training, do nothing
    if (isInTraining) {
      alert('This document is already in your training list.');
      return;
    }
    
    // Get document ID from button's data attribute
    var documentId = $button.data('document-id');
    
    // Validate document ID
    if (!documentId || documentId <= 0) {
      console.error('Invalid document ID:', documentId);
      alert('Invalid document ID. Please refresh the page and try again.');
      return;
    }
    
    // Prevent multiple clicks during AJAX
    if ($button.data('processing')) {
      console.log('Request already in progress');
      return;
    }
    $button.data('processing', true);
    
    // Make AJAX POST request to /mrc/add-document with documentId
    $.ajax({
      url: '/mrc/add-document',
      type: 'POST',
      data: {
        documentId: documentId,
        AntiforgeryFieldname: $('input[name="AntiforgeryFieldname"]').first().val() || $('input[name="__RequestVerificationToken"]').first().val()
      },
      dataType: 'json',
      timeout: 10000, // 10 second timeout
      success: function (response) {
        if (response && response.success) {
          // On success: update button to active state
          $button.removeClass('fa-training-off').addClass('fa-training-on');
          $button.attr('data-in-training', 'true');
          $button.attr('title', 'Already in training');
          $button.attr('aria-label', 'Already in training');
          
          // Add document ID to local array
          if (userMrcDocumentIds.indexOf(documentId) === -1) {
            userMrcDocumentIds.push(documentId);
          }
          
          // Update status text
          var statusDiv = $('#training_status_' + documentId);
          if (statusDiv.length) {
            statusDiv.text('Added');
          }
          
          // Show success notification
          showSuccessNotification(response.message || 'Document added to your training list successfully.');
        } else {
          // On error: show error message with response message or generic error
          var errorMsg = response && response.message ? response.message : 'Failed to add document to training';
          console.error('Failed to add training document:', errorMsg);
          showErrorNotification(errorMsg);
        }
      },
      error: function (xhr, status, error) {
        var errorMsg = 'An error occurred while adding document to training.';
        
        // Handle authentication errors (401) by redirecting to login
        if (xhr.status === 401) {
          errorMsg = 'Your session has expired. Please log in again.';
          showErrorNotification(errorMsg);
          setTimeout(function() {
            window.location.href = '/login?returnurl=' + encodeURIComponent(window.location.pathname);
          }, 2000);
          return;
        }
        
        // Handle authorization errors (403) by showing "MRC membership required" message
        if (xhr.status === 403) {
          errorMsg = 'MRC membership required. Please contact support if you believe this is an error.';
          showErrorNotification(errorMsg);
          return;
        }
        
        // Handle other error scenarios
        if (status === 'timeout') {
          errorMsg = 'Request timed out. Please check your connection and try again.';
        } else if (xhr.status === 400) {
          errorMsg = 'Invalid request. Please refresh the page and try again.';
        } else if (xhr.status >= 500) {
          errorMsg = 'Server error. Please try again later.';
        }
        
        console.error('Error adding document to training:', {
          status: status,
          error: error,
          xhr: xhr
        });
        showErrorNotification(errorMsg);
      },
      complete: function () {
        $button.removeData('processing');
      }
    });
  });
  
  /**
   * Show success notification
   * Requirements: 7.1, 8.1
   */
  function showSuccessNotification(message) {
    alert(message); // Using simple alert for now - can be enhanced with toast notifications
  }
  
  /**
   * Show error notification
   * Requirements: 7.2, 8.2
   */
  function showErrorNotification(message) {
    alert(message); // Using simple alert for now - can be enhanced with toast notifications
  }
  
  // Add keyboard support for training button
  $('.fa-graduation-cap[role="button"][tabindex="0"]').on('keydown', function(e) {
    // Handle Enter (13) or Space (32) key press
    if (e.which === 13 || e.which === 32) {
      e.preventDefault(); // Prevent default action
      $(this).click(); // Trigger the click event
    }
  });

  $('.fa-heart').click(function (e) {
    if (isMember === 1) {
      trToggleFavorite(this);
    }
  });
  
  // Add keyboard support for favorite button
  $('.fa-heart[role="button"][tabindex="0"]').on('keydown', function(e) {
    // Handle Enter (13) or Space (32) key press
    if (e.which === 13 || e.which === 32) {
      e.preventDefault(); // Prevent default action
      $(this).click(); // Trigger the click event
    }
  });
 
 
 $(function () {
   $('[data-toggle="tooltip"]').tooltip()
 });
</script>
