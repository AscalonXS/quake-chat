              <source srcset="/sites/default/files/styles/tablet_full/public/document/image/marie_from_the_drc_is_reconnected_with_her_family_through_the_restoring_family_links_programme.jpg.webp?h=71976bb4&amp;itok=3I9sdhCx 1x" media="all and (min-width: 576px)" type="image/webp" width="768" height="440"/>
              <source srcset="/sites/default/files/styles/mobile_square/public/document/image/marie_from_the_drc_is_reconnected_with_her_family_through_the_restoring_family_links_programme.jpg.webp?h=71976bb4&amp;itok=p23lvYu_ 1x" media="all and (max-width: 576px)" type="image/webp" width="360" height="360"/>
                  <img loading="lazy" width="1280" height="736" src="/sites/default/files/styles/desktop_full/public/document/image/marie_from_the_drc_is_reconnected_with_her_family_through_the_restoring_family_links_programme.jpg.webp?h=71976bb4&amp;itok=0qsyAHtV" title="marie_from_the_drc_is_reconnected_with_her_family_through_the_restoring_family_links_programme.jpg" />

