<aside class="share-widget" aria-labelledby="Share">
    <div class="icrc-container">
        <div class="frame">
            <h3 id="Share" class="label">Share</h3>
            <ul class="share-list"><li><a href="https://twitter.com/intent/tweet?url=https%3A//www.icrc.org/en/article/faq-missing-persons&amp;text=Frequently%20asked%20questions%20on%20the%20missing" title="Share on X" target="_blank" class="icon-x">Share on X</a></li><li><a href="https://www.linkedin.com/shareArticle?url=https%3A//www.icrc.org/en/article/faq-missing-persons&amp;title=Frequently%20asked%20questions%20on%20the%20missing" title="Share on LinkedIn" target="_blank" class="icon-linkedin">Share on LinkedIn</a></li><li><a href="https://www.facebook.com/sharer/sharer.php?u=https%3A//www.icrc.org/en/article/faq-missing-persons&amp;title=Frequently%20asked%20questions%20on%20the%20missing" title="Share on Facebook" target="_blank" class="icon-facebook">Share on Facebook</a></li></ul>
        </div>
