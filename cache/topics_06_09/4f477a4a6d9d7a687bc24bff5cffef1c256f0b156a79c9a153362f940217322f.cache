indian-ocean" class="nav-link" data-drupal-link-system-path="node/49">Indian Ocean</a></li><li class="nav-item"> <a href="/en/neam" class="nav-link" data-drupal-link-system-path="node/50">North-Eastern Atlantic &amp; Mediterranean</a></li><li class="nav-item"> <a href="/en/caribbean" class="nav-link" data-drupal-link-system-path="node/51">Caribbean</a></li></ul></li></ul> </nav></div></div></div><div class="col-lg-12"><div class="footer"><div class="region region-footer-bottom"> <nav role="navigation" aria-labelledby="block-galaxyfooter-menu" id="block-galaxyfooter" class="col-lg-9 block block-menu navigation menu--galaxy-footer"><h5 class="visually-hidden" id="block-galaxyfooter-menu">Galaxy Footer</h5><ul data-block="footer_bottom" class="nav navbar-nav"><li class="nav-item"> <a href="https://www.unesco.org/en/terms-use" class="nav-link">Terms of Use</a></li><li class="nav-item"> <a href="https://www.unesco.org/en/website-privacy-notice" class="nav-link">Privacy Notice</a></li><li class="nav-item"> <a href="https://www.unesco.org/en/logo-patronage" class="nav-link">UNESCO Name &amp; Logo</a></li><li class="nav-item"> <a href="https://www.unesco.org/en/unesco-access-information-policy" class="nav-link">Access to Information</a></li><li class="nav-item"> <a href="https://www.unesco.org/en/environmental-commitment-and-policy" class="nav-link">Environmental and Social Policies</a></li><li class="nav-item"> <a href="https://www.unesco.org/en/legal-affairs/cr-committee/104-procedure" class="nav-link">Protection of human rights : Procedure 104</a></li><li class="nav-item"> <a href="https://www.unesco.org/en/ethics/expected-conduct-prevent-harassment" class="nav-link">Preventing harassment at UNESCO events</a></li><li class="nav-item"> <a href="https://www.unesco.org/fr/faq" class="nav-link">FAQ</a></li><li class="nav-item"> <a href="https://www.unesco.org/en/scamalert" class="text-danger font-weight-bolder nav-link">Scam alert</a></li><li class="nav-item"> <a href="https