</div>
<script type="text/javascript">
$(document).ready( function() {
	$(".thickbox").each( function(i) {

		var href = $(this).attr("href");
		$(this).attr("href", href + "&ajax=true");
	});

	// Use jquery to set the value of jsEnabled hidden field
	// This allows us to check that the user has javascript enabled and that jquery is working
	$("#jsEnabled").val("true");
    
    $('#frmLogin').on('submit', function(e) {
        var username = $.trim($('#username').val());
        var password = $('#textpass').val();
      
        if (!isValidString(username)) {
            e.preventDefault();
            ensAlert("Invalid Username", "Your username contains forbidden characters. Please change and try again.");            
        } else if (!isValidString(password)) {
            e.preventDefault();
            ensAlert("Invalid Password", "Your password contains forbidden characters. Please change and try again.");
        }
    });
    
});

</script>
