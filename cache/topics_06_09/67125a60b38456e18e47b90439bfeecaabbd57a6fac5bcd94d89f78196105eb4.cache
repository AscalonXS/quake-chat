                </div>
                <hr class="separator">
                <div class="ens-card-description">
                    <a class="thickbox" href="#TB_inline?height=300&width=790&inlineId=oaf-message">Example Aftershock Message</a>
                </div>
            </div> 
            
            <div class="ens-card">
                <div class="ens-card-title">ShakeMap Text Summary</div>
                <div class="ens-card-description">Brief summary of peak shaking intensity</div>
                <div class="ens-card-image">
                    <a href="https://earthquake.usgs.gov/data/shakemap/" target="_blank" rel="noopener noreferrer">
                        <img src="images/login/fig_shakemap_small.png" alt="ShakeMap">
                    </a>
                </div>
                <hr class="separator">
                <div class="ens-card-description">
                    <a href="https://earthquake.usgs.gov/data/shakemap/" target="_blank" rel="noopener noreferrer">ShakeMap Home</a>
