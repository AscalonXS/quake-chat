<div class="field field--name--field-thumbnail field--type--entity-reference field--label--hidden">
    
      <div  class="field-thumbnail">  <img loading="lazy" src="https://d9-wret.s3.us-west-2.amazonaws.com/assets/palladium/production/s3fs-public/styles/list_item/public/IMG_6461.jpg?itok=dVYEAXne" width="180" height="180" alt="Image: Tsunami Carried Boat" />


