		<div class="journal-content-article " data-analytics-asset-id="77812702" data-analytics-asset-title="Reunification Header" data-analytics-asset-type="web-content" data-analytics-web-content-resource-pk="77812704">
			

			<div style="display: flex; align-items: center; margin-bottom: 12px;">
<div style="float: left; border-radius: 100px; min-width: 100px; height: 100px; display: flex; justify-content: center; position: relative; margin-right: 24px;"><picture data-fileentryid="78553563"><source media="(max-width:128px)" srcset="/o/adaptive-media/image/78553563/Thumbnail-128x128/Population.png?t=1704983275073" /><source media="(max-width:176px) and (min-width:128px)" srcset="/o/adaptive-media/image/78553563/Preview-1000x0/Population.png?t=1704983275073" /><img alt="" height="100" src="/documents/36520569/76295608/Population.png/e7184360-47a4-31c6-29f5-a5342ab06731" style="position: absolute; inset: 0px; margin: 0px;" width="100" data-fileentryid="78553563" /></picture></div>

<h1>Reunification</h1>
</div>

			
		</div>

		

	



