<div id="hmenu">&nbsp;</div>

<div align="left" class="content_slider" style="margin-top:15px;">
<p id="coin-slider"><!--
	first Slider image
--><a href="https://www.weather.gov/wrn/fall-safety"><img 10px="" alt="coastal tsunami damage" img="" src="/images/safety/slider/coast600.png" style="width: 650px; height: 357px;" /></a><a href="https://www.weather.gov/wrn/fall-safety"> </a><img height="356" src="/images/safety/slider/AKtsunamidamagetxt600.png" width="650" /><a href="https://www.weather.gov/wrn/fall-safety"> </a><img height="355" src="/images/safety/slider/AStsunamitxt600.png" width="650" /></p>
