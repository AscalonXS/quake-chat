<script>
	var loaded = false;
	$(document).ready(function() {
		if (loaded == false) {
			var pageName = location.href.split("/").slice(-1)[0];
			if (pageName.indexOf("?") > 0) {
				pageName = pageName.split("?")[0];
			}
			if (pageName.indexOf("#") > 0) {
                pageName = pageName.split("#")[0];
            }
			var pagesQuery = query(_spPageContextInfo.webAbsoluteUrl + "/_api/web/lists/getbyTitle('Pages')/items?$select=File/Name,bannerURL&$expand=File&$filter=FileLeafRef eq '"+ pageName +"'");
			var bannerURL = "";
			if (pagesQuery.length > 0) {
				bannerURL = pagesQuery[0].bannerURL;
			}
			if (bannerURL != null && bannerURL != "") {
				$("[id$=_EditModePanel5]").append('<img style="width:100%;" src="'+bannerURL+'"></img>');
			}
			loaded = true;
		}
		
	});
	
	function query(url) {
		var tempdata = [];
		$.ajax({
			url: url,
			method: "GET",
			async: false,
			headers: { "Accept": "Application/json; odata=verbose" },
			success: function(data) {
				data: JSON.stringify(data);
				tempdata = data.d.results;
			}
		});
		return tempdata;
	}
</script>

