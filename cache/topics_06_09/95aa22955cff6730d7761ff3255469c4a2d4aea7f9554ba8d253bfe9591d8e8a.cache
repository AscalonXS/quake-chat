</script><script src="https://www.ssc.ca.gov/wp-content/plugins/gtranslate/js/dwf.js?ver=5.0.2" data-no-optimize="1" data-no-minify="1" data-gt-orig-url="/after-a-quake/what-to-do/" data-gt-orig-domain="www.ssc.ca.gov" data-gt-widget-id="65057395" defer></script>  <script id="hide-title-attributes">
  function hide_title_attributes(el){
    var t = el.querySelectorAll('[title]');
    if(t && t.length > 0){
      for(var n=0;n<t.length;++n){
        var title=t[n].title;
        t[n].removeAttribute('title');
        t[n].setAttribute('aria-label',title);
      }
    }
  }
  hide_title_attributes(document.body);
  document.body.onmouseover = function(e){
    if(e.target.innerHTML.indexOf('title=')>-1){
      hide_title_attributes(e.target);   
    }
    else if(e.target.title){
      var t=e.target.title;
      e.target.removeAttribute('title');
      e.target.setAttribute('aria-label',t);     
    }
  }
  </script>
  	
