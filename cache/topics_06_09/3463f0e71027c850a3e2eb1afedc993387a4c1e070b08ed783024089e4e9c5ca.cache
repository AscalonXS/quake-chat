<script>
 function checknavsearch(obj)
 {
   
   if(obj === undefined || obj === null)
   {
      console.log("Variable is either null or undefined");
   }
   else
   {
  
      var searchvalue = document.getElementById("search_nav").value;
      if(searchvalue == '')
      {
            event.preventDefault();
            event.stopPropagation();
      }
   }
 
 } 
