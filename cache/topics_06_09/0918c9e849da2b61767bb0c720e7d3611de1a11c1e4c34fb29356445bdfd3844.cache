on">{"path":{"baseUrl":"\/","pathPrefix":"en\/","currentPath":"node\/10","currentPathIsAdmin":false,"isFront":false,"currentLanguage":"en"},"pluralDelimiter":"\u0003","suppressDeprecationErrors":true,"ajaxPageState":{"libraries":"eJxtkF1uxDAIhC_krJ96ngg7yPGWGIvBqrKnX2uj_qpPwACfBhK7s63QXElW7GS1lTUNd22I8FNmHZKqw436W0wE_lV_pcsdi5Az_Ge_iCaS5R_SwQAVRshCwBmbbhyyGsfNRie5VedjkTp5L7WpHST1waGTUZmMHZ-j38pttD7S3Np5CzgxGZfn0RhZ__q51BVMlvd4hfDBafT5E7G4zYOMWuFe8zvbE3Twdow","theme":"unesco","theme_token":null},"ajaxTrustedUrl":{"form_action_p_pvdeGsVG5zNF_XLGPTvYSKCf43t8qZYSwcfZl2uzM":true,"\/en\/search":true},"charts_google":{"mapApiKey":false},"unesco_common":{"whereami_api_endpoint":""},"field_group":{"html_element":{"mode":"level_0","context":"view","settings":{"classes":"left-wrapper col-lg-3 col-md-12","id":"","element":"div","show_label":false,"label_element":"h3","label_element_classes":"","attributes":"","effect":"none","speed":"fast","show_empty_fields":false}}},"csp":{"nonce":"SRe0-294Wa-j5GfaNDVWEg"},"user":{"uid":0,"permissionsHash":"73c00b9ac20579dd32e12eb651d86b96fbdaa06413345f70b21dfe3805169fcf"}}</script><script src="/core/assets/vendor/jquery/jquery.min.js?v=4.0.0"></script><script src="/sites/default/files/js/js_8R8eNtUxo3Ix7dQrIt6OS61RKChZzdGt6PvM-CehK9Y.js?scope=footer&amp;delta=1&amp;language=en&amp;theme=unesco&amp;include=eJw9i9EKgCAMAH9I8anvkc2GWcPJNon-vqDo6Y6DQxE3VxhLwl_jbpHByTzMTlYkVRYEjuYXt16_mo1Ay5ZehJNwjmzCmtZnVuiVRisH6Q3ZMCej"></script></body>
