<script id="soh-tf-script-js-extra">
var sohTfData = {"ajax_url":"https://dod.hawaii.gov/hiema/wp-admin/admin-ajax.php","nonce":"730b1b682a"};
//# sourceURL=soh-tf-script-js-extra
</script>
<script id="soh-tf-script-js-after">
document.addEventListener('DOMContentLoaded', function() {
            document.body.addEventListener('click', function(e) {
                if (e.target && e.target.classList.contains('soh-tf-load-more')) {
                    let btn = e.target;
                    let userId = btn.getAttribute('data-userid');
                    let username = btn.getAttribute('data-username');
                    let nextToken = btn.getAttribute('data-next-token');
                    let count = btn.getAttribute('data-count');
                    
                    if (!nextToken) return;
                    
                    btn.innerText = 'Loading...';
                    btn.setAttribute('aria-busy', 'true');
                    btn.disabled = true;

                    // Use URLSearchParams for application/x-www-form-urlencoded
                    let params = new URLSearchParams({
                        action: 'soh_tf_load_more',
                        security: sohTfData.nonce,
                        user_id: userId,
                        username: username,
                        next_token: nextToken,
                        count: count
                    });

                    fetch(sohTfData.ajax_url, { 
                        method: 'POST', 
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, // Hardened for anon public users
                        body: params 
                    })
                    .then(res => res.json())
                    .then(response => {
                        if (response.success) {
                            btn.insertAdjacentHTML('beforebegin', response.data.html);
                            if (response.data.next_token) {
                                btn.setAttribute('data-next-token', response.data.next_token);
                                btn.innerText = 'Show more';
                                btn.removeAttribute('aria-busy');
                                btn.disabled = false;
                            } else {
                                btn.remove(); 
                            }
                        } else {
                            btn.innerText = 'Error loading tweets';
                            btn.removeAttribute('aria-busy');
                        }
                    })
                    .catch(() => { 
                        btn.innerText = 'Error'; 
                        btn.removeAttribute('aria-busy');
                    });
                }
            });
        });
    
//# sourceURL=soh-tf-script-js-after
</script>
