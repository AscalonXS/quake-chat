<link rel='stylesheet' id='ctf_styles-css' href='https://dod.hawaii.gov/hiema/wp-content/plugins/custom-twitter-feeds-pro/css/ctf-styles.min.css?ver=2.9.0' media='all' />
<style id="soh-tf-style-inline-css">

        .soh-tf-wrapper { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; width: 100%; max-width: 600px; margin: 0 auto; background: #ffffff; border: 1px solid #cfd9de; border-radius: 16px; overflow: hidden; color: #0f1419; display: flex; flex-direction: column; }
        .soh-tf-wrapper a:focus-visible, .soh-tf-wrapper div:focus-visible, .soh-tf-wrapper button:focus-visible { outline: 3px solid #005A9C; outline-offset: 2px; border-radius: 4px; }
        
        .soh-tf-profile { padding: 16px; border-bottom: 1px solid #cfd9de; background-color: #ffffff; z-index: 10; position: relative; }
        .soh-tf-profile-top { display: flex; align-items: center; margin-bottom: 12px; }
        .soh-tf-profile-img { width: 48px; height: 48px; border-radius: 50%; margin-right: 12px; border: 1px solid #eff3f4; }
        .soh-tf-profile-info { display: flex; flex-direction: column; }
        .soh-tf-profile-name { font-weight: 800; font-size: 17px; color: #0f1419; text-decoration: none; line-height: 1.2; }
        .soh-tf-profile-name:hover { text-decoration: underline; }
        .soh-tf-profile-handle { color: #475a69; font-size: 15px; text-decoration: none; }
        .soh-tf-profile-desc { font-size: 16px; margin-bottom: 12px; line-height: 1.4; white-space: pre-wrap; word-wrap: break-word; }
        .soh-tf-profile-desc a { color: #005A9C; text-decoration: none; font-weight: 500; }
        .soh-tf-profile-desc a:hover { text-decoration: underline; }
        .soh-tf-profile-metrics { display: flex; flex-wrap: wrap; gap: 16px; font-size: 14px; color: #475a69; }
        .soh-tf-profile-metrics span strong { color: #0f1419; font-weight: 700; }

        .soh-tf-feed-scroll { max-height: 800px; overflow-y: auto; overscroll-behavior: contain; background: #ffffff; }
        .soh-tf-feed-scroll::-webkit-scrollbar { width: 8px; }
        .soh-tf-feed-scroll::-webkit-scrollbar-track { background: transparent; }
        .soh-tf-feed-scroll::-webkit-scrollbar-thumb { background-color: #cfd9de; border-radius: 4px; }
        .soh-tf-feed-scroll::-webkit-scrollbar-thumb:hover { background-color: #aebbc5; }

        .soh-tf-tweet { padding: 16px; border-bottom: 1px solid #cfd9de; transition: background-color 0.2s ease; display: flex; flex-direction: column; }
        .soh-tf-tweet:hover { background-color: #f7f9f9; }
        .soh-tf-context { font-size: 13px; color: #475a69; margin-bottom: 4px; padding-left: 52px; font-weight: 700; display: flex; align-items: center; }
        .soh-tf-context svg { fill: #475a69; width: 16px; height: 16px; margin-right: 8px; }
        .soh-tf-tweet-body { display: flex; align-items: flex-start; }
        .soh-tf-avatar { width: 40px; height: 40px; border-radius: 50%; margin-right: 12px; flex-shrink: 0; background-color: #eff3f4; border: 1px solid rgba(0,0,0,0.04); }
        .soh-tf-content { flex-grow: 1; min-width: 0; }
        
        .soh-tf-header { display: flex; align-items: center; margin-bottom: 2px; font-size: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .soh-tf-author { font-weight: 700; text-decoration: none; color: #0f1419; margin-right: 4px; overflow: hidden; text-overflow: ellipsis; }
        .soh-tf-author:hover { text-decoration: underline; }
        .soh-tf-handle, .soh-tf-date { color: #475a69; text-decoration: none; flex-shrink: 0; }
        .soh-tf-date:hover { text-decoration: underline; }
        .soh-tf-text { font-size: 16px; line-height: 1.4; margin: 0 0 12px 0; word-wrap: break-word; white-space: pre-wrap; }
        .soh-tf-text a { color: #005A9C; text-decoration: none; font-weight: 500; position: relative; z-index: 2; }
        .soh-tf-text a:hover { text-decoration: underline; }
        
        .soh-tf-media-grid { display: grid; gap: 4px; margin-top: 12px; border-radius: 16px; overflow: hidden; border: 1px solid #cfd9de; }
        .soh-tf-media-grid img { width: 100%; height: auto; display: block; }
        .soh-tf-video-preview { position: relative; }
        .soh-tf-video-play { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 48px; height: 48px; background: rgba(0,0,0,0.6); border-radius: 50%; display: flex; align-items: center; justify-content: center; pointer-events: none; }
        .soh-tf-video-play::after { content: ''; border-top: 10px solid transparent; border-bottom: 10px solid transparent; border-left: 16px solid #fff; margin-left: 4px; }
        
        .soh-tf-quote { border: 1px solid #cfd9de; border-radius: 16px; padding: 12px; margin-top: 12px; transition: background-color 0.2s ease; cursor: pointer; display: block; color: inherit; background-color: transparent; text-align: left; }
        .soh-tf-quote:hover { background-color: rgba(0,0,0,0.03); }
        .soh-tf-quote-header { display: flex; align-items: center; margin-bottom: 4px; font-size: 15px; }
        .soh-tf-quote-avatar { width: 20px; height: 20px; border-radius: 50%; margin-right: 8px; flex-shrink: 0; background-color: #eff3f4; }
        .soh-tf-quote .soh-tf-text { font-size: 15px; margin-bottom: 0; }
        .soh-tf-quote .soh-tf-media-grid { border: none; margin-top: 12px; border-radius: 12px; }
        .soh-tf-quote .soh-tf-media-grid img, 
        .soh-tf-quote .soh-tf-video-preview img { max-height: 250px; object-fit: cover; }
        
        .soh-tf-load-more { display: block; width: 100%; padding: 16px; background: transparent; border: none; color: #005A9C; font-size: 16px; cursor: pointer; transition: background-color 0.2s ease; font-weight: 600; }
        .soh-tf-load-more:hover { background-color: #f7f9f9; text-decoration: underline; }
        .soh-tf-load-more:disabled { color: #7f9ab0; cursor: not-allowed; text-decoration: none; }

        /* Dark Mode */
        .soh-tf-dark { background-color: #000000; border-color: #2f3336; color: #e7e9ea; }
        .soh-tf-dark .soh-tf-profile { background-color: #000000; border-color: #2f3336; }
        .soh-tf-dark .soh-tf-feed-scroll { background-color: #000000; }
        .soh-tf-dark .soh-tf-feed-scroll::-webkit-scrollbar-thumb { background-color: #2f3336; }
        .soh-tf-dark .soh-tf-tweet { border-color: #2f3336; }
        .soh-tf-dark .soh-tf-tweet:hover { background-color: #16181c; }
        .soh-tf-dark .soh-tf-profile-name, .soh-tf-dark .soh-tf-author { color: #e7e9ea; }
        .soh-tf-dark .soh-tf-profile-handle, .soh-tf-dark .soh-tf-context, .soh-tf-dark .soh-tf-handle, .soh-tf-dark .soh-tf-date, .soh-tf-dark .soh-tf-profile-metrics { color: #71767b; }
        .soh-tf-dark .soh-tf-context svg { fill: #71767b; }
        .soh-tf-dark .soh-tf-text a, .soh-tf-dark .soh-tf-profile-desc a, .soh-tf-dark .soh-tf-load-more { color: #1d9bf0; }
        .soh-tf-dark .soh-tf-quote { border-color: #2f3336; }
        .soh-tf-dark .soh-tf-quote:hover { background-color: rgba(255,255,255,0.03); }
        .soh-tf-dark .soh-tf-media-grid { border-color: #2f3336; }
        .soh-tf-dark .soh-tf-avatar, .soh-tf-dark .soh-tf-quote-avatar { border-color: #2f3336; background-color: #16181c; }
        .soh-tf-dark .soh-tf-load-more:hover { background-color: #16181c; }
    
/*# sourceURL=soh-tf-style-inline-css */
</style>
<link rel='stylesheet' id='bootstrapstyle-css' href='https://dod.hawaii.gov/hiema/wp-content/themes/soh_tyler_block_editor_template_parent/assets/css/bootstrap.min.css?ver=7.1.5' media='all' />
