      false"><div class="TwoColumnContainer_twoColumnLeftContainer__oKwcX"><div class="TestYourKnowledge_testYourKnowledgeContainer__KoeWd TestYourKnowledge_MarginTopSmall__LVKo_ innerCurvedBorder" data-testid="test-your-knowledge"><div class="TestYourKnowledge_testYourKnowImg__IIz3y" data-testid="test-your-knowledge-img"><img alt="quizzes_lightbulb_red" srcSet="/_next/image?url=https%3A%2F%2Fedge.sitecorecloud.io%2Fmmanual-ssq1ci05%2Fmedia%2Fmanual%2Fmarketing%2Fquizzes_lightbulb_red.png&amp;w=64&amp;q=75 1x, /_next/image?url=https%3A%2F%2Fedge.sitecorecloud.io%2Fmmanual-ssq1ci05%2Fmedia%2Fmanual%2Fmarketing%2Fquizzes_lightbulb_red.png&amp;w=128&amp;q=75 2x" src="/_next/image?url=https%3A%2F%2Fedge.sitecorecloud.io%2Fmmanual-ssq1ci05%2Fmedia%2Fmanual%2Fmarketing%2Fquizzes_lightbulb_red.png&amp;w=128&amp;q=75" width="64" height="52" decoding="async" data-nimg="1" loading="lazy" style="color:transparent"/></div><div class="TestYourKnowledge_testYourKnowDesc__6jdYS"><span class="TestYourKnowledge_text__odJna ">Test your Knowledge</span><a class="TestYourKnowledge_link__fHmmM" data-testid="test-your-knowledge-desc-link" href="/home/pages-with-widgets/quizzes">Take a Quiz!</a></div></div></div><div class="TwoColumnContainer_twoColumnRightContainer__imC5d"><div data-testid="marketing-block-container"><div class="MarketingBlock_marketingBlockContainer__mXv43" data-testid="marketing-block"><div class="MarketingBlock_marketingContainer__Xaao9"><div class="MarketingBlock_marketingBlockMobile__nRoQt MarketingBlock_customBorder__DYfTa innerCurvedBorder"><img useMap="#mobile258BF70F2F694C07AAEA9776CB47ED9D" alt="" srcSet="/_next/image?url=https%3A%2F%2Fedge.sitecorecloud.io%2Fmmanual-ssq1ci05%2Fmedia%2Fmanual%2Fmarketing%2Fmobile_qr%2Fsmall_mobile_images%2Fen_msd_mobile_con_326.png&amp;w=384&amp;q=75 1x, /_next/image?url=https%3A%2F%2Fedge.sitecorecloud.io%2Fmmanual-ssq1ci05%2Fmedia%2Fmanual%2Fmarketing%2Fmobile_qr%2Fsmall_mobile_images%2Fen_msd_mobile_con_326.png&amp;w=750&amp;q=75 2x" src="/_next/image?url=https%3A%2F%2Fedge.sitecorecloud.io%2Fmmanual-ssq1ci05%2Fmedia%2Fmanual%2Fmarketing%2Fmobile_qr%2Fsmall_mobile_images%2Fen_msd_mobile_con_326.png&amp;w=750&amp;q=75" width="326" height="100" decoding="async" data-nimg="1" class="innerCurvedBorder" loading="lazy" style="color:transparent"/><map name="mobile258BF70F2F694C07AAEA9776CB47ED9D"><area shape="RECT" coords="176,79,90,53" href="https://apps.apple.com/app/msd-consumer-version/id1124035048 " target="_blank" alt="iOS" />
<area shape="RECT" coords="202,51,297,80" href="https://play.google.com/store/apps/details?id=com.msd.consumer&referrer=utm_source%3DMMWeb%26utm_medium%3Dbanner%26utm_content%3DTopic1Vertical%26utm_campaign%3DWebAppAds"  target="_blank" alt="ANDROID" /></map></div><div class="MarketingBlock_marketingBlockTablet__H0mWd MarketingBlock_customBorder__DYfTa MarketingBlock_MarginTopSmall__ROo1v innerCurvedBorder"><img useMap="#tablet258BF70F2F694C07AAEA9776CB47ED9D" alt="" srcSet="/_next/image?url=https%3A%2F%2Fedge.sitecorecloud.io%2Fmmanual-ssq1ci05%2Fmedia%2Fmanual%2Fmarketing%2Fmobile_qr%2Fsmall_tablet_images%2Fen_msd_mobile_con_255.png&amp;w=256&amp;q=75 1x, /_next/image?url=https%3A%2F%2Fedge.sitecorecloud.io%2Fmmanual-ssq1ci05%2Fmedia%2Fmanual%2Fmarketing%2Fmobile_qr%2Fsmall_tablet_images%2Fen_msd_mobile_con_255.png&amp;w=640&amp;q=75 2x" src="/_next/image?url=https%3A%2F%2Fedge.sitecorecloud.io%2Fmmanual-ssq1ci05%2Fmedia%2Fmanual%2Fmarketing%2Fmobile_qr%2Fsmall_tablet_images%2Fen_msd_mobile_con_255.png&amp;w=640&amp;q=75" width="255" height="81" decoding="async" data-nimg="1" class="innerCurvedBorder" loading="lazy" style="color:transparent"/><map name="tablet258BF70F2F694C07AAEA9776CB47ED9D"><area shape="RECT" coords="176,79,90,53" href="https://apps.apple.com/app/msd-consumer-version/id1124035048 "  target="_blank" alt="iOS" />
<area shape="RECT" coords="202,51,297,80" href="https://play.google.com/store/apps/details?id=com.msd.consumer&referrer=utm_source%3DMMWeb%26utm_medium%3Dbanner%26utm_content%3DTopic1Vertical%26utm_campaign%3DWebAppAds" target="_blank" alt="ANDROID" /></map></div><div class="MarketingBlock_marketingBlockDesktop__I6YiW MarketingBlock_customBorder__DYfTa MarketingBlock_MarginTopSmall__ROo1v innerCurvedBorder"><img useMap="#desktop258BF70F2F694C07AAEA9776CB47ED9D" alt="" srcSet="/_next/image?url=https%3A%2F%2Fedge.sitecorecloud.io%2Fmmanual-ssq1ci05%2Fmedia%2Fmanual%2Fmarketing%2Fmobile_qr%2Fsmall_desktop_images%2Fen_msd_mobile_qr_con_322.png&amp;w=384&amp;q=75 1x, /_next/image?url=https%3A%2F%2Fedge.sitecorecloud.io%2Fmmanual-ssq1ci05%2Fmedia%2Fmanual%2Fmarketing%2Fmobile_qr%2Fsmall_desktop_images%2Fen_msd_mobile_qr_con_322.png&amp;w=750&amp;q=75 2x" src="/_next/image?url=https%3A%2F%2Fedge.sitecorecloud.io%2Fmmanual-ssq1ci05%2Fmedia%2Fmanual%2Fmarketing%2Fmobile_qr%2Fsmall_desktop_images%2Fen_msd_mobile_qr_con_322.png&amp;w=750&amp;q=75" width="322" height="99" decoding="async" data-nimg="1" class="innerCurvedBorder" loading="lazy" style="color:transparent"/><map name="desktop258BF70F2F694C07AAEA9776CB47ED9D"><area shape="RECT" coords="176,79,90,53" href="https://apps.apple.com/app/msd-consumer-version/id1124035048 "  target="_blank" alt="iOS" />
