anguage Selector","displayName":"Language Selector","url":{"path":"/components/stickyicons/language-selector"},"title":{"value":"Language Selector"},"Type":{"value":"LanguageSwitcher"},"PageType":{"value":"All"},"Link":{"targetItem":null},"Hide":{"boolValue":false},"icon":{"height":70,"width":70,"alt":"open-lang-selector","src":"https://edge.sitecorecloud.io/mmanual-ssq1ci05/media/manual/sticky-icons/open-lang-selector.png","title":""},"hovericon":{"height":null,"width":null,"alt":null,"src":null,"title":null}}]}}},"94d783e0-8321-401b-bdae-8d9f6abf8f70":{"items":[{"title":"First Aid","url":"/home/injuries-and-poisoning/first-aid"}],"schema":{"itemListElement":[{"@type":"ListItem","item":{"@type":"Thing","@id":"/home","name":"Home"},"position":1},{"@type":"ListItem","item":{"@type":"Thing","@id":"/home/injuries-and-poisoning","name":"Injuries and Poisoning"},"position":2},{"@type":"ListItem","item":{"@type":"Thing","@id":"/home/injuries-and-poisoning/first-aid","name":"First Aid"},"position":3},{"@type":"ListItem","item":{"@type":"Thing","@id":"/home/injuries-and-poisoning/first-aid/first-aid-for-cuts-scrapes-and-wounds","name":"First Aid for Cuts, Scrapes, and Wounds"},"position":4}]},"IsBreadcrumbSchema":{"value":"1"}},"b1387fca-b4de-41ad-802c-22cba767f18e":{"context":"","layoutData":{"htmltotextpageTitle":"First Aid for Cuts, Scrapes, and Wounds","htmltotextpageName":"v829525","topicSubLinks":"First-Aid-for-Cuts,-Scrapes,-and-Other-Wounds_v829544","IsHealthAndWellness":false,"IsZoonotic":false,"IsQuickFactsTag":false},"firstUnrestrictedImageUrl":"https://edge.sitecorecloud.io/mmanual-ssq1ci05/media/manual/seo/promotional_share_msd.jpg","firstImageAlt":"Promotional Share Msd","robotsTagCheck":false,"domainUrl":"https://www.msdmanuals.com"},"7b2e0c31-6d50-4048-87a8-6b95292926b9":{"videoListObject":[],"audioListObject":[]},"0df15f35-1520-47ba-8557-976c2d6497da":{"domainUrl":"https://www.msdmanuals.com","websiteUrl":"https://www.msdmanuals.com","shareImagePath":"https://edge.sitecorecloud.io/mmanual-ssq1ci05/media/manual/seo/promotional_share_msd.jpg","socialLinks":[],"logoUrl":"https://www.msdmanuals.com/_next/image?url=https://edge.sitecorecloud.io/mmanual-ssq1ci05/media/manual/brand-logos/mm_logo.svg\u0026w=64\u0026q=75","dateModified":"","datePublished":"","htmltotextFooterText":"Brought to you by Merck \u0026 Co, Inc., Rahway, NJ, USA (known as MSD outside the US and Canada)—dedicated to using leading-edge\nscience to save and improve lives around the world. Learn more about the MSD Manuals and our commitment to Global Medical\nKnowledge [/en/home/resourcespages/global-medical-knowledge]."},"04fd527e-35f2-480f-871f-ce7c9d329a31":{"dateModified":"2026-05-08","datePublished":"2026-05-01","synonym":"","definitionItemFound":false,"keypointItemFound":false,"imageData":[],"domainUrl":"https://www.msdmanuals.com","audience":["http://schema.org/Patient"],"authorList":[{"authorUrl":"https://www.msdmanuals.com/home/authors/jordan-jaime","authorname":"Jaime Jordan","username":"JORDAN.JAIME"}],"reviewerList":[],"potentialActionUrl":"https://www.msdmanuals.com/home/searchresults?query={search_term}","relatedLinks":["/professional/searchresults?query=first+aid+for+cuts%2c+scrapes%2c+and+wounds\u0026icd9=mm724%3b873.0%3b873.1%3b873.20%3b873.4%3b873.5%3b873.8%3b873.9%3b874.8%3b875.0%3b876.0%3b878.4%3b878.5%3b878.6%3b878.7%3b878.8%3b878.9%3b879%3b880%3b881%3b882%3b883%3b884%3b890%3b891%3b892%3b893%3b894%3b877.0"]},"ebce85a2-47e5-45dd-97f6-dd2d9e347dbf":{"props":{"datasource":{"SectionDetails":{"parent":{"parent":{"SectionTitle":{"value":"Injuries and Poisoning"}}}},"ChapterAuthorDetails":{"parent":{"Author":{"fields":[{"Affiliation":{"jsonValue":{"value":"\u003cul \u003e\u003cli \u003eAssociate Clinical Professor, Emergency Medicine\u003c/li\u003e\u003cli class='affiliation' \u003e\u003ca href=\"https://www.uclahealth.org/providers/jaime-jordan\"\u003eUCLA School of Medicine\u003c/a\u003e\u003c/li\u003e\u003cli \u003eAssociate Program Director\u003c/li\u003e\u003cli class='affiliation' \u003e\u003ca href=\"https://www.uclahealth.org/reagan/\"\u003eRonald Reagan UCLA Medical Center\u003c/a\u003e\u003c/li\u003e\u003c/ul\u003e"}},"AuthorName":{"jsonValue":{"value":"Jaime Jordan"}},"Degree":{"jsonValue":{"value":"MD"}},"ProfileUrl":{"jsonValue":{"value":""}},"UserName":{"jsonValue":{"value":"JORDAN.JAIME"}},"htmltostrAff":["UCLA School of Medicine","Ronald Reagan UCLA Medical Center"],"CurrentEdition":"home"}]},"CoAuthor":{"fields":[]},"Reviewer":{"fields":[]}}},"TopicAuthorDetails":{"Author":{"fields":[]},"CoAuthor":{"fields":[]},"Reviewer":{"fields":[]}},"TopicData":{"ICD9":{"value":"MM724;873.0;873.1;873.20;873.4;873.5;873.8;873.9;874.8;875.0;876.0;878.4;878.5;878.6;878.7;878.8;878.9;879;880;881;882;883;884;890;891;892;893;894;877.0"},"ICD9CM":{"value":""},"ICD10":{"value":"S01.0;S01.2;S01.4;S01.5;S01.8;S01.9;S11.8;S11.9;S21.0;S21.1;S21.2;S21.9;S31.0;S31.1;S31.8;S41;S51;S61;S71;S81;S91"},"ICD10CM":{"value":""},"ICD11":{"value":""},"LOINC":{"value":""},"SNOMEDCT":{"value":""},"MESH":{"value":""},"MMEdition":{"value":"Home"},"ContentType":{"value":"Topic"},"IsHealthAndWellness":{"value":false},"ItemPath":{"path":"/home/injuries-and-poisoning/first-aid/first-aid-for-cuts-scrapes-and-wounds"},"RxNorm":{"value":""},"Synonym":{"value":""},"RevisionDate":{"value":"2026-05-01T00:00:00Z"},"ModificationDate":{"value":"20260508"},"ChapterMetaData":{"value":""},"QuickFactsSwitchLink":{"jsonValue":{"value":{"href":""}}},"Whatsnew":{"value":""},"Keywords":{"value":"cuts,tears in tissue,lacerations,scrapes,abrasions,puncture wounds,contaminated wounds,splinters,glass wounds,fever,tetanus vaccination"},"Summary":{"value":"Cuts or tears in tissue (lacerations), scrapes (abrasions), and puncture wounds can be caused by contact with sharp objects, bites , or by other mechanisms. Wounds that are not caused by bites..."},"ZooRelation":{"value":""},"IsZoonotic":{"value":false},"CitationReferences":""},"datasource":{"datesToDisplay":{"revisionDate":"May 2026","modificationDate":"May 2026","isupdateOlderThanRevision":false},"Drugs":{"jsonValue":{"value":"[]"}},"LeftMenuNavigation":{"jsonValue":{"value":"[{\"Title\":\"First Aid for Cuts, Scrapes, and Other Wounds\",\"UniqueID\":\"v829544\",\"Index\":1.0,\"Summary\":\"\u003cspan id=\\\"v829546\\\" class=\\\"anchor\\\" \u003e\u003c/span\u003e\u003cdiv class=\\\"para\\\" \u003e \u003cp \u003eThe first step in treating a cut is to stop the bleeding. Visible bleeding can almost always be stopped by placing a gauze pad or clean cloth over the bleeding area and firmly compressing the area with a finger or hand for at least 5 minutes. Whenever possible, the bleeding part is elevated above the level of the heart. \u003c/p\u003e\u003c/div\u003e\",\"HeadType\":\"F_Head\",\"SchemeItemProp\":\"itemprop=\\\"possibleTreatment\\\" itemscope itemtype=\\\"http://schema.org/MedicalTherapy\\\"\",\"Children\":[]}]"}},"totalResourcesCount":0,"Resources":{"jsonValue":{"value":"null"}},"name":"v829525","ViewModel":{"jsonValue":{"value":{"$type":"MM.Foundation.Vasont.Framework.ViewModel.ContainerViewModel, MM.Foundation.Vasont","tk":"VasontContainer","c":[{"$type":"MM.Feature.Vasont.Presentation.Para.ParaViewModel, MM.Feature.Vasont","ExcludeFromBrand":"","Indent":"","tk":"VasontPara","c":[{"$type":"MM.Feature.Vasont.Presentation.Text.String.StringViewModel, MM.Feature.Vasont","c":[],"it":"Cuts or tears in tissue (lacerations), scrapes (abrasions), and puncture wounds can be caused by contact with sharp objects, "},{"$type":"MM.Foundation.Presentation.Vasont.XRef.BaseXRefViewModel, MM.Foundation.Presentation","Xlinktext":"bites","tk":"VasontXLink","ItemId":"c7716ebb-64df-40f8-8991-bd31b1728970","Id":"ca064467-862c-46ec-a86a-a4f74882d20b","Url":"/home/injuries-and-poisoning/bites-and-stings/introduction-to-bites-and-stings","Summary":"Many creatures, including humans , bite when frightened or provoked. Others include Common pets (such as cats or dogs) or other animals Alligators and crocodiles Iguanas Mites","PlainTitle":"Introduction to Bites and Stings","ReadMore":"read more","ShowToolTip":"true","c":[{"$type":"MM.Feature.Vasont.Presentation.Text.String.StringViewModel, MM.Feature.Vasont","c":[],"it":"bites"}]},{"$type":"MM.Feature.Vasont.Presentation.Text.String.StringViewModel, MM.Feature.Vasont","c":[],"it":", or by other mechanisms. Wounds that are not caused by bites and are clean and relatively small usually heal rapidly without any problems. However, some wounds can cause extensive blood loss. "}],"id":"v829538","a":""},{"$type":"MM.Feature.Vasont.Presentation.Para.ParaViewModel, MM.Feature.Vasont","ExcludeFromBrand":"","Indent":"","tk":"VasontPara","c":[{"$type":"MM.Feature.Vasont.Presentation.Text.String.StringViewModel, MM.Feature.Vasont","c":[],"it":"In some wounds, deeper structures, such as nerves, tendons, or blood vessels, are also injured. Wounds can become infected. A piece of foreign material (such as a splinter, glass, or a clothing fragment) can also remain hidden inside a wound, causing later problems such as infection, prolonged pain, or delayed healing."}],"id":"v38403703","a":""},{"$type":"MM.Feature.Vasont.Presentation.Para.ParaViewModel, MM.Feature.Vasont","ExcludeFromBrand":"","Indent":"","tk":"VasontPara","c":[{"$type":"MM.Feature.Vasont.Presentation.Text.String.StringViewModel, MM.Feature.Vasont","c":[],"it":"Shallow cuts to most areas of the skin rarely bleed much and often stop bleeding on their own. Cuts to the hand and scalp as well as cuts to arteries and larger veins often bleed vigorously."}],"id":"v829540","a":""},{"$type":"MM.Feature.Tables.Presentation.BaseIllustrativeMaterial.ViewModel, MM.Feature.Tables","MaterialType":"DidYouKnow","NewInVersion":"MM18","MMEdition":1,"TypeCalss":"inlinebox--didyouknow","Alignment":"inlinebox--right","MultiMediaModel":{"$type":"MM.Feature.Tables.Popup.TableMultimediaModel, MM.Feature.Tables","ItemId":"0fbe87c7-a340-4c4d-b2ad-088788b1ac8a","Title":"Did You Know...","ShareUrlTitle":"did-you-know","ThumbnailUrl":"/Base/table/icon_table_red.png?h=600\u0026w=600","MediaType":"table","MediaNameTranslated":"Table","UniqueId":"v55358846"},"Placement":1,"PlacementClass":"","PlacementType":"sideline","tk":"DidYouKnow","c":[{"$type":"MM.Feature.Tables.Presentation.Table.TableViewModel, MM.Feature.Tables","TabStyle":"SidebarHalfPage","TitleModel":[],"c":[{"$type":"MM.Feature.Tables.Presentation.Table.Group.TableGroupViewModel, MM.Feature.Tables","TBody":{"$type":"MM.Feature.Tables.Presentation.Table.Section.TableSectionViewModel, MM.Feature.Tables","Rows":[],"RowCounter":1,"tk":"tbody","c":[{"$type":"MM.Feature.Tables.Presentation.Table.Row.TableRowViewModel, MM.Feature.Tables","Columns":[],"CssClass":"","IsOdd":true,"IsTBody":true,"c":[{"$type":"MM.Feature.Tables.Presentation.Table.Cell.TableCellViewModel, MM.Feature.Tables","align":"","c":[{"$type":"MM.Feature.Vasont.Presentation.List.ListViewModel, MM.Feature.Vasont","tk":"VasontList","TitleModel":[],"c":[{"$type":"MM.Feature.Vasont.Presentation.List.Items.ListItemViewModel, MM.Feature.Vasont","c":[{"$type":"MM.Feature.Vasont.Presentation.Para.ParaViewModel, MM.Feature.Vasont","ExcludeFromBrand":"","Indent":"","tk":"VasontPara","c":[{"$type":"MM.Feature.Vasont.Presentation.Text.String.StringViewModel, MM.Feature.Vasont","c":[],"it":"Even shallow cuts to the scalp or fingertip may bleed vigorously."}],"id":"v55358855","a":""}]}],"a":"bulleted"}]}]}],"id":"v55358850"},"Columns":[{"$type":"MM.Feature.Tables.Presentation.Table.TableColumn, MM.Feature.Tables","Index":1,"Name":"col1"}],"ColumnsCount":1,"TabStyle":"SidebarHalfPage","c":[],"tl":{"$type":"MM.Foundation.Vasont.Framework.ViewModel.ContainerViewModel, MM.Foundation.Vasont","tk":"VasontContainer","c":[{"$type":"MM.Feature.Vasont.Presentation.Text.String.StringViewModel, MM.Feature.Vasont","c":[],"it":"Did You Know..."}],"id":"v8381018"},"id":"v55358846"}],"tl":{"$type":"MM.Foundation.Vasont.Framework.ViewModel.ContainerViewModel, MM.Foundation.Vasont","tk":"VasontContainer","c":[{"$type":"MM.Feature.Vasont.Presentation.Text.String.StringViewModel, MM.Feature.Vasont","c":[],"it":"Did You Know..."}],"id":"v8381018"},"id":"v55358846"}],"tl":{"$type":"MM.Foundation.Vasont.Framework.ViewModel.ContainerViewModel, MM.Foundation.Vasont","tk":"VasontContainer","c":[{"$type":"MM.Feature.Vasont.Presentation.Text.String.StringViewModel, MM.Feature.Vasont","c":[],"it":"Did You Know..."}],"id":"v8381018"},"id":"v55358845","e":"Print"},{"$type":"MM.Feature.Vasont.Presentation.Para.ParaViewModel, MM.Feature.Vasont","ExcludeFromBrand":"","Indent":"","tk":"VasontPara","c":[{"$type":"MM.Feature.Vasont.Presentation.Text.String.StringViewModel, MM.Feature.Vasont","c":[],"it":"Infection can develop when a wound is contaminated with dirt and bacteria. Although any wound can become infected, infection is particularly likely in deep scrapes, which grind dirt into the skin, and in puncture wounds (particularly those resulting from "},{"$type":"MM.Foundation.Presentation.Vasont.XRef.BaseXRefViewModel, MM.Foundation.Presentation","Xlinktext":"animal bites","tk":"VasontXLink","ItemId":"c26425a3-13d9-4667-9a17-21aba8a09553","Id":"30dc4fb6-afb1-4d3d-a0ec-7edf7ee24600","Url":"/home/injuries-and-poisoning/bites-and-stings/animal-bites","Summary":"Most animal bites in the United States are from dogs and cats. Wounds should be cleaned and cared for as soon as possible. (See also Introduction to Bites and Stings .) Although any animal may...","PlainTitle":"Animal Bites","ReadMore":"read more","ShowToolTip":"true","c":[{"$type":"MM.Feature.Vasont.Presentation.Text.String.StringViewModel, MM.Feature.Vasont","c":[],"it":"animal bites"}]},{"$type":"MM.Feature.Vasont.Presentation.Text.String.StringViewModel, MM.Feature.Vasont","c":[],"it":" or "},{"$type":"MM.Foundation.Presentation.Vasont.XRef.BaseXRefViewModel, MM.Foundation.Presentation","Xlinktext":"human bites","tk":"VasontXLink","ItemId":"811ac9bf-2683-407c-a7d6-df7d237bd538","Id":"716203f6-b52f-4a71-be76-be2ba7e70b92","Url":"/home/injuries-and-poisoning/bites-and-stings/human-bites","Summary":"Because human teeth are not particularly sharp, most human bites cause no injury or just a bruise and a shallow wound ( laceration ). Exceptions are on fleshy appendages, such as the ears or...","PlainTitle":"Human Bites","ReadMore":"read more","ShowToolTip":"true","c":[{"$type":"MM.Feature.Vasont.Presentation.Text.String.StringViewModel, MM.Feature.Vasont","c":[],"it":"human bites"}]},{"$type":"MM.Feature.Vasont.Presentation.Text.String.StringViewModel, MM.Feature.Vasont","c":[],"it":"), which introduce contamination deep under the skin. Also, wounds that contain foreign material frequently become infected. The longer a wound remains contaminated, the more likely it is that infection will develop."}],"id":"v829541","a":""},{"$type":"MM.Feature.Vasont.Presentation.Para.ParaViewModel, MM.Feature.Vasont","ExcludeFromBrand":"","Indent":"","tk":"VasontPara","c":[{"$type":"MM.Feature.Vasont.Presentation.Text.String.StringViewModel, MM.Feature.Vasont","c":[],"it":"Wounds can be painful at first, but usually the pain lessens after the first day. If a cut affects a nerve or tendon, the person may be unable to move the body part fully. Some nerve injuries cause weakness or paralysis, loss of sensation, or numbness. If foreign material remains inside a puncture wound, the part of the wound near the material is usually painful when touched."}],"id":"v829542","a":""},{"$type":"MM.Feature.Vasont.Presentation.Para.ParaViewModel, MM.Feature.Vasont","ExcludeFromBrand":"","Indent":"","tk":"VasontPara","c":[{"$type":"MM.Feature.Vasont.Presentation.Text.String.StringViewModel, MM.Feature.Vasont","c":[],"it":"Pain that worsens a day or more after the injury is often the first sign of infection. Later, an infected wound may become red and swollen and may ooze pus. A fever may also develop."}],"id":"v829543","a":""},{"$type":"MM.Feature.Vasont.Presentation.Para.ParaViewModel, MM.Feature.Vasont","ExcludeFromBrand":"","Indent":"","tk":"VasontPara","c":[{"$type":"MM.Foundation.Presentation.Vasont.XRef.BaseXRefViewModel, MM.Foundation.Presentation","Xlinktext":"Necrotizing skin infections","tk":"VasontXLink","ItemId":"f226fa51-d521-4d7c-9e99-8db51a897f9a","Id":"6e9376b6-fb4a-49e7-8cd4-bba7607a4771","Url":"/home/infections/bacterial-skin-infections/necrotizing-skin-infections","ImageUrl":"/-/media/home/images/3/8/9/389_necrotizing_fasciitis_slide_13_springer_high.jpg?thn=0\u0026sc_lang=en\u0026mh=160\u0026mw=160","Summary":"Necrotizing skin infections, including necrotizing cellulitis and necrotizing fasciitis, are severe forms of cellulitis . These infections cause infected skin and tissues to die (necrosis)....","PlainTitle":"Necrotizing Skin Infections","HasImage":true,"ReadMore":"read more","ShowToolTip":"true","c":[{"$type":"MM.Feature.Vasont.Presentation.Text.String.StringViewModel, MM.Feature.Vasont","c":[],"it":"Necrotizing skin infections"}]},{"$type":"MM.Feature.Vasont.Presentation.Text.String.StringViewModel, MM.Feature.Vasont","c":[],"it":" are rapidly progressing infections that threaten life and limb that can occur even after a very minor skin wound."}],"id":"v38403707","a":""},{"$type":"MM.Feature.Vasont.Presentation.Headers.F_Head.F_HeadViewModel, MM.Feature.Vasont","SchemaAttributes":"itemprop=\"possibleTreatment\" itemscope itemtype=\"http://schema.org/MedicalTherapy\"","KeypointsClass":"","HeaderId":"Treatment_v829545","OriginalTitle":{"$type":"MM.Foundation.Vasont.Framework.ViewModel.ContainerViewModel, MM.Foundation.Vasont","tk":"VasontContainer","t":"Text/Title","c":[{"$type":"MM.Feature.Vasont.Presentation.Text.String.StringViewModel, MM.Feature.Vasont","c":[],"it":"First Aid for Cuts, Scrapes, and Other Wounds"}]},"HeaderType":"FHead","HeaderTag":"h2","SectionClass":"section","TitleModel":[],"TitleUniqueId":"v829545","tk":"F_HeadViewModel","c":[{"$type":"MM.Feature.Vasont.Presentation.Para.ParaViewModel, MM.Feature.Vasont","ExcludeFromBrand":"","Indent":"","tk":"VasontPara","c":[{"$type":"MM.Feature.Vasont.Presentation.Text.String.StringViewModel, MM.Feature.Vasont","c":[],"it":"The first step in treating a cut is to stop the bleeding. Visible bleeding can almost always be stopped by placing a gauze pad or clean cloth over the bleeding area and firmly compressing the area with a finger or hand for at least 5 minutes. Whenever possible, the bleeding part is elevated above the level of the heart. "}],"id":"v829546","a":""},{"$type":"MM.Feature.Vasont.Presentation.Para.ParaViewModel, MM.Feature.Vasont","ExcludeFromBrand":"","Indent":"","tk":"VasontPara","c":[{"$type":"MM.Feature.Vasont.Presentation.Text.String.StringViewModel, MM.Feature.Vasont","c":[],"it":"If the bleeding is on an arm or leg and continues after pressure has been applied, a tourniquet can be applied by anyone who has been trained to use one. This is usually required only in severe injuries (for example, gunshot wounds, deep penetrating stab injuries, large deep cuts, or amputations. Tourniquets should be used only until the person can be evaluated and treated by a doctor. (See "},{"$type":"MM.Feature.Vasont.Presentation.Link.LinkViewModel, MM.Feature.Vasont","ExternalURL":"https://www.stopthebleed.org/","Value":"Stop the Bleed.org","Title":"Stop the Bleed.org","TitleModel":[],"c":[],"a":"rel=\"noopener nofollow\" target=\"_blank\""},{"$type":"MM.Feature.Vasont.Presentation.Text.String.StringViewModel, MM.Feature.Vasont","c":[],"it":" for additional information on tourniquet use.)"}],"id":"x000012","a":""},{"$type":"MM.Feature.Vasont.Presentation.Para.ParaViewModel, MM.Feature.Vasont","ExcludeFromBrand":"","Indent":"","tk":"VasontPara","c":[{"$type":"MM.Feature.Vasont.Presentation.Text.String.StringViewModel, MM.Feature.Vasont","c":[],"it":"To prevent infection, dirt and particles are removed and the wound is washed. Large, visible particles are picked off. Smaller dirt and particles that cannot be seen are removed by washing with mild soap and tap water. Gentle scrubbing may be required to cleanse deep scrapes. Colder temperature water may allow the blood vessels to constrict, helping to slow the bleeding. Dirt and particles that remain after washing often can be removed with a more highly pressured stream of warm tap water. Harsher agents, such as alcohol, iodine, and peroxide, are not recommended. These solutions can damage tissue, impairing the capacity to heal. "}],"id":"v829548","a":""},{"$type":"MM.Feature.Vasont.Presentation.Para.ParaViewModel, MM.Feature.Vasont","ExcludeFromBrand":"","Indent":"","tk":"VasontPara","c":[{"$type":"MM.Feature.Vasont.Presentation.Text.String.StringViewModel, MM.Feature.Vasont","c":[],"it":"If a wound is very small, it can be kept closed with first aid tape or skin adhesive (products that are used specifically for closing a small wound). Stitches may be needed for deep or large cuts. Stitches should be placed only by a health care professional. After cleansing and, if necessary, closing the wound, antibiotic ointment and a bandage are applied. Antibiotic ointments should not be applied if specialized tape or skin adhesive has been used for wound closure."}],"id":"v38403709","a":""},{"$type":"MM.Feature.Vasont.Presentation.Para.ParaViewModel, MM.Feature.Vasont","ExcludeFromBrand":"","Indent":"","tk":"VasontPara","c":[{"$type":"MM.Feature.Vasont.Presentation.Text.String.StringViewModel, MM.Feature.Vasont","c":[],"it":"Medical assistance is needed under the following circumstances:"}],"id":"v829549","a":""},{"$type":"MM.Feature.Vasont.Presentation.List.ListViewModel, MM.Feature.Vasont","tk":"VasontList","TitleModel":[],"c":[{"$type":"MM.Feature.Vasont.Presentation.List.Items.ListItemViewModel, MM.Feature.Vasont","c":[{"$type":"MM.Feature.Vasont.Presentation.Para.ParaViewModel, MM.Feature.Vasont","ExcludeFromBrand":"","Indent":"","tk":"VasontPara","c":[{"$type":"MM.Feature.Vasont.Presentation.Text.String.StringViewModel, MM.Feature.Vasont","c":[],"it":"If a cut is longer than about ⅓ inch (¾ centimeter), is on the face, appears deep, or has edges that separate"}],"id":"v1380831","a":""}]},{"$type":"MM.Feature.Vasont.Presentation.List.Items.ListItemViewModel, MM.Feature.Vasont","c":[{"$type":"MM.Feature.Vasont.Presentation.Para.ParaViewModel, MM.Feature.Vasont","ExcludeFromBrand":"","Indent":"","tk":"VasontPara","c":[{"$type":"MM.Feature.Vasont.Presentation.Text.String.StringViewModel, MM.Feature.Vasont","c":[],"it":"If bleeding does not stop on its own or within several minutes after pressure is applied"}],"id":"v1380832","a":""}]},{"$type":"MM.Feature.Vasont.Presentation.List.Items.ListItemViewModel, MM.Feature.Vasont","c":[{"$type":"MM.Feature.Vasont.Presentation.Para.ParaViewModel, MM.Feature.Vasont","ExcludeFromBrand":"","Indent":"","tk":"VasontPara","c":[{"$type":"MM.Feature.Vasont.Presentation.Text.String.StringViewModel, MM.Feature.Vasont","c":[],"it":"If there are symptoms of a nerve or tendon injury, such as loss of sensation or loss of movement"}],"id":"v1380833","a":""}]},{"$type":"MM.Feature.Vasont.Presentation.List.Items.ListItemViewModel, MM.Feature.Vasont","c":[{"$type":"MM.Feature.Vasont.Presentation.Para.ParaViewModel, MM.Feature.Vasont","ExcludeFromBrand":"","Indent":"","tk":"VasontPara","c":[{"$type":"MM.Feature.Vasont.Presentation.Text.String.StringViewModel, MM.Feature.Vasont","c":[],"it":"If a scrape is deep or has dirt and particles that are difficult to remove"}],"id":"v1380834","a":""}]},{"$type":"MM.Feature.Vasont.Presentation.List.Items.ListItemViewModel, MM.Feature.Vasont","c":[{"$type":"MM.Feature.Vasont.Presentation.Para.ParaViewModel, MM.Feature.Vasont","ExcludeFromBrand":"","Indent":"","tk":"VasontPara","c":[{"$type":"MM.Feature.Vasont.Presentation.Text.String.StringViewModel, MM.Feature.Vasont","c":[],"it":"If there is a puncture wound, particularly if foreign material in the wound is likely"}],"id":"v1380835","a":""}]},{"$type":"MM.Feature.Vasont.Presentation.List.Items.ListItemViewModel, MM.Feature.Vasont","c":[{"$type":"MM.Feature.Vasont.Presentation.Para.ParaViewModel, MM.Feature.Vasont","ExcludeFromBrand":"","Indent":"","tk":"VasontPara","c":[{"$type":"MM.Feature.Vasont.Presentation.Text.String.StringViewModel, MM.Feature.Vasont","c":[],"it":"If the person has not had a "},{"$type":"MM.Foundation.Presentation.Vasont.XRef.BaseXRefViewModel, MM.Foundation.Presentation","Xlinktext":"tetanus vaccination","tk":"VasontXLink","ItemId":"c5e0ab39-d560-47c3-90fd-1ed4fc2e4255","Id":"b7160219-697e-4544-9c7c-ef439389857d","Url":"/home/infections/bacterial-infections-anaerobic-bacteria/tetanus#v81568178","Summary":"Tetanus is poisoning that results from a toxin produced by the anaerobic bacteria \u003ci\u003eClostridium tetani\u003c/i\u003e. Tetanus usually develops after a wound or an injury that breaks the skin becomes...","PlainTitle":"Vaccination","ReadMore":"read more","ShowToolTip":"true","c":[{"$type":"MM.Feature.Vasont.Presentation.Text.String.StringViewModel, MM.Feature.Vasont","c":[],"it":"tetanus vaccination"}]},{"$type":"MM.Feature.Vasont.Presentation.Text.String.StringViewModel, MM.Feature.Vasont","c":[],"it":" within the past 5 years"}],"id":"v1380836","a":""}]}],"a":"bulleted"},{"$type":"MM.Feature.Vasont.Presentation.Para.ParaViewModel, MM.Feature.Vasont","ExcludeFromBrand":"","Indent":"","tk":"VasontPara","c":[{"$type":"MM.Feature.Vasont.Presentation.Text.String.StringViewModel, MM.Feature.Vasont","c":[],"it":"All wounds, whether treated at home or by health care professionals, should be observed for symptoms of infection (worsening redness, tenderness, warmth, or drainage of pus) during the first several days after treatment. "},{"$type":"MM.Feature.Vasont.Presentation.Text.TextViewModel, MM.Feature.Vasont","tk":"VasontItalic","t":"Text/Italic","c":[{"$type":"MM.Feature.Vasont.Presentation.Text.String.StringViewModel, MM.Feature.Vasont","c":[],"it":"If any symptoms of infection develop (such as fever, pus in or leaking from the wound, or redness increasing around the wound), medical assistance should be sought as quickly as possible (within several hours)."}]}],"id":"v829557","a":""},{"$type":"MM.Feature.Vasont.Presentation.Para.ParaViewModel, MM.Feature.Vasont","ExcludeFromBrand":"","Indent":"","tk":"VasontPara","c":[{"$type":"MM.Feature.Vasont.Presentation.Text.String.StringViewModel, MM.Feature.Vasont","c":[],"it":"Most small wounds heal within a few days."}],"id":"v38403711","a":""}],"tl":{"$type":"MM.Foundation.Vasont.Framework.ViewModel.ContainerViewModel, MM.Foundation.Vasont","tk":"VasontContainer","t":"Text/Title","c":[{"$type":"MM.Feature.Vasont.Presentation.Text.String.StringViewModel, MM.Feature.Vasont","c":[],"it":"First Aid for Cuts, Scrapes, and Other Wounds"}]},"id":"v829544"}]}}},"NutShell":{"jsonValue":{"value":""}},"topicid":"414CFD515AFF42929A806BD77EC1A73C","othertopics":{"MMTopic":{"results":[{"title":{"value":"Basic First Aid Supplies"},"id":"DCE074399BE94A52809F96E8235FA7E7","url":{"url":"/home/injuries-and-poisoning/first-aid/basic-first-aid-supplies","path":"/home/injuries-and-poisoning/first-aid/basic-first-aid-supplies"},"sortIndex":{"value":""}},{"title":{"value":"Steps in Emergency First Aid"},"id":"77D1C94D9C264E77A0EF96D4D1D3B0EF","url":{"url":"/home/injuries-and-poisoning/first-aid/steps-in-emergency-first-aid","path":"/home/injuries-and-poisoning/first-aid/steps-in-emergency-first-aid"},"sortIndex":{"value":""}},{"title":{"value":"Choking"},"id":"1678BD61584E43028C19F0B650BA7688","url":{"url":"/home/injuries-and-poisoning/first-aid/choking","path":"/home/injuries-and-poisoning/first-aid/choking"},"sortIndex":{"value":""}},{"title":{"value":"Internal Bleeding"},"id":"0014C1B25BBD44AC8CF9F2D5DBC8E7F0","url":{"url":"/home/injuries-and-poisoning/first-aid/internal-bleeding","path":"/home/injuries-and-poisoning/first-aid/internal-bleeding"},"sortIndex":{"value":""}},{"title":{"value":"First Aid for Severed or Constricted Limbs, Fingers, or Toes"},"id":"CEA2BF46B1514ECBA5E96A5DD027E2A1","url":{"url":"/home/injuries-and-poisoning/first-aid/first-aid-for-severed-or-constricted-limbs-fingers-or-toes","path":"/home/injuries-and-poisoning/first-aid/first-aid-for-severed-or-constricted-limbs-fingers-or-toes"},"sortIndex":{"value":""}},{"title":{"value":"First Aid for Strains, Sprains, or Bruises"},"id":"E06B77A856D744559C0CBB97FA958D05","url":{"url":"/home/injuries-and-poisoning/first-aid/first-aid-for-strains-sprains-or-bruises","path":"/home/injuries-and-poisoning/first-aid/first-aid-for-strains-sprains-or-bruises"},"sortIndex":{"value":""}},{"title":{"value":"First Aid for Cuts, Scrapes, and Wounds"},"id":"414CFD515AFF42929A806BD77EC1A73C","url":{"url":"/home/injuries-and-poisoning/first-aid/first-aid-for-cuts-scrapes-and-wounds","path":"/home/injuries-and-poisoning/first-aid/first-aid-for-cuts-scrapes-and-wounds"},"sortIndex":{"value":""}}]}},"Title":{"jsonValue":{"value":"First Aid for Cuts, Scrapes, and Wounds"}},"pageTitle":{"value":"First Aid for Cuts, Scrapes, and Wounds"},"SeoDescription":{"value":"Cuts or tears in tissue (lacerations), scrapes (abrasions), and puncture wounds can be caused by contact with sharp objects, bites , or by other mechanisms. Wounds that are not caused by bites..."},"SEOType":{"value":"general"},"OptimizedTitle":{"value":"First Aid for Cuts, Scrapes, and Wounds"},"mTitle":{"value":"First Aid for Cuts, Scrapes, and Wounds"},"leftNavHtmlTostr":[{"Title":"First Aid for Cuts, Scrapes, and Other Wounds","UniqueID":"v829544","Index":1,"Summary":"\u003cspan id=\"v829546\" class=\"anchor\" \u003e\u003c/span\u003e\u003cdiv class=\"para\" \u003e \u003cp \u003eThe first step in treating a cut is to stop the bleeding. Visible bleeding can almost always be stopped by placing a gauze pad or clean cloth over the bleeding area and firmly compressing the area with a finger or hand for at least 5 minutes. Whenever possible, the bleeding part is elevated above the level of the heart. \u003c/p\u003e\u003c/div\u003e","HeadType":"F_Head","SchemeItemProp":"itemprop=\"possibleTreatment\" itemscope itemtype=\"http://schema.org/MedicalTherapy\"","Children":[],"htmltotextTitle":"First Aid for Cuts, Scrapes, and Other Wounds"}]}}},"FinalResultforStandalone":{"finalResult":{"urls":[],"canonicalUrl":"https://www.msdmanuals.com/home/injuries-and-poisoning/first-aid/first-aid-for-cuts-scrapes-and-wounds","xdefault":"https://www.msdmanuals.com/home/injuries-and-poisoning/first-aid/first-aid-for-cuts-scrapes-and-wounds"},"XDefault":"https://www.msdmanuals.com/home/injuries-and-poisoning/first-aid/first-aid-for-cuts-scrapes-and-wounds"},"htmltotextTitle":"First Aid for Cuts, Scrapes, and Wounds","htmltotextSectionTitle":"Injuries and Poisoning","htmltotextOptimizedTitle":"First Aid for Cuts, Scrapes, and Wounds","dates":{"revisionDate":"May 2026","modificationDate":"May 2026","whatsNewDiffDate":7,"modificationDateFormat":"MMM yyyy","revisionDateFormat":"MMM yyyy"}}},"host":"msdmanuals.com"},"__N_SSG":true},"page":"/[site]/[section]/[chapter]/[topic]","query":{"site":"home","section":"injuries-and-poisoning","chapter":"first-aid","topic":"first-aid-for-cuts-scrapes-and-wounds"},"buildId":"SaUQ-rDQ-N6qry6P-Gv9_","assetPrefix":"/home","isFallback":false,"dynamicIds":[89996],"gsp":true,"locale":"en","locales":["en","en-us","de","es","fr","ar","ko","it","pt","ru","zh","es-us","hi","ja-jp","fr-ca","en-ca","sw","id"],"defaultLocale":"en","scriptLoader":[]}</script></body></html>