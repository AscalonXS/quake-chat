m:.75rem!important;padding-bottom:.5rem!important}.toolbox-content h2{margin:1.2rem 0 .6rem!important;padding-bottom:.25rem!important}.toolbox-content h3{margin:.9rem 0 .4rem!important}.toolbox-content h4{margin:.7rem 0 .3rem!important}.toolbox-content p{margin-bottom:.5rem!important;line-height:1.45!important}.toolbox-content li{margin-bottom:.25rem!important;line-height:1.45!important}.toolbox-content ul,.toolbox-content ol{margin-bottom:.75rem!important}.discussion-questions{padding:1rem!important;margin-top:1rem!important}.discussion-questions li{padding-left:2rem!important;margin-bottom:.6rem!important}.discussion-questions li::before{width:22px!important;height:22px!important;font-size:.85rem!important}.safety-flowchart,.maintenance-schedule{padding:1rem!important;margin:1rem 0!important}.flow-step{padding:.6rem .75rem!important;margin:.25rem 0!important}.flow-arrow{margin:.1rem 0!important;animation:none!important}.practice-icon,.category-icon,.schedule-icon{width:32px!important;height:32px!important;font-size:1rem!important;margin-bottom:.5rem!important}.step-number{width:28px!important;height:28px!important;font-size:.95rem!important}.print-only{display:block!important}.print-header{text-align:center;margin-bottom:1rem}.print-header img{width:180px;height:auto}.print-footer{margin-top:1.5rem;padding-top:.75rem;border-top:1px solid #999;font-size:.8rem;color:#333!important;text-align:center}.signin-sheet{page-break-before:always;break-before:page;color:#111!important;margin:0!important;padding:0!important}.signin-sheet .signin-title{font-size:1.4rem!important;margin:0 0 .75rem!important;padding-bottom:.35rem!important;color:#111!important;border-bottom:1px solid #111!important}.signin-sheet .signin-talk,.signin-sheet .signin-fields{font-size:.95rem!important;margin:0 0 .75rem!important;color:#111!important;line-height:1.6!important}.signin-sheet .signin-blank{display:inline-block;width:180px;border-bottom:1px solid #111;margin:0 1.5rem 0 .25rem}.signin-sheet .signin-table{width:100%;border-collapse:collapse;margin-top:.75rem}.signin-sheet .signin-table th,.signin-sheet .signin-table td{border:1px solid #000;padding:.35rem .5rem;color:#111!important;width:50%}.signin-sheet .signin-table th{text-align:left;font-size:.95rem;border-bottom:2px solid #000}.signin-sheet .signin-table td{height:30px;min-height:30px}.signin-sheet .signin-table tr{page-break-inside:avoid;break-inside:avoid}}</style></head><body><header class=nav><div class="wrap nav__inner"><a class=brand href=/ aria-label="SmarterRisk home"><img class=brand__logo src=/brand/smarterrisk-logo-2026-tagline.webp alt="SmarterRisk — Automate Safety. Reduce Risk. Stop Claims." width=314 height=58></a><nav class=nav__links id=nav-links><a href=/businesses/>Businesses</a>
