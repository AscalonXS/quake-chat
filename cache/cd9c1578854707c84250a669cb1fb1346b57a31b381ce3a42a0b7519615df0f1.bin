  <!-- Modal Overlay -->
  <div
    class="discount-tab__overlay"
    id="discount-tab-overlay"
    role="dialog"
    aria-modal="true"
    aria-label="Get 10% Off"
  >
    <div style="position:absolute;inset:0;" aria-hidden="true" id="discount-tab-backdrop"></div>

    <div class="discount-tab__modal" id="discount-tab-modal">
      <button class="discount-tab__modal-close" id="discount-tab-close" aria-label="Close">&times;</button>

      <div class="discount-tab__modal-body"><form method="post" action="/contact#discount-tab-form" id="discount-tab-form" accept-charset="UTF-8" class="discount-tab-form"><input type="hidden" name="form_type" value="customer" /><input type="hidden" name="utf8" value="✓" /><input type="hidden" name="contact[tags]" value="newsletter,discount-10"><div class="discount-tab-form__heading">
              <p class="discount-tab-form__eyebrow">Newsletter</p>
              <h2 class="discount-tab-form__title">Get 10% Off!</h2>
              <p class="discount-tab-form__desc">Join our mailing list and save 10% on your first order! Plus, be the first to know about new products, sales, and more!</p>
            </div><div class="discount-tab-form__field">
              <label for="discount-tab-email" class="visually-hidden">Your Email...</label>
              <input
                id="discount-tab-email"
                type="email"
                name="contact[email]"
                value=""
                placeholder="Email address"
                autocomplete="email"
                required
                aria-required="true"
                
                class="discount-tab-form__input"
              >
            </div>

            <button type="submit" class="discount-tab-form__submit">
              Sign Up
            </button>

            <button type="button" class="discount-tab-form__later" id="discount-tab-later">
              Maybe later
            </button></form></div>
    </div>
  </div>

  <script>
    (function () {
      var overlay  = document.getElementById('discount-tab-overlay');
      var openBtn  = document.getElementById('discount-tab-btn');
      var closeBtn = document.getElementById('discount-tab-close');
      var backdrop = document.getElementById('discount-tab-backdrop');
      var later    = document.getElementById('discount-tab-later');

      function openModal() {
        overlay.classList.add('is-open');
        document.body.style.overflow = 'hidden';
        closeBtn.focus();
      }

      function closeModal() {
        overlay.classList.remove('is-open');
        document.body.style.overflow = '';
        openBtn.focus();
      }

      openBtn.addEventListener('click', openModal);
      closeBtn.addEventListener('click', closeModal);
      backdrop.addEventListener('click', closeModal);
      if (later) later.addEventListener('click', closeModal);

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && overlay.classList.contains('is-open')) closeModal();
      });

      // Auto-open after success (form reloads page)
      
    })();
  </script>

