<script>
(function () {
  var overlay      = document.getElementById('quote-modal-overlay');
  var modalBody    = document.getElementById('quote-modal-body');
  var closeBtn     = document.getElementById('quote-modal-close');
  var backdrop     = document.getElementById('quote-modal-backdrop');
  var cartField    = document.getElementById('quote-cart-items');
  var form         = document.getElementById('QuoteRequestForm');
  var lastFocused  = null;

  function formatMoney(cents) {
    return '$' + (cents / 100).toFixed(2);
  }

  function openModal() {
    lastFocused = document.activeElement;

    var display = document.getElementById('quote-cart-items-display');

    fetch('/cart.js')
      .then(function (r) { return r.json(); })
      .then(function (cart) {
        // Hidden field for email
        var lines = ['=== Cart Items ===', ''];
        cart.items.forEach(function (item) {
          var title = item.product_title;
          if (item.variant_title && item.variant_title !== 'Default Title') {
            title += ' (' + item.variant_title + ')';
          }
          lines.push(title + ' | Qty: ' + item.quantity + ' | ' + formatMoney(item.final_line_price));
        });
        lines.push('');
        lines.push('Order Total: ' + formatMoney(cart.total_price));
        cartField.value = lines.join('\n');

        // Visible cart items table
        if (display) {
          if (cart.items.length === 0) {
            display.innerHTML = '<p class="quote-modal__cart-empty">Your cart is empty.</p>';
          } else {
            var rows = cart.items.map(function (item) {
              var title = item.product_title;
              if (item.variant_title && item.variant_title !== 'Default Title') {
                title += '<br><small>' + item.variant_title + '</small>';
              }
              return '<tr>' +
                '<td>' + title + '</td>' +
                '<td class="quote-cart__qty">' + item.quantity + '</td>' +
                '<td class="quote-cart__price">' + formatMoney(item.final_line_price) + '</td>' +
              '</tr>';
            }).join('');
            display.innerHTML =
              '<p class="quote-modal__cart-label">Items in your quote:</p>' +
              '<table class="quote-cart__table">' +
                '<thead><tr>' +
                  '<th>Product</th><th>Qty</th><th>Price</th>' +
                '</tr></thead>' +
                '<tbody>' + rows + '</tbody>' +
                '<tfoot><tr>' +
                  '<td colspan="2"><strong>Total</strong></td>' +
                  '<td class="quote-cart__price"><strong>' + formatMoney(cart.total_price) + '</strong></td>' +
                '</tr></tfoot>' +
              '</table>';
          }
        }
      })
      .catch(function () {
        if (display) display.innerHTML = '';
      });

    overlay.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    setTimeout(function () { closeBtn.focus(); }, 50);
  }

  function closeModal() {
    overlay.classList.remove('is-open');
    document.body.style.overflow = '';
    if (lastFocused) lastFocused.focus();
  }

  closeBtn.addEventListener('click', closeModal);
  backdrop.addEventListener('click', closeModal);

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && overlay.classList.contains('is-open')) closeModal();
  });

  window.openQuoteModal  = openModal;
  window.closeQuoteModal = closeModal;
})();
</script>


