      <a aria-labelledby="attachment_68f801d93d63321f7ce773a1" href="#attachment_68f801d93d63321f7ce773a1" class="gallerySlider-tabs-item-link " role="tab" aria-controls="attachment_68f801d93d63321f7ce773a1" style="background-image: url(https://iprsoftwaremedia.com/67/files/20259/68f801d93d63321f7ce773a1_Woman%20choking/Woman%20choking_thmb.jpg?v=3fc3fd2b-5fc8-4eb9-bba6-3bf33760cf7b)">
        <img src="https://iprsoftwaremedia.com/67/files/20259/68f801d93d63321f7ce773a1_Woman%20choking/Woman%20choking_thmb.jpg?v=3fc3fd2b-5fc8-4eb9-bba6-3bf33760cf7b" alt="Woman choking" />
      </a>
    </li>
  
    <li class="gallerySlider-tabs-item">
      <a aria-labelledby="attachment_68f801d43d63322452e77395" href="#attachment_68f801d43d63322452e77395" class="gallerySlider-tabs-item-link " role="tab" aria-controls="attachment_68f801d43d63322452e77395" style="background-image: url(https://iprsoftwaremedia.com/67/files/20259/68f801d43d63322452e77395_Lay%20rescuer%20using%20AED/Lay%20rescuer%20using%20AED_thmb.jpg?v=9f3f0009-738b-4f37-9bce-7b31aa66d77e)">
        <img src="https://iprsoftwaremedia.com/67/files/20259/68f801d43d63322452e77395_Lay%20rescuer%20using%20AED/Lay%20rescuer%20using%20AED_thmb.jpg?v=9f3f0009-738b-4f37-9bce-7b31aa66d77e" alt="Lay rescuer using AED" />
      </a>
    </li>
  
    <li class="gallerySlider-tabs-item">
      <a aria-labelledby="attachment_68f801cd3d63322262e7738e" href="#attachment_68f801cd3d63322262e7738e" class="gallerySlider-tabs-item-link " role="tab" aria-controls="attachment_68f801cd3d63322262e7738e" style="background-image: url(https://iprsoftwaremedia.com/67/files/20259/68f801cd3d63322262e7738e_Depiction%20of%20compressions%20on%20infant/Depiction%20of%20compressions%20on%20infant_thmb.jpg?v=2d81bfd9-1c8b-478f-8ea1-ce104abc9dbe)">
        <img src="https://iprsoftwaremedia.com/67/files/20259/68f801cd3d63322262e7738e_Depiction%20of%20compressions%20on%20infant/Depiction%20of%20compressions%20on%20infant_thmb.jpg?v=2d81bfd9-1c8b-478f-8ea1-ce104abc9dbe" alt="Depiction of compressions on infant" />
      </a>
    </li>
  
    <li class="gallerySlider-tabs-item">
      <a aria-labelledby="attachment_68f7fd113d6332f72ce7739a" href="#attachment_68f7fd113d6332f72ce7739a" class="gallerySlider-tabs-item-link " role="tab" aria-controls="attachment_68f7fd113d6332f72ce7739a" style="background-image: url(https://iprsoftwaremedia.com/67/files/20259/68f7fd113d6332f72ce7739a_Cardiac%20Arrest%20Chain%20of%20Survivial/Cardiac%20Arrest%20Chain%20of%20Survivial_thmb.jpg?v=b8a65f78-1ce5-41e8-8d63-f148df8e90f1)">
        <img src="https://iprsoftwaremedia.com/67/files/20259/68f7fd113d6332f72ce7739a_Cardiac%20Arrest%20Chain%20of%20Survivial/Cardiac%20Arrest%20Chain%20of%20Survivial_thmb.jpg?v=b8a65f78-1ce5-41e8-8d63-f148df8e90f1" alt="Cardiac Arrest Chain of Survivial Infographic" />
      </a>
    </li>
  
    <li class="gallerySlider-tabs-item">
      <a aria-labelledby="attachment_68f7fd173d6332f72ee773b2" href="#attachment_68f7fd173d6332f72ee773b2" class="gallerySlider-tabs-item-link " role="tab" aria-controls="attachment_68f7fd173d6332f72ee773b2" style="background-image: url(https://iprsoftwaremedia.com/67/files/20259/68f7fd173d6332f72ee773b2_Neonatal%20Cardiac%20Arrest%20Chain%20of%20Survival/Neonatal%20Cardiac%20Arrest%20Chain%20of%20Survival_thmb.jpg?v=8b87bd76-10bc-4a49-b829-c48ae849a918)">
        <img src="https://iprsoftwaremedia.com/67/files/20259/68f7fd173d6332f72ee773b2_Neonatal%20Cardiac%20Arrest%20Chain%20of%20Survival/Neonatal%20Cardiac%20Arrest%20Chain%20of%20Survival_thmb.jpg?v=8b87bd76-10bc-4a49-b829-c48ae849a918" alt="Neonatal Cardiac Arrest Chain of Survival Infographic" />
