        <li>
          Updated CPR guidelines tackle choking response, opioid-related emergencies and a revised Chain of Survival
        </li>
        
      </ol>
    </nav>
    
  </div>
  

  
    
    
      
<div class="container container-fluid">
  <article class="article">
    <div class="article-info">
      
      <div class="article-info-category">
        <strong>Categories:</strong> 
      <a href="/news?c=860">Scientific Advisories, Statements, Guidelines</a>, 
      <a href="/news?c=856">Heart News</a>

      </div>
      |
      
      <div class="article-info-date">
        Published: October 22, 2025
      </div>
    </div>
    <div class="row">
      <div class="col-lg-8">
        <header class="article-header">
          <h1 id="maintitle-container" class="cBuilder article-header-title">Updated CPR guidelines tackle choking response, opioid-related emergencies and a revised Chain of Survival</h1>
          
          <div id="subtitle-container" class="cBuilder article-header-subtitle">
            American Heart Association Guidelines
          </div>
          
        </header>
        
        
<div class="content-share">
  <div class="content-share__button">
