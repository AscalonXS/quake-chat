    </a>
  </div>
  <div class="content-share__button">
    <a href="https://newsroom.heart.org/news/updated-cpr-guidelines-tackle-choking-response-opioid-related-emergencies-and-a-revised-chain-of-survival?print=1" target="_blank" class="social-btn social-btn--print">
      <span class="social-btn__icon printer">
        <span class="icon-printer"><img src="/media/themes/5cf02be72cfac21af0e27a3f/fonts/printer-fill.svg" alt="facebook"></span>
