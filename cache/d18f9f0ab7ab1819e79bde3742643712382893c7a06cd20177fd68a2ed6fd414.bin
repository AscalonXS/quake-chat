    <div class="arrow-line__vertical--dashed" style="position: relative; height: 1034px; width: 2px; margin-left: 4px;">&nbsp;</div>
    <!-- ARROW HEAD DOWN -->
    <div class="arrow-head__down" style="position: relative;">&nbsp;</div>
  </div>
  <!-- end ARROW SOLID VERTICAL LINE --><!-- RED BOX -->
  <div class="outline nobullets5a critical" style="position: absolute; z-index: 1; top: 466px; left: 122px; width: 484px; height: 17px;"><a class="pop1000x600nobar" href="/clinical-pathway/trauma-resuscitation-primary-survey-organized-evaluation"><span class="redorange2">Primary Survey:</span> Organized Evaluation</a> to identify life threats and Intervene</div>
  <div class="nooutline nobullets5a" style="position: absolute; z-index: 1; top: 448px; left: 660px; width: 180px; height: 166px; text-align: left;">
    <table class="borders1 nobullets5a">
      <tbody>
        <tr>
          <td style="border: 0; padding: 5px 0;"><a class="pop1000x600nobar" href="/clinical-pathway/trauma-resuscitation-life-threatening-injuries-and-interventions"><strong>Life-threatening Injury</strong></a></td>
        </tr>
        <tr>
          <th>Respiratory</th>
        </tr>
        <tr>
          <td>
            <ul>
              <li>Altered mental status due to neurologic/circulatory etiologies</li>
              <li>Airway Obstruction</li>
              <li>Direct Airway Trauma</li>
              <li>Tension Pneumothorax</li>
              <li>Suspected Pneumothorax</li>
              <li>Pulmonary Contusion</li>
              <li>Smoke Inhalation</li>
            </ul>
          </td>
        </tr>
        <tr>
          <th>Circulatory</th>
        </tr>
        <tr>
          <td>
            <ul>
              <li>Hemorrhagic Shock
                <ul>
                  <li>Blunt Trauma</li>
                  <li>Penetrating Trauma</li>
                  <li>Pelvic Fracture</li>
                  <li>Long Bone Fracture</li>
                  <li><a class="pop810x600" href="/clinical-pathway/trauma-resuscitation-care-vascular-injuries">Vascular Injury</a></li>
                  <!-- vascular-injuries.php --></ul>
              </li>
              <li>Massive Hemothorax</li>
              <li>Cardiac Tamponade</li>
            </ul>
          </td>
        </tr>
        <tr>
          <th>Neurologic</th>
        </tr>
        <tr>
          <td>
            <ul>
              <li>Head/Intracranial Injury</li>
              <li>Spinal Cord Trauma</li>
              <li>Spinal Shock</li>
            </ul>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
  <div class="nooutline nobullets5a" style="position: absolute; z-index: 1; top: 494px; left: 122px; width: 600px; height: 166px; text-align: left;">
    <table class="noborders1 noborders1a" style="width: 520px;">
      <tbody>
        <tr>
          <td style="padding-bottom: 0;">&nbsp;</td>
          <td style="padding-bottom: 0;">&nbsp;</td>
          <th style="padding-bottom: 0;"><span style="font-size: 14px; padding-left: 9px;"><strong>Interventions</strong></span></th>
        </tr>
        <tr>
          <th style="vertical-align: middle; width: 15px; font-size: 17px; padding-top: 8px;"><span class="redorange2">X</span></th>
          <td style="vertical-align: middle; width: 190px; text-align: left; font-size: 16px !important"><a href="/clinical-pathway/trauma-resuscitation-exsanguinating-hemorrhage-traumatic-arrest" class="pop1000x600nobar">Exsanguinating Hemorrhage</a><!-- /pathways/trauma-activation-criteria/exsanguinating-hemorrhage.php --></td>
          <td style="vertical-align: middle; width: 315px;"><span style="padding-left: 9px; white-space: nowrap;"><strong>Traumatic exsanguinating hemorrhage or arrest</strong></span></td>
        </tr>
        <tr>
          <th style="vertical-align: top; font-size: 17px; padding-top: 16px;"><span class="redorange2">A</span></th>
          <td style="vertical-align: top !important; padding-top: 16px !important; font-size: 16px !important;"><a class="pop1000x600nobar" href="/clinical-pathway/trauma-resuscitation-airway-cervical-spine-c-spine-breathing">Airway, C-Spine</a></td>
          <td style="vertical-align: top; padding-top: 16px;">
            <ul>
              <li>Oxygen, Suction</li>
              <li><a class="pop860x650" href="/clinical-pathway/trauma-resuscitation-cervical-spine-c-spine-immobilization">C-Spine Immobilization, Clearance</a></li>
            </ul>
          </td>
        </tr>
        <tr>
          <th style="vertical-align: top; font-size: 17px;"><span class="redorange2">B</span></th>
          <td style="vertical-align: top; padding-top: 7px !important; font-size: 16px !important;"><a class="pop1000x600nobar" href="/clinical-pathway/trauma-resuscitation-airway-cervical-spine-c-spine-breathing#breathing">Breathing</a></td>
          <td style="vertical-align: top;">
            <ul>
              <li>Assess Indications for Intubation
                <ul>
                  <li>Medications, Procedure</li>
                </ul>
              </li>
              <li>Ventilation, Monitoring</li>
            </ul>
          </td>
        </tr>
        <tr>
          <th style="vertical-align: top; font-size: 17px;"><span class="redorange2">C</span></th>
          <td style="vertical-align: top; padding-top: 7px !important; font-size: 16px !important;"><a class="pop1000x600nobar" href="/clinical-pathway/trauma-resuscitation-circulation-fluid-guidelines-rapid-administration">Circulation</a><!-- circulation-fluid-guidelines-for-rapid-administration.php --></td>
          <td style="vertical-align: top;">
            <ul>
              <li><a class="pop1000x600nobar" href="/clinical-pathway/trauma-resuscitation-circulation-vascular-access-escalation">Vascular Access, Escalation</a><!-- circulation-vascular-access-escalation.php -->, Large Bore Access x2</li>
              <li><a class="pop1000x600nobar" href="/clinical-pathway/trauma-resuscitation-considerations-trauma-labs-trauma-level-1-or-2-activations">Trauma Labs</a></li>
              <li><a class="pop1000x600nobar" href="/clinical-pathway/trauma-resuscitation-circulation-fluid-guidelines-rapid-administration">Rapid Fluid Administration</a><!-- circulation-fluid-guidelines-for-rapid-administration.php --></li>
              <li>Consider massive transfusion protocol<br>
                See <a href="https://saml.policymedical.net/policymed/anonymous/docViewer?stoken=14de2fa8-d9f5-4188-983b-29545b20809f&amp;dtoken=7de4bc4e-ad5a-4fdf-8800-f68814583081" rel="noopener" target="_blank">Massive Transfusion Protocol Procedure</a></li>
            </ul>
          </td>
        </tr>
        <tr>
          <th style="vertical-align: top; font-size: 17px;"><span class="redorange2">D</span></th>
          <td style="vertical-align: top; padding-top: 7px !important; font-size: 16px !important;"><a class="pop1000x600nobar" href="/clinical-pathway/trauma-resuscitation-disability-neurologic-evaluation">Disability, Dextrose</a></td>
          <td style="vertical-align: top;">
            <ul>
              <li><a class="pop1000x600nobar" href="/clinical-pathway/trauma-resuscitation-disability-neurologic-evaluation">Neurologic Assessment, GCS Score, AVPU</a></li>
              <li><a class="pop750x560" href="/clinical-pathway/trauma-resuscitation-treat-brain-injury">Treat Brain Injury</a>
                <ul>
                  <li>For suspected herniation:
                    <ul>
                      <li>Modest hyperventilation</li>
                      <li>3% NS bolus</li>
                    </ul>
                  </li>
                  <li>If Signs of spinal cord injury:
                    <ul>
                      <li>Spine immobilization</li>
                    </ul>
                  </li>
                </ul>
              </li>
              <li>Evaluate for signs of <a href="/clinical-pathway/spinal-cord-injury-sci-traumatic-clinical-pathway" rel="noopener" target="_blank">Spinal Shock</a></li>
            </ul>
          </td>
        </tr>
        <tr>
          <th style="vertical-align: top; font-size: 17px;"><span class="redorange2">E</span></th>
          <td style="vertical-align: top; padding-top: 7px !important; font-size: 16px !important;"><a class="pop600x600" href="/clinical-pathway/trauma-resuscitation-exposure-maintain-normothermia">Exposure</a></td>
          <td style="vertical-align: top;">
            <ul>
              <li>Ensure full exposure (remove all clothing)</li>
              <li>Environmental support, <a class="pop600x600" href="/clinical-pathway/trauma-resuscitation-exposure-maintain-normothermia">Maintain Normothermia</a></li>
            </ul>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
  <!-- RED BOX -->
  <div class="outline nobullets5a critical" style="position: absolute; z-index: 1; top: 1056px; left: 122px; width: 484px; height: 17px;"><span class="redorange2">Log Roll:</span> Immediately after primary survey completion</div>
 
  <!-- RED BOX -->
  <div class="outline nobullets5a critical" style="position: absolute; z-index: 1; top: 1098px; left: 122px; width: 484px; height: 17px;"><a class="pop1000x600nobar" href="/clinical-pathway/trauma-resuscitation-secondary-survey-organized-evaluation"><span class="redorange2">Secondary Survey:</span> Organized Evaluation</a> to identify all injuries</div>
  <div class="nooutline nobullets5a" style="position: absolute; z-index: 1; top: 1141px; left: 122px; width: 600px; height: 166px; text-align: left;">
    <table class="noborders1" style="width: 520px;">
      <tbody>
        <tr>
          <th style="width: 210px;"><a class="pop1000x600nobar" href="/clinical-pathway/trauma-resuscitation-imaging-considerations">Imaging Considerations</a></th>
          <td style="width: 310px;">Per Trauma Attending/Fellow, ED Attending/Fellow - Prioritize triaging imaging</td>
        </tr>
        <tr>
          <th style="padding-left: 24px;">Plain films X-ray</th>
          <td>C-Spine, chest, pelvis, injured extremities</td>
        </tr>
        <tr>
          <th style="padding-left: 24px;">Computerized tomography (CT)</th>
          <td>Non-contrast Head CT (consider C1-C2)<br>
            abdominal CT IV contrast, chest CT IV contrast</td>
        </tr>
        <tr>
          <th><a class="pop860x650" href="/clinical-pathway/trauma-resuscitation-considerations-pediatric-efast">Considerations for Pediatric eFAST</a><br>
            Nasogastric/orogastric tube, foley</th>
          <td>&nbsp;</td>
        </tr>
      </tbody>
    </table>
  </div>
  <!-- RED BOX -->
  <div class="outline nobullets5a critical" style="position: absolute; z-index: 1; top: 1299px; left: 122px; width: 484px; height: 17px;"><strong>Ongoing Care:</strong> Stabilization and Considerations for Disposition</div>
  <div class="nooutline nobullets5a" style="position: absolute; z-index: 1; top: 1331px; left: 122px; width: 600px; height: 166px; text-align: left;">
    <table class="noborders1" style="width: 500px; font-size: 11px; font-family: verdana;">
      <tbody>
        <tr>
          <th style="width: 150px; padding-bottom: 0; font-size: 11px; font-family: verdana;">
            <ul>
              <li>Consults</li>
            </ul>
          </th>
          <td style="width: 390px; padding-bottom: 0; font-size: 11px; font-family: verdana;">
            <ul>
              <li>Neurosurgery, Orthopedics, Plastics, Oral and Maxillofacial Surgery, ENT, Vascular, Urology, Social Work</li>
              <li>As clinically indicated, <a class="pop600x600" href="/clinical-pathway/trauma-resuscitation-trauma-activation-level#contact">Contact Numbers</a></li>
            </ul>
          </td>
        </tr>
        <tr>
          <th style="padding-top: 0; font-size: 11px; font-family: verdana;">
            <ul>
              <li>Other Considerations</li>
            </ul>
          </th>
          <td style="padding-top: 0; font-size: 11px; font-family: verdana;">
            <ul>
              <li>Continued attention to ABCDs</li>
              <li>Analgesia, temperature, antibiotics, tetanus</li>
              <li>Review laboratory/radiology results</li>
            </ul>
          </td>
        </tr>
        <tr>
          <th style="padding-top: 0; font-size: 11px; font-family: verdana;">
            <ul>
              <li>Communication</li>
            </ul>
          </th>
          <td style="padding-top: 0; font-size: 11px; font-family: verdana;">
            <ul>
              <li>CT, Blood Bank, OR, Anesthesia, PICU</li>
              <li><a class="pop600x600" href="/clinical-pathway/trauma-resuscitation-trauma-activation-level#contact">Contact numbers</a></li>
            </ul>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
  <!-- RED TEXT -->
  <div class="nooutline redorange2" style="position: absolute; z-index: 1; top: 1532px; left: 55px; width: 54px; height: 17px; text-align: right;">20 min</div>

  <!-- RED BOX -->
  <div class="outline nobullets5a critical" style="position: absolute; z-index: 1; top: 1531px; left: 122px; width: 484px; height: 17px;"><a class="pop750x560" href="/clinical-pathway/trauma-resuscitation-disposition"><strong>Disposition</strong></a></div>
  <div class="nooutline nobullets5a" style="position: absolute; z-index: 1; top: 1561px; left: 122px; width: 600px; height: 166px; text-align: left;">
    <table class="noborders1" style="width: 520px;">
      <tbody>
        <tr>
          <th style="width: 400px; padding-bottom: 0;">
            <ul>
              <li><a class="pop600x600" href="/clinical-pathway/trauma-resuscitation-prepare-patient-transport">Prepare patient for transport</a> with equipment and medications</li>
              <li>Proceed to Radiology as clinically indicated</li>
            </ul>
          </th>
          <td style="width: 120px; padding-bottom: 0;">&nbsp;</td>
        </tr>
      </tbody>
    </table>
