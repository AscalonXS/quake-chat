    <div class="modal fade" id="report3dModal" tabindex="-1" role="dialog" aria-labelledby="report3dModal" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-body">
                    <div class="mb-2 text-end">
                        <a href="#" data-bs-dismiss="modal">
                            <i class="fa-solid fa-times"></i>
                        </a>
                    </div>

                    <form action="" method="get" class="report-3d-form">
                        <h4 class="text-center mb-3">Help Us Improve This Model</h4>
                        <fieldset>
                            <div class="form-group">
                                <textarea name="report" class="form-control" placeholder="Was something confusing, missing, or not working properly? Share your thoughts so we can make it better." required rows="5"></textarea>
                            </div>
                            <div id='turnstile-3d-report' class="mt-2"></div>
                            
                            <div class="form-group">
                                <div class="text-end mt-4">
                                    <button type="submit" class="btn btn-primary px-4">Submit</button>
                                </div>
                            </div>
                        </fieldset>
                    </form>
                </div>
            </div>
        </div>
    </div>
    
    <script>
        jQuery(document).ready(function($) {
            // Handle 3D model like
            jQuery('.like-3d-model').on('click', function(e) {
                e.preventDefault();

                jQuery(this).removeClass('btn-light').addClass('btn-primary');
                jQuery(this).siblings('.dislike-3d-model').removeClass('btn-danger').addClass('btn-light');

                jQuery.post(ajaxurl, {
                    action: 'like_3d_model',
                    post_id:  jQuery(this).data('postid')
                });
            });
            // Handle 3D model dislike
            jQuery('.dislike-3d-model').on('click', function(e) {
                e.preventDefault();

                jQuery(this).removeClass('btn-light').addClass('btn-danger');
                jQuery(this).siblings('.like-3d-model').removeClass('btn-primary').addClass('btn-light');

                jQuery.post(ajaxurl, {
                    action: 'dislike_3d_model',
                    post_id: jQuery(this).data('postid')
                });
            });

            // Handle 3D model report form
            $('.report-3d-form').submit(function (e) {
                e.preventDefault();

                if ($(this).data('submitting')) {
                    return;
                }

                $('.report-3d-form .alert').remove();
                if ($('.report-3d-form .spinner-border').length === 0) {
                    $('.report-3d-form button[type="submit"]').before('<div class="spinner-border spinner-border-sm me-4" role="status"></div>');
                }
                $('.report-3d-form button[type="submit"]').prop('disabled', true);

                if (typeof turnstile !== 'undefined' && window.turnstile3DReportWidget) {
                    turnstile.execute(window.turnstile3DReportWidget, {
                        callback: function(token) {
                            report3DSubmit(token);
                        }
                    });
                } else {
                    jQuery('.report-3d-form .spinner-border').remove();
                    jQuery('.report-3d-form button[type="submit"]').prop('disabled', false);
                    jQuery('.report-3d-form').prepend('<div class="alert alert-danger">Captcha not available</div>');
                }
            });
        });
        function report3DSubmit(token) {
            var postId = jQuery('.report-3d-model').data('postid');

            jQuery('.report-3d-form').data('submitting', true);
            jQuery('.report-3d-form .alert').remove();
            jQuery.post(ajaxurl, {
                action: 'report_3d_model',
                post_id: postId,
                comments: jQuery('.report-3d-form').find('[name="report"]').val(),
                referralpage: location.href,
                captcha: token || jQuery('.report-3d-form').find('[name="cf-turnstile-response"]').val()
            }, function (data) {
                jQuery('.report-3d-form .spinner-border').remove();
                jQuery('.report-3d-form button[type="submit"]').prop('disabled', false);

                if (data.success) {
                    // Remove fieldset and h4
                    jQuery('.report-3d-form fieldset').remove();
                    jQuery('.report-3d-form h4').remove();
                    jQuery('.report-3d-form').prepend('<div class="alert alert-success">Thank you for submitting your report.</div>');
                } else {
                    if (typeof turnstile !== 'undefined' && window.turnstile3DReportWidget) {
                        turnstile.reset(window.turnstile3DReportWidget);
                    }
                    jQuery('.report-3d-form').data('submitting', false);
                    jQuery('.report-3d-form').prepend('<div class="alert alert-danger">There was an error submitting your report. Please try again.</div>');
                }
            }, 'json').fail(function() {
                jQuery('.report-3d-form .spinner-border').remove();
                jQuery('.report-3d-form button[type="submit"]').prop('disabled', false);
                jQuery('.report-3d-form').data('submitting', false);
                if (typeof turnstile !== 'undefined' && window.turnstile3DReportWidget) {
                    turnstile.reset(window.turnstile3DReportWidget);
                }
                jQuery('.report-3d-form').prepend('<div class="alert alert-danger">Network error. Please try again.</div>');
            });
        }
    </script>
    <div class="modal fade" id="reportModal" tabindex="-1" role="dialog" aria-labelledby="reportModal" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-body">
                <div class="mb-2 text-end">
                    <a href="#" data-bs-dismiss="modal">
                        <i class="fa-solid fa-times"></i>
                    </a>
                </div>

                <form action="" method="get" class="report-form">
                    <h4 class="text-center mb-3">Help Us Improve This Question</h4>
                    <fieldset>
                        <div class="form-group">
                            <textarea name="report" class="form-control" placeholder="Was the question unclear, incorrect, too easy, or too hard? Let us know how we can improve it." required rows="5"></textarea>
                        </div>
                        <div id='turnstile-report' class="mt-2"></div>
                        
                        <div class="form-group">
                            <div class="text-end mt-4">
                                <button type="submit" class="btn btn-primary px-4">Submit</button>
                            </div>
                        </div>
                    </fieldset>
                </form>
            </div>
        </div>
    </div>
</div>
<script>
    jQuery('.report-form').submit(function (e) {
        e.preventDefault();

        if (jQuery(this).data('submitting')) {
            return;
        }

        jQuery('.report-form .alert').remove();
        if (jQuery('.report-form .spinner-border').length === 0) {
            jQuery('.report-form button[type="submit"]').before('<div class="spinner-border spinner-border-sm me-4" role="status"></div>');
        }
        jQuery('.report-form button[type="submit"]').prop('disabled', true);

        if (typeof turnstile !== 'undefined' && window.turnstileReportWidget) {
            turnstile.execute(window.turnstileReportWidget, {
                callback: function(token) {
                    reportSubmit(token);
                }
            });
        } else {
            jQuery('.report-form .spinner-border').remove();
            jQuery('.report-form button[type="submit"]').prop('disabled', false);
            jQuery('.report-form').prepend('<div class="alert alert-danger">Captcha not available</div>');
        }
    });

    function reportSubmit(token) {
        jQuery('.report-form').data('submitting', true);
        var reportQuestionId = parseInt(jQuery('.report-form').attr('data-question-id'), 10) || 0;
        if (!reportQuestionId && typeof quizQuestions !== 'undefined' && typeof currentQuestion !== 'undefined' && quizQuestions[currentQuestion - 1]) {
            reportQuestionId = quizQuestions[currentQuestion - 1].question_id;
        }
        jQuery.post(ajaxurl, { 'action': 'report_question', 'id': reportQuestionId, 'comments': jQuery('.report-form').find('[name="report"]').val(), 'referralpage': location.href, 'captcha': token || jQuery('.report-form').find('[name="cf-turnstile-response"]').val() }, function (data) {
            jQuery('.report-form .spinner-border').remove();
            jQuery('.report-form button[type="submit"]').prop('disabled', false);
            jQuery('[name="report"]').val('');

            if (data.success) {
                jQuery('#report-question').removeClass('btn-light').addClass('btn-danger');
                jQuery('.report-form').prepend('<div class="alert alert-success">Thank you for submitting your report.</div>');
            } else {
                if (typeof turnstile !== 'undefined' && window.turnstileReportWidget) {
                    turnstile.reset(window.turnstileReportWidget);
                }
                jQuery('.report-form').data('submitting', false);
                jQuery('.report-form').prepend('<div class="alert alert-danger">There was an error submitting your report. Please try again and contact us if this problem persists.</div>');
            }
        }, 'json').fail(function() {
            jQuery('.report-form .spinner-border').remove();
            jQuery('.report-form button[type="submit"]').prop('disabled', false);
            jQuery('.report-form').data('submitting', false);
            if (typeof turnstile !== 'undefined' && window.turnstileReportWidget) {
                turnstile.reset(window.turnstileReportWidget);
            }
            jQuery('.report-form').prepend('<div class="alert alert-danger">Network error. Please try again.</div>');
        });
    }
</script>
