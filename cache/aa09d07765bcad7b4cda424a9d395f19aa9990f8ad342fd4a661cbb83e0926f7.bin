    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Disable context menu and drag on article images
            document.querySelectorAll('article picture img').forEach(img => {
                img.addEventListener('contextmenu', e => e.preventDefault());
                img.setAttribute('draggable', 'false');
            });

            // Disable lightbox <a> tags from copying/opening images
            const protectLightboxLinks = () => {
                document.querySelectorAll('a[rel="lightbox"]').forEach(link => {
                    if (!link.dataset.protected) {
                        link.addEventListener('contextmenu', e => e.preventDefault());
                        link.addEventListener('click', e => e.preventDefault());
                        link.setAttribute('draggable', 'false');
                        link.dataset.protected = 'true';
                    }
                });
            };

            protectLightboxLinks();

            // Observe dynamic changes (e.g., modal or ajax-loaded content)
            const observer = new MutationObserver(() => {
                // Protect modal images
                const modalImg = document.querySelector('.mfp-image-holder img');
                if (modalImg && !modalImg.dataset.protected) {
                    modalImg.addEventListener('contextmenu', e => e.preventDefault());
                    modalImg.setAttribute('draggable', 'false');
                    modalImg.dataset.protected = 'true';
                }

                // Re-apply protection to lightbox links
                protectLightboxLinks();
            });

            observer.observe(document.body, {
                childList: true,
                subtree: true
            });

            // Fallback: polling in case MutationObserver misses something
            setInterval(() => {
                const modalImg = document.querySelector('.mfp-image-holder img');
                if (modalImg && !modalImg.dataset.protected) {
                    modalImg.addEventListener('contextmenu', e => e.preventDefault());
                    modalImg.setAttribute('draggable', 'false');
                    modalImg.dataset.protected = 'true';
                }

                protectLightboxLinks();
            }, 500);
        });
    </script>
