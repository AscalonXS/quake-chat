86px, (min-width: 460px) 35px" srcSet="/_next/static/media/CCFLogo.000428c6.svg?w=16&amp;q=75 16w, /_next/static/media/CCFLogo.000428c6.svg?w=32&amp;q=75 32w, /_next/static/media/CCFLogo.000428c6.svg?w=48&amp;q=75 48w, /_next/static/media/CCFLogo.000428c6.svg?w=64&amp;q=75 64w, /_next/static/media/CCFLogo.000428c6.svg?w=96&amp;q=75 96w, /_next/static/media/CCFLogo.000428c6.svg?w=128&amp;q=75 128w, /_next/static/media/CCFLogo.000428c6.svg?w=256&amp;q=75 256w, /_next/static/media/CCFLogo.000428c6.svg?w=384&amp;q=75 384w, /_next/static/media/CCFLogo.000428c6.svg?w=640&amp;q=75 640w, /_next/static/media/CCFLogo.000428c6.svg?w=750&amp;q=75 750w, /_next/static/media/CCFLogo.000428c6.svg?w=828&amp;q=75 828w, /_next/static/media/CCFLogo.000428c6.svg?w=1080&amp;q=75 1080w, /_next/static/media/CCFLogo.000428c6.svg?w=1200&amp;q=75 1200w, /_next/static/media/CCFLogo.000428c6.svg?w=1920&amp;q=75 1920w, /_next/static/media/CCFLogo.000428c6.svg?w=2048&amp;q=75 2048w, /_next/static/media/CCFLogo.000428c6.svg?w=3840&amp;q=75 3840w" src="/_next/static/media/CCFLogo.000428c6.svg?w=3840&amp;q=75"/></a><div class="border-l border-gray-400 h-rem24px my-auto mx-rem12px bp1400:mx-rem16px"></div><a href="https://health.clevelandclinic.org/" class="flex flex-wrap content-center" aria-label="Health Essentials logo" data-identity="secondary-logo"><div class="flex"><img alt="Health Essentials logo" width="200" height="40" decoding="async" data-nimg="1" class="w-[150px] h-[30px] bp600:w-[200px] bp600:h-[40px]" style="color:transparent" sizes="150px, (min-width: 600px) 200px" srcSet="/_next/static/media/HealthEssentials.b811bb06.svg?w=16&amp;q=75 16w, /_next/static/media/HealthEssentials.b811bb06.svg?w=32&amp;q=75 32w, /_next/static/media/HealthEssentials.b811bb06.svg?w=48&amp;q=75 48w, /_next/static/media/HealthEssentials.b811bb06.svg?w=64&amp;q=75 64w, /_next/static/media/HealthEssentials.b811bb06.svg?w=96&amp;q=75 96w, /_next/static/media/HealthEssentials.b811bb06.svg?w=128&amp;q=75 128w, /_next/static/media/HealthEssentials.b811bb06.svg?w=256&amp;q=75 256w, /_next/static/media/HealthEssentials.b811bb06.svg?w=384&amp;q=75 384w, /_next/static/media/HealthEssentials.b811bb06.svg?w=640&amp;q=75 640w, /_next/static/media/HealthEssentials.b811bb06.svg?w=750&amp;q=75 750w, /_next/static/media/HealthEssentials.b811bb06.svg?w=828&amp;q=75 828w, /_next/static/media/HealthEssentials.b811bb06.svg?w=1080&amp;q=75 1080w, /_next/static/media/HealthEssentials.b811bb06.svg?w=1200&amp;q=75 1200w, /_next/static/media/HealthEssentials.b811bb06.svg?w=1920&amp;q=75 1920w, /_next/static/media/HealthEssentials.b811bb06.svg?w=2048&amp;q=75 2048w, /_next/static/media/HealthEssentials.b811bb06.svg?w=3840&amp;q=75 3840w" src="/_next/static/media/HealthEssentials.b811bb06.svg?w=3840&amp;q=75"/></div></a></div><div class="flex flex-col gap-x-rem24px bp600:flex-row"><img alt="Subscription icon" width="120" height="120" decoding="async" data-nimg="1" class="mb-rem16px w-full aspect-video object-cover bp600:mb-0 bp600:aspect-square bp600:w-[120px] bp600:h-[120px]" style="color:transparent" srcSet="https://assets.clevelandclinic.org/transform/482db8cd-aa1e-45b5-a2a4-cf6aa5e5d2d4/Health-Essentials?w=128&amp;q=75 1x, https://assets.clevelandclinic.org/transform/482db8cd-aa1e-45b5-a2a4-cf6aa5e5d2d4/Health-Essentials?w=256&amp;q=75 2x" src="https://assets.clevelandclinic.org/transform/482db8cd-aa1e-45b5-a2a4-cf6aa5e5d2d4/Health-Essentials?w=256&amp;q=75"/><div class="w-full"><h2 data-identity="headline" class="text-gray-900 font-bold leading-rem24px text-rem20px bp600:text-rem25px bp600:leading-rem30px print:text-rem15px print:leading-rem20px print:font-bold pb-rem8px">Better health starts here</h2><p class="text-gray-900 text-rem16px leading-rem23px bp600:w-full pb-rem8px bp900:pb-rem16px">Sign up for our Health Essentials emails for expert guidance on nutrition, fitness, sleep, skin care and more.</p><div class="flex flex-col max-w-body gap-y-rem16px bp900:hidden"><a href="https://assets.clevelandclinic.org/transform/2ff943a2-abb1-4a1c-8ede-f8848703e789/HealthEssentials-SampleEmail-2026" target="_blank" class="font-medium text-brandBlue-500 hover:text-blue-800 text-rem15px leading-rem23px underline underline-offset-[5px]">Example email</a><a data-identity="link-button" class="transition select-none text-white bg-brandBlue-500 hover:bg-blue-800 group block font-medium text-rem18px leading-rem24px px-rem24px rounded-[0.3125rem] text-center focus-standard py-rem8px w-full bp600:w-fit" href="https://my.clevelandclinic.org/health-essentials-sign-up">Sign up</a></div><div class="hidden bp900:flex bp900:justify-between bp900:items-center w-full"><a data-identity="link-button" class="transition select-none text-white bg-brandBlue-500 hover:bg-blue-800 group block font-medium w-fit text-rem18px leading-rem24px px-rem24px rounded-[0.3125rem] text-center focus-standard py-rem8px" href="https://my.clevelandclinic.org/health-essentials-sign-up">Sign up</a><a href="https://assets.clevelandclinic.org/transform/2ff943a2-abb1-4a1c-8ede-f8848703e789/HealthEssentials-SampleEmail-2026" target="_blank" class="font-medium text-brandBlue-500 hover:text-blue-800 text-rem15px leading-rem23px underline underline-offset-[5px] whitespace-nowrap">Example email</a></div></div></div></div></div><section class="bg-blue-050 p-rem32px pb-rem8px mt-rem56px print:hidden"><h3 data-identity="headline" class="text-gray-900 font-bold leading-rem30px text-rem25px bp600:text-rem32px bp600:leading-rem38px print:text-rem19px print:leading-rem27px print:font-semibold mb-rem16px">Experts You Can Trust</h3><section data-identity="medical-review-disclaimer" class=""><span class="flex flex-col bp600:flex-row items-start text-gray-900 print:text-black" data-identity="medically-reviewed-badge"><span class="flex items-center"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" class="mr-rem4px"><circle cx="7.5" cy="7.5" r="7.5" fill="#ffffff"></circle><path 