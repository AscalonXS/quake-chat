    <div class="listwithicon parbase">
<div class="icon-list-main" data-context="icon-list-main">
    
    
        <div class="list-row transparent">
            <div class="image-content">
                <img loading="lazy" class="icon-list-image" src="/content/dam/redcross/atg/Photos/Find_Help/400x200-ERV-icon.jpg.transform/282/q70/feature/image.jpeg" alt="ERV icon"/>
