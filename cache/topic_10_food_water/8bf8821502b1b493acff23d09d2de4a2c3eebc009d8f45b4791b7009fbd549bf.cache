    <div id="shadow_device"></div><script>
	$(document).ready(function(){		
		var topSlide = $('.tpop_slide'),
			topSlide_ctrl = topSlide.parent().find('.tpop_ctrl'),
			topSlide_stop = topSlide_ctrl.find('.slick-stop'),
			topSlide_play = topSlide_ctrl.find('.slick-play'),
			topCurrent = topSlide_ctrl.find('.current'),
			topTotal = topSlide_ctrl.find('.total');
		if (topSlide.find('div.item').length > 1){
			topSlide.on('init reInit afterChange', function(event, slick, currentSlide, nextSlide){
				topCurrent.text(slick.currentSlide + 1);
				topTotal.text(slick.slideCount);
			});
			topSlide.slick({
				pauseOnHover : false,
				autoplay : true,
				autoplaySpeed : 5000,
				slidesToShow : 1,
				slidesToScroll : 1,
				arrows: false
			});
			topSlide_play.click(function(){
				topSlide.slick('slickPlay');
				topSlide_stop.show().focus();
				topSlide_play.hide();					
			});
			topSlide_stop.click(function(){
				topSlide.slick('slickPause');
				topSlide_play.show().focus();
				topSlide_stop.hide();
			});
		} else {
			$('.ctrl_wrap').hide();
		}
		
		if (topSlide.find('div.item').length > 0){
			$('#toppopup').show();
		} else {
			$('#toppopup').hide();
		}
		function getCookie(cname) {
			var name = cname + "=";
			var ca = document.cookie.split(';');
			for(var i=0; i<ca.length; i++) {
				var c = ca[i];
				while (c.charAt(0)==' ') c = c.substring(1);
				if (c.indexOf(name) != -1) return c.substring(name.length,c.length);
			}
			return "";
		}
		function setCookie(cname, cvalue, exdays) {
			var d = new Date();
			d.setTime(d.getTime() + (exdays*24*60*60*1000));
			var expires = "expires="+d.toUTCString();
			document.cookie = cname + "=" + cvalue + "; " + expires;
		}

		function pClose(){
			$('body').removeClass('top');
			$('.tpop_slide').slideUp();
			
		}
		function pOpen(){
			if (topSlide.find('div.item').length > 0){
				$('body').addClass('top');
				$('#toppopup').slideDown();
			}
		}	
		cookiedata = document.cookie;
		if(cookiedata.indexOf("p_close=Y")<0 && sessionStorage.getItem("tpop") != "N"){
			pOpen();
		} else {
			pClose();
			$('#toppopup').hide();
		}
		
		$('.tpop_open').click(function(){
			sessionStorage.setItem("tpop", "Y");
			pOpen();
			$('.tpop_close').focus();
			return false;
		});
		$('.tpop_close').click(function(){
			sessionStorage.setItem("tpop", "N");
			pClose();
			return false;
		});

		$('.p_close').click(function(){
			if($('#close1').is(':checked')){
				sessionStorage.setItem("tpop", "N");
				setCookie("p_close","Y",1);
			}
			pClose();
		});		
	});
</script>

