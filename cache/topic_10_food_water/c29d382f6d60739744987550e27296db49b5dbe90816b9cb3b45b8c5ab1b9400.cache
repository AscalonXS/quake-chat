<!-- @prismcss@ -->
<style>
	header, footer, nav {
		display: none;
	}

    @media print {
        .is-external-archive .container {
            background-image: url('/TemplatePackage/4.0/assets/imgs/bg-archived-content.jpg') !important;
            background-repeat: repeat !important;
            -webkit-print-color-adjust: exact !important;
            color-adjust: exact !important;
            print-color-adjust: exact !important;
        }
    }
	
	@media screen and (min-width: 992px) {
		.cdc-2020-mobile-title.d-lg-none {
			display: none;
		}
	}

	.header-language-bar,
	.leftnav-wrapper,
	.cdc-journey-nav,
	.quick-feedback-block,
	.cdc-dfe-body__right,
	.cdc-page-banner,
	.site-footer,
	.site-title {
		display: none;
	}

	.breadcrumb {
		display: none;
	}

	nav {
		display: none;
	}

	.tab-content .tab-pane {
		display: block !important;
		border: 1px gray solid;
	}

	.cdc-card-slider,
	.accordion .collapse {
		display: block !important;
	}

	#archive-header {
		display: block;
	}

	#archive-header .archive-header-top {
		padding: 1rem;
	}

	#archive-header .archive-header-logo {
		align-items: center;
		display: flex;
		height: 80px;
		justify-content: center;
		max-width: 280px;
		width: 100%;
	}

	#archive-header .archive-header-logo-atsdr {
		align-items: center;
		display: flex;
		height: 80px;
		justify-content: center;
		max-width: 671px;
		width: 100%;
	}

	#archive-header .archive-header-bottom {
		background-color: rgb(251 171 24);
		border-top-width: 8px;
		border-top-style: solid;
		border-top-color: rgb(30 58 138 / 1);
		padding: 0.25rem 1rem;
	}

	#archive-header .archive-header-title {
		color: rgb(31 41 55 / 1);
		font-size: 1.75rem;
		font-weight: bold;
		text-decoration: none;
	}

	#archive-warning {
		background-color: rgb(255 236 179);
		margin-bottom: 1rem;
		padding: 1rem;
	}

	#archive-warning .archive-warning-title {
		font-size: 21px;
		font-weight: bold;
		margin-bottom: 1rem;
		margin-top: 0;
	}

	#archive-warning .archive-warning-body {
		display: flex;
		margin-bottom: 1rem;
	}

	#archive-warning .archive-warning-img+.archive-warning-info {
		margin-left: 1rem;
	}

	#archive-warning .archive-warning-info {
		margin-bottom: 0;
		margin-top: 0;
	}

	#archive-warning .archive-warning-btn {
		background-color: rgb(229 231 235);
		border: 2px solid rgb(235 216 159);
		border-radius: 4px;
		color: rgb(0 94 170);
		display: block;
		font-weight: bold;
		padding: 0.5rem 0.75rem;
		text-align: center;
		text-decoration: none;
	}

	@media screen and (min-width: 576px) {
		#archive-warning .archive-warning-btn {
			display: inline-block;
			text-align: left;
		}
	}

	#archive-warning .archive-warning-btn:focus,
	#archive-warning .archive-warning-btn:hover {
		text-decoration: underline;
	}

	#archive-warning .archive-warning-btn+.archive-warning-btn {
		margin-top: 0.5rem;
	}

	@media screen and (min-width: 576px) {
		#archive-warning .archive-warning-btn+.archive-warning-btn {
			margin-left: 0.5rem;
			margin-top: 0;
		}
	}

	#archive-footer {
		display: block;
	}

	#archive-footer .archive-footer-top {
		background-color: rgb(251 171 24);
		padding: .25rem 1rem;
	}

	#archive-footer .archive-footer-title {
		color: rgb(31 41 55);
		font-size: 1.75rem;
		font-weight: bold;
		text-decoration: none;
	}

	#archive-footer .archive-footer-bottom {
		background-color: rgb(31 41 55);
		padding: 1rem;
	}

	#archive-footer .archive-footer-nav {
		display: block;
	}

	#archive-footer .archive-footer-list {
		font-size: 15px;
		list-style-type: none;
		margin: 0;
		padding-left: 0;
	}

	@media screen and (min-width: 768px) {
		#archive-footer .archive-footer-list {
			display: flex;
			flex-wrap: wrap;
		}
	}

	@media screen and (min-width: 1200px) {
		#archive-footer .archive-footer-list {
			flex-wrap: no-wrap;
			justify-content: space-between;
		}
	}

	#archive-footer .archive-footer-item {
		margin: 0;
	}

	@media screen and (min-width: 768px) {
		#archive-footer .archive-footer-item {
			width: 50%;
		}
	}

	@media screen and (min-width: 1200px) {
		#archive-footer .archive-footer-item {
			width: auto;
		}
	}

	#archive-footer .archive-footer-item+.archive-footer-item {
		margin-top: 0.5rem;
	}

	@media screen and (min-width: 1200px) {
		#archive-footer .archive-footer-item+.archive-footer-item {
			margin-top: 0;
		}
	}

	@media screen and (min-width: 768px) {
		#archive-footer .archive-footer-item:nth-child(-n+2) {
			margin-top: 0;
		}
	}

	#archive-footer .archive-footer-link {
		color: #fff;
		text-decoration: none;
	}

	#archive-footer .archive-footer-link:hover {
		text-decoration: underline;
	}
	
	#archive-footer .archive-footer-bottom .archive-unlink {
		color: #ffffff !important;
	}
	.archive-unlink {
		color: #000000 !important;
	}
	.archive-unlink:focus,
	.archive-unlink:hover {
		color: #075290 !important;
	}
</style>
<script>

    class CDC_Archive_Page {

        archivedUrls = [];
        isATSDR = false;

        static ENABLE_ALL_LINKS_CLASS = 'archive-links-enabled';
        static ENABLE_LINK_CLASS      = 'archive-enable';
        static DISABLED_LINK_CLASS    = 'archive-unlink';
        static DATA_FILE_EXTENSIONS   = [
            '.csv',
            '.json',
            '.xml',
            '.xls',
            '.xlsx'
        ];

        constructor() {
            //Is this an ATSDR page
            if (window.location.pathname.includes('/www_atsdr_cdc_gov/')) {
                this.isATSDR = true;
            }

            //Add class to html if archive
            this.addArchiveSelectorClass();

            //Disable all links
            this.disableAllLinks();

            // Hide SSI Errors
            this.hideSSIErrors();

            // Hide youtube videos
            this.hideYoutube();

            // Render header/footer when outside of app
            this.renderArchiveHeaderFooter();

            //Ajax call to fetch links to allow (block until response)
            this.fetchArchiveLinks();

            //Enable select links
            this.processPageLinks();
        }

        addArchiveSelectorClass() {
            document.body.parentNode.classList.add('is-external-archive');
        }

        disableAllLinks() {
            var links = document.getElementsByTagName('a');
            for (var i = 0; i < links.length; i++) {
                links[i].addEventListener('click', (event) => {
                    event.preventDefault();
                    return false;
                });
                links[i].classList.add(CDC_Archive_Page.DISABLED_LINK_CLASS);
            }
        }

        hideSSIErrors() {
            document.querySelectorAll('B').forEach((element) => {
                if ('Error processing SSI file' === element.innerHTML) {
                    element.innerHTML = '';
                }
            });
            if (document.title && -1 < document.title.indexOf('<B>Error processing SSI file</B>')) {
                document.title = String(document.title).replace('<B>Error processing SSI file</B>', '');
                document.title = String(document.title).replace('<BR>', '');
            }
        }

        hideYoutube() {
            var youtubeContainers = document.getElementsByClassName('video-container');
            for (var i = 0; i < youtubeContainers.length; i++) {
                var youtubeContainer = youtubeContainers[i];
                while (youtubeContainer.firstChild) {
                    youtubeContainer.removeChild(youtubeContainer.firstChild);
                }
                var youtubeRemovedText = document.createTextNode("YouTube Video Removed");
                youtubeContainer.appendChild(youtubeRemovedText);
            }

            var youtubeIframes = document.querySelectorAll('iframe[src*="youtube"]');
            for (var i = 0; i < youtubeIframes.length; i++) {
                var replacementText = document.createTextNode("YouTube Video Removed");
                youtubeIframes[i].replaceWith(replacementText);
            }
        }

        renderArchiveHeaderFooter() {
            // Render Archive App Header/Warning/Footer when viewing content outside of iframe
            if (!window.frameElement) {
                var env = window.location.origin;
                var url = window.location.protocol + '/' + window.location.pathname;
                url = url.replace('_cdc_', '.cdc.');

