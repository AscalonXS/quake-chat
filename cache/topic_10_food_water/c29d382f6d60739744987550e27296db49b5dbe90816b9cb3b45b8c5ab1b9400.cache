.604.605-.705.907-.101.303-.302.806-.302 1.209v6.852h-1.511v.1zM663.651 54.003l-4.232-10.681h1.614l3.525 8.767 3.728-8.767h1.612l-6.446 14.911h-1.613l1.812-4.23z"/></svg>';
                    logoClass = 'archive-header-logo-atsdr';
                    siteUrl = 'https://www.atsdr.cdc.gov';
                    siteName = 'ATSDR';
                    siteTitle = 'Agency for Toxic Substances and Disease Registry';
                    siteAboutUrl = 'https://www.atsdr.cdc.gov/about/index.html';
                }


                var archiveHeaderMarkup = '<div class="archive-header-top"><a class="' + logoClass + '" title="' + siteTitle + '" href="' + siteUrl + '" target="_blank">' + logoSvg + '</a></div><div class="archive-header-bottom"><a class="archive-header-title" title="' + siteName + ' Archive Home" href="' + env + '" target="_blank">' + siteName + ' Archive</a></div>';
                var archiveHeader = document.createElement('header');
                archiveHeader.id = 'archive-header';
                archiveHeader.role = 'banner';
                archiveHeader.innerHTML = archiveHeaderMarkup;
                document.body.insertAdjacentElement('afterbegin', archiveHeader);

                
                var warningMarkup = '<p class="archive-warning-title">This page is archived for historical purposes and is no longer being updated.</p><div class="archive-warning-body"><i class="archive-warning-img"><svg fill="#fbab18" xmlns="https://www.w3.org/2000/svg" width="48" viewBox="0 0 109.84 95.894"><path d="M109.441 91.498 57.466 1.465C56.936.549 55.964 0 54.92 0s-2.015.568-2.546 1.465L.398 91.498a2.894 2.894 0 0 0 0 2.93 2.937 2.937 0 0 0 2.546 1.466h103.953a2.97 2.97 0 0 0 2.545-1.466 2.891 2.891 0 0 0-.001-2.93z"></path><path fill="#FFF" d="M61.878 79.6A6.939 6.939 0 1 1 48 79.6a6.938 6.938 0 0 1 6.94-6.938 6.936 6.936 0 0 1 6.938 6.938zM54.939 30.878c-3.782 0-6.826 3.109-6.826 6.97l2.018 24.415c.385 3.158.714 4.948 2.018 5.789a6.689 6.689 0 0 0 2.79.607c.99 0 1.93-.217 2.777-.603 1.311-.84 1.645-2.631 2.03-5.796l2.019-24.415c-.001-3.858-3.044-6.967-6.826-6.967z"></path></svg></i><p class="archive-warning-info">This is archived content from the ' + siteName + ' website. The information here may be outdated and links may no longer function. Go to <a href="' + siteUrl + '" target="_blank">' + siteName + ' Home</a> for all other recent information.</p></div><a class="archive-warning-btn" href="' + env + '/#/details?url=' + url + '" target="_blank">View in ' + siteName + ' Archive</a><a class="archive-warning-btn" href="' + env + '" target="_blank">Go to ' + siteName + ' Archive Home Page</a>';
                var warning = document.createElement('div');
                warning.id = 'archive-warning';
                warning.classList.add('archive-warning');
                warning.innerHTML = warningMarkup;
                document.getElementById('archive-header').insertAdjacentElement('beforeend', warning);

                var archiveFooterMarkup = '<div class="archive-footer-top"><a class="archive-footer-title" title="' + siteName + ' Archive Home" href="' + env + '" target="_blank">' + siteName + ' Archive</a></div><div class="archive-footer-bottom"><nav class="archive-footer-nav" role="navigation"><ul class="archive-footer-list"><li class="archive-footer-item"><a class="archive-footer-link" href="' + siteAboutUrl + '" title="' + siteTitle + '" target="_blank">About ' + siteName + '</a></li><li class="archive-footer-item"><a class="archive-footer-link" href="https://www.cdc.gov/other/accessibility.html" title="CDC Accessibility" target="_blank">Accessibility</a></li><li class="archive-footer-item"><a class="archive-footer-link" href="https://www.cdc.gov/other/privacy.html" title="CDC Digital Media Channel Privacy Policy Notice" target="_blank">Privacy</a></li><li class="archive-footer-item"><a class="archive-footer-link" href="https://www.cdc.gov/od/foia/" title="Freedom of Information Act (FOIA)" target="_blank">FOIA</a></li><li class="archive-footer-item"><a class="archive-footer-link" href="https://www.hhs.gov/" title="U.S. Department of Health &amp; Human Services" target="_blank">U.S. Department of Health &amp; Human Services</a></li><li class="archive-footer-item"><a class="archive-footer-link" href="https://www.cdc.gov/Other/policies.html" title="CDC Policies and Regulations" target="_blank">Policies</a></li><li class="archive-footer-item"><a class="archive-footer-link" href="https://www.usa.gov/" title="USA.gov" target="_blank">USA.gov</a></li><li class="archive-footer-item"><a class="archive-footer-link" href="https://www.cdc.gov/other/disclaimer.html#exit-notification" title="Exit Notification/Disclaimer Policy" target="_blank">CDC Website Exit Disclaimer</a></li></ul></nav></div>';
                var archiveFooter = document.createElement('footer');
                archiveFooter.id = 'archive-footer';
                archiveFooter.role = 'contentinfo';
                archiveFooter.innerHTML = archiveFooterMarkup;
                document.body.insertAdjacentElement('beforeend', archiveFooter);
            }
        }

        fetchArchiveLinks() {
            let xhr = new XMLHttpRequest();
            xhr.open('GET', '/sitemap.json', false);
            xhr.onload = () => {
                if (xhr.status < 400) {
                    this.archivedUrls = JSON.parse(xhr.responseText);
                } else {
                    console.log('Server error fetching sitemap.json');
                }
            }
            xhr.onerror = () => {
                console.log('Connection Error fetching sitemap.json');
            }
            xhr.send();
        }

        processPageLinks() {
            // Allow all links on page?
            let allowAllLinks = false;
            let htmlElem = document.querySelector('html');
            if (htmlElem.classList.contains(CDC_Archive_Page.ENABLE_ALL_LINKS_CLASS)) {
                allowAllLinks = true;
            }

            // Get each link and process exceptions/rules to re-enable
            const allLinks = document.querySelectorAll('a');
            allLinks.forEach((link) => {
                if (
                    link.classList.contains(CDC_Archive_Page.DISABLED_LINK_CLASS) &&
                    (true === allowAllLinks || true === this.shouldAllowLink(link))
                ) {
                    this.fixLinkRootFolder(link);
                    link.classList.remove(CDC_Archive_Page.DISABLED_LINK_CLASS);
                    link.addEventListener('click', (event) => {
                        let linkHref = link.href;
                        if (!this.isUrlAbsoluteExternal(link.href)) {
                            //If in the app iframe and link is root relative url need to open the link within the context of the archive app
                            if (window.frameElement) {
                                linkHref = this.buildArchiveAppUrlToLink(link);
                            }
                        }
                        window.open(linkHref);
                    });
                }
            });
        }

        buildArchiveAppUrlToLink(link) {
            try {
                let iframeUrl = new URL(window.location);
                let linkUrl = iframeUrl.origin + link.getAttribute('href');
                let parentUrl = new URL(window.parent.location);
                parentUrl.hash = `#/details?archive_url=${linkUrl}`;
                return parentUrl.href;
            } catch (error) {
                console.log(error);
                return link.href;
            }
        }

        fixLinkRootFolder(originalLink) {
            let href = originalLink.getAttribute('href');
            if (href?.startsWith('/')) {
                originalLink.setAttribute('href', this.addRootFolderToUrl(href));
            }
        }

        addRootFolderToUrl(url) {
            const pathParts = window.location.pathname.split('/');
            if (pathParts.length > 0) {
                const firstPart = pathParts[1];
                if (!url.startsWith(`/${firstPart}`)) {
                    return `/${firstPart}${url}`;
                } else {
                    return url;
                }
            } else {
                return url;
            }
        }

        shouldAllowLink(link) {
            if (! link.href) {
                return false;
            }
            let url = new URL(link.href);
            let href = link.getAttribute('href');

            //Is this a link in the archive header or footer?
            if (
                document.querySelector('#archive-header')?.contains(link) ||
                document.querySelector('#archive-footer')?.contains(link)
            ) {
                return true;
            }

            //Does link have enable class and is valid extension?
            if (link.classList.contains(CDC_Archive_Page.ENABLE_LINK_CLASS)) {
                let ext = url.pathname.substring(url.pathname.lastIndexOf('.'), url.pathname.length);
                if (CDC_Archive_Page.DATA_FILE_EXTENSIONS.includes(ext)) {
                    return true;
                }
            }

            //Is link absolute, if so allow
            if (href.indexOf('http') === 0) {
	            if (this.isUrlAbsoluteExternal(url)) {
					//Fix absolute urls to original pre-archive site pages that are now archived
	                this.maybeFixAbsoluteUrlToArchivedPage(link);
	            } else {
					//Fix absolute urls to this site, make them root relative to avoid react issue
					this.maybeFixArchiveAbsoluteUrls(link);
				}
	            return true;
            }

            //Is this link in the list of pages currently in the archives?
            if (href?.startsWith('/')) {
                let archiveUrl = this.addRootFolderToUrl(href);
                if (this.archivedUrls.includes(archiveUrl)) {
                    return true;
                }
            }

            return false;
        }

        isUrlAbsoluteExternal(url) {
            if (typeof url === 'string') {
                try {
                    url = new URL(url);
                } catch (error) {
                    //Do nothing
                }
            }
            if (url instanceof URL && (url.host !== window.location.host)) {
                return true;
            }
            return false;
        }

        maybeFixAbsoluteUrlToArchivedPage(link) {
            try {
                let url = new URL(link.href);
                let rootRelativeUrl = this.addRootFolderToUrl(url.pathname);
                if (this.archivedUrls.includes(rootRelativeUrl)) {
                    link.href = rootRelativeUrl;
                }
            } catch (error) {
                //Nothing to report
                console.log('Error parsing link.href to URL object: ' + link.href);
            }
        }

		maybeFixArchiveAbsoluteUrls(originalLink) {
			let href = originalLink.getAttribute('href');
			if (href?.startsWith(window.location.origin)) {
				href = href.replace(window.location.origin, '');
				originalLink.setAttribute('href', href);
			}
        }
    }

	document.addEventListener('DOMContentLoaded', function () {
        window.archivePage = new CDC_Archive_Page();
	});
</script>
