}

/* ======================= CSS for PUBLICATIONS section ========================== */
/* === Publications figure imgs align as inline === */
.image-container {
display:flex;
justify-content:left;
margin-top:30px
}

/* ============ CSS from Kara Bonsack ============== */
#expub_content thead {
background-color:#003ecd;
color:#fff
}

#expub_content .table > thead > tr > th,#expub_content .table > thead > tr > td,#expub_content .table > tbody > tr > th,#expub_content .table > tbody > tr > td,#expub_content .table > tfoot > tr > th,#expub_content .table > tfoot > tr > td {
border:1.5px solid #D5DBF1
}

/* ============ CSS from DX Group-Joel Salisbury ============== */
/* === publications page - remove bullets from pubs boxes === */
#publication-list {
list-style:none
}

/** 2-columns in the archive because of long excerpts **/
@media screen and (min-width: 960px) {
#publication-list {
grid-template-columns:repeat(auto-fill,48%)
}
}

.filters div:first-child {
border-bottom:1px solid #ccc;
padding-bottom:10px;
margin-bottom:10px
}

.checkbox-contain {
margin-bottom:17px!important;
line-height:18px;
font-weight:400
}

#year_of_publication {
margin-top:10px;
width:100%;
