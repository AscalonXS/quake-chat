<!-- Simple Custom CSS -->
<style type='text/css'>
/* ============ Impacts Page ============== */
.statewide-indicator h2,.statewide-indicator .h2 {
font-weight:500;
font-family:"PT Serif"!important;
margin-top:0;
text-align:right
}

/* === end === */
.widget_sp_image-description {
font-size:14px;
color:#5b607d;
line-height:1em;
margin-top:15px
}

.home-intro {
font-size:16px
}

.home #content .cahnr-title-style hr {
border-top:2px solid #51b055;
margin-bottom:-30px;
margin-top:50px
}

.home #content .cahnr-title-style h2 {
background-color:#fff;
font-size:37px;
display:inline-block;
padding-left:20px;
padding-right:20px
}

.cahnr-title-style hr {
border-top:2px solid #51b055;
margin-bottom:-60px;
margin-top:50px
}

.cahnr-title-style {
text-align:center
}

.cahnr-title-style h2 {
background-color:#fff;
font-size:32px;
display:inline-block;
padding-left:20px;
padding-right:20px
}

/* === arrow-row in grandchild theme ==== */
.recent-headlines:after {
/* ==== the white arrow icon attached to the above row with recent-headline class ==== */
content:"";
display:inline-block;
width:0;
height:0;
border-style:solid;
border-width:33px 50px 0;
border-color:#fff transparent transparent;
position:absolute;
bottom:-33px;
left:0;
right:0;
margin-left:auto;
margin-right:auto
}

.mobile-arrow {
/* PLOYT fact sheet */
display:none!important
}

/* ============ MASTHEAD AND NAV ============== */
/* ==== ADD Home Link ==== */
#masthead .navbar-default .navbar-collapse .navbar-nav > li:nth-of-type(1) {
display:inline-block
}

#masthead .navbar-default .navbar-collapse .navbar-nav > li:nth-of-type(2) > a {
margin-left:0
}

/* ==== ADD Mobile Home Link ==== */
#masthead #nav-wrapper .navbar-default .navbar-nav > li:nth-of-type(1) {
display:inline-block
}

/* ==== flag ==== */
#page #content .widget .btn.btn-default .flag {
background-color:#859fc0!important
}

#page #content .widget .btn.btn-success .flag {
color:#fff!important
}

/* hover line under nav links */
@media (min-width: 767px) {
#masthead .navbar-default .navbar-collapse .navbar-nav > li > a:after {
background:linear-gradient(to right,#003ecd 0%,#003ecd 100%)
}
}

#masthead .navbar-default .navbar-collapse .navbar-nav > li > a:after {
background:linear-gradient(to right,#003ecd 0%,#003ecd 100%)
}

/* ==== for People template pages ==== */
#page-userlist {
/* KEEP FOR PAGE HEADER space */
margin-top:0
}

/* ==== INFOGRAPHICS ==== */
.ext-infographic .widget {
background:#005497!important;
border-bottom:8px solid #001542!important;
border-radius:20px!important;
padding:20px 20px 22px!important;
color:#fff!important
}

.ext-infographic .widget strong {
font-size:40px;
line-height:1em;
margin-top:2px;
display:inline-block;
margin-bottom:4px
}

@media (max-width: 1200px) {
.ext-infographic .widget strong {
font-size:35px
}
}

/* ============ BUTTONS ============== */
/* ==== Button Default ==== */
#page #content .widget .btn.btn-default {
color:#1e1e1e!important;
border:3px solid #ddd;
background:transparent;
background-image:-webkit-linear-gradient(120deg,transparent 50%,white 50%);
background-image:linear-gradient(120deg,transparent 50%,white 50%);
background-size:225%;
background-repeat:no-repeat;
background-position:100%;
-webkit-transition:all 400ms ease-in-out;
transition:all 400ms ease-in-out
}

#page #content .widget .btn.btn-default:hover,#page #content .widget .btn.btn-default:active,#page #content .widget .btn.btn-default:focus {
color:#fff!important;
background-color:transparent
}

/* Form button */
#page #content .entry-content .panel-layout .panel-grid .panel-grid-cell .widget.widget_gform_widget .gform_wrapper .gform_footer input.button,#page #content .entry-content .panel-layout .panel-grid .panel-grid-cell .widget.widget_gform_widget .gform_wrapper .gform_footer input[type="submit"],#page #content .entry-content .panel-layout .panel-grid .panel-grid-cell .widget.widget_gform_widget .gform_wrapper .gform_page_footer input.button,#page #content .entry-content .panel-layout .panel-grid .panel-grid-cell .widget.widget_gform_widget .gform_wrapper .gform_page_footer input[type="submit"] {
background-image:linear-gradient(90deg,transparent 50%,#69ac5f 50%);
border:3px solid #69ac5f
}

/* ==== GENERAL ==== */
.wp-caption .wp-caption-text {
color:#6B6B6B
}

.page-template-default #content {
margin-top:5px;
margin-bottom:40px
}

h1,h2,.h1,.h2 {
/* Web Dev add */
font-weight:500;
font-family:"PT Serif"!important;
margin-top:/* KB add */
35px
}

.newsletter-h1 h1,.newsletter-h1 .h1,.newsletter-h2 h2,.newsletter-h2 .h2 {
margin:0;
padding:0!important
}

h3,.h3 {
font-size:24px;
margin-top:25px
}

.panel-grid-cell .widget-title {
font-family:"PT Serif"!important;
font-weight:500
}

h4,.h4 {
font-size:18px;
font-weight:500
}

.navbar-nav li a {
font-weight:400
}

a {
color:#013ecd
}

.subpage .widget a {
color:#013ecd
}

hr {
border-top:2px solid #dedede
}

.bold-menu {
/* higlight text in a menu list */
font-weight:700!important
}

.breadcrumb {
background-color:#fff!important
}

/* === glyphs === */
.glyph-large .glyphicons {
font-size:30px;
color:#7c878e
}

.glyph-large a {
/* text link when using a glyph */
font-size:20px;
font-weight:500;
line-height:1em
}

blockquote {
width:85%
}

/* ===== ACCORDIONS ====== */
#page #content .entry-content .widget_siteorigin-panels-builder .panel-body {
background:none
}

/* ===== BOXES ====== */
/* shaded-box */
.shaded-box {
padding:10px;
background-color:#f2f3f9;
border:1px solid #003ecd21;
border-radius:10px
}

/* shaded-box-green */
.shaded-box-green {
padding:10px;
background-color:#f2f8f2;
border:1px solid #69ac5e;
border-radius:10px
}

/* shaded-box-white */
.shaded-box-white {
background-color:#fff;
padding:10px;
border:1px solid #BABBB5;
border-radius:10px
}

/* ========= TITLE-BOX as green (title-box) ========= */
#page #content .entry-content .panel-layout .panel-grid .panel-grid-cell .widget .title-box h3.widget-title {
background:/*green */
#69ac5f;
margin:0
}

.title-box .widget-title {
position:relative;
bottom:0;
width:100%;
font-weight:500!important;
letter-spacing:.04em;
line-height:1;
color:#fff!important;
font-size:24px!important;
padding:10px!important;
padding-bottom:15px!important
}

body.home.page-template-page-blank .title-box h3.widget-title {
margin-bottom:0!important
}

/* ========= CAPTION-BOX as IMG CAPTION (caption-box) ========= */
.caption-box {
background:/* green */
#69ac5f
}

#page #content .entry-content .panel-layout .panel-grid .panel-grid-cell .widget.widget_sp_image .caption-box .widget_sp_image-description {
font-style:normal;
font-weight:700;
letter-spacing:.04em;
line-height:1.2em;
color:#fff;
font-size:24px;
padding:3px 10px;
border-left:none;
margin-top:10px
}

#page #content .caption-box .widget_sp_image-description a {
color:#e0e5eb
}

#page #content .caption-box .widget_sp_image-description a:hover {
color:#fff
}

/* ========= Overlay box when text link over images  ========= */
.widget_widget_sp_image .widget_sp_image-description.image-has-link a {
width:100%;
background:#000e2fc4;
display:block;
padding:8px 10px 7px;
color:#fff!important;
font-size:18px;
font-weight:500
}

/* === (card-header) used in Newsletter section === */
#page #content .entry-content .panel-layout .panel-grid .panel-grid-cell .widget .card-header h3.widget-title {
background-color:#000d30;
color:#fff;
line-height:1.3;
letter-spacing:.05em;
font-size:18px;
font-weight:700;
padding:10px;
margin:0
}

/* === Metaslider Headers === */
.entry-content .widget.widget_metaslider_widget .metaslider .caption-wrap .caption h1,.entry-content .widget.widget_metaslider_widget .metaslider .caption-wrap .caption h1 {
font-weight:700;
line-height:1.15em;
/* text-shadow: 3px 3px 3px rgba(0,0,0,0.7); */
padding:10px
}

.entry-content .widget.widget_metaslider_widget .metaslider .caption-wrap .caption {
top:auto!important;
bottom:3vw!important;
width:100%!important;
background-color:#0000004d
}

@media (max-width: 991px) {
.entry-content .widget.widget_metaslider_widget .metaslider .caption-wrap .caption {
