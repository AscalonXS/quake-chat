top:0;
left:0;
width:100%;
height:100%
}

/* === Extension page rss feeds===  */
.page-id-11828 .extension-rss-feed-row .widget_cahnr-rss li {
display:none
}

.page-id-11828 .extension-rss-feed-row .widget_cahnr-rss li:nth-of-type(1) {
