}

.publication-block h2 {
line-height:24px
}

.single-publication h2 {
line-height:32px!important
}

.publication-block img {
height:250px!important
}

div#searchApp {
padding-top:35px
}

#expub_content .panel-layout:first-child .panel-grid:first-child a {
background-color:#000f;
padding:2px 5px;
border-radius:5px;
color:#fff
}

#expub_content .panel-layout:first-child .panel-grid:first-child a:hover {
color:#eee
}

#searchApp:has(.htmx-request) #publication-wrap {
opacity:.4!important
}

#search {
width:100%;
margin-bottom:10px
}

.filters button {
width:100%;
display:block
}

.print-image {
display:none
}

@media (min-width: 767px) {
#masthead .navbar-default .navbar-collapse .navbar-nav > li > a:hover::before,#masthead .navbar-default .navbar-collapse .navbar-nav > li > a:focus::before,#masthead .navbar-default .navbar-collapse .navbar-nav > li > a:active::before {
width:unset!important
}
}

/** Print CSS **/
@media print {
#footers {
display:none
}

h1 {
font-size:30px!important;
line-height:32px!important
}

h2 {
margin-top:24px!important
}

.print-btn {
display:none!important
}

.siteorigin-panels-stretch {
margin:0!important
}

.siteorigin-panels-stretch h2 {
padding:0!important
}

.siteorigin-panels-stretch .panel-widget-style {
width:100%;
padding:0!important
}

.panel-cell-style {
padding:0 0 20px!important
}

img {
max-width:60%!important
}

.print-image {
display:block;
max-width:100%!important;
width:100%!important
}
}

/** ENDS media print **/
.print-btn {
border-radius:20px;
border:1px #fff solid;
background-color:#000;
text-align:center
}

.dxg-pub-feed ul {
display:flex
}

.dxg-pub-feed li {
width:33%;
margin:5px
}

.dxg-pub-feed li img {
height:250px;
width:100%;
object-fit:cover
}

.dxg-pub-feed .title {
/** controlling home page news and fact sheet feed title text **/
color:#3c3d3d!important;
font-size:18px!important;
text-decoration:none;
line-height:1.3em;
font-weight:500!important
}

.dxg-pub-feed .so-panel {
display:flex;
flex-wrap:wrap
}

.dxg-pub-feed .rcpt_items {
width:33%;
padding:5px 10px
}

/* ===================== FOOTER ============================ */
#footers {
border-top:none;
background-color:#000e2f;
border-bottom:5px solid #000e2f;
padding-bottom:10px!important
}

#footers #mega-footer {
/* === secondary footer box dk blue === */
background-color:#000e2f
}

#footers #mega-footer .widget .widget-title {
margin:0;
color:#fff;
font-weight:500;
font-size:24px;
letter-spacing:.1em;
text-transform:capitalize
}

#footers #mega-footer .widget {
color:#fff;
margin-bottom:0
}

#footers #mega-footer .widget a {
/* === lt green === */
color:#d6ffd8
}

#footers #mega-footer .widget a:hover {
color:#fff
}

/* === UConn FOOTER (dk blue) === */
#footers #footer {
border-top:3px solid #6aac60;
padding-top:20px;
background-color:#000e2f
}

#footers #footer ul li {
color:#fff
}

#footers #footer ul li a {
color:#d6ffd8
}

#footers #footer ul li a:hover {
color:#fff
}

/* === Contact icons (green) === */
#footers #mega-footer .widget.uc-contact-widget .table-responsive .uc-output-phone::before {
color:#69ac5f
}

#footers #mega-footer .widget.uc-contact-widget .table-responsive .uc-output-email::before {
color:#69ac5f
}

#footers #mega-footer .widget.uc-contact-widget .table-responsive .uc-output-addr::before {
color:#69ac5f
}

/* === FOOTER BUTTONS (royal blue) === */
#footers #mega-footer .widget .btn.btn-success {
font-weight:700;
font-size:14px;
background:transparent;
background-image:linear-gradient(90deg,transparent 50%,#003ecd 50%);
border:2px solid #fff;
border-radius:40px;
background-size:229%;
background-repeat:no-repeat;
background-position:99%;
transition:all .85s cubic-bezier(0.68,-0.55,0.265,1.55)
}

#footers #mega-footer .widget .btn {
text-transform:uppercase;
letter-spacing:.16em;
padding:7px 20px
}

#footers #mega-footer .widget .btn.btn-success:active,#footers #mega-footer .widget .btn.btn-success:hover,#footers #mega-footer .widget .btn.btn-success:focus {
background-position:0;
color:#fff!important;
background-color:transparent;
background-image:-webkit-linear-gradient(90deg,transparent 50%,#003ecd 50%);
background-image:linear-gradient(90deg,transparent 50%,#003ecd 50%)
}

/* === Social Media Icons (royal blue) === */
#footers #mega-footer .widget.widget_simple-social-icons a {
border-radius:100px;
padding:10px;
color:#fff!important;
background-image:linear-gradient(90deg,transparent 50%,#003ecd 50%);
border:2px solid var(--wp--preset--color--white)!important
}

#footers #mega-footer .widget.widget_simple-social-icons a:active,#footers #mega-footer .widget.widget_simple-social-icons a:hover,#footers #mega-footer .widget.widget_simple-social-icons a:focus {
background-position:0;
color:#fff!important;
background-color:transparent
}

/* === Fix for bullets in tables == */
table ol,table ul {
list-style:square!important;
padding-left:20px!important
}
