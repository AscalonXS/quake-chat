width:100%;
float:none
}

.page-id-11828 .extension-rss-feed-row .widget_cahnr-rss li:nth-of-type(1) img {
color:#ddd
}

.page-id-11828 .extension-rss-feed-row .widget_cahnr-rss li:nth-of-type(1) img:hover {
text-decoration:none
}

/* =============== UConn Today transition =============== */
.uctoday-plugin {
display:grid
}

.uctoday-plugin img {
width:100%
}

.uctoday-plugin .uctoday-cell-title {
color:#3c3d3d!important;
font-size:18px;
text-decoration:none;
line-height:1.3em;
font-weight:500
}

#ext-today-feed .uctoday-list-item {
width:32%;
float:left;
margin:0 2% 20px 0;
overflow:hidden
}

#ext-today-feed .uctoday-list-item:last-child {
margin:0 0 20px
}

#ext-today-feed .uctoday-img-container {
min-height:240px;
max-height:240px;
display:block;
margin-bottom:15px;
background:#ddd;
list-style:none;
overflow:hidden
}

#today-feed .uctoday-list-item {
width:32%;
float:left;
margin:0 2% 20px 0;
overflow:hidden
}

#today-feed .uctoday-list-item:last-child {
margin:0 0 20px
}

#today-feed .uctoday-img-container {
min-height:240px;
max-height:240px;
display:block;
margin-bottom:15px;
background:#ddd;
list-style:none;
overflow:hidden
}

#news-today-feed .uctoday-plugin,#research-today-feed .uctoday-plugin {
