</script><input data-sf-role='en' type='hidden' value='https://www.who.int/teams/environment-climate-change-and-health/water-sanitation-and-health/environmental-health-in-emergencies/humanitarian-emergencies'><script type="text/javascript">

/*
 * WHO Mobile Geography Navigation Hotfix
 * Regions + Countries
 * Language-independent menu detection
 *
 * Sitefinity:
 * JavaScript Widget > Write JavaScript
 * Placement: Before the closing body tag
 *
 * Replace previous WHO navigation hotfix scripts.
 */

(function () {
  "use strict";

  if (window.__whoGeoNavigationHotfixV4) return;
  window.__whoGeoNavigationHotfixV4 = true;

  const breakpoint = 991;
  const openClass = "who-geo-open-v4";

  const navSelector = ".sf-geo-navigation";

  /*
   * MOBILE CSS
   */
  const css = `
    @media (max-width: ${breakpoint}px) {

      /* Open submenu */
      ${navSelector}
      .sf-primary-geo-navigation > li.${openClass}
      > .sf-secondary-geo-navigation-container {
        display: block !important;
        position: absolute !important;
        top: 0 !important;
        left: 0 !important;
        width: 100% !important;
        height: 100% !important;
        min-height: 0 !important;
        box-sizing: border-box !important;
        overflow-y: auto !important;
        overflow-x: hidden !important;
        background: #203540 !important;
        z-index: 20 !important;
      }

      /* Submenu wrapper */
      ${navSelector} li.${openClass}
      .sf-secondary-geo-navigation-wrapper {
        display: block !important;
        width: 100% !important;
        max-width: 100% !important;
        height: auto !important;
      }

      /* Regions and Countries lists */
      ${navSelector} li.${openClass}
      .sf-secondary-geo-navigation {
        display: block !important;
        opacity: 1 !important;
        visibility: visible !important;
        transform: none !important;
        width: 100% !important;
        height: auto !important;
        padding: 0 !important;
        margin: 0 !important;
        overflow: visible !important;
      }

      /* List items */
      ${navSelector} li.${openClass}
      .sf-secondary-geo-navigation > li {
        display: block !important;
        position: static !important;
        float: none !important;
        width: 100% !important;
        max-width: 100% !important;
        height: auto !important;
        min-height: 0 !important;
        box-sizing: border-box !important;
        margin: 0 !important;
        padding: 0 !important;
        text-align: start !important;
      }

      /* Regional and country links */
      ${navSelector} li.${openClass}
      .sf-secondary-geo-navigation > li > a {
        display: flex !important;
        align-items: center !important;
        justify-content: flex-start !important;
        position: static !important;
        transform: none !important;
        width: 100% !important;
        height: auto !important;
        min-height: 48px !important;
        box-sizing: border-box !important;
        margin: 0 !important;
        padding: 12px 20px !important;
        border-bottom: 1px solid #344b55 !important;
        color: #fff !important;
        text-align: start !important;
        font-size: 16px !important;
        font-weight: 600 !important;
        line-height: 24px !important;
        white-space: normal !important;
      }

      /* Region name spans */
      ${navSelector} li.${openClass}
      .sf-secondary-geo-navigation-region
      > li > a > span {
        display: inline !important;
        position: static !important;
        transform: none !important;
        width: auto !important;
        height: auto !important;
        margin: 0 !important;
        padding: 0 !important;
        line-height: 24px !important;
        color: #fff !important;
        text-align: start !important;
      }

      /* Hide map icons and flag images */
      ${navSelector} li.${openClass}
      .sf-secondary-geo-navigation img {
        display: none !important;
      }

      /* Hide original overlapping back arrow */
      ${navSelector} li.${openClass}
      .nav-back-btn {
        display: none !important;
      }

      /* Back button hidden by default */
      ${navSelector} .who-geo-back-v4 {
        display: none !important;
      }

      /* Back button visible inside open submenu */
      ${navSelector} li.${openClass}
      .who-geo-back-v4 {
        display: block !important;
        width: 100% !important;
        min-height: 48px !important;
        padding: 14px 20px !important;
        margin: 0 !important;
        border: 0 !important;
        border-bottom: 1px solid #344b55 !important;
        background: transparent !important;
        color: white !important;
        font-size: 15px !important;
        font-weight: 600 !important;
        text-align: start !important;
        cursor: pointer !important;
      }

      /* Focus and hover */
      ${navSelector} li.${openClass}
      .sf-secondary-geo-navigation a:hover,
      ${navSelector} li.${openClass}
      .sf-secondary-geo-navigation a:focus-visible,
      ${navSelector} li.${openClass}
      .who-geo-back-v4:focus-visible {
        background: #294653 !important;
        outline-offset: -2px !important;
      }
    }
  `;

  /*
   * INJECT STYLES
   */
  if (!document.getElementById(
    "who-geo-navigation-hotfix-v4"
  )) {
    const style = document.createElement("style");
    style.id = "who-geo-navigation-hotfix-v4";
    style.textContent = css;
    document.head.appendChild(style);
  }

  /*
   * HELPERS
   */
  function directLink(item) {
    return item?.querySelector(":scope > a");
  }

  function directContainer(item) {
    return item?.querySelector(
      ":scope > .sf-secondary-geo-navigation-container"
    );
  }

  /*
   * Detect menus using HTML structure.
   * No translated label checks.
   */
  function getMenuType(item) {
    const container = directContainer(item);

    if (!container) return null;

    if (container.querySelector(
      ".sf-secondary-geo-navigation-region"
    )) {
      return "regions";
    }

    if (container.querySelector(
      ".sf-secondary-geo-navigation-country"
    )) {
      return "countries";
    }

    return null;
  }

  /*
   * Localized Back button.
   * Menu detection remains language-independent.
   */
  function localizedBackText() {
    const lang = (
      document.documentElement.lang || "en"
    ).toLowerCase().split("-")[0];

    const labels = {
      en: "Back to main menu",
      fr: "Retour au menu principal",
      es: "Volver al menú principal",
      ar: "العودة إلى القائمة الرئيسية",
      ru: "Вернуться в главное меню",
      zh: "返回主菜单"
    };

    return labels[lang] || labels.en;
  }

  /*
   * CLOSE MENU
   */
  function closeMenu(item, restoreFocus = false) {
    if (!item) return;

    item.classList.remove(openClass);

    const link = directLink(item);

    if (link) {
      link.setAttribute("aria-expanded", "false");

      if (restoreFocus) {
        link.focus();
      }
    }
  }

  function closeAll(except = null) {
    document.querySelectorAll(
      navSelector +
      " .sf-primary-geo-navigation > li." +
      openClass
    ).forEach(item => {
      if (item !== except) {
        closeMenu(item);
      }
    });
  }

  /*
   * OPEN MENU
   */
  function openMenu(item) {
    const menuType = getMenuType(item);

    if (!menuType) return;

    const container = directContainer(item);
    const link = directLink(item);

    if (!container) return;

    closeAll(item);

    /*
     * Reuse existing localized menu title.
     * If empty, use the existing parent link text.
     */
    const title = container.querySelector(
      ".sf-geo-navigation-title .nav-title"
    );

    if (
      title &&
      !title.textContent.trim() &&
      link
    ) {
      title.textContent = link.textContent.trim();
    }

    /*
     * Create Back button.
     */
    let button = container.querySelector(
      ".who-geo-back-v4"
    );

    if (!button) {
      button = document.createElement("button");
      button.type = "button";
      button.className = "who-geo-back-v4";

      const titleContainer = container.querySelector(
        ".sf-geo-navigation-title"
      );

      if (titleContainer) {
        titleContainer.appendChild(button);
      } else {
        container.prepend(button);
      }
    }

    /*
     * Support RTL and LTR languages.
     */
    const direction = getComputedStyle(item).direction;

    const arrow = direction === "rtl"
      ? "\u2192 "
      : "\u2190 ";

    button.textContent =
      arrow + localizedBackText();

    item.classList.add(openClass);

    if (link) {
      link.setAttribute("aria-expanded", "true");
    }

    container.scrollTop = 0;
    button.focus();
  }

  /*
   * CLICK HANDLER
   */
  document.addEventListener("click", function (event) {
    if (window.innerWidth > breakpoint) return;

    /*
     * Back button
     */
    const back = event.target.closest(
      navSelector + " .who-geo-back-v4"
    );

    if (back) {
      event.preventDefault();
      event.stopImmediatePropagation();

      closeMenu(
        back.closest("li.has-children"),
        true
      );

      return;
    }

    /*
     * Find top-level geography navigation link.
     */
    const link = event.target.closest(
      navSelector +
      " .sf-primary-geo-navigation" +
      " > li.has-children > a"
    );

    if (!link) return;

    /*
     * Ignore hidden navigation copies.
     */
    if (!link.getClientRects().length) return;

    const item = link.closest("li.has-children");

    /*
     * Only handle Regions or Countries.
     * Detection does not depend on language.
     */
    if (!getMenuType(item)) return;

    event.preventDefault();
    event.stopImmediatePropagation();

    /*
     * Toggle menu.
     */
    if (item.classList.contains(openClass)) {
      closeMenu(item, true);
    } else {
      openMenu(item);
    }
  }, true);

  /*
   * ESCAPE KEY
   */
  document.addEventListener("keydown", function (event) {
    if (
      event.key !== "Escape" ||
      window.innerWidth > breakpoint
    ) {
      return;
    }

    const openItem = document.querySelector(
      navSelector +
      " .sf-primary-geo-navigation > li." +
      openClass
    );

    if (!openItem) return;

    event.preventDefault();
    closeMenu(openItem, true);
  });

  /*
   * RESET ON DESKTOP
   */
  window.addEventListener("resize", function () {
    if (window.innerWidth > breakpoint) {
      closeAll();
    }
  });

  console.info(
    "WHO Mobile Geography Navigation Hotfix V4 loaded"
  );
})();

