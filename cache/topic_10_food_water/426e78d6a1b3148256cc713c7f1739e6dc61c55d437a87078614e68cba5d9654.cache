border: none;
padding: 0;
margin: 0 0 30px 0;
display: inline-block;
}

.media-collection-list-view .form-actions {
display: inline-block;
}

.media-collection-list-view .form-actions input {
background: #477326;
}

div.feature_standalone .feature_standalone__image--processed article.media div.field img {
    height: 100%;
    width: 100%;
    object-fit: contain;
    max-width: unset;
    max-height: 300px !important;
}

.page-node-type-storytelling-landing-page .super-hero .hero .superhero-title-summary {
background: rgb(0, 43, 71);
}

.storytelling-minis {
background: rgb(0, 43, 71);
box-shadow: 0 0 0 100vmax rgb(0, 43, 71);
clip-path: inset(0 -100vmax);
}

img {
height: auto;
}

@media all and (min-width:64em) {
.usa-banner__language-menu {

    height: 100%;

}
  .usa-banner__dropdown-language-menu button {
    padding: 6px 24px 6px 16px;
    margin: 0 !important;
    min-width: 115px;
    background-position: right 0 top 53%;
  }
}
div.usa-banner__inner div.usa-banner__dropdown-language-menu{
  height: 100%;
}

iframe {
max-width: 100%;
}

.node-hero-image {
line-height: inherit;
}

.region-content {
  padding-left: 0.5rem !important;
}

html:lang(ar) .sidebar-menu:before, html:lang(he) .sidebar-menu:before, html:lang(ur) .sidebar-menu:before, html:lang(yi) .sidebar-menu:before {
  width: 0;
}

html:lang(ar)  .sidebar-menu ul, html:lang(he)  .sidebar-menu ul, html:lang(ur)  .sidebar-menu ul, html:lang(yi)  .sidebar-menu ul {
  padding-inline-start: 0;
}

html:lang(ur) .usa-nav__secondary, html:lang(ar) .usa-nav__secondary, html:lang(he) .usa-nav__secondary {
  right: auto;
  left: 2rem;
}

html:lang(ar) .node-hero-image, html:lang(ur) .node-hero-image, html:lang(he) .node-hero-image {
left: inherit;
}

@media (min-width: 1024px) {
.usa-nav__primary button.language-switcher {
    color: #1b1b1b !important;
}
}

.wp-block-fema-features .feature a.fema-link p {
margin-bottom: 0;
}

a.fema-link p {
font-weight: 600;
}

.wp-block-fema-features .feature a {
    text-decoration: underline;
}

.view-kids-resource-library .usa-accordion__button {
font-weight: bold;
}

.view-kids-resource-library .usa-accordion__button span {
font-weight: normal;
}

.fema-callout.alert.emergency {
    border-left: solid 6px #477236;
    background: #f5f5f7;
    margin-top: 20px;
    margin-bottom: 0;
}

.fema-callout {
    display: flex;
    align-items: center;
    padding: 1.3rem;
    margin: 20px 0;
}

.fema-callout.emergency p,.fema-callout.warning p,.header-top .fema-callout p,.language-warning p {
    font-weight: normal !important;
}

.fema-callout.emergency a,.fema-callout.warning a,.header-top .fema-callout a,.language-warning a {
    font-weight: normal !important;
}

.fema-callout.emergency a {
    color: #005288;
}

.fema-callout img {
    width: 40px;
    height: 40px;
    margin: 0 1rem;
}

.fema-callout p {
    margin: 0;
    padding: 0 1rem;
    font-weight: normal;
    width: 100%;
}

/* Storytelling landing page blue section */
.storytelling-minis {
padding: 2rem 0 1rem;
}
.wp-block-column .wp-block-fema-feature-mini.feature_mini {
margin-bottom:40px
}


