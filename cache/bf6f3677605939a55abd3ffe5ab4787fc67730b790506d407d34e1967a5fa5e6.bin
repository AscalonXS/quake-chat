<header><h2 id="righthand-choices-title">Your privacy choices</h2><button id="righthand-choices-close" type="button" aria-label="Close privacy choices">&times;</button></header>
<section><h3>Privacy preferences</h3><p id="righthand-choices-intro">Use this control to opt out of sale or sharing of personal information for cross-context behavioral advertising. On this website, opting out also stops optional analytics and advertising tracking in this browser. <a href="/privacy-statement/">See our privacy statement</a>.</p>
<label class="choice-row" for="righthand-choices-allow"><span>Allow optional analytics and advertising</span><input id="righthand-choices-allow" type="checkbox" role="switch"></label>
<p class="choice-detail">Turn this off and save your choice to stop optional tracking. Contact forms and direct scheduling links remain available.</p><p id="righthand-choices-signal" hidden>Your browser privacy signal has turned optional tracking off. This cannot be enabled while that signal is active.</p><p id="righthand-choices-status" role="status"></p><div id="righthand-choices-confirm" hidden><p>Allow optional analytics and advertising tracking in this browser?</p><button id="righthand-choices-confirm-allow" type="button">Allow tracking</button> <button id="righthand-choices-confirm-cancel" type="button">Keep opt-out</button></div></section>
<footer><button type="submit">Save my choices</button></footer>
</form></dialog>
<style>
#righthand-choices-footer{display:block;margin-top:8px;font:12px/1.5 Arial,sans-serif;color:#d0d0d0}#righthand-choices-open{border:0;background:transparent;color:inherit;font:inherit;cursor:pointer;padding:0;text-decoration:underline}#righthand-choices-open:focus-visible{outline:2px solid currentColor;outline-offset:4px}
#righthand-choices-dialog{box-sizing:border-box;width:440px;max-width:calc(100vw - 32px);max-height:calc(100dvh - 48px);padding:0;border:0;border-radius:6px;margin:auto;color:#292e31;background:#fff;font:13px/1.55 Arial,sans-serif;box-shadow:0 8px 40px #0003;overflow:auto}#righthand-choices-dialog::backdrop{background:rgba(0,0,0,.18)}
#righthand-choices-dialog form{margin:0}#righthand-choices-dialog header,#righthand-choices-dialog section,#righthand-choices-dialog footer{padding:16px 20px}#righthand-choices-dialog header{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #edf0f2}#righthand-choices-dialog h2{font:700 16px/1.4 Arial,sans-serif;margin:0}#righthand-choices-dialog h3{font:700 14px/1.4 Arial,sans-serif;margin:0 0 12px}#righthand-choices-dialog p{font:13px/1.55 Arial,sans-serif;color:#454b50;margin:0 0 16px}#righthand-choices-dialog a{color:inherit;text-decoration:underline}#righthand-choices-dialog button{cursor:pointer;border:0;border-radius:5px;background:#e7edef;color:#252a2d;font:700 13px/1.4 Arial,sans-serif;padding:12px 18px}#righthand-choices-dialog #righthand-choices-close{font-size:24px;line-height:1;padding:6px 12px;font-weight:400}#righthand-choices-dialog footer{display:flex;justify-content:flex-end;border-top:1px solid #edf0f2}#righthand-choices-dialog .choice-row{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:16px;background:#edf2f4;border-radius:5px;font-weight:700;cursor:pointer}#righthand-choices-dialog .choice-detail{margin:12px 0 0}#righthand-choices-dialog input{appearance:none;flex:0 0 48px;width:48px;height:26px;border:0;border-radius:20px;background:#626d75;position:relative;margin:0;cursor:pointer}#righthand-choices-dialog input::before{content:'';position:absolute;left:3px;top:3px;width:20px;height:20px;background:#fff;border-radius:50%;transition:transform .15s}#righthand-choices-dialog input:checked{background:#28566b}#righthand-choices-dialog input:checked::before{transform:translateX(22px)}#righthand-choices-dialog input:disabled{opacity:.65;cursor:default}#righthand-choices-dialog input:focus-visible,#righthand-choices-dialog button:focus-visible{outline:2px solid #28566b;outline-offset:3px}
</style>
<script data-choice-core data-nowprocket>
(function(){
var api=window.righthandPrivacy;
var dialog=document.getElementById('righthand-choices-dialog'),toggle=document.getElementById('righthand-choices-allow'),opener=document.getElementById('righthand-choices-open'),status=document.getElementById('righthand-choices-status'),confirmBox=document.getElementById('righthand-choices-confirm'),saveButton=document.querySelector('#righthand-choices-form button[type="submit"]');
var wrapper=document.getElementById('righthand-choices-footer');var policyLink=document.querySelector('p a[href$="/privacy-statement/"]');if(policyLink)policyLink.parentElement.appendChild(wrapper);
function render(){toggle.checked=!api.isOut();toggle.disabled=api.isGPC();document.getElementById('righthand-choices-signal').hidden=!api.isGPC();status.textContent=api.isOut()?'Optional tracking is off in this browser.':'';confirmBox.hidden=true;saveButton.hidden=false;}
function commit(value){var saved=api.choose(value);if(!saved){status.textContent='Your browser could not save this preference. Please enable site storage or contact us for help with your privacy request.';return;}dialog.close();location.reload();}
opener.addEventListener('click',function(){render();dialog.showModal();api.ready.then(function(){if(api.isGPC())render();});});
document.getElementById('righthand-choices-close').addEventListener('click',function(){dialog.close();});
document.getElementById('righthand-choices-form').addEventListener('submit',async function(event){event.preventDefault();var requestedOut=!toggle.checked;if(requestedOut){commit(true);return;}await api.ready;var next=api.isGPC()||requestedOut;if(!next&&api.isOut()){confirmBox.hidden=false;saveButton.hidden=true;document.getElementById('righthand-choices-confirm-allow').focus();return;}commit(next);});
document.getElementById('righthand-choices-confirm-allow').addEventListener('click',function(){if(!api.isGPC())commit(false);});
document.getElementById('righthand-choices-confirm-cancel').addEventListener('click',render);
dialog.addEventListener('close',function(){opener.focus();});
})();
