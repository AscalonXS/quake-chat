<script type="text/rocketlazyloadscript">
    jQuery(document).ready(function() {

        var sync1 = jQuery('#sync1'),
            sync2 = jQuery('#sync2'),
            duration = 300,
            thumbs = 5;

        // Sync nav
        sync1.on('click', '.owl-next', function() {
            var i = jQuery(sync1).find('.active').index();
            sync2.find('.owl-item').removeClass('current');
            sync2.find('.owl-item').eq(i).addClass('current');
            sync2.trigger('next.owl.carousel');
        });
        sync1.on('click', '.owl-prev', function() {
            var i = jQuery(sync1).find('.active').index();
            sync2.find('.owl-item').removeClass('current');
            sync2.find('.owl-item').eq(i).addClass('current');
            sync2.trigger('prev.owl.carousel');
        });

        // Start Carousel
        sync1.owlCarousel({
            items: 1,
            margin: 0,
            nav: true,
            dots: false,
            mouseDrag: false,
            touchDrag: false,
            pullDrag: false,
            autoHeight: true
        });

        sync2.owlCarousel({
            items: thumbs,
            // nav: true,
            dots: false,
            mouseDrag: false,
            touchDrag: false,
            pullDrag: false,

            responsive: {
                0: {
                    items: 1
                },
                600: {
                    items: 3
                },
                992: {
                    items: 5
                }
            }
        });

        sync2.on('click', '.owl-item', function() {
            var i = jQuery(this).index();
            jQuery(this).parent().find('.owl-item').removeClass('current');
            jQuery(this).addClass('current');
            sync1.trigger('to.owl.carousel', [i, duration, true]);
        });

        //        checkClasses();
        //        function checkClasses() {
        jQuery('#sync2 .owl-stage .owl-item.active').each(function(index) {
            if (index === 0) {
                jQuery(this).addClass('current');
            }
        });
        //        }
    });


    jQuery(document).ready(function() {
        jQuery('.cnt_video').owlCarousel({
            loop: true,
            nav: true,
            autoplay: false,
            margin: 0,
            autoHeight: false,
            autoplayTimeout: 4000,
            items: 1,
            responsive: {
                0: {
                    items: 1
                },
                600: {
                    items: 1
                },
                1600: {
                    items: 1
                }
            }
        });
    });

    jQuery(document).ready(function() {
        function close_accordion_section() {
            jQuery('.accordion .accordion-section-title').removeClass('active');
            jQuery('.accordion .accordion-section-content').slideUp(300).removeClass('open');
        }

        jQuery('.accordion-section-title').click(function(e) {
            // Grab current anchor value
            var currentAttrValue = jQuery(this).attr('href');

            if (jQuery(e.target).is('.active')) {
                close_accordion_section();
            } else {
                close_accordion_section();

                // Add active class to section title
                jQuery(this).addClass('active');
                // Open up the hidden content panel
                jQuery('.accordion ' + currentAttrValue).slideDown(300).addClass('open');
            }

            e.preventDefault();
        });
    });
</script>
