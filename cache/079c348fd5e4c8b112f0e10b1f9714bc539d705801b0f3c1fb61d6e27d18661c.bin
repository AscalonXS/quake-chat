                    window.g_isOneTrustAvailable = true;

                    if (typeof window.__tcfapi === 'function') {
                        window.g_isIabTcfInUse = true;
                        
                    }

                    if (typeof window.__gpp === 'function') {
                        window.g_isIabGppInUse = true;
