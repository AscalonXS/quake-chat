<script>
    const extractAndMultiply = (numbers) => {
      if (typeof numbers === 'string') {
        const parts = numbers.split(',');
        const number = parseInt(parts[0], 10);
        return [number * 100];
      }
      if (!numbers) return [];
      const multipliedNumbers = [];
      for (let i = 0; i < numbers.length; i++) {
          const parts = numbers[i].split(',');
          const number = parseInt(parts[0], 10);
          const multipliedNumber = number * 100;
          multipliedNumbers.push(multipliedNumber);
      }
      return multipliedNumbers;
  };
  document.addEventListener("DOMContentLoaded", () => {updateStepper(0, extractAndMultiply(["200,2026-early-access-tier-1","400,2026-early-access-tier-2"]), 0)
  });
</script>

