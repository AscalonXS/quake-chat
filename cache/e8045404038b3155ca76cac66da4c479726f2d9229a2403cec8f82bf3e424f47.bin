    /shopify-cdn\.getredo\.com/,
    /a\.klaviyo\.com/,
    /Js\.hs-scripts\.com/,
    /fonts\.googleapis\.com/,
    /s3-us-west-2\.amazonaws\.com/,
    /cdn\.iubenda\.com/,
    /public\.getfondue\.com/,
    /unpkg\.com/,
    /main\.js/,
    /theme\.js/,
    /cdn-widgetsrepository\.yotpo\.com/,
    /staticw2\.yotpo\.com/,
    /cdnjs\.cloudflare\.com/,
