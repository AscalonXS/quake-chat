				</nav>

				<!-- Title -->
				<h1 class="text-3xl md:text-4xl font-montserrat font-bold text-primary leading-tight mb-4">
					Concussion Symptoms: What to Watch for After a Head Injury				</h1>

				<!-- Meta -->
				<div class="flex items-center gap-5 text-bas text-primary mb-8">
											<span>Cerebral Health Team</span>
																<span>June 23, 2026</span>
									</div>

				<!-- Featured Image -->
				
				<!-- Article Content -->
				<article class="prose prose-lg max-w-none prose-headings:text-primary prose-headings:font-montserrat prose-headings:font-bold prose-headings:my-5 prose-p:text-[#363636] prose-p:leading-relaxed prose-a:text-[#5DADE2] prose-p:text-base prose-ul:text-base prose-li:text-base prose-strong:text-primary prose-ul:text-[#363636] prose-li:text-[#363636] prose-li:marker:!text-primary mb-12">
					
